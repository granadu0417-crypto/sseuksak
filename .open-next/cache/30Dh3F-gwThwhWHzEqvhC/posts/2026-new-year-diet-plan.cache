 수 없다\\u003c/strong\\u003e는 거예요.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 제가 직접 시도해보고 효과를 본 \\u003cstrong\\u003e건강한 4주 다이어트 식단\\u003c/strong\\u003e을 공유해드릴게요. 배고프지 않으면서도 체중 감량이 가능한 현실적인 방법입니다!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e다이어트 시작 전 체크리스트\\u003c/h2\\u003e\\n\\u003cp\\u003e식단을 짜기 전에, 먼저 몇 가지 점검해볼 게 있어요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e1. 현재 상태 파악하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e체크 항목\\u003c/th\\u003e\\n\\u003cth\\u003e나의 현재\\u003c/th\\u003e\\n\\u003cth\\u003e목표\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체중\\u003c/td\\u003e\\n\\u003ctd\\u003e___kg\\u003c/td\\u003e\\n\\u003ctd\\u003e___kg\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e키\\u003c/td\\u003e\\n\\u003ctd\\u003e___cm\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eBMI\\u003c/td\\u003e\\n\\u003ctd\\u003e___\\u003c/td\\u003e\\n\\u003ctd\\u003e18.5~23\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체지방률\\u003c/td\\u003e\\n\\u003ctd\\u003e___%\\u003c/td\\u003e\\n\\u003ctd\\u003e남 15\\u003cdel\\u003e20% / 여 20\\u003c/del\\u003e25%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eBMI 계산법\\u003c/strong\\u003e: 체중(kg) / 키(m) / 키(m)\\u003c/p\\u003e\\n\\u003cp\\u003e예시: 70kg, 170cm → 70 / 1.7 / 1.7 = 24.2\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e2. 현실적인 목표 세우기\\u003c/h3\\u003e\\n\\u003cp\\u003e한 달에 2~3kg 감량이 건강한 속도예요. 그 이상은 요요가 올 확률이 높아요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e비현실적: \\\"한 달에 10kg 빼겠다!\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e현실적: \\\"4주 동안 3kg 빼고, 이후 유지하겠다\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e3. 나에게 맞는 다이어트 방법 찾기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e추천 대상\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e칼로리 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e섭취량 줄이기\\u003c/td\\u003e\\n\\u003ctd\\u003e처음 시작하는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저탄수화물\\u003c/td\\u003e\\n\\u003ctd\\u003e탄수화물 줄이기\\u003c/td\\u003e\\n\\u003ctd\\u003e밥, 빵 좋아하시는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간헐적 단식\\u003c/td\\u003e\\n\\u003ctd\\u003e식사 시간 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e규칙적 생활 가능한 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저지방\\u003c/td\\u003e\\n\\u003ctd\\u003e지방 섭취 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e고기 좋아하시는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-4\\\"\\u003e4주 다이어트 식단표\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e기본 원칙\\u003c/h3\\u003e\\n\\u003cp\\u003e시작하기 전에 이 원칙만 기억하세요!\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e아침은 꼭 먹기 (대사 활성화)\\u003c/li\\u003e\\n\\u003cli\\u003e저녁은 가볍게 (취침 3시간 전 마무리)\\u003c/li\\u003e\\n\\u003cli\\u003e물 하루 2L 이상 마시기\\u003c/li\\u003e\\n\\u003cli\\u003e간식은 과일, 견과류로\\u003c/li\\u003e\\n\\u003cli\\u003e하루 한 끼는 맛있게 (스트레스 방지)\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e1주차: 적응 주간 (하루 1,600kcal)\\u003c/h3\\u003e\\n\\u003cp\\u003e첫 주는 몸이 적응하는 시간이에요. 너무 급격하게 줄이면 포기하기 쉬워요!\\u003c/p\\u003e\\n\\u003ch4\\u003e월요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e통밀빵 1장 + 삶은 달걀 2개 + 우유 200ml\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e닭가슴살 샐러드 + 현미밥 반 공기\\u003c/td\\u003e\\n\\u003ctd\\u003e450kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e두부 스테이크 + 채소 볶음\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e그릭요거트 + 블루베리\\u003c/td\\u003e\\n\\u003ctd\\u003e150kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e화요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e오트밀 + 바나나 + 아몬드\\u003c/td\\u003e\\n\\u003ctd\\u003e300kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e연어 포케 볼\\u003c/td\\u003e\\n\\u003ctd\\u003e500kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e계란찜 + 나물 반찬 + 잡곡밥 1/3\\u003c/td\\u003e\\n\\u003ctd\\u003e400kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e사과 1개\\u003c/td\\u003e\\n\\u003ctd\\u003e100kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e수요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e그릭요거트 + 그래놀라 + 딸기\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e소고기 샤브샤브 (채소 위주)\\u003c/td\\u003e\\n\\u003ctd\\u003e450kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e닭가슴살 구이 + 구운 채소\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e견과류 한 줌 (30g)\\u003c/td\\u003e\\n\\u003ctd\\u003e180kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e목요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e통밀 베이글 + 크림치즈(라이트) + 아메리카노\\u003c/td\\u003e\\n\\u003ctd\\u003e320kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e비빔밥 (고추장 적게, 밥 적게)\\u003c/td\\u003e\\n\\u003ctd\\u003e480kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e생선구이 + 미역국 + 반찬\\u003c/td\\u003e\\n\\u003ctd\\u003e380kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e당근 스틱 + 후무스\\u003c/td\\u003e\\n\\u003ctd\\u003e120kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e금요일 (치팅데이!)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e스크램블 에그 + 토스트\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e좋아하는 음식 (적당량)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e600kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e콩나물국 + 두부 + 나물\\u003c/td\\u003e\\n\\u003ctd\\u003e300kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e과일\\u003c/td\\u003e\\n\\u003ctd\\u003e100kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e치팅데이 팁\\u003c/strong\\u003e: 완전 폭식이 아니라, 평소 먹고 싶었던 걸 '적당량' 먹는 날이에요!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e주말\\u003c/h4\\u003e\\n\\u003cp\\u003e주말에는 평일보다 조금 여유롭게, 하지만 원칙은 지켜주세요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e토요일\\u003c/strong\\u003e: 브런치 (에그베네딕트 등) + 가벼운 저녁\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e일요일\\u003c/strong\\u003e: 집밥 위주, 다음 주 준비\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e2주차: 본격 감량 주간 (하루 1,400kcal)\\u003c/h3\\u003e\\n\\u003cp\\u003e1주차에 적응했다면, 이제 조금 더 줄여볼게요.\\u003c/p\\u003e\\n\\u003ch4\\u003e2주차 식단 포인트\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e탄수화물을 점심에 집중\\u003c/li\\u003e\\n\\u003cli\\u003e저녁은 단백질 + 채소 위주\\u003c/li\\u003e\\n\\u003cli\\u003e간식은 오후 3시 전에만\\u003c/li\\u003e\\n\\u003cli\\u003e저녁 7시 이후 금식\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e샘플 메뉴\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아침 옵션 (300kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e삶은 달걀 2개 + 방울토마토\\u003c/li\\u003e\\n\\u003cli\\u003e프로틴 쉐이크 + 바나나 반 개\\u003c/li\\u003e\\n\\u003cli\\u003e무가당 그릭요거트 + 견과류 소량\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e점심 옵션 (450kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e닭가슴살 도시락 (밥 반 공기)\\u003c/li\\u003e\\n\\u003cli\\u003e월남쌈 + 라이스페이퍼\\u003c/li\\u003e\\n\\u003cli\\u003e메밀소바 + 삶은 달걀\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e저녁 옵션 (350kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e두부 샐러드 (드레싱 적게)\\u003c/li\\u003e\\n\\u003cli\\u003e계란찜 + 버섯볶음\\u003c/li\\u003e\\n\\u003cli\\u003e닭가슴살 수프\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e3주차: 가속 주간 (하루 1,300kcal + 운동)\\u003c/h3\\u003e\\n\\u003cp\\u003e3주차부터는 가벼운 운동을 병행해요. 식단만으로는 한계가 있거든요!\\u003c/p\\u003e\\n\\u003ch4\\u003e추천 운동 조합\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e요일\\u003c/th\\u003e\\n\\u003cth\\u003e운동\\u003c/th\\u003e\\n\\u003cth\\u003e시간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월/수/금\\u003c/td\\u003e\\n\\u003ctd\\u003e유산소 (걷기, 조깅)\\u003c/td\\u003e\\n\\u003ctd\\u003e30분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e화/목\\u003c/td\\u003e\\n\\u003ctd\\u003e근력 (스쿼트, 플랭크)\\u003c/td\\u003e\\n\\u003ctd\\u003e20분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e토\\u003c/td\\u003e\\n\\u003ctd\\u003e자유 운동\\u003c/td\\u003e\\n\\u003ctd\\u003e1시간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일\\u003c/td\\u003e\\n\\u003ctd\\u003e휴식\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e3주차 식단 특징\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e아침: 단백질 위주 (250kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e점심: 균형 잡힌 식사 (450kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e저녁: 채소 + 단백질 (300kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e간식: 운동 후 프로틴 (200kcal)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e4주차: 마무리 \\u0026#x26; 유지 주간\\u003c/h3\\u003e\\n\\u003cp\\u003e드디어 마지막 주! 여기서 중요한 건 \\u003cstrong\\u003e유지할 수 있는 식습관 만들기\\u003c/strong\\u003e예요.\\u003c/p\\u003e\\n\\u003ch4\\u003e4주차 목표\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e3주 동안 만든 식습관 유지\\u003c/li\\u003e\\n\\u003cli\\u003e치팅데이 규칙 세우기 (주 1회)\\u003c/li\\u003e\\n\\u003cli\\u003e내 몸에 맞는 적정 칼로리 찾기\\u003c/li\\u003e\\n\\u003cli\\u003e장기 유지 가능한 루틴 확립\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e유지를 위한 팁\\u003c/h4\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e기록하기\\u003c/strong\\u003e: 식단 앱으로 먹은 것 기록\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e주간 체크\\u003c/strong\\u003e: 매주 같은 시간에 체중 측정\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e유연하게\\u003c/strong\\u003e: 외식, 모임은 즐기되 다음 날 조절\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e운동 습관화\\u003c/strong\\u003e: 주 3회 이상 꾸준히\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-10\\\"\\u003e다이어트 장보기 리스트\\u003c/h2\\u003e\\n\\u003cp\\u003e매주 장볼 때 이것만 사세요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e단백질\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e닭가슴살 (냉동 대용량 추천)\\u003c/li\\u003e\\n\\u003cli\\u003e달걀\\u003c/li\\u003e\\n\\u003cli\\u003e두부\\u003c/li\\u003e\\n\\u003cli\\u003e그릭요거트 (무가당)\\u003c/li\\u003e\\n\\u003cli\\u003e연어, 고등어 등 생선\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e탄수화물\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e현미, 잡곡\\u003c/li\\u003e\\n\\u003cli\\u003e통밀빵\\u003c/li\\u003e\\n\\u003cli\\u003e오트밀\\u003c/li\\u003e\\n\\u003cli\\u003e고구마\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e채소 \\u0026#x26; 과일\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e방울토마토, 오이, 당근 (간식용)\\u003c/li\\u003e\\n\\u003cli\\u003e브로콜리, 시금치, 양배추\\u003c/li\\u003e\\n\\u003cli\\u003e버섯류\\u003c/li\\u003e\\n\\u003cli\\u003e사과, 바나나, 베리류\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e기타\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e견과류 (소포장)\\u003c/li\\u003e\\n\\u003cli\\u003e올리브오일\\u003c/li\\u003e\\n\\u003cli\\u003e후무스, 땅콩버터 (무가당)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-15\\\"\\u003e다이어트 성공 꿀팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e1. 물 마시기의 마법\\u003c/h3\\u003e\\n\\u003cp\\u003e물만 잘 마셔도 다이어트 효과가 있어요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e식전 30분에 물 한 잔 - 포만감 UP\\u003c/li\\u003e\\n\\u003cli\\u003e배고플 때 물 한 잔 - 가짜 배고픔 해결\\u003c/li\\u003e\\n\\u003cli\\u003e하루 2L - 대사량 증가\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e2. 야식 참는 법\\u003c/h3\\u003e\\n\\u003cp\\u003e저녁 먹고 배고플 때 이렇게 해보세요:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e따뜻한 물 또는 허브티 마시기\\u003c/li\\u003e\\n\\u003cli\\u003e양치질하기 (효과 있어요!)\\u003c/li\\u003e\\n\\u003cli\\u003e일찍 자기 (8시간 수면 권장)\\u003c/li\\u003e\\n\\u003cli\\u003e정 배고프면 오이, 당근 스틱\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e3. 외식할 때 꿀팁\\u003c/h3\\u003e\\n\\u003cp\\u003e회식이나 외식은 피할 수 없잖아요. 이럴 땐:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상황\\u003c/th\\u003e\\n\\u003cth\\u003e추천 메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e피할 메뉴\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한식\\u003c/td\\u003e\\n\\u003ctd\\u003e생선구이, 제육볶음\\u003c/td\\u003e\\n\\u003ctd\\u003e찌개 + 밥 많이\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e양식\\u003c/td\\u003e\\n\\u003ctd\\u003e스테이크, 샐러드\\u003c/td\\u003e\\n\\u003ctd\\u003e파스타, 피자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일식\\u003c/td\\u003e\\n\\u003ctd\\u003e사시미, 초밥 적당히\\u003c/td\\u003e\\n\\u003ctd\\u003e튀김, 우동\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중식\\u003c/td\\u003e\\n\\u003ctd\\u003e깐풍기, 유산슬\\u003c/td\\u003e\\n\\u003ctd\\u003e짜장면, 탕수육\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e4. 정체기 극복법\\u003c/h3\\u003e\\n\\u003cp\\u003e2~3주 지나면 체중이 안 빠지는 정체기가 와요. 당황하지 마세요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e정체기 돌파 전략\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e식단 변화 주기 (다른 메뉴로)\\u003c/li\\u003e\\n\\u003cli\\u003e운동 강도나 종류 바꾸기\\u003c/li\\u003e\\n\\u003cli\\u003e충분한 수면 (7~8시간)\\u003c/li\\u003e\\n\\u003cli\\u003e스트레스 관리 (코르티솔 때문)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-20\\\"\\u003e추천 다이어트 앱\\u003c/h2\\u003e\\n\\u003cp\\u003e식단 관리에 도움되는 앱들이에요!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e앱 이름\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e마이피트니스팔\\u003c/td\\u003e\\n\\u003ctd\\u003e칼로리 계산, 음식 DB 풍부\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 (프리미엄 유료)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e눔\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 코칭, 심리 기반 접근\\u003c/td\\u003e\\n\\u003ctd\\u003e유료 구독\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성 헬스\\u003c/td\\u003e\\n\\u003ctd\\u003e걸음 수, 운동 연동\\u003c/td\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다신\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 음식 DB, 커뮤니티\\u003c/td\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-21\\\"\\u003e다이어트 시 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e절대 하지 말아야 할 것\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e하루 1,000kcal 이하 극단적 제한\\u003c/li\\u003e\\n\\u003cli\\u003e한 가지 음식만 먹는 원푸드 다이어트\\u003c/li\\u003e\\n\\u003cli\\u003e다이어트 약 무분별한 복용\\u003c/li\\u003e\\n\\u003cli\\u003e살 빠졌다고 바로 폭식\\u003c/li\\u003e\\n\\u003cli\\u003e운동 없이 굶기만 하기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e이런 증상 나타나면 중단하세요\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e심한 어지러움, 두통\\u003c/li\\u003e\\n\\u003cli\\u003e생리불순 (여성)\\u003c/li\\u003e\\n\\u003cli\\u003e탈모\\u003c/li\\u003e\\n\\u003cli\\u003e근육 경련\\u003c/li\\u003e\\n\\u003cli\\u003e극심한 피로감\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e이런 증상이 나타나면 칼로리를 늘리고, 필요시 전문가 상담을 받으세요!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-24\\\"\\u003e4주 후 기대 효과\\u003c/h2\\u003e\\n\\u003cp\\u003e현실적으로 기대할 수 있는 변화예요:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e기대 변화\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체중\\u003c/td\\u003e\\n\\u003ctd\\u003e-2~4kg\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체지방률\\u003c/td\\u003e\\n\\u003ctd\\u003e-1~2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e허리둘레\\u003c/td\\u003e\\n\\u003ctd\\u003e-2~5cm\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e컨디션\\u003c/td\\u003e\\n\\u003ctd\\u003e훨씬 가벼움\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e피부\\u003c/td\\u003e\\n\\u003ctd\\u003e트러블 감소\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수면\\u003c/td\\u003e\\n\\u003ctd\\u003e질 향상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e다이어트는 단기간에 끝나는 게 아니라 \\u003cstrong\\u003e생활 습관을 바꾸는 과정\\u003c/strong\\u003e이에요.\\u003c/p\\u003e\\n\\u003cp\\u003e4주 식단표를 따라하시면서 느끼실 거예요. \\\"아, 이 정도면 평생 할 수 있겠다!\\\" 그 느낌이 올 때, 진짜 다이어트에 성공한 거예요.\\u003c/p\\u003e\\n\\u003cp\\u003e무리하지 말고, 포기하지 말고, 천천히 꾸준히!\\u003c/p\\u003e\\n\\u003cp\\u003e2026년에는 건강한 몸과 함께 자신감도 되찾으시길 바랍니다!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/home-training-routine-2026\\\"\\u003e집에서 하는 홈트레이닝 루틴 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/ces-2026-tech-trends\\\"\\u003e2026년 건강 트렌드: AI 헬스케어의 진화\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L22\\\",null,{\\\"content\\\":\\\"$23\\\"}]\\n24:T33c2,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 신년 다이어트 식단: 건강하게 살 빼는 4주 식단표 완벽 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"올해는 진짜 살 빼야지!\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e새해 첫날, 이렇게 다짐하신 분들 많으시죠?\\u003c/p\\u003e\\n\\u003cp\\u003e저도 매년 똑같은 결심을 했다가 작심삼일로 끝나곤 했는데요. 그러다 깨달은 게 있어요. \\u003cstrong\\u003e무조건 굶는 다이어트는 절대 성공할 수 없다\\u003c/strong\\u003e는 거예요.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 제가 직접 시도해보고 효과를 본 \\u003cstrong\\u003e건강한 4주 다이어트 식단\\u003c/strong\\u003e을 공유해드릴게요. 배고프지 않으면서도 체중 감량이 가능한 현실적인 방법입니다!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e다이어트 시작 전 체크리스트\\u003c/h2\\u003e\\n\\u003cp\\u003e식단을 짜기 전에, 먼저 몇 가지 점검해볼 게 있어요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e1. 현재 상태 파악하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e체크 항목\\u003c/th\\u003e\\n\\u003cth\\u003e나의 현재\\u003c/th\\u003e\\n\\u003cth\\u003e목표\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체중\\u003c/td\\u003e\\n\\u003ctd\\u003e___kg\\u003c/td\\u003e\\n\\u003ctd\\u003e___kg\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e키\\u003c/td\\u003e\\n\\u003ctd\\u003e___cm\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eBMI\\u003c/td\\u003e\\n\\u003ctd\\u003e___\\u003c/td\\u003e\\n\\u003ctd\\u003e18.5~23\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체지방률\\u003c/td\\u003e\\n\\u003ctd\\u003e___%\\u003c/td\\u003e\\n\\u003ctd\\u003e남 15\\u003cdel\\u003e20% / 여 20\\u003c/del\\u003e25%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eBMI 계산법\\u003c/strong\\u003e: 체중(kg) / 키(m) / 키(m)\\u003c/p\\u003e\\n\\u003cp\\u003e예시: 70kg, 170cm → 70 / 1.7 / 1.7 = 24.2\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e2. 현실적인 목표 세우기\\u003c/h3\\u003e\\n\\u003cp\\u003e한 달에 2~3kg 감량이 건강한 속도예요. 그 이상은 요요가 올 확률이 높아요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e비현실적: \\\"한 달에 10kg 빼겠다!\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e현실적: \\\"4주 동안 3kg 빼고, 이후 유지하겠다\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e3. 나에게 맞는 다이어트 방법 찾기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e추천 대상\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e칼로리 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e섭취량 줄이기\\u003c/td\\u003e\\n\\u003ctd\\u003e처음 시작하는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저탄수화물\\u003c/td\\u003e\\n\\u003ctd\\u003e탄수화물 줄이기\\u003c/td\\u003e\\n\\u003ctd\\u003e밥, 빵 좋아하시는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간헐적 단식\\u003c/td\\u003e\\n\\u003ctd\\u003e식사 시간 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e규칙적 생활 가능한 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저지방\\u003c/td\\u003e\\n\\u003ctd\\u003e지방 섭취 제한\\u003c/td\\u003e\\n\\u003ctd\\u003e고기 좋아하시는 분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-4\\\"\\u003e4주 다이어트 식단표\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e기본 원칙\\u003c/h3\\u003e\\n\\u003cp\\u003e시작하기 전에 이 원칙만 기억하세요!\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e아침은 꼭 먹기 (대사 활성화)\\u003c/li\\u003e\\n\\u003cli\\u003e저녁은 가볍게 (취침 3시간 전 마무리)\\u003c/li\\u003e\\n\\u003cli\\u003e물 하루 2L 이상 마시기\\u003c/li\\u003e\\n\\u003cli\\u003e간식은 과일, 견과류로\\u003c/li\\u003e\\n\\u003cli\\u003e하루 한 끼는 맛있게 (스트레스 방지)\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e1주차: 적응 주간 (하루 1,600kcal)\\u003c/h3\\u003e\\n\\u003cp\\u003e첫 주는 몸이 적응하는 시간이에요. 너무 급격하게 줄이면 포기하기 쉬워요!\\u003c/p\\u003e\\n\\u003ch4\\u003e월요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e통밀빵 1장 + 삶은 달걀 2개 + 우유 200ml\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e닭가슴살 샐러드 + 현미밥 반 공기\\u003c/td\\u003e\\n\\u003ctd\\u003e450kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e두부 스테이크 + 채소 볶음\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e그릭요거트 + 블루베리\\u003c/td\\u003e\\n\\u003ctd\\u003e150kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e화요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e오트밀 + 바나나 + 아몬드\\u003c/td\\u003e\\n\\u003ctd\\u003e300kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e연어 포케 볼\\u003c/td\\u003e\\n\\u003ctd\\u003e500kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e계란찜 + 나물 반찬 + 잡곡밥 1/3\\u003c/td\\u003e\\n\\u003ctd\\u003e400kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e사과 1개\\u003c/td\\u003e\\n\\u003ctd\\u003e100kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e수요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e그릭요거트 + 그래놀라 + 딸기\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e소고기 샤브샤브 (채소 위주)\\u003c/td\\u003e\\n\\u003ctd\\u003e450kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e닭가슴살 구이 + 구운 채소\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e견과류 한 줌 (30g)\\u003c/td\\u003e\\n\\u003ctd\\u003e180kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e목요일\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e통밀 베이글 + 크림치즈(라이트) + 아메리카노\\u003c/td\\u003e\\n\\u003ctd\\u003e320kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e비빔밥 (고추장 적게, 밥 적게)\\u003c/td\\u003e\\n\\u003ctd\\u003e480kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e생선구이 + 미역국 + 반찬\\u003c/td\\u003e\\n\\u003ctd\\u003e380kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e당근 스틱 + 후무스\\u003c/td\\u003e\\n\\u003ctd\\u003e120kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e금요일 (치팅데이!)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e끼니\\u003c/th\\u003e\\n\\u003cth\\u003e메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e칼로리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e아침\\u003c/td\\u003e\\n\\u003ctd\\u003e스크램블 에그 + 토스트\\u003c/td\\u003e\\n\\u003ctd\\u003e350kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e점심\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e좋아하는 음식 (적당량)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e600kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e저녁\\u003c/td\\u003e\\n\\u003ctd\\u003e콩나물국 + 두부 + 나물\\u003c/td\\u003e\\n\\u003ctd\\u003e300kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003ctd\\u003e과일\\u003c/td\\u003e\\n\\u003ctd\\u003e100kcal\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e치팅데이 팁\\u003c/strong\\u003e: 완전 폭식이 아니라, 평소 먹고 싶었던 걸 '적당량' 먹는 날이에요!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e주말\\u003c/h4\\u003e\\n\\u003cp\\u003e주말에는 평일보다 조금 여유롭게, 하지만 원칙은 지켜주세요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e토요일\\u003c/strong\\u003e: 브런치 (에그베네딕트 등) + 가벼운 저녁\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e일요일\\u003c/strong\\u003e: 집밥 위주, 다음 주 준비\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e2주차: 본격 감량 주간 (하루 1,400kcal)\\u003c/h3\\u003e\\n\\u003cp\\u003e1주차에 적응했다면, 이제 조금 더 줄여볼게요.\\u003c/p\\u003e\\n\\u003ch4\\u003e2주차 식단 포인트\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e탄수화물을 점심에 집중\\u003c/li\\u003e\\n\\u003cli\\u003e저녁은 단백질 + 채소 위주\\u003c/li\\u003e\\n\\u003cli\\u003e간식은 오후 3시 전에만\\u003c/li\\u003e\\n\\u003cli\\u003e저녁 7시 이후 금식\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e샘플 메뉴\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아침 옵션 (300kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e삶은 달걀 2개 + 방울토마토\\u003c/li\\u003e\\n\\u003cli\\u003e프로틴 쉐이크 + 바나나 반 개\\u003c/li\\u003e\\n\\u003cli\\u003e무가당 그릭요거트 + 견과류 소량\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e점심 옵션 (450kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e닭가슴살 도시락 (밥 반 공기)\\u003c/li\\u003e\\n\\u003cli\\u003e월남쌈 + 라이스페이퍼\\u003c/li\\u003e\\n\\u003cli\\u003e메밀소바 + 삶은 달걀\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e저녁 옵션 (350kcal 이하)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e두부 샐러드 (드레싱 적게)\\u003c/li\\u003e\\n\\u003cli\\u003e계란찜 + 버섯볶음\\u003c/li\\u003e\\n\\u003cli\\u003e닭가슴살 수프\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e3주차: 가속 주간 (하루 1,300kcal + 운동)\\u003c/h3\\u003e\\n\\u003cp\\u003e3주차부터는 가벼운 운동을 병행해요. 식단만으로는 한계가 있거든요!\\u003c/p\\u003e\\n\\u003ch4\\u003e추천 운동 조합\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e요일\\u003c/th\\u003e\\n\\u003cth\\u003e운동\\u003c/th\\u003e\\n\\u003cth\\u003e시간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월/수/금\\u003c/td\\u003e\\n\\u003ctd\\u003e유산소 (걷기, 조깅)\\u003c/td\\u003e\\n\\u003ctd\\u003e30분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e화/목\\u003c/td\\u003e\\n\\u003ctd\\u003e근력 (스쿼트, 플랭크)\\u003c/td\\u003e\\n\\u003ctd\\u003e20분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e토\\u003c/td\\u003e\\n\\u003ctd\\u003e자유 운동\\u003c/td\\u003e\\n\\u003ctd\\u003e1시간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일\\u003c/td\\u003e\\n\\u003ctd\\u003e휴식\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e3주차 식단 특징\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e아침: 단백질 위주 (250kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e점심: 균형 잡힌 식사 (450kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e저녁: 채소 + 단백질 (300kcal)\\u003c/li\\u003e\\n\\u003cli\\u003e간식: 운동 후 프로틴 (200kcal)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e4주차: 마무리 \\u0026#x26; 유지 주간\\u003c/h3\\u003e\\n\\u003cp\\u003e드디어 마지막 주! 여기서 중요한 건 \\u003cstrong\\u003e유지할 수 있는 식습관 만들기\\u003c/strong\\u003e예요.\\u003c/p\\u003e\\n\\u003ch4\\u003e4주차 목표\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e3주 동안 만든 식습관 유지\\u003c/li\\u003e\\n\\u003cli\\u003e치팅데이 규칙 세우기 (주 1회)\\u003c/li\\u003e\\n\\u003cli\\u003e내 몸에 맞는 적정 칼로리 찾기\\u003c/li\\u003e\\n\\u003cli\\u003e장기 유지 가능한 루틴 확립\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e유지를 위한 팁\\u003c/h4\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e기록하기\\u003c/strong\\u003e: 식단 앱으로 먹은 것 기록\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e주간 체크\\u003c/strong\\u003e: 매주 같은 시간에 체중 측정\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e유연하게\\u003c/strong\\u003e: 외식, 모임은 즐기되 다음 날 조절\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e운동 습관화\\u003c/strong\\u003e: 주 3회 이상 꾸준히\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-10\\\"\\u003e다이어트 장보기 리스트\\u003c/h2\\u003e\\n\\u003cp\\u003e매주 장볼 때 이것만 사세요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e단백질\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e닭가슴살 (냉동 대용량 추천)\\u003c/li\\u003e\\n\\u003cli\\u003e달걀\\u003c/li\\u003e\\n\\u003cli\\u003e두부\\u003c/li\\u003e\\n\\u003cli\\u003e그릭요거트 (무가당)\\u003c/li\\u003e\\n\\u003cli\\u003e연어, 고등어 등 생선\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e탄수화물\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e현미, 잡곡\\u003c/li\\u003e\\n\\u003cli\\u003e통밀빵\\u003c/li\\u003e\\n\\u003cli\\u003e오트밀\\u003c/li\\u003e\\n\\u003cli\\u003e고구마\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e채소 \\u0026#x26; 과일\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e방울토마토, 오이, 당근 (간식용)\\u003c/li\\u003e\\n\\u003cli\\u003e브로콜리, 시금치, 양배추\\u003c/li\\u003e\\n\\u003cli\\u003e버섯류\\u003c/li\\u003e\\n\\u003cli\\u003e사과, 바나나, 베리류\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e기타\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e견과류 (소포장)\\u003c/li\\u003e\\n\\u003cli\\u003e올리브오일\\u003c/li\\u003e\\n\\u003cli\\u003e후무스, 땅콩버터 (무가당)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-15\\\"\\u003e다이어트 성공 꿀팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e1. 물 마시기의 마법\\u003c/h3\\u003e\\n\\u003cp\\u003e물만 잘 마셔도 다이어트 효과가 있어요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e식전 30분에 물 한 잔 - 포만감 UP\\u003c/li\\u003e\\n\\u003cli\\u003e배고플 때 물 한 잔 - 가짜 배고픔 해결\\u003c/li\\u003e\\n\\u003cli\\u003e하루 2L - 대사량 증가\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e2. 야식 참는 법\\u003c/h3\\u003e\\n\\u003cp\\u003e저녁 먹고 배고플 때 이렇게 해보세요:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e따뜻한 물 또는 허브티 마시기\\u003c/li\\u003e\\n\\u003cli\\u003e양치질하기 (효과 있어요!)\\u003c/li\\u003e\\n\\u003cli\\u003e일찍 자기 (8시간 수면 권장)\\u003c/li\\u003e\\n\\u003cli\\u003e정 배고프면 오이, 당근 스틱\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e3. 외식할 때 꿀팁\\u003c/h3\\u003e\\n\\u003cp\\u003e회식이나 외식은 피할 수 없잖아요. 이럴 땐:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상황\\u003c/th\\u003e\\n\\u003cth\\u003e추천 메뉴\\u003c/th\\u003e\\n\\u003cth\\u003e피할 메뉴\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한식\\u003c/td\\u003e\\n\\u003ctd\\u003e생선구이, 제육볶음\\u003c/td\\u003e\\n\\u003ctd\\u003e찌개 + 밥 많이\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e양식\\u003c/td\\u003e\\n\\u003ctd\\u003e스테이크, 샐러드\\u003c/td\\u003e\\n\\u003ctd\\u003e파스타, 피자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일식\\u003c/td\\u003e\\n\\u003ctd\\u003e사시미, 초밥 적당히\\u003c/td\\u003e\\n\\u003ctd\\u003e튀김, 우동\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중식\\u003c/td\\u003e\\n\\u003ctd\\u003e깐풍기, 유산슬\\u003c/td\\u003e\\n\\u003ctd\\u003e짜장면, 탕수육\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e4. 정체기 극복법\\u003c/h3\\u003e\\n\\u003cp\\u003e2~3주 지나면 체중이 안 빠지는 정체기가 와요. 당황하지 마세요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e정체기 돌파 전략\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e식단 변화 주기 (다른 메뉴로)\\u003c/li\\u003e\\n\\u003cli\\u003e운동 강도나 종류 바꾸기\\u003c/li\\u003e\\n\\u003cli\\u003e충분한 수면 (7~8시간)\\u003c/li\\u003e\\n\\u003cli\\u003e스트레스 관리 (코르티솔 때문)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-20\\\"\\u003e추천 다이어트 앱\\u003c/h2\\u003e\\n\\u003cp\\u003e식단 관리에 도움되는 앱들이에요!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e앱 이름\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e마이피트니스팔\\u003c/td\\u003e\\n\\u003ctd\\u003e칼로리 계산, 음식 DB 풍부\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 (프리미엄 유료)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e눔\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 코칭, 심리 기반 접근\\u003c/td\\u003e\\n\\u003ctd\\u003e유료 구독\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성 헬스\\u003c/td\\u003e\\n\\u003ctd\\u003e걸음 수, 운동 연동\\u003c/td\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다신\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 음식 DB, 커뮤니티\\u003c/td\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-21\\\"\\u003e다이어트 시 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e절대 하지 말아야 할 것\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e하루 1,000kcal 이하 극단적 제한\\u003c/li\\u003e\\n\\u003cli\\u003e한 가지 음식만 먹는 원푸드 다이어트\\u003c/li\\u003e\\n\\u003cli\\u003e다이어트 약 무분별한 복용\\u003c/li\\u003e\\n\\u003cli\\u003e살 빠졌다고 바로 폭식\\u003c/li\\u003e\\n\\u003cli\\u003e운동 없이 굶기만 하기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e이런 증상 나타나면 중단하세요\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e심한 어지러움, 두통\\u003c/li\\u003e\\n\\u003cli\\u003e생리불순 (여성)\\u003c/li\\u003e\\n\\u003cli\\u003e탈모\\u003c/li\\u003e\\n\\u003cli\\u003e근육 경련\\u003c/li\\u003e\\n\\u003cli\\u003e극심한 피로감\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e이런 증상이 나타나면 칼로리를 늘리고, 필요시 전문가 상담을 받으세요!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-24\\\"\\u003e4주 후 기대 효과\\u003c/h2\\u003e\\n\\u003cp\\u003e현실적으로 기대할 수 있는 변화예요:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e기대 변화\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체중\\u003c/td\\u003e\\n\\u003ctd\\u003e-2~4kg\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체지방률\\u003c/td\\u003e\\n\\u003ctd\\u003e-1~2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e허리둘레\\u003c/td\\u003e\\n\\u003ctd\\u003e-2~5cm\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e컨디션\\u003c/td\\u003e\\n\\u003ctd\\u003e훨씬 가벼움\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e피부\\u003c/td\\u003e\\n\\u003ctd\\u003e트러블 감소\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수면\\u003c/td\\u003e\\n\\u003ctd\\u003e질 향상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e다이어트는 단기간에 끝나는 게 아니라 \\u003cstrong\\u003e생활 습관을 바꾸는 과정\\u003c/strong\\u003e이에요.\\u003c/p\\u003e\\n\\u003cp\\u003e4주 식단표를 따라하시면서 느끼실 거예요. \\\"아, 이 정도면 평생 할 수 있겠다!\\\" 그 느낌이 올 때, 진짜 다이어트에 성공한 거예요.\\u003c/p\\u003e\\n\\u003cp\\u003e무리하지 말고, 포기하지 말고, 천천히 꾸준히!\\u003c/p\\u003e\\n\\u003cp\\u003e2026년에는 건강한 몸과 함께 자신감도 되찾으시길 바랍니다!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/home-training-routine-2026\\\"\\u003e집에서 하는 홈트레이닝 루틴 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/ces-2026-tech-trends\\\"\\u003e2026년 건강 트렌드: AI 헬스케어의 진화\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$24\\\"}}]\\n\"])</script><script>self.__ne