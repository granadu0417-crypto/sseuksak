구분\\u003c/th\\u003e\\n\\u003cth\\u003e공제액 (수도권)\\u003c/th\\u003e\\n\\u003cth\\u003e공제액 (비수도권)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e청년·장애인·60세 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e1,100만원\\u003c/td\\u003e\\n\\u003ctd\\u003e1,200만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e그 외 상시근로자\\u003c/td\\u003e\\n\\u003ctd\\u003e700만원\\u003c/td\\u003e\\n\\u003ctd\\u003e770만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적용 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e3년간\\u003c/td\\u003e\\n\\u003ctd\\u003e3년간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-23\\\"\\u003e5. 월별 세금 캘린더\\u003c/h2\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월\\u003c/th\\u003e\\n\\u003cth\\u003e세금\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e부가가치세\\u003c/td\\u003e\\n\\u003ctd\\u003e2기 확정신고 (25일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e원천세\\u003c/td\\u003e\\n\\u003ctd\\u003e12월분 신고·납부 (10일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e부가가치세\\u003c/td\\u003e\\n\\u003ctd\\u003e1기 예정신고 (25일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e5월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e종합소득세\\u003c/td\\u003e\\n\\u003ctd\\u003e전년도 신고·납부 (31일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e지방소득세\\u003c/td\\u003e\\n\\u003ctd\\u003e종합소득세와 동시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e7월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e부가가치세\\u003c/td\\u003e\\n\\u003ctd\\u003e1기 확정신고 (25일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e재산세\\u003c/td\\u003e\\n\\u003ctd\\u003e1기분 납부\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e부가가치세\\u003c/td\\u003e\\n\\u003ctd\\u003e2기 예정신고 (25일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-24\\\"\\u003e6. 세무조사 대비 증빙 관리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e반드시 보관해야 할 증빙\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e증빙 종류\\u003c/th\\u003e\\n\\u003cth\\u003e보관 기간\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세금계산서\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e전자 발행 권장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현금영수증\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e지출증빙용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e카드전표\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e법인카드/사업자카드\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간이영수증\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e3만원 미만만 인정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인건비 증빙\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e근로계약서, 급여대장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e통장 거래내역\\u003c/td\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e사업용 계좌\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e증빙 없이 인정되는 경우\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e경조사비\\u003c/td\\u003e\\n\\u003ctd\\u003e건당 20만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e농어민 구입\\u003c/td\\u003e\\n\\u003ctd\\u003e건당 10만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e간이영수증\\u003c/td\\u003e\\n\\u003ctd\\u003e건당 3만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003e자주 묻는 질문\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003eQ1. 간이과세자와 일반과세자, 어떤 게 유리한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 상황에 따라 다릅니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e매입이 많은 경우\\u003c/strong\\u003e: 일반과세자 유리 (매입세액 전액 공제)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e매입이 적은 경우\\u003c/strong\\u003e: 간이과세자 유리 (낮은 세율)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eB2B 거래 시\\u003c/strong\\u003e: 일반과세자 필수 (세금계산서 발행)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003eQ2. 사업용 카드 vs 개인 카드, 차이가 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 사업용 카드가 유리합니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e국세청에 자동 신고되어 누락 방지\\u003c/li\\u003e\\n\\u003cli\\u003e세무조사 시 증빙으로 인정\\u003c/li\\u003e\\n\\u003cli\\u003e부가세 매입세액공제 용이\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ3. 프리랜서도 사업자등록을 해야 하나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 연소득 3,000만원 이상이면 \\u003cstrong\\u003e권장\\u003c/strong\\u003e합니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e세금계산서 발행 가능\\u003c/li\\u003e\\n\\u003cli\\u003e필요경비 인정 범위 확대\\u003c/li\\u003e\\n\\u003cli\\u003e노란우산공제 등 혜택\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003eQ4. 부부가 함께 사업하면 절세가 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 공동사업자 등록 시:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e소득을 분산하여 낮은 세율 적용\\u003c/li\\u003e\\n\\u003cli\\u003e각자 기본공제 적용\\u003c/li\\u003e\\n\\u003cli\\u003e단, 실질적 공동 경영 증빙 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003eQ5. 법인 전환이 유리한 시점은 언제인가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 일반적으로:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e연 순이익 \\u003cstrong\\u003e1억원 이상\\u003c/strong\\u003e 시 검토\\u003c/li\\u003e\\n\\u003cli\\u003e법인세율(10~25%)이 소득세율보다 낮아지는 구간\\u003c/li\\u003e\\n\\u003cli\\u003e단, 대표자 급여, 배당소득세 등 종합 고려 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-33\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e개인사업자의 절세는 \\u003cstrong\\u003e증빙 관리\\u003c/strong\\u003e와 \\u003cstrong\\u003e공제 항목 활용\\u003c/strong\\u003e에서 시작됩니다.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2026년 핵심 절세 체크리스트\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e✅ 사업용 카드/계좌 분리\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 전자세금계산서 발행·수취\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 노란우산공제 가입\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 퇴직연금(IRP) 납입\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 신용카드 매출전표 세액공제 활용\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 간이과세자 기준 확인 (1억 400만원)\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 기장세액공제 챙기기\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e세금은 미리 준비할수록 절약할 수 있습니다. 복잡한 세무 문제는 전문 \\u003cstrong\\u003e세무사 상담\\u003c/strong\\u003e을 통해 해결하시기 바랍니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 연말정산 달라지는 점\\u003c/li\\u003e\\n\\u003cli\\u003e부동산 세금 총정리\\u003c/li\\u003e\\n\\u003cli\\u003e법인 전환 가이드\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었습니다. 세법은 개정될 수 있으므로 정확한 내용은 국세청 또는 세무 전문가에게 확인하시기 바랍니다.\\u003c/em\\