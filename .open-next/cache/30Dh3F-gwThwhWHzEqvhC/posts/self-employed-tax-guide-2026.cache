/td\\u003e\\n\\u003ctd\\u003e매월 10일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-1\\\"\\u003e1. 종합소득세 완벽 가이드\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e종합소득세 세율 (2026년)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e과세표준\\u003c/th\\u003e\\n\\u003cth\\u003e세율\\u003c/th\\u003e\\n\\u003cth\\u003e누진공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1,400만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e6%\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003ctd\\u003e126만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e8,800만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e24%\\u003c/td\\u003e\\n\\u003ctd\\u003e576만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1.5억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e35%\\u003c/td\\u003e\\n\\u003ctd\\u003e1,544만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e38%\\u003c/td\\u003e\\n\\u003ctd\\u003e1,994만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e2,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e42%\\u003c/td\\u003e\\n\\u003ctd\\u003e3,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10억원 초과\\u003c/td\\u003e\\n\\u003ctd\\u003e45%\\u003c/td\\u003e\\n\\u003ctd\\u003e6,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e종합소득세 계산 공식\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e과세표준 = 총수입금액 - 필요경비 - 소득공제\\n산출세액 = 과세표준 × 세율 - 누진공제\\n결정세액 = 산출세액 - 세액공제\\n납부세액 = 결정세액 - 기납부세액\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e신고 방법 선택\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e단순경비율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e직전연도 수입 2,400만원 미만\\u003c/td\\u003e\\n\\u003ctd\\u003e간편, 증빙 불필요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e기준경비율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e단순경비율 미적용자\\u003c/td\\u003e\\n\\u003ctd\\u003e주요경비 증빙 필요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e간편장부\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e직전연도 수입 7,500만원 미만\\u003c/td\\u003e\\n\\u003ctd\\u003e장부 기장, 기장세액공제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e복식부기\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e직전연도 수입 7,500만원 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e정확한 장부, 기장세액공제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 \\u003cstrong\\u003eTip\\u003c/strong\\u003e: 간편장부 또는 복식부기로 장부를 작성하면 \\u003cstrong\\u003e기장세액공제\\u003c/strong\\u003e(산출세액의 20%, 최대 100만원)를 받을 수 있습니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e경비율 기준 (2026년)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e업종\\u003c/th\\u003e\\n\\u003cth\\u003e단순경비율\\u003c/th\\u003e\\n\\u003cth\\u003e기준경비율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소매업\\u003c/td\\u003e\\n\\u003ctd\\u003e89.7%\