003e\\n\\u003ctd\\u003e납부의무 면제\\u003c/td\\u003e\\n\\u003ctd\\u003e연 4,800만원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e연 4,800만원\\u003c/strong\\u003e (유지)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📢 \\u003cstrong\\u003e중요\\u003c/strong\\u003e: 2026년부터 간이과세자 기준이 \\u003cstrong\\u003e연매출 1억 400만원 미만\\u003c/strong\\u003e으로 상향되었습니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e부가세 신고 일정\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e과세기간\\u003c/th\\u003e\\n\\u003cth\\u003e신고·납부기한\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1기\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e1.1 ~ 6.30\\u003c/td\\u003e\\n\\u003ctd\\u003e7월 25일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2기\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e7.1 ~ 12.31\\u003c/td\\u003e\\n\\u003ctd\\u003e다음해 1월 25일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e간이과세자\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e1.1 ~ 12.31\\u003c/td\\u003e\\n\\u003ctd\\u003e다음해 1월 25일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e소상공인 부가세 납부 유예\\u003c/h3\\u003e\\n\\u003cp\\u003e2026년 소상공인 지원책으로 \\u003cstrong\\u003e부가세 납부기한 2개월 연장\\u003c/strong\\u003e이 시행됩니다.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e혜택\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연 매출 8,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e납부기한 2개월 연장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세금 체납 없음\\u003c/td\\u003e\\n\\u003ctd\\u003e가산세 없이 연장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e3. 절세를 위한 필요경비 처리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e비용처리 가능 항목\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e공제 가능 여부\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e임차료\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e사업장 임대료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e인건비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e4대보험 포함\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e광고선전비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e마케팅 비용 전액\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소모품비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e사무용품 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e통신비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e사업용 비율만\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e차량유지비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 가능\\u003c/td\\u003e\\n\\u003ctd\\u003e사업용 비율만\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e접대비\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e⚠️ 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e연 3,600만원 한도\\u003c/td\\u003e\\n\\u003c/tr\\u003