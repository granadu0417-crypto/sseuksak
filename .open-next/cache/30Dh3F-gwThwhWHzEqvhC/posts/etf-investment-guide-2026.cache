:\\\"주식투자\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"28\\\",{\\\"property\\\":\\\"article:tag\\\",\\\"content\\\":\\\"S\\u0026P500\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"29\\\",{\\\"property\\\":\\\"article:tag\\\",\\\"content\\\":\\\"적립식투자\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"30\\\",{\\\"property\\\":\\\"article:tag\\\",\\\"content\\\":\\\"분산투자\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"31\\\",{\\\"property\\\":\\\"article:tag\\\",\\\"content\\\":\\\"KODEX\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"32\\\",{\\\"property\\\":\\\"article:tag\\\",\\\"content\\\":\\\"TIGER\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"33\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"34\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"ETF 투자 입문 가이드: 초보자도 쉽게 시작하는 ETF 완벽 정리 | 쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"35\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"ETF가 뭔지 몰라도 괜찮아요! 초보자도 이해할 수 있는 ETF 기초부터 추천 종목, 투자 방법까지 2026년 ETF 투자의 모든 것을 정리했습니다.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"36\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://images.unsplash.com/photo-1523839699072-5ec088b61a21?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\"}],[\\\"$\\\",\\\"link\\\",\\\"37\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L1f\\\",\\\"38\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"19:\\\"$14:metadata\\\"\\n\"])</script><script>self.__next_f.push([1,\"20:I[1356,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"Image\\\"]\\n21:I[286,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative w-full h-64 md:h-96 mb-8 rounded-lg overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L20\\\",null,{\\\"src\\\":\\\"https://images.unsplash.com/photo-1523839699072-5ec088b61a21?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\",\\\"alt\\\":\\\"ETF 투자 입문 가이드: 초보자도 쉽게 시작하는 ETF 완벽 정리\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 768px) 100vw, 896px\\\",\\\"className\\\":\\\"object-cover\\\",\\\"priority\\\":true}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://unsplash.com/@erol?utm_source=sseuksak\\u0026utm_medium=referral\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Photo by Erol Ahmed on Unsplash\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"22:T46cc,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003eETF 투자 입문 가이드: 초보자도 쉽게 시작하는 2026년 ETF 완벽 정리\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"주식 투자 시작하고 싶은데, 뭘 사야 할지 모르겠어요.\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e이런 고민 많이 하시죠? 개별 주식은 어렵고, 펀드는 수수료가 비싸고...\\u003c/p\\u003e\\n\\u003cp\\u003e그런 분들께 딱 맞는 게 바로 \\u003cstrong\\u003eETF\\u003c/strong\\u003e예요!\\u003c/p\\u003e\\n\\u003cp\\u003eETF는 \\u003cstrong\\u003e초보자가 가장 쉽게 시작할 수 있는 투자 상품\\u003c/strong\\u003e이에요. 오늘은 ETF가 뭔지부터 어떻게 투자하는지까지, 진짜 쉽게 설명해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003eETF가 뭔가요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한 줄 정의\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF = 여러 주식을 묶어서 주식처럼 거래하는 펀드\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e조금 더 풀어서 설명할게요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e쉬운 비유\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF는 \\\"주식 도시락\\\"이에요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e개별 주식\\u003c/th\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e반찬 하나만 사는 것\\u003c/td\\u003e\\n\\u003ctd\\u003e도시락 세트 사는 것\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성전자만 사기\\u003c/td\\u003e\\n\\u003ctd\\u003e삼성전자+SK하이닉스+현대차+... 한 번에\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한 회사에 집중\\u003c/td\\u003e\\n\\u003ctd\\u003e여러 회사에 분산\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e그 회사 망하면 끝\\u003c/td\\u003e\\n\\u003ctd\\u003e하나 망해도 다른 게 버텨줌\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003eETF의 정식 이름\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF = Exchange Traded Fund\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eExchange: 거래소에서\\u003c/li\\u003e\\n\\u003cli\\u003eTraded: 거래되는\\u003c/li\\u003e\\n\\u003cli\\u003eFund: 펀드\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e즉, \\u003cstrong\\u003e거래소에서 주식처럼 거래할 수 있는 펀드\\u003c/strong\\u003e예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-4\\\"\\u003eETF의 장점\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e1. 분산투자가 자동으로!\\u003c/h3\\u003e\\n\\u003cp\\u003e개별 주식은 그 회사가 망하면 끝이에요. 하지만 ETF는 여러 종목이 들어있어서 리스크가 분산돼요.\\u003c/p\\u003e\\n\\u003cp\\u003e예시: KODEX 200\\u003c/p\\u003e\\n\\u003cp\\u003e이 ETF 하나 사면?\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e삼성전자, SK하이닉스, 현대차, NAVER, 카카오...\\u003c/li\\u003e\\n\\u003cli\\u003e200개 기업에 자동 분산투자!\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e2. 소액으로 시작 가능!\\u003c/h3\\u003e\\n\\u003cp\\u003e비싼 주식도 ETF로 쉽게 투자할 수 있어요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e개별 주식\\u003c/th\\u003e\\n\\u003cth\\u003e1주 가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성전자\\u003c/td\\u003e\\n\\u003ctd\\u003e약 7만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eSK하이닉스\\u003c/td\\u003e\\n\\u003ctd\\u003e약 15만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성바이오로직스\\u003c/td\\u003e\\n\\u003ctd\\u003e약 80만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e1주 가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3.5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e약 1.5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e1~3만 원으로 글로벌 대기업에 투자 가능!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e3. 수수료가 저렴!\\u003c/h3\\u003e\\n\\u003cp\\u003e펀드보다 운용 수수료가 훨씬 저렴해요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상품 유형\\u003c/th\\u003e\\n\\u003cth\\u003e연간 수수료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일반 펀드\\u003c/td\\u003e\\n\\u003ctd\\u003e1.0~2.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.05~0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e장기 투자할수록 수수료 차이가 커져요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e4. 쉽게 사고 팔 수 있어!\\u003c/h3\\u003e\\n\\u003cp\\u003e일반 펀드는 환매하는 데 며칠 걸리지만, ETF는 주식처럼 실시간 매매 가능해요.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e장 중 언제든 매매 가능 (9:00~15:30)\\u003c/li\\u003e\\n\\u003cli\\u003e주식 앱으로 간편하게\\u003c/li\\u003e\\n\\u003cli\\u003e가격을 보고 원하는 타이밍에\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-9\\\"\\u003eETF 종류 알아보기\\u003c/h2\\u003e\\n\\u003cp\\u003eETF도 종류가 정말 다양해요. 대표적인 것들을 정리해드릴게요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e1. 지수 추종 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e특정 지수를 그대로 따라가는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e추종 지수\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e코스피 200\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 대형주 200개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 코스닥150\\u003c/td\\u003e\\n\\u003ctd\\u003e코스닥 150\\u003c/td\\u003e\\n\\u003ctd\\u003e코스닥 우량주 150개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003eS\\u0026#x26;P 500\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 대형주 500개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국나스닥100\\u003c/td\\u003e\\n\\u003ctd\\u003e나스닥 100\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 기술주 100개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e2. 섹터/테마 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e특정 산업이나 테마에 투자하는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e테마\\u003c/th\\u003e\\n\\u003cth\\u003e대표 ETF\\u003c/th\\u003e\\n\\u003cth\\u003e투자 대상\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e반도체\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX 반도체\\u003c/td\\u003e\\n\\u003ctd\\u003e삼성전자, SK하이닉스 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2차전지\\u003c/td\\u003e\\n\\u003ctd\\u003eTIGER 2차전지테마\\u003c/td\\u003e\\n\\u003ctd\\u003eLG에너지, 삼성SDI 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAI\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX AI테크\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 관련 기업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e헬스케어\\u003c/td\\u003e\\n\\u003ctd\\u003eTIGER 헬스케어\\u003c/td\\u003e\\n\\u003ctd\\u003e제약, 바이오 기업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e3. 배당 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e배당을 많이 주는 주식들을 모은 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e예상 배당률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eARIRANG 고배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e고배당 우량주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 4~5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 배당가치\\u003c/td\\u003e\\n\\u003ctd\\u003e배당+가치주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3~4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국배당다우존스\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3~4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e4. 채권 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e채권에 투자하는 안정적인 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e위험도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 국고채10년\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 국채\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 단기채권\\u003c/td\\u003e\\n\\u003ctd\\u003e단기 채권\\u003c/td\\u003e\\n\\u003ctd\\u003e낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 미국채10년선물\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 국채\\u003c/td\\u003e\\n\\u003ctd\\u003e낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e5. 해외 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e해외 시장에 투자하는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e투자 지역\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e미국\\u003c/td\\u003e\\n\\u003ctd\\u003e가장 인기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 선진국MSCI World\\u003c/td\\u003e\\n\\u003ctd\\u003e선진국 전체\\u003c/td\\u003e\\n\\u003ctd\\u003e글로벌 분산\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 차이나CSI300\\u003c/td\\u003e\\n\\u003ctd\\u003e중국\\u003c/td\\u003e\\n\\u003ctd\\u003e중국 대형주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 일본TOPIX100\\u003c/td\\u003e\\n\\u003ctd\\u003e일본\\u003c/td\\u003e\\n\\u003ctd\\u003e일본 대형주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-15\\\"\\u003e2026년 추천 ETF 포트폴리오\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e초보자용 포트폴리오 (안정형)\\u003c/h3\\u003e\\n\\u003cp\\u003e처음 시작하는 분들께 추천드려요!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e비중\\u003c/th\\u003e\\n\\u003cth\\u003e이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 대형주, 안정적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 대형주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 국고채10년\\u003c/td\\u003e\\n\\u003ctd\\u003e20%\\u003c/td\\u003e\\n\\u003ctd\\u003e채권으로 안정성\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현금/파킹통장\\u003c/td\\u003e\\n\\u003ctd\\u003e10%\\u003c/td\\u003e\\n\\u003ctd\\u003e유동성 확보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예상 수익률\\u003c/strong\\u003e: 연 5~8%\\n\\u003cstrong\\u003e위험도\\u003c/strong\\u003e: 중간\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e성장형 포트폴리오 (공격형)\\u003c/h3\\u003e\\n\\u003cp\\u003e조금 더 높은 수익을 원하는 분들께!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e비중\\u003c/th\\u003e\\n\\u003cth\\u003e이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국나스닥100\\u003c/td\\u003e\\n\\u003ctd\\u003e35%\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 기술주 성장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e25%\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 대형주 안정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX AI테크\\u003c/td\\u003e\\n\\u003ctd\\u003e20%\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 성장 수혜\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e20%\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 시장 노출\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예상 수익률\\u003c/strong\\u003e: 연 8~15% (변동성 큼)\\n\\u003cstrong\\u003e위험도\\u003c/strong\\u003e: 높음\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e배당형 포트폴리오 (인컴형)\\u003c/h3\\u003e\\n\\u003cp\\u003e꾸준한 배당 수익을 원하는 분들께!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e비중\\u003c/th\\u003e\\n\\u003cth\\u003e배당률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eARIRANG 고배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e35%\\u003c/td\\u003e\\n\\u003ctd\\u003e약 4.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국배당다우존스\\u003c/td\\u003e\\n\\u003ctd\\u003e35%\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 국고채10년\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예상 배당률\\u003c/strong\\u003e: 연 3.5~4%\\n\\u003cstrong\\u003e위험도\\u003c/strong\\u003e: 낮음\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-19\\\"\\u003eETF 투자 시작하기 (실전)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e1단계: 증권 계좌 개설\\u003c/h3\\u003e\\n\\u003cp\\u003e먼저 증권 계좌가 필요해요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e추천 증권사 앱\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e앱\\u003c/th\\u003e\\n\\u003cth\\u003e장점\\u003c/th\\u003e\\n\\u003cth\\u003e수수료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e토스증권\\u003c/td\\u003e\\n\\u003ctd\\u003e초보 친화적 UI\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 이벤트 많음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e키움증권\\u003c/td\\u003e\\n\\u003ctd\\u003e수수료 최저\\u003c/td\\u003e\\n\\u003ctd\\u003e0.015%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성증권\\u003c/td\\u003e\\n\\u003ctd\\u003e안정적, 리서치\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% 내외\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e카카오페이증권\\u003c/td\\u003e\\n\\u003ctd\\u003e간편함\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 이벤트\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e계좌 개설 방법\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e앱 다운로드\\u003c/li\\u003e\\n\\u003cli\\u003e본인 인증 (신분증 촬영)\\u003c/li\\u003e\\n\\u003cli\\u003e계좌 개설 신청\\u003c/li\\u003e\\n\\u003cli\\u003e비대면 계좌 개설 완료 (10분 소요)\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e2단계: 돈 입금하기\\u003c/h3\\u003e\\n\\u003cp\\u003e계좌 개설했으면 투자할 돈을 넣어요.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e팁\\u003c/strong\\u003e: 처음엔 10만~50만 원으로 시작하세요! 연습하면서 감을 익히는 게 중요해요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e3단계: ETF 검색하기\\u003c/h3\\u003e\\n\\u003cp\\u003e앱에서 원하는 ETF를 검색해요.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e검색 방법\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e방법 1: ETF 이름으로 검색\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"KODEX 200\\\" 또는 \\\"TIGER S\\u0026#x26;P500\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e방법 2: 종목코드로 검색\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eKODEX 200: 069500\\u003c/li\\u003e\\n\\u003cli\\u003eTIGER 미국S\\u0026#x26;P500: 360750\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e4단계: 매수하기\\u003c/h3\\u003e\\n\\u003cp\\u003eETF를 사는 방법이에요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e매수 주문 과정\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eETF 검색 후 선택\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"매수\\\" 버튼 클릭\\u003c/li\\u003e\\n\\u003cli\\u003e수량 입력 (몇 주 살지)\\u003c/li\\u003e\\n\\u003cli\\u003e가격 유형 선택\\n\\u003cul\\u003e\\n\\u003cli\\u003e시장가: 현재 가격으로 바로\\u003c/li\\u003e\\n\\u003cli\\u003e지정가: 원하는 가격에\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"매수 주문\\\" 확인\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예시: TIGER 미국S\\u0026#x26;P500 10주 매수\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e현재가: 15,000원\\u003c/li\\u003e\\n\\u003cli\\u003e수량: 10주\\u003c/li\\u003e\\n\\u003cli\\u003e총 금액: 150,000원\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"매수\\\" 클릭하면 완료!\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e5단계: 정기 투자 설정 (추천!)\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e적립식 투자\\u003c/strong\\u003e가 가장 좋은 방법이에요!\\u003c/p\\u003e\\n\\u003cp\\u003e적립식 투자란?\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e매월 같은 금액을 정기적으로 투자하는 것\\u003c/li\\u003e\\n\\u003cli\\u003e가격이 높을 때 적게 사고, 낮을 때 많이 사게 됨\\u003c/li\\u003e\\n\\u003cli\\u003e평균 매수 단가를 낮추는 효과!\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e앱에서 자동투자 설정\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e자동투자 메뉴 찾기\\u003c/li\\u003e\\n\\u003cli\\u003e투자할 ETF 선택\\u003c/li\\u003e\\n\\u003cli\\u003e매월 투자 금액 설정 (예: 50만 원)\\u003c/li\\u003e\\n\\u003cli\\u003e투자 날짜 설정 (예: 매월 15일)\\u003c/li\\u003e\\n\\u003cli\\u003e자동 투자 시작!\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003eETF 투자 꿀팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e1. 장기 투자가 답이다\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF는 최소 3년 이상\\u003c/strong\\u003e 투자할 때 효과가 좋아요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e투자 기간\\u003c/th\\u003e\\n\\u003cth\\u003eS\\u0026#x26;P500 ETF 수익률 (과거 평균)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1년\\u003c/td\\u003e\\n\\u003ctd\\u003e-30% ~ +40% (변동 큼)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e연평균 8~10%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10년\\u003c/td\\u003e\\n\\u003ctd\\u003e연평균 9~11%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e20년\\u003c/td\\u003e\\n\\u003ctd\\u003e연평균 10~12%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e오래 가지고 있을수록 안정적인 수익!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e2. 적립식으로 꾸준히\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e한 번에 몰빵 vs 적립식\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003cth\\u003e장점\\u003c/th\\u003e\\n\\u003cth\\u003e단점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일시불 투자\\u003c/td\\u003e\\n\\u003ctd\\u003e상승장에서 유리\\u003c/td\\u003e\\n\\u003ctd\\u003e타이밍 실패 시 큰 손실\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적립식 투자\\u003c/td\\u003e\\n\\u003ctd\\u003e타이밍 걱정 없음\\u003c/td\\u003e\\n\\u003ctd\\u003e급등장에서 수익 제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e초보자는 적립식이 정답!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e3. 분배금(배당) 확인하기\\u003c/h3\\u003e\\n\\u003cp\\u003eETF도 배당(분배금)을 줘요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e분배금 지급 시기\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e분기 배당: 1, 4, 7, 10월\\u003c/li\\u003e\\n\\u003cli\\u003e반기 배당: 6, 12월\\u003c/li\\u003e\\n\\u003cli\\u003e연 배당: 12월\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e배당 ETF는 분배금을 재투자하면 복리 효과!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e4. 총보수(수수료) 확인하기\\u003c/h3\\u003e\\n\\u003cp\\u003eETF마다 운용 수수료가 달라요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF 유형\\u003c/th\\u003e\\n\\u003cth\\u003e총보수 범위\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e국내 지수 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.05~0.15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e해외 지수 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.07~0.25%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e테마/섹터 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.20~0.50%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e액티브 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.30~1.00%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e비슷한 ETF면 수수료 낮은 걸 선택!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e5. 거래량 확인하기\\u003c/h3\\u003e\\n\\u003cp\\u003e거래량이 너무 적으면 사고팔기 어려워요.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e일 거래량 10만 주 이상: 안전\\u003c/li\\u003e\\n\\u003cli\\u003e일 거래량 1만 주 미만: 주의 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003eETF 투자 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e피해야 할 ETF 유형 (초보자)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003cth\\u003e위험도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e레버리지 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e2배, 3배 수익 추구\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인버스 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e지수 하락 시 수익\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e원자재 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e선물 기반, 롤오버 비용\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신흥국 ETF\\u003c/td\\u003e\\n\\u003ctd\\u003e환율, 정치 리스크\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"KODEX 레버리지\\\" - 초보자 비추\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"KODEX 인버스\\\" - 초보자 비추\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"KODEX 200\\\" - 초보자 추천\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e흔한 실수 피하기\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e레버리지 ETF 장기 보유 (녹는다!)\\u003c/li\\u003e\\n\\u003cli\\u003e인버스 ETF로 하락 베팅 (어려워요)\\u003c/li\\u003e\\n\\u003cli\\u003e테마 ETF 몰빵 (변동성 큼)\\u003c/li\\u003e\\n\\u003cli\\u003e유행하는 ETF만 쫓기\\u003c/li\\u003e\\n\\u003cli\\u003e하락할 때 패닉셀링\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e세금 알아두기\\u003c/h3\\u003e\\n\\u003cp\\u003eETF 투자 시 발생하는 세금이에요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e세율\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e매매차익 (국내 주식형)\\u003c/td\\u003e\\n\\u003ctd\\u003e비과세\\u003c/td\\u003e\\n\\u003ctd\\u003e팔아서 번 돈\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e매매차익 (해외/기타)\\u003c/td\\u003e\\n\\u003ctd\\u003e15.4%\\u003c/td\\u003e\\n\\u003ctd\\u003e배당소득세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e분배금\\u003c/td\\u003e\\n\\u003ctd\\u003e15.4%\\u003c/td\\u003e\\n\\u003ctd\\u003e배당소득세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003eISA 계좌 활용하면 비과세 혜택!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e연 200~400만 원까지 비과세\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003eETF 정보 확인하는 법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003e유용한 사이트\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e사이트\\u003c/th\\u003e\\n\\u003cth\\u003e용도\\u003c/th\\u003e\\n\\u003cth\\u003e링크\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e네이버 금융\\u003c/td\\u003e\\n\\u003ctd\\u003eETF 검색, 차트\\u003c/td\\u003e\\n\\u003ctd\\u003efinance.naver.com\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eETF CHECK\\u003c/td\\u003e\\n\\u003ctd\\u003eETF 비교, 분석\\u003c/td\\u003e\\n\\u003ctd\\u003eetfcheck.co.kr\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한국거래소\\u003c/td\\u003e\\n\\u003ctd\\u003e공식 정보\\u003c/td\\u003e\\n\\u003ctd\\u003eetf.krx.co.kr\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eETF 선택 시 체크리스트\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e어떤 지수/테마를 추종하나?\\u003c/li\\u003e\\n\\u003cli\\u003e총보수(수수료)는 얼마인가?\\u003c/li\\u003e\\n\\u003cli\\u003e운용사가 믿을 만한가?\\u003c/li\\u003e\\n\\u003cli\\u003e거래량은 충분한가?\\u003c/li\\u003e\\n\\u003cli\\u003e설정 후 얼마나 됐나? (1년 이상 추천)\\u003c/li\\u003e\\n\\u003cli\\u003e괴리율은 낮은가? (NAV와 시장가 차이)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-38\\\"\\u003e월별 투자 금액 예시\\u003c/h2\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e월 50만 원 투자 시\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e비중\\u003c/th\\u003e\\n\\u003cth\\u003e금액\\u003c/th\\u003e\\n\\u003cth\\u003e주수 (약)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e25만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e16주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e15만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e4주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 단기채권\\u003c/td\\u003e\\n\\u003ctd\\u003e20%\\u003c/td\\u003e\\n\\u003ctd\\u003e10만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e1주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e10년 후 예상 자산\\u003c/strong\\u003e (연 7% 수익 가정)\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e월 50만 원 x 12개월 x 10년 = 원금 6,000만 원\\u003c/li\\u003e\\n\\u003cli\\u003e복리 수익 포함 약 8,600만 원\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-39\\\"\\u003e2026년 ETF 투자 전망\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003e주목할 테마\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e테마\\u003c/th\\u003e\\n\\u003cth\\u003e전망\\u003c/th\\u003e\\n\\u003cth\\u003e관련 ETF\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAI/반도체\\u003c/td\\u003e\\n\\u003ctd\\u003e성장 지속\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX AI테크, TIGER 반도체\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e미국 대형주\\u003c/td\\u003e\\n\\u003ctd\\u003e안정적\\u003c/td\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 인하 시 주목\\u003c/td\\u003e\\n\\u003ctd\\u003eARIRANG 고배당주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e채권\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 인하 수혜\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX 국고채\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-41\\\"\\u003e투자 전략 제안\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e코어(핵심) 70%: S\\u0026#x26;P500, KODEX200 같은 지수 ETF\\u003c/li\\u003e\\n\\u003cli\\u003e위성(테마) 30%: AI, 반도체 등 성장 테마\\u003c/li\\u003e\\n\\u003cli\\u003e안정적 기반 + 성장 기회 동시에!\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-42\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003eETF는 \\u003cstrong\\u003e초보자가 투자를 시작하기에 가장 좋은 상품\\u003c/strong\\u003e이에요.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e분산투자 자동으로\\u003c/li\\u003e\\n\\u003cli\\u003e소액으로 시작\\u003c/li\\u003e\\n\\u003cli\\u003e수수료 저렴\\u003c/li\\u003e\\n\\u003cli\\u003e쉽게 사고 팔기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e오늘 배운 내용을 정리하면:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eETF = 주식 도시락\\u003c/strong\\u003e (여러 종목 한 번에)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e지수 ETF로 시작\\u003c/strong\\u003e (KODEX200, S\\u0026#x26;P500)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e적립식으로 꾸준히\\u003c/strong\\u003e (매월 정해진 금액)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e장기 투자\\u003c/strong\\u003e (최소 3년 이상)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e레버리지/인버스는 피하기\\u003c/strong\\u003e (초보자는 위험)\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e이제 10만 원으로 시작해보세요! 작게 시작해서 감을 익히고, 점점 늘려가는 거예요.\\u003c/p\\u003e\\n\\u003cp\\u003e2026년, ETF로 부자 되는 첫걸음 내딛으세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/2026-investment-strategy-guide\\\"\\u003e2026년 재테크 전략 가이드: 초보자 자산관리 로드맵\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/ces-2026-tech-trends\\\"\\u003eCES 2026 기술 트렌드 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"$L21\\\",null,{\\\"content\\\":\\\"$22\\\"}]\\n23:T46cc,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003eETF 투자 입문 가이드: 초보자도 쉽게 시작하는 2026년 ETF 완벽 정리\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"주식 투자 시작하고 싶은데, 뭘 사야 할지 모르겠어요.\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e이런 고민 많이 하시죠? 개별 주식은 어렵고, 펀드는 수수료가 비싸고...\\u003c/p\\u003e\\n\\u003cp\\u003e그런 분들께 딱 맞는 게 바로 \\u003cstrong\\u003eETF\\u003c/strong\\u003e예요!\\u003c/p\\u003e\\n\\u003cp\\u003eETF는 \\u003cstrong\\u003e초보자가 가장 쉽게 시작할 수 있는 투자 상품\\u003c/strong\\u003e이에요. 오늘은 ETF가 뭔지부터 어떻게 투자하는지까지, 진짜 쉽게 설명해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003eETF가 뭔가요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한 줄 정의\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF = 여러 주식을 묶어서 주식처럼 거래하는 펀드\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e조금 더 풀어서 설명할게요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e쉬운 비유\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF는 \\\"주식 도시락\\\"이에요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e개별 주식\\u003c/th\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e반찬 하나만 사는 것\\u003c/td\\u003e\\n\\u003ctd\\u003e도시락 세트 사는 것\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성전자만 사기\\u003c/td\\u003e\\n\\u003ctd\\u003e삼성전자+SK하이닉스+현대차+... 한 번에\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한 회사에 집중\\u003c/td\\u003e\\n\\u003ctd\\u003e여러 회사에 분산\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e그 회사 망하면 끝\\u003c/td\\u003e\\n\\u003ctd\\u003e하나 망해도 다른 게 버텨줌\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003eETF의 정식 이름\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eETF = Exchange Traded Fund\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eExchange: 거래소에서\\u003c/li\\u003e\\n\\u003cli\\u003eTraded: 거래되는\\u003c/li\\u003e\\n\\u003cli\\u003eFund: 펀드\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e즉, \\u003cstrong\\u003e거래소에서 주식처럼 거래할 수 있는 펀드\\u003c/strong\\u003e예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-4\\\"\\u003eETF의 장점\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e1. 분산투자가 자동으로!\\u003c/h3\\u003e\\n\\u003cp\\u003e개별 주식은 그 회사가 망하면 끝이에요. 하지만 ETF는 여러 종목이 들어있어서 리스크가 분산돼요.\\u003c/p\\u003e\\n\\u003cp\\u003e예시: KODEX 200\\u003c/p\\u003e\\n\\u003cp\\u003e이 ETF 하나 사면?\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e삼성전자, SK하이닉스, 현대차, NAVER, 카카오...\\u003c/li\\u003e\\n\\u003cli\\u003e200개 기업에 자동 분산투자!\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e2. 소액으로 시작 가능!\\u003c/h3\\u003e\\n\\u003cp\\u003e비싼 주식도 ETF로 쉽게 투자할 수 있어요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e개별 주식\\u003c/th\\u003e\\n\\u003cth\\u003e1주 가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성전자\\u003c/td\\u003e\\n\\u003ctd\\u003e약 7만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eSK하이닉스\\u003c/td\\u003e\\n\\u003ctd\\u003e약 15만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e삼성바이오로직스\\u003c/td\\u003e\\n\\u003ctd\\u003e약 80만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e1주 가격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3.5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003e약 1.5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e1~3만 원으로 글로벌 대기업에 투자 가능!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e3. 수수료가 저렴!\\u003c/h3\\u003e\\n\\u003cp\\u003e펀드보다 운용 수수료가 훨씬 저렴해요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상품 유형\\u003c/th\\u003e\\n\\u003cth\\u003e연간 수수료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일반 펀드\\u003c/td\\u003e\\n\\u003ctd\\u003e1.0~2.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eETF\\u003c/td\\u003e\\n\\u003ctd\\u003e0.05~0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e장기 투자할수록 수수료 차이가 커져요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e4. 쉽게 사고 팔 수 있어!\\u003c/h3\\u003e\\n\\u003cp\\u003e일반 펀드는 환매하는 데 며칠 걸리지만, ETF는 주식처럼 실시간 매매 가능해요.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e장 중 언제든 매매 가능 (9:00~15:30)\\u003c/li\\u003e\\n\\u003cli\\u003e주식 앱으로 간편하게\\u003c/li\\u003e\\n\\u003cli\\u003e가격을 보고 원하는 타이밍에\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-9\\\"\\u003eETF 종류 알아보기\\u003c/h2\\u003e\\n\\u003cp\\u003eETF도 종류가 정말 다양해요. 대표적인 것들을 정리해드릴게요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e1. 지수 추종 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e특정 지수를 그대로 따라가는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e추종 지수\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 200\\u003c/td\\u003e\\n\\u003ctd\\u003e코스피 200\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 대형주 200개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 코스닥150\\u003c/td\\u003e\\n\\u003ctd\\u003e코스닥 150\\u003c/td\\u003e\\n\\u003ctd\\u003e코스닥 우량주 150개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u003eS\\u0026#x26;P 500\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 대형주 500개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국나스닥100\\u003c/td\\u003e\\n\\u003ctd\\u003e나스닥 100\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 기술주 100개\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e2. 섹터/테마 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e특정 산업이나 테마에 투자하는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e테마\\u003c/th\\u003e\\n\\u003cth\\u003e대표 ETF\\u003c/th\\u003e\\n\\u003cth\\u003e투자 대상\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e반도체\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX 반도체\\u003c/td\\u003e\\n\\u003ctd\\u003e삼성전자, SK하이닉스 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2차전지\\u003c/td\\u003e\\n\\u003ctd\\u003eTIGER 2차전지테마\\u003c/td\\u003e\\n\\u003ctd\\u003eLG에너지, 삼성SDI 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAI\\u003c/td\\u003e\\n\\u003ctd\\u003eKODEX AI테크\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 관련 기업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e헬스케어\\u003c/td\\u003e\\n\\u003ctd\\u003eTIGER 헬스케어\\u003c/td\\u003e\\n\\u003ctd\\u003e제약, 바이오 기업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e3. 배당 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e배당을 많이 주는 주식들을 모은 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e예상 배당률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eARIRANG 고배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e고배당 우량주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 4~5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 배당가치\\u003c/td\\u003e\\n\\u003ctd\\u003e배당+가치주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3~4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국배당다우존스\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 배당주\\u003c/td\\u003e\\n\\u003ctd\\u003e약 3~4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e4. 채권 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e채권에 투자하는 안정적인 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e위험도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 국고채10년\\u003c/td\\u003e\\n\\u003ctd\\u003e한국 국채\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 단기채권\\u003c/td\\u003e\\n\\u003ctd\\u003e단기 채권\\u003c/td\\u003e\\n\\u003ctd\\u003e낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKODEX 미국채10년선물\\u003c/td\\u003e\\n\\u003ctd\\u003e미국 국채\\u003c/td\\u003e\\n\\u003ctd\\u003e낮음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e5. 해외 ETF\\u003c/h3\\u003e\\n\\u003cp\\u003e해외 시장에 투자하는 ETF예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eETF\\u003c/th\\u003e\\n\\u003cth\\u003e투자 지역\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTIGER 미국S\\u0026#x26;P500\\u003c/td\\u003e\\n\\u003ctd\\u00