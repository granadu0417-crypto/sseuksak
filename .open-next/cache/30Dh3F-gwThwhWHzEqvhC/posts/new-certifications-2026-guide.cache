03ctd\\u003e정부 지원사업\\u003c/td\\u003e\\n\\u003ctd\\u003e스마트공장 보급사업 수행\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e바이오공정기능사\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e취업처\\u003c/th\\u003e\\n\\u003cth\\u003e연봉 수준\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대형 제약사\\u003c/td\\u003e\\n\\u003ctd\\u003e3,500~5,000만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e바이오벤처\\u003c/td\\u003e\\n\\u003ctd\\u003e3,000~4,500만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCMO 기업\\u003c/td\\u003e\\n\\u003ctd\\u003e3,200~4,500만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연구소\\u003c/td\\u003e\\n\\u003ctd\\u003e3,000~4,000만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e이륜자동차정비기능사\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e취업처\\u003c/th\\u003e\\n\\u003cth\\u003e수요 전망\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이륜차 정비소\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e배달 플랫폼 제휴점\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이륜차 검사소\\u003c/td\\u003e\\n\\u003ctd\\u003e높음 (2025.3월 검사제도 시행)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전동 킥보드 업체\\u003c/td\\u003e\\n\\u003ctd\\u003e증가 추세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003e자격증 취득 비용\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e응시료 (2026년 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e자격증\\u003c/th\\u003e\\n\\u003cth\\u003e필기\\u003c/th\\u003e\\n\\u003cth\\u003e실기\\u003c/th\\u003e\\n\\u003cth\\u003e합계\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e14,500원\\u003c/td\\u003e\\n\\u003ctd\\u003e실기별 상이\\u003c/td\\u003e\\n\\u003ctd\\u003e약 5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e산업기사\\u003c/td\\u003e\\n\\u003ctd\\u003e19,400원\\u003c/td\\u003e\\n\\u003ctd\\u003e실기별 상이\\u003c/td\\u003e\\n\\u003ctd\\u003e약 6만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기능장\\u003c/td\\u003e\\n\\u003ctd\\u003e26,000원\\u003c/td\\u003e\\n\\u003ctd\\u003e실기별 상이\\u003c/td\\u003e\\n\\u003ctd\\u003e약 8만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e학습 비용 (예상)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e비용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교재\\u003c/td\\u003e\\n\\u003ctd\\u003e2~4만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e온라인 강의\\u003c/td\\u003e\\n\\u003ctd\\u003e5~20만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기출문제집\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e총 비용\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10~30만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e비용 절약 팁\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e국비지원\\u003c/strong\\u003e: 내일배움카드 활용 (최대 500만 원)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e무료 자료\\u003c/strong\\u003e: 큐넷 출제기준, 유튜브 강의\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e도서관\\u003c/strong\\u003e: 수험서 대출 가능\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e스터디\\u003c/strong\\u003e: 교재 공동 구매, 정보 공유\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003eQ1. 신설 자격증 첫 시험, 난이도는?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예측이 어렵습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e기출문제가 없어 출제기준이 유일한 가이드\\u003c/li\\u003e\\n\\u003cli\\u003e첫 시험은 상대적으로 수월할 수 있음\\u003c/li\\u003e\\n\\u003cli\\u003e시간이 지날수록 난이도 상향 경향\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e팁\\u003c/strong\\u003e: NCS 학습모듈과 출제기준 철저히 분석!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003eQ2. 비전공자도 응시 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e등급에 따라 다릅니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e등급\\u003c/th\\u003e\\n\\u003cth\\u003e응시 자격\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e제한 없음 (누구나 가능)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e산업기사\\u003c/td\\u003e\\n\\u003ctd\\u003e관련 학과 또는 기능사 + 경력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기능장\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 + 경력 또는 산업기사 + 장기경력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003eQ3. 신설 자격증, 취업에 도움이 될까요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e분야에 따라 매우 유리합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e스마트공장: 제조업 디지털 전환 핵심 인력\\u003c/li\\u003e\\n\\u003cli\\u003e바이오공정: K-바이오 성장으로 인력 부족\\u003c/li\\u003e\\n\\u003cli\\u003e이륜차정비: 배달 산업 성장 + 검사제도 시행\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e팁\\u003c/strong\\u003e: 신설 자격증은 경쟁자가 적어 차별화에 유리!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003eQ4. 자격증 유효기간이 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e국가기술자격은 영구적입니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e종류\\u003c/th\\u003e\\n\\u003cth\\u003e유효기간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e국가기술자격\\u003c/td\\u003e\\n\\u003ctd\\u003e영구 (갱신 불필요)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전문자격\\u003c/td\\u003e\\n\\u003ctd\\u003e일부 갱신 필요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e민간자격\\u003c/td\\u003e\\n\\u003ctd\\u003e발급 기관마다 상이\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003eQ5. AI 관련 국가자격증은 없나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아직 신설되지 않았습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e정부에서 검토 중이나 확정되지 않음\\u003c/li\\u003e\\n\\u003cli\\u003e현재 AI 관련 자격증은 \\u003cstrong\\u003e민간자격증\\u003c/strong\\u003e만 존재\\u003c/li\\u003e\\n\\u003cli\\u003eKAIT AI활용능력, 한국데이터산업진흥원 자격증 등\\u003c/li\\u003e\\n\\u003cli\\u003e국가자격증 신설 시 공식 발표 예정\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-37\\\"\\u003e정리: 2026년 신설 자격증 핵심\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003e7종목 요약표\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e순위\\u003c/th\\u003e\\n\\u003cth\\u003e자격증\\u003c/th\\u003e\\n\\u003cth\\u003e시행일\\u003c/th\\u003e\\n\\u003cth\\u003e추천 이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e스마트공장산업기사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003e제조업 디지털 전환 핵심\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e바이오공정기능사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003eK-바이오 성장, 인력 수요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e이륜자동차정비기능사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003e배달 산업 + 검사제도 시행\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e스마트공장기능사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003e산업기사 전 기초 역량\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e산림기능장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003e탄소중립 정책, 최고 등급\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e6\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e공공조달관리사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003e공공기관 취업 유리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e7\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e봉제기능사\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.1.1\\u003c/td\\u003e\\n\\u003ctd\\u003eK-패션 성장, 기술 전수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003e체크리스트\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 목표 자격증 선정했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 응시 자격 확인했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 큐넷에서 출제기준 다운로드했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 시험 일정 파악했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 국비지원 가능 여부 확인했나요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-40\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 1월 1일부터 시행되는 \\u003cstrong\\u003e7개 신설 자격증\\u003c/strong\\u003e은 4차 산업혁명 시대의 새로운 기회입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e특히 스마트공장, 바이오, 이륜차정비 분야는 산업 수요가 급증하고 있어 자격증 취득 시 취업에 매우 유리해요.\\u003c/p\\u003e\\n\\u003cp\\u003e자격증은 단순한 스펙이 아니라 \\u003cstrong\\u003e나의 전문성을 증명하는 도구\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e중요\\u003c/strong\\u003e: 시험 정보는 반드시 \\u003ca href=\\\"https://www.q-net.or.kr\\\"\\u003e큐넷(Q-net)\\u003c/a\\u003e 공식 발표를 확인하세요!\\u003c/p\\u003e\\n\\u003cp\\u003e궁금한 점은 한국산업인력공단(1644-8000)으로 문의하세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/national-technical-exam-schedule-2026\\\"\\u003e2026년 국가기술자격 시험일정 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/health-insurance-premium-2026\\\"\\u003e2026년 건강보험료 변경사항 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L21\\\",null,{\\\"content\\\":\\\"$22\\\"}]\\n23:T56f4,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 신설 국가자격증 가이드: 스마트공장·바이오·모빌리티 7종목 완벽 정리\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"2026년에 새로 생긴 자격증, 뭐가 있을까?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2026년 1월 1일부터 \\u003cstrong\\u003e국가기술자격 7종목\\u003c/strong\\u003e이 새롭게 시행됩니다. 스마트공장, 바이오, 모빌리티 등 4차 산업혁명 시대를 반영한 자격증들인데요.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 \\u003cstrong\\u003e2026년 신설 자격증\\u003c/strong\\u003e의 정확한 정보와 취득 전략을 정리해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e2026년 신설 자격증 한눈에 보기\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e신설 7종목 요약\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e자격증\\u003c/th\\u003e\\n\\u003cth\\u003e등급\\u003c/th\\u003e\\n\\u003cth\\u003e시행일\\u003c/th\\u003e\\n\\u003cth\\u003e분야\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e스마트공장산업기사\\u003c/td\\u003e\\n\\u003ctd\\u003e산업기사\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026.1.1\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e제조·IT융합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e스마트공장기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026.1.1\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e제조·IT융합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e바이오공정기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026.1.1\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e바이오·제약\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이륜자동차정비기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e기능사\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026.1.1\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e모빌리티\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e산림기능장\\u003c/td\\u003e\\n\\u003ctd\\u003e기능장\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026.1.1\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e산림·환경\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공공조달관리사\\u003c/td\\u003e\\n\\u003ctd\\u003e관리사\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u0