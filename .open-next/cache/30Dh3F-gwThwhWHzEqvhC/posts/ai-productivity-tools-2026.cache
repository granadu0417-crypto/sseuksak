03ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 내장\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $10\\u003c/td\\u003e\\n\\u003ctd\\u003e문서 작성\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 연동\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 365 포함\\u003c/td\\u003e\\n\\u003ctd\\u003e오피스 작업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 검색\\u003c/td\\u003e\\n\\u003ctd\\u003e무료/월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003e정보 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e그럼 하나씩 자세히 알아볼게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-1\\\"\\u003e1. ChatGPT 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003eChatGPT란?\\u003c/h3\\u003e\\n\\u003cp\\u003eOpenAI에서 만든 대화형 AI예요. 가장 많이 쓰이는 AI 도구죠!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e가격 정책\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e플랜\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003ctd\\u003e0원\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o mini, 기본 기능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePlus\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o, 이미지 생성\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTeam\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $25/인\\u003c/td\\u003e\\n\\u003ctd\\u003e팀 기능, 보안 강화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 이메일 작성\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e다음 상황에 맞는 비즈니스 이메일을 작성해줘.\\n\\n상황: 프로젝트 일정 지연을 고객사에 알리고 양해 구하기\\n- 지연 기간: 1주일\\n- 원인: 내부 테스트 중 버그 발견\\n- 톤: 정중하지만 신뢰감 있게\\n- 길이: 10줄 이내\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e결과 활용\\u003c/strong\\u003e: AI가 작성한 초안 → 상황에 맞게 수정 → 발송\\u003c/p\\u003e\\n\\u003ch4\\u003e2. 회의록 정리\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e아래 회의 내용을 정리해줘.\\n\\n[회의 내용 붙여넣기]\\n\\n형식:\\n1. 핵심 논의 사항 (3-5개)\\n2. 결정된 사항\\n3. 액션 아이템 (담당자, 기한 포함)\\n4. 다음 회의 안건\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 보고서 초안 작성\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e월간 마케팅 보고서 초안을 작성해줘.\\n\\n데이터:\\n- 웹사이트 방문자: 50,000명 (전월 대비 +20%)\\n- 신규 가입자: 3,000명\\n- 광고 비용: 500만 원\\n- 매출: 5,000만 원\\n\\n포함할 내용:\\n1. 요약 (Executive Summary)\\n2. 주요 성과\\n3. 개선점\\n4. 다음 달 계획\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003eChatGPT 꿀팁\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e역할 부여하기: \\\"너는 10년차 마케터야\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e구체적으로 요청하기: \\\"3가지로 정리해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e예시 보여주기: \\\"이런 형식으로 작성해줘: [예시]\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e피드백 주기: \\\"더 간결하게 / 더 자세히\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e2. Claude 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003eClaude란?\\u003c/h3\\u003e\\n\\u003cp\\u003eAnthropic에서 만든 AI예요. \\u003cstrong\\u003e긴 문서 처리\\u003c/strong\\u003e에 특히 강해요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003eChatGPT vs Claude\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003eChatGPT\\u003c/th\\u003e\\n\\u003cth\\u003eClaude\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문서 길이\\u003c/td\\u003e\\n\\u003ctd\\u003e보통\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 김 (20만 토큰)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e코딩\\u003c/td\\u003e\\n\\u003ctd\\u003e강함\\u003c/td\\u003e\\n\\u003ctd\\u003e강함\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e글쓰기\\u003c/td\\u003e\\n\\u003ctd\\u003e좋음\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 좋음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e파일 분석\\u003c/td\\u003e\\n\\u003ctd\\u003e가능\\u003c/td\\u003e\\n\\u003ctd\\u003e가능 (PDF 강점)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e특징\\u003c/td\\u003e\\n\\u003ctd\\u003e범용적\\u003c/td\\u003e\\n\\u003ctd\\u003e문서 특화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 긴 문서 요약\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 PDF 문서를 분석해서 다음을 정리해줘:\\n\\n1. 핵심 내용 요약 (5줄)\\n2. 주요 데이터/수치\\n3. 실행 가능한 인사이트 3가지\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003eClaude는 100페이지가 넘는 PDF도 한 번에 분석 가능!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e2. 계약서/법률 문서 검토\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 계약서를 검토하고 다음을 알려줘:\\n\\n1. 우리에게 불리한 조항\\n2. 협상이 필요한 부분\\n3. 빠진 중요 조항\\n4. 주의해야 할 점\\n\\n[계약서 내용 붙여넣기 또는 파일 첨부]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 연구 자료 분석\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 연구 보고서 3개를 비교 분석해줘.\\n\\n분석 항목:\\n1. 공통된 결론\\n2. 상충되는 내용\\n3. 각 연구의 한계점\\n4. 종합 인사이트\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003eClaude 꿀팁\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e여러 파일 동시 분석 가능\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"Artifacts\\\" 기능으로 코드/문서 별도 출력\\u003c/li\\u003e\\n\\u003cli\\u003e긴 대화도 맥락 잘 유지\\u003c/li\\u003e\\n\\u003cli\\u003e한국어 글쓰기 품질 좋음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-11\\\"\\u003e3. 노션 AI 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e노션 AI란?\\u003c/h3\\u003e\\n\\u003cp\\u003e노션(Notion) 안에 내장된 AI 기능이에요. 문서 작성 중에 바로 AI 도움을 받을 수 있어요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e가격\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e플랜\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003eAI 사용량\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003ctd\\u003e0원\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePlus\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $10\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eBusiness\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $15\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 미팅 노트 정리\\u003c/h4\\u003e\\n\\u003cp\\u003e회의 중 막 적은 메모를 AI로 정리:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[스페이스바 누르고 \\\"AI로 개선하기\\\" 선택]\\n→ \\\"회의록 형식으로 정리해줘\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e2. 브레인스토밍\\u003c/h4\\u003e\\n\\u003cp\\u003e빈 페이지에서:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[스페이스바] → \\\"아이디어 브레인스토밍\\\"\\n→ \\\"2026년 마케팅 캠페인 아이디어 10개\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 글 다듬기\\u003c/h4\\u003e\\n\\u003cp\\u003e작성한 글 선택 후:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e→ \\\"더 전문적으로\\\"\\n→ \\\"더 간결하게\\\"\\n→ \\\"영어로 번역\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e노션 AI 단축키\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기능\\u003c/th\\u003e\\n\\u003cth\\u003e단축키\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAI 호출\\u003c/td\\u003e\\n\\u003ctd\\u003eSpace (빈 줄에서)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e선택 영역 AI\\u003c/td\\u003e\\n\\u003ctd\\u003eCmd/Ctrl + J\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e요약하기\\u003c/td\\u003e\\n\\u003ctd\\u003e텍스트 선택 → 요약\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e번역하기\\u003c/td\\u003e\\n\\u003ctd\\u003e텍스트 선택 → 번역\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-16\\\"\\u003e4. Microsoft Copilot 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003eCopilot이란?\\u003c/h3\\u003e\\n\\u003cp\\u003e마이크로소프트 365에 통합된 AI예요. \\u003cstrong\\u003e엑셀, 워드, PPT에서 바로\\u003c/strong\\u003e 사용 가능!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e오피스별 활용법\\u003c/h3\\u003e\\n\\u003ch4\\u003eExcel에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 데이터로 피벗 테이블 만들어줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"매출 추이 그래프 그려줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"이상치 데이터 찾아줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"수식 설명해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 판매 데이터에서:\\n1. 월별 매출 합계 계산\\n2. 상위 10개 제품 추출\\n3. 전년 대비 성장률 계산\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003ePowerPoint에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 문서로 PPT 만들어줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"발표자 노트 작성해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"슬라이드 디자인 개선해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"요약 슬라이드 추가해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 기획안으로 10장짜리 발표 자료 만들어줘.\\n스타일: 심플하고 전문적\\n포함할 것: 목차, 현황, 전략, 예산, 일정\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003eWord에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 보고서 요약해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"초안 작성해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"톤 변경해줘 (공식적/친근하게)\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"길이 조절해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-19\\\"\\u003e5. Perplexity AI 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003ePerplexity란?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eAI 검색 엔진\\u003c/strong\\u003e이에요. 구글처럼 검색하지만, AI가 답변을 정리해줘요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e구글 vs Perplexity\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e구글\\u003c/th\\u003e\\n\\u003cth\\u003ePerplexity\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e결과\\u003c/td\\u003e\\n\\u003ctd\\u003e링크 목록\\u003c/td\\u003e\\n\\u003ctd\\u003e정리된 답변\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e출처\\u003c/td\\u003e\\n\\u003ctd\\u003e직접 확인\\u003c/td\\u003e\\n\\u003ctd\\u003e자동 표시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e후속 질문\\u003c/td\\u003e\\n\\u003ctd\\u003e새로 검색\\u003c/td\\u003e\\n\\u003ctd\\u003e대화로 이어감\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정확도\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003ctd\\u003e높음 + 편리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 시장 조사\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e2026년 한국 이커머스 시장 현황 알려줘.\\n- 시장 규모\\n- 주요 플레이어\\n- 최신 트렌드\\n- 전망\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e결과에 \\u003cstrong\\u003e출처가 표시\\u003c/strong\\u003e되어 보고서에 인용 가능!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e2. 경쟁사 분석\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[경쟁사 이름] 최근 1년 동향 분석해줘.\\n- 주요 뉴스\\n- 신제품/서비스\\n- 재무 현황\\n- 전략적 움직임\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 기술 트렌드 파악\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e2026년 AI 기술 트렌드 Top 5 정리해줘.\\n각 트렌드별로:\\n- 개요\\n- 적용 사례\\n- 우리 업무 적용 방안\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003ePerplexity Pro 기능 ($20/월)\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eGPT-4, Claude 모델 선택 가능\\u003c/li\\u003e\\n\\u003cli\\u003e파일 업로드 분석\\u003c/li\\u003e\\n\\u003cli\\u003e더 긴 답변\\u003c/li\\u003e\\n\\u003cli\\u003e무제한 Pro 검색\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-24\\\"\\u003e6. 업무별 AI 도구 조합 추천\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e상황별 추천 도구\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e업무\\u003c/th\\u003e\\n\\u003cth\\u003e추천 도구\\u003c/th\\u003e\\n\\u003cth\\u003e이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이메일 작성\\u003c/td\\u003e\\n\\u003ctd\\u003eChatGPT\\u003c/td\\u003e\\n\\u003ctd\\u003e빠르고 자연스러움\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e긴 문서 분석\\u003c/td\\u003e\\n\\u003ctd\\u003eClaude\\u003c/td\\u003e\\n\\u003ctd\\u003e긴 문맥 처리 강점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시장 조사\\u003c/td\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003e출처 표시, 최신 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePPT 제작\\u003c/td\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eOffice 연동\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문서 작성\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e작업 흐름 통합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e코딩\\u003c/td\\u003e\\n\\u003ctd\\u003eChatGPT/Claude\\u003c/td\\u003e\\n\\u003ctd\\u003e둘 다 강력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e직무별 추천 조합\\u003c/h3\\u003e\\n\\u003ch4\\u003e마케터\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT (콘텐츠 제작)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Perplexity (시장 조사)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: 노션 AI (기획서 작성)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e기획자\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: Claude (문서 분석)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Copilot (PPT 제작)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: ChatGPT (아이디어)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e개발자\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT/Claude (코딩)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: GitHub Copilot (코드 자동완성)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: Perplexity (기술 검색)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e영업/세일즈\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT (이메일, 제안서)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Perplexity (고객사 조사)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: Copilot (엑셀 분석)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003eAI 도구 활용 꿀팁 모음\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e1. 프롬프트 작성 공식\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e좋은 프롬프트 = 역할 + 맥락 + 구체적 요청 + 형식\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e나쁜 예: \\\"마케팅 아이디어 알려줘\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e좋은 예:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e너는 10년차 마케팅 매니저야. [역할]\\n우리 회사는 20대 타겟 화장품 브랜드인데 [맥락]\\nSNS 마케팅 캠페인 아이디어 5개를 [구체적 요청]\\n각각 제목, 개요, 예상 효과로 정리해줘 [형식]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e2. 반복 작업 템플릿 만들기\\u003c/h3\\u003e\\n\\u003cp\\u003e자주 쓰는 프롬프트는 저장해두세요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예시 - 회의록 템플릿\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e아래 회의 내용을 다음 형식으로 정리해줘:\\n\\n## 회의 정보\\n- 일시:\\n- 참석자:\\n- 안건:\\n\\n## 논의 내용\\n(핵심 위주로)\\n\\n## 결정 사항\\n\\n\\n## 액션 아이템\\n| 담당자 | 할 일 | 기한 |\\n|--------|-------|------|\\n\\n## 다음 회의 안건\\n\\n\\n[회의 내용]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e3. AI 결과물 검증하기\\u003c/h3\\u003e\\n\\u003cp\\u003eAI 답변을 100% 믿지 마세요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e수치/통계: 반드시 출처 확인\\u003c/li\\u003e\\n\\u003cli\\u003e최신 정보: 날짜 확인 (학습 데이터 기준)\\u003c/li\\u003e\\n\\u003cli\\u003e전문 분야: 전문가 검토 필요\\u003c/li\\u003e\\n\\u003cli\\u003e중요 문서: 여러 AI로 교차 검증\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e4. AI와 대화하듯 사용하기\\u003c/h3\\u003e\\n\\u003cp\\u003e한 번에 완벽한 결과를 기대하지 마세요!\\u003c/p\\u003e\\n\\u003cp\\u003e1차: 초안 요청\\n→ \\\"괜찮은데, 2번 부분 더 자세히\\\"\\n→ \\\"톤이 너무 딱딱해, 친근하게 바꿔\\\"\\n→ \\\"마지막에 CTA 추가해줘\\\"\\n→ 최종 결과물!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003eAI 도구 사용 시 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e1. 보안 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e고객 개인정보 입력 금지\\u003c/li\\u003e\\n\\u003cli\\u003e회사 기밀 정보 입력 금지\\u003c/li\\u003e\\n\\u003cli\\u003e민감한 재무 데이터 주의\\u003c/li\\u003e\\n\\u003cli\\u003e익명화된 데이터 사용\\u003c/li\\u003e\\n\\u003cli\\u003e회사 보안 정책 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e2. 저작권 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eAI 생성물의 저작권은 복잡\\u003c/li\\u003e\\n\\u003cli\\u003e상업적 사용 전 확인 필요\\u003c/li\\u003e\\n\\u003cli\\u003e이미지 생성물 특히 주의\\u003c/li\\u003e\\n\\u003cli\\u003e참고/초안 용도로 활용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003e3. 의존 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eAI는 도구일 뿐\\u003c/li\\u003e\\n\\u003cli\\u003e최종 판단은 인간이\\u003c/li\\u003e\\n\\u003cli\\u003e비판적 사고 유지\\u003c/li\\u003e\\n\\u003cli\\u003eAI + 인간 협업 (휴먼인더루프)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-36\\\"\\u003eAI 도구 비용 정리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003e무료로 시작하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e도구\\u003c/th\\u003e\\n\\u003cth\\u003e무료 사용량\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eChatGPT\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o mini 무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eClaude\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적 사용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGemini\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003e하루 5회 Pro 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003e유료 플랜 비교 (월 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e도구\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003e핵심 기능\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eChatGPT Plus\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o, DALL-E\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eClaude Pro\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003e긴 문서, 빠른 응답\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity Pro\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e$10\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 내 무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 365 포함\\u003c/td\\u003e\\n\\u003ctd\\u003e오피스 통합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003e추천 투자 우선순위\\u003c/h3\\u003e\\n\\u003cp\\u003e1순위: ChatGPT 또는 Claude ($20) - 범용\\n2순위: 노션 AI ($10) - 문서 작업 많으면\\n3순위: Perplexity ($20) - 리서치 많으면\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-40\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003eAI 도구는 이제 선택이 아니라 \\u003cstrong\\u003e필수\\u003c/strong\\u003e가 됐어요.\\u003c/p\\u003e\\n\\u003cp\\u003e중요한 건 \\u003cstrong\\u003eAI를 두려워하지 말고, 잘 활용하는 것\\u003c/strong\\u003e!\\u003c/p\\u003e\\n\\u003cp\\u003e트렌드 코리아에서 말하는 **'켄타우로스형 인간'**처럼, AI의 능력과 인간의 지혜를 결합하는 사람이 2026년의 경쟁력을 갖게 됩니다.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘 소개한 도구들 중 하나라도 시작해보세요. 처음엔 어색하지만, 일주일만 써보면 \\\"왜 진작 안 썼지?\\\" 하실 거예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/ces-2026-tech-trends\\\"\\u003eCES 2026 기술 트렌드 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/trend-korea-2026-keywords\\\"\\u003e트렌드 코리아 2026 핵심 키워드 해설\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L22\\\",null,{\\\"content\\\":\\\"$23\\\"}]\\n24:T3f32,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e업무 효율 200% 높이는 AI 도구 활용법: 2026년 필수 AI 툴 총정리\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"AI 쓰면 좋다는데, 뭘 어떻게 써야 하지?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003eChatGPT가 나온 지 벌써 3년이 지났는데요. 아직도 AI를 제대로 활용 못 하고 계신 분들 많으시죠?\\u003c/p\\u003e\\n\\u003cp\\u003e솔직히 저도 처음엔 그랬어요. \\\"이게 뭐가 대단하다고?\\\" 했는데, 제대로 활용하기 시작하니까 \\u003cstrong\\u003e업무 시간이 절반으로\\u003c/strong\\u003e 줄더라고요!\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 2026년 현재 \\u003cstrong\\u003e실무에서 바로 쓸 수 있는 AI 도구들\\u003c/strong\\u003e과 활용법을 정리해드릴게요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e2026년 필수 AI 도구 한눈에 보기\\u003c/h2\\u003e\\n\\u003cp\\u003e먼저 어떤 도구들이 있는지 볼까요?\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e도구\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003e추천 용도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eChatGPT\\u003c/td\\u003e\\n\\u003ctd\\u003e가장 대중적\\u003c/td\\u003e\\n\\u003ctd\\u003e무료/월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003e글쓰기, 코딩, 분석\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eClaude\\u003c/td\\u003e\\n\\u003ctd\\u003e긴 문서 처리\\u003c/td\\u003e\\n\\u003ctd\\u003e무료/월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003e문서 요약, 분석\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGemini\\u003c/td\\u003e\\n\\u003ctd\\u003e구글 연동\\u003c/td\\u003e\\n\\u003ctd\\u003e무료/월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003e검색, 리서치\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 내장\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $10\\u003c/td\\u003e\\n\\u003ctd\\u003e문서 작성\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 연동\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 365 포함\\u003c/td\\u003e\\n\\u003ctd\\u003e오피스 작업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 검색\\u003c/td\\u003e\\n\\u003ctd\\u003e무료/월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003e정보 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e그럼 하나씩 자세히 알아볼게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-1\\\"\\u003e1. ChatGPT 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003eChatGPT란?\\u003c/h3\\u003e\\n\\u003cp\\u003eOpenAI에서 만든 대화형 AI예요. 가장 많이 쓰이는 AI 도구죠!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e가격 정책\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e플랜\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003ctd\\u003e0원\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o mini, 기본 기능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePlus\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $20\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o, 이미지 생성\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eTeam\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $25/인\\u003c/td\\u003e\\n\\u003ctd\\u003e팀 기능, 보안 강화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 이메일 작성\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e다음 상황에 맞는 비즈니스 이메일을 작성해줘.\\n\\n상황: 프로젝트 일정 지연을 고객사에 알리고 양해 구하기\\n- 지연 기간: 1주일\\n- 원인: 내부 테스트 중 버그 발견\\n- 톤: 정중하지만 신뢰감 있게\\n- 길이: 10줄 이내\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e결과 활용\\u003c/strong\\u003e: AI가 작성한 초안 → 상황에 맞게 수정 → 발송\\u003c/p\\u003e\\n\\u003ch4\\u003e2. 회의록 정리\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e아래 회의 내용을 정리해줘.\\n\\n[회의 내용 붙여넣기]\\n\\n형식:\\n1. 핵심 논의 사항 (3-5개)\\n2. 결정된 사항\\n3. 액션 아이템 (담당자, 기한 포함)\\n4. 다음 회의 안건\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 보고서 초안 작성\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e월간 마케팅 보고서 초안을 작성해줘.\\n\\n데이터:\\n- 웹사이트 방문자: 50,000명 (전월 대비 +20%)\\n- 신규 가입자: 3,000명\\n- 광고 비용: 500만 원\\n- 매출: 5,000만 원\\n\\n포함할 내용:\\n1. 요약 (Executive Summary)\\n2. 주요 성과\\n3. 개선점\\n4. 다음 달 계획\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003eChatGPT 꿀팁\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e역할 부여하기: \\\"너는 10년차 마케터야\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e구체적으로 요청하기: \\\"3가지로 정리해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e예시 보여주기: \\\"이런 형식으로 작성해줘: [예시]\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e피드백 주기: \\\"더 간결하게 / 더 자세히\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e2. Claude 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003eClaude란?\\u003c/h3\\u003e\\n\\u003cp\\u003eAnthropic에서 만든 AI예요. \\u003cstrong\\u003e긴 문서 처리\\u003c/strong\\u003e에 특히 강해요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003eChatGPT vs Claude\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003eChatGPT\\u003c/th\\u003e\\n\\u003cth\\u003eClaude\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문서 길이\\u003c/td\\u003e\\n\\u003ctd\\u003e보통\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 김 (20만 토큰)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e코딩\\u003c/td\\u003e\\n\\u003ctd\\u003e강함\\u003c/td\\u003e\\n\\u003ctd\\u003e강함\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e글쓰기\\u003c/td\\u003e\\n\\u003ctd\\u003e좋음\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 좋음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e파일 분석\\u003c/td\\u003e\\n\\u003ctd\\u003e가능\\u003c/td\\u003e\\n\\u003ctd\\u003e가능 (PDF 강점)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e특징\\u003c/td\\u003e\\n\\u003ctd\\u003e범용적\\u003c/td\\u003e\\n\\u003ctd\\u003e문서 특화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 긴 문서 요약\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 PDF 문서를 분석해서 다음을 정리해줘:\\n\\n1. 핵심 내용 요약 (5줄)\\n2. 주요 데이터/수치\\n3. 실행 가능한 인사이트 3가지\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003eClaude는 100페이지가 넘는 PDF도 한 번에 분석 가능!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e2. 계약서/법률 문서 검토\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 계약서를 검토하고 다음을 알려줘:\\n\\n1. 우리에게 불리한 조항\\n2. 협상이 필요한 부분\\n3. 빠진 중요 조항\\n4. 주의해야 할 점\\n\\n[계약서 내용 붙여넣기 또는 파일 첨부]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 연구 자료 분석\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 연구 보고서 3개를 비교 분석해줘.\\n\\n분석 항목:\\n1. 공통된 결론\\n2. 상충되는 내용\\n3. 각 연구의 한계점\\n4. 종합 인사이트\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003eClaude 꿀팁\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e여러 파일 동시 분석 가능\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"Artifacts\\\" 기능으로 코드/문서 별도 출력\\u003c/li\\u003e\\n\\u003cli\\u003e긴 대화도 맥락 잘 유지\\u003c/li\\u003e\\n\\u003cli\\u003e한국어 글쓰기 품질 좋음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-11\\\"\\u003e3. 노션 AI 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e노션 AI란?\\u003c/h3\\u003e\\n\\u003cp\\u003e노션(Notion) 안에 내장된 AI 기능이에요. 문서 작성 중에 바로 AI 도움을 받을 수 있어요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e가격\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e플랜\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003eAI 사용량\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무료\\u003c/td\\u003e\\n\\u003ctd\\u003e0원\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePlus\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $10\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eBusiness\\u003c/td\\u003e\\n\\u003ctd\\u003e월 $15\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 미팅 노트 정리\\u003c/h4\\u003e\\n\\u003cp\\u003e회의 중 막 적은 메모를 AI로 정리:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[스페이스바 누르고 \\\"AI로 개선하기\\\" 선택]\\n→ \\\"회의록 형식으로 정리해줘\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e2. 브레인스토밍\\u003c/h4\\u003e\\n\\u003cp\\u003e빈 페이지에서:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[스페이스바] → \\\"아이디어 브레인스토밍\\\"\\n→ \\\"2026년 마케팅 캠페인 아이디어 10개\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 글 다듬기\\u003c/h4\\u003e\\n\\u003cp\\u003e작성한 글 선택 후:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e→ \\\"더 전문적으로\\\"\\n→ \\\"더 간결하게\\\"\\n→ \\\"영어로 번역\\\"\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e노션 AI 단축키\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기능\\u003c/th\\u003e\\n\\u003cth\\u003e단축키\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eAI 호출\\u003c/td\\u003e\\n\\u003ctd\\u003eSpace (빈 줄에서)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e선택 영역 AI\\u003c/td\\u003e\\n\\u003ctd\\u003eCmd/Ctrl + J\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e요약하기\\u003c/td\\u003e\\n\\u003ctd\\u003e텍스트 선택 → 요약\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e번역하기\\u003c/td\\u003e\\n\\u003ctd\\u003e텍스트 선택 → 번역\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-16\\\"\\u003e4. Microsoft Copilot 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003eCopilot이란?\\u003c/h3\\u003e\\n\\u003cp\\u003e마이크로소프트 365에 통합된 AI예요. \\u003cstrong\\u003e엑셀, 워드, PPT에서 바로\\u003c/strong\\u003e 사용 가능!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e오피스별 활용법\\u003c/h3\\u003e\\n\\u003ch4\\u003eExcel에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 데이터로 피벗 테이블 만들어줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"매출 추이 그래프 그려줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"이상치 데이터 찾아줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"수식 설명해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 판매 데이터에서:\\n1. 월별 매출 합계 계산\\n2. 상위 10개 제품 추출\\n3. 전년 대비 성장률 계산\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003ePowerPoint에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 문서로 PPT 만들어줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"발표자 노트 작성해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"슬라이드 디자인 개선해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"요약 슬라이드 추가해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e이 기획안으로 10장짜리 발표 자료 만들어줘.\\n스타일: 심플하고 전문적\\n포함할 것: 목차, 현황, 전략, 예산, 일정\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003eWord에서 Copilot\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e할 수 있는 것들\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\\"이 보고서 요약해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"초안 작성해줘\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"톤 변경해줘 (공식적/친근하게)\\\"\\u003c/li\\u003e\\n\\u003cli\\u003e\\\"길이 조절해줘\\\"\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-19\\\"\\u003e5. Perplexity AI 실무 활용법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003ePerplexity란?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eAI 검색 엔진\\u003c/strong\\u003e이에요. 구글처럼 검색하지만, AI가 답변을 정리해줘요!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e구글 vs Perplexity\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e구글\\u003c/th\\u003e\\n\\u003cth\\u003ePerplexity\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e결과\\u003c/td\\u003e\\n\\u003ctd\\u003e링크 목록\\u003c/td\\u003e\\n\\u003ctd\\u003e정리된 답변\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e출처\\u003c/td\\u003e\\n\\u003ctd\\u003e직접 확인\\u003c/td\\u003e\\n\\u003ctd\\u003e자동 표시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e후속 질문\\u003c/td\\u003e\\n\\u003ctd\\u003e새로 검색\\u003c/td\\u003e\\n\\u003ctd\\u003e대화로 이어감\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정확도\\u003c/td\\u003e\\n\\u003ctd\\u003e높음\\u003c/td\\u003e\\n\\u003ctd\\u003e높음 + 편리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e실무 활용 예시\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 시장 조사\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e2026년 한국 이커머스 시장 현황 알려줘.\\n- 시장 규모\\n- 주요 플레이어\\n- 최신 트렌드\\n- 전망\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e결과에 \\u003cstrong\\u003e출처가 표시\\u003c/strong\\u003e되어 보고서에 인용 가능!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003e2. 경쟁사 분석\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e[경쟁사 이름] 최근 1년 동향 분석해줘.\\n- 주요 뉴스\\n- 신제품/서비스\\n- 재무 현황\\n- 전략적 움직임\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e3. 기술 트렌드 파악\\u003c/h4\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e프롬프트 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e2026년 AI 기술 트렌드 Top 5 정리해줘.\\n각 트렌드별로:\\n- 개요\\n- 적용 사례\\n- 우리 업무 적용 방안\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003ePerplexity Pro 기능 ($20/월)\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eGPT-4, Claude 모델 선택 가능\\u003c/li\\u003e\\n\\u003cli\\u003e파일 업로드 분석\\u003c/li\\u003e\\n\\u003cli\\u003e더 긴 답변\\u003c/li\\u003e\\n\\u003cli\\u003e무제한 Pro 검색\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-24\\\"\\u003e6. 업무별 AI 도구 조합 추천\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e상황별 추천 도구\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e업무\\u003c/th\\u003e\\n\\u003cth\\u003e추천 도구\\u003c/th\\u003e\\n\\u003cth\\u003e이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이메일 작성\\u003c/td\\u003e\\n\\u003ctd\\u003eChatGPT\\u003c/td\\u003e\\n\\u003ctd\\u003e빠르고 자연스러움\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e긴 문서 분석\\u003c/td\\u003e\\n\\u003ctd\\u003eClaude\\u003c/td\\u003e\\n\\u003ctd\\u003e긴 문맥 처리 강점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시장 조사\\u003c/td\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003e출처 표시, 최신 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePPT 제작\\u003c/td\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eOffice 연동\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문서 작성\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e작업 흐름 통합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e코딩\\u003c/td\\u003e\\n\\u003ctd\\u003eChatGPT/Claude\\u003c/td\\u003e\\n\\u003ctd\\u003e둘 다 강력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e직무별 추천 조합\\u003c/h3\\u003e\\n\\u003ch4\\u003e마케터\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT (콘텐츠 제작)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Perplexity (시장 조사)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: 노션 AI (기획서 작성)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e기획자\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: Claude (문서 분석)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Copilot (PPT 제작)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: ChatGPT (아이디어)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e개발자\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT/Claude (코딩)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: GitHub Copilot (코드 자동완성)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: Perplexity (기술 검색)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e영업/세일즈\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e메인: ChatGPT (이메일, 제안서)\\u003c/li\\u003e\\n\\u003cli\\u003e서브: Perplexity (고객사 조사)\\u003c/li\\u003e\\n\\u003cli\\u003e보조: Copilot (엑셀 분석)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003eAI 도구 활용 꿀팁 모음\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e1. 프롬프트 작성 공식\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e좋은 프롬프트 = 역할 + 맥락 + 구체적 요청 + 형식\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e나쁜 예: \\\"마케팅 아이디어 알려줘\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e좋은 예:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e너는 10년차 마케팅 매니저야. [역할]\\n우리 회사는 20대 타겟 화장품 브랜드인데 [맥락]\\nSNS 마케팅 캠페인 아이디어 5개를 [구체적 요청]\\n각각 제목, 개요, 예상 효과로 정리해줘 [형식]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e2. 반복 작업 템플릿 만들기\\u003c/h3\\u003e\\n\\u003cp\\u003e자주 쓰는 프롬프트는 저장해두세요!\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예시 - 회의록 템플릿\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e아래 회의 내용을 다음 형식으로 정리해줘:\\n\\n## 회의 정보\\n- 일시:\\n- 참석자:\\n- 안건:\\n\\n## 논의 내용\\n(핵심 위주로)\\n\\n## 결정 사항\\n\\n\\n## 액션 아이템\\n| 담당자 | 할 일 | 기한 |\\n|--------|-------|------|\\n\\n## 다음 회의 안건\\n\\n\\n[회의 내용]\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e3. AI 결과물 검증하기\\u003c/h3\\u003e\\n\\u003cp\\u003eAI 답변을 100% 믿지 마세요!\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e수치/통계: 반드시 출처 확인\\u003c/li\\u003e\\n\\u003cli\\u003e최신 정보: 날짜 확인 (학습 데이터 기준)\\u003c/li\\u003e\\n\\u003cli\\u003e전문 분야: 전문가 검토 필요\\u003c/li\\u003e\\n\\u003cli\\u003e중요 문서: 여러 AI로 교차 검증\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e4. AI와 대화하듯 사용하기\\u003c/h3\\u003e\\n\\u003cp\\u003e한 번에 완벽한 결과를 기대하지 마세요!\\u003c/p\\u003e\\n\\u003cp\\u003e1차: 초안 요청\\n→ \\\"괜찮은데, 2번 부분 더 자세히\\\"\\n→ \\\"톤이 너무 딱딱해, 친근하게 바꿔\\\"\\n→ \\\"마지막에 CTA 추가해줘\\\"\\n→ 최종 결과물!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003eAI 도구 사용 시 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e1. 보안 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e고객 개인정보 입력 금지\\u003c/li\\u003e\\n\\u003cli\\u003e회사 기밀 정보 입력 금지\\u003c/li\\u003e\\n\\u003cli\\u003e민감한 재무 데이터 주의\\u003c/li\\u003e\\n\\u003cli\\u003e익명화된 데이터 사용\\u003c/li\\u003e\\n\\u003cli\\u003e회사 보안 정책 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e2. 저작권 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eAI 생성물의 저작권은 복잡\\u003c/li\\u003e\\n\\u003cli\\u003e상업적 사용 전 확인 필요\\u003c/li\\u003e\\n\\u003cli\\u003e이미지 생성물 특히 주의\\u003c/li\\u003e\\n\\u003cli\\u003e참고/초안 용도로 활용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003e3. 의존 주의\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eAI는 도구일 뿐\\u003c/li\\u003e\\n\\u003cli\\u003e최종 판단은 인간이\\u003c/li\\u003e\\n\\u003cli\\u003e비판적 사고 유지\\u003c/li\\u003e\\n\\u003cli\\u003eAI + 인간 협업 (휴먼인더루프)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-36\\\"\\u003eAI 도구 비용 정리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003e무료로 시작하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e도구\\u003c/th\\u003e\\n\\u003cth\\u003e무료 사용량\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eChatGPT\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o mini 무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eClaude\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적 사용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eGemini\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity\\u003c/td\\u003e\\n\\u003ctd\\u003e하루 5회 Pro 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e제한적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003e유료 플랜 비교 (월 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e도구\\u003c/th\\u003e\\n\\u003cth\\u003e가격\\u003c/th\\u003e\\n\\u003cth\\u003e핵심 기능\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eChatGPT Plus\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003eGPT-4o, DALL-E\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eClaude Pro\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003e긴 문서, 빠른 응답\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003ePerplexity Pro\\u003c/td\\u003e\\n\\u003ctd\\u003e$20\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한 검색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노션 AI\\u003c/td\\u003e\\n\\u003ctd\\u003e$10\\u003c/td\\u003e\\n\\u003ctd\\u003e노션 내 무제한\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eCopilot\\u003c/td\\u003e\\n\\u003ctd\\u003eMS 365 포함\\u003c/td\\u003e\\n\\u003ctd\\u003e오피스 통합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003e추천 투자 우선순위\\u003c/h3\\u003e\\n\\u003cp\\u003e1순위: ChatGPT 또는 Claude ($20) - 범용\\n2순위: 노션 AI ($10) - 문서 작업 많으면\\n3순위: Perplexity ($20) - 리서치 많으면\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-40\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003eAI 도구는 이제 선택이 아니라 \\u003cstrong\\u003e필수\\u003c/strong\\u003e가 됐어요.\\u003c/p\\u003e\\n\\u003cp\\u003e중요한 건 \\u003cstrong\\u003eAI를 두려워하지 말고, 잘 활용하는 것\\u003c/strong\\u003e!\\u003c/p\\u003e\\n\\u003cp\\u003e트렌드 코리아에서 말하는 **'켄타우로스형 인간'**처럼, AI의 능력과 인간의 지혜를 결합하는 사람이 2026년의 경쟁력을 갖게 됩니다.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘 소개한 도구들 중 하나라도 시작해보세요. 처음엔 어색하지만, 일주일만 써보면 \\\"왜 진작 안 썼지?\\\" 하실 거예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/ces-2026-tech-trends\\\"\\u003eCES 2026 기술 트렌드 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/trend-korea-2026-keywords\\\"\\u003e트렌드 코리아 2026 핵심 키워드 해설\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$24\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/2026-zodiac-fortune-guide\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 병오년 띠별 운세 총정리: 12띠 신년운세 완벽 가이드\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/ces-2026-tech-trends\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"다음 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"CES 2026 기술 트렌드 총정리: 올해 주목해야 할 혁신 기술 TOP 10\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 pt-8 border-t border-gray-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-gray-900 mb-6\\\",\\\"children\\\":\\\"관련 게시글\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",\\\"galaxy-s26-specs-release-date-2026\\\",{\\\"href\\\":\\\"/posts/galaxy-s26-specs-release-date-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"갤럭시 S26 출시일, 스펙, 가격 총정리\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"삼성 갤럭시 S26 시리즈의 출시일, 스펙, 가격을 총정리했습니다. 언팩 일정, 프로세서, 카메라, 배터리 등 확정 정보와 유출 정보를 구분하여 정리합니다.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"ces-2026-tech-trends\\\",{\\\"href\\\":\\\"/posts/ces-2026-tech-trends\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"CES 2026 기술 트렌드 총정리: 올해 주목해야 할 혁신 기술 TOP 10\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"CES 2026에서 공개된 최신 기술 트렌드를 정리했습니다. AI, 로봇, 전기차, XR 등 올해 우리 생활을 바꿀 혁신 기술들을 확인하세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"self-employed-tax-guide-2026\\\",{\\\"href\\\":\\\"/posts/self-employed-tax-guide-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\\\"}]]}]]}]]}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[1402,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"\"]\n3:I[1398,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[8924,[],\"\"]\n6:I[2619,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"\"]\ne:I[7150,[],\"\"]\n:HL[\"/_next/static/media/d2c1ffb734f61872-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/css/be89a9700d24476f.css\",\"style\"]\n:HL[\"/_next/static/css/b060768bd19d627c.css\",\"style\"]\n0:{\"P\":null,\"b\":\"30Dh3F-gwThwhWHzEqvhC\",\"p\":\"\",\"c\":[\"\",\"posts\",\"ai-productivity-tools-2026\"],\"i\":false,\"f\":[[[\"\",{\"children\":[\"posts\",{\"children\":[[\"slug\",\"ai-productivity-tools-2026\",\"d\"],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/be89a9700d24476f.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/b060768bd19d627c.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"ko\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"$L2\",null,{\"async\":true,\"src\":\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3591490977493759\",\"crossOrigin\":\"anonymous\",\"strategy\":\"afterInteractive\"}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerousl