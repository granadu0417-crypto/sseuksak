y\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e수도권 외 지역 창업 5년 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e감면율\\u003c/td\\u003e\\n\\u003ctd\\u003e소득세 \\u003cstrong\\u003e50~100%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 5년간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e4대 보험료 지원\\u003c/h3\\u003e\\n\\u003ch4\\u003e두루누리 사회보험\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e10인 미만 사업장, 월급 270만 원 미만 근로자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원\\u003c/td\\u003e\\n\\u003ctd\\u003e고용보험·국민연금 사업주+근로자 부담금 \\u003cstrong\\u003e80%\\u003c/strong\\u003e 지원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 36개월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e고용 지원\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e일자리 안정자금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e30인 미만 사업장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e조건\\u003c/td\\u003e\\n\\u003ctd\\u003e최저임금 준수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원금\\u003c/td\\u003e\\n\\u003ctd\\u003e근로자 1인당 월 \\u003cstrong\\u003e최대 11만 원\\u003c/strong\\