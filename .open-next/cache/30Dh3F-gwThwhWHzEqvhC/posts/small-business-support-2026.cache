\\u003e\\n\\u003ctd\\u003e경영 개선 필요 소상공인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원\\u003c/td\\u003e\\n\\u003ctd\\u003e경영, 마케팅, 세무 등 \\u003cstrong\\u003e무료 컨설팅\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신청\\u003c/td\\u003e\\n\\u003ctd\\u003e소상공인마당, 소상공인지원센터\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e온라인 판로 지원\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e스마트스토어 입점 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 교육 + 입점 수수료 지원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e라이브커머스 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e장비 대여 + 촬영 지원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e온라인 마케팅 지원\\u003c/td\\u003e\\n\\u003ctd\\u003eSNS 광고비 일부 지원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-23\\\"\\u003e신청 채널 안내\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e주요 신청 사이트\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e사이트\\u003c/th\\u003e\\n\\u003cth\\u003e주소\\u003c/th\\u003e\\n\\u003cth\\u003e주요 서비스\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소상공인마당\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003esbiz.or.kr\\u003c/td\\u003e\\n\\u003ctd\\u003e정책자금, 지원사업 총괄\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e정부24\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003egov.kr\\u003c/td\\u003e\\n\\u003ctd\\u003e각종 증명서 발급\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003