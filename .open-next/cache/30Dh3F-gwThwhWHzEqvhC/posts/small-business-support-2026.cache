u003e\\u003cstrong\\u003e교육/컨설팅\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 경영 교육\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-2\\\"\\u003e소상공인 정책자금\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e제도 개요\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e소상공인시장진흥공단에서 운영하는 저금리 정책자금 대출\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e업체당 최대 \\u003cstrong\\u003e7억 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e금리\\u003c/td\\u003e\\n\\u003ctd\\u003e연 \\u003cstrong\\u003e2~4%\\u003c/strong\\u003e (시중금리 대비 저금리)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상환 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e5~8년 (거치 2년 포함)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e담보\\u003c/td\\u003e\\n\\u003ctd\\u003e신용보증 연계 (무담보 가능)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e자금 종류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e자금 유형\\u003c/th\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e일반경영안정자금\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e경영 위기 소상공인\\u003c/td\\u003e\\n\\u003ctd\\u003e7억 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e성장촉진자금\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e성장 잠재력 있는 업체\\u003c/td\\u003e\\n\\u003ctd\\u003e5억 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e특별경영안정자금\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e재해·위기지역 업체\\u003c/td\\u003e\\n\\u003ctd\\u003e2억 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e청년고용특별자금\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년 고용 업체\\u003c/td\\u003e\\n\\u003ctd\\u003e5억 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e신청 자격\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e업종\\u003c/td\\u003e\\n\\u003ctd\\u003e소상공인 해당 업종\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상시근로자\\u003c/td\\u003e\\n\\u003ctd\\u003e5인 미만 (제조업 10인 미만)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e사업 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e6개월 이상 영업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용 등급\\u003c/td\\u003e\\n\\u003ctd\\u003e신용등급 제한 없음 (일부 자금 제외)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e신청 방법\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e소상공인마당\\u003c/strong\\u003e (\\u003ca href=\\\"http://www.sbiz.or.kr\\\"\\u003ewww.sbiz.or.kr\\u003c/a\\u003e) 접속\\u003c/li\\u003e\\n\\u003cli\\u003e정책자금 신청 메뉴 클릭\\u003c/li\\u003e\\n\\u003cli\\u003e자격 자가진단 실시\\u003c/li\\u003e\\n\\u003cli\\u003e온라인 신청서 작성\\u003c/li\\u003e\\n\\u003cli\\u003e필요 서류 업로드\\u003c/li\\u003e\\n\\u003cli\\u003e상담 예약 및 심사\\u003c/li\\u003e\\n\\u003cli\\u003e승인 후 대출 실행\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e필요 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e서류\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e사업자등록증\\u003c/td\\u003e\\n\\u003ctd\\u003e필수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증 사본\\u003c/td\\u003e\\n\\u003ctd\\u003e대표자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재무제표\\u003c/td\\u003e\\n\\u003ctd\\u003e최근 2년분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부가세 과세표준증명\\u003c/td\\u003e\\n\\u003ctd\\u003e국세청 발급\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e사업장 임대차계약서\\u003c/td\\u003e\\n\\u003ctd\\u003e해당 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-8\\\"\\u003e세금 감면 혜택\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e부가가치세 간이과세\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e기준\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e연매출 \\u003cstrong\\u003e1억 400만 원 미만\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세율\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5~4% (업종별 상이)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신고\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1회 (1월)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e간이과세 세율\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e업종\\u003c/th\\u003e\\n\\u003cth\\u003e부가율\\u003c/th\\u003e\\n\\u003cth\\u003e실제 세율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e음식점\\u003c/td\\u003e\\n\\u003ctd\\u003e20%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소매업\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1.5%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e서비스업\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e제조업\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e소득세 감면\\u003c/h3\\u003e\\n\\u003ch4\\u003e소규모 사업자 세액감면\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e직전 과세기간 수입 8,000만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e감면율\\u003c/td\\u003e\\n\\u003ctd\\u003e세액의 \\u003cstrong\\u003e5%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e조건\\u003c/td\\u003e\\n\\u003ctd\\u003e성실신고 사업자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e창업중소기업 세액감면\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e수도권 외 지역 창업 5년 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e감면율\\u003c/td\\u003e\\n\\u003ctd\\u003e소득세 \\u003cstrong\\u003e50~100%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 5년간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e4대 보험료 지원\\u003c/h3\\u003e\\n\\u003ch4\\u003e두루누리 사회보험\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e10인 미만 사업장, 월급 270만 원 미만 근로자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원\\u003c/td\\u003e\\n\\u003ctd\\u003e고용보험·국민연금 사업주+근로자 부담금 \\u003cstrong\\u003e80%\\u003c/strong\\u003e 지원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 36개월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e고용 지원\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e일자리 안정자금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e30인 미만 사업장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e조건\\u003c/td\\u003e\\n\\u003ctd\\u003e최저임금 준수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원금\\u003c/td\\u003e\\n\\u003ctd\\u003e근로자 1인당 월 \\u003cstrong\\u003e최대 11만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e청년추가고용장려금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\