ext-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 부동산 세금을 한눈에 정리했습니다. 취득세, 양도소득세, 종합부동산세의 세율과 계산 방법, 절세 전략까지 꼭 알아야 할 핵심 내용을 확인하세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"national-pension-reform-2026\\\",{\\\"href\\\":\\\"/posts/national-pension-reform-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 1월부터 시행되는 국민연금 개정안의 모든 것! 보험료율 9%→13% 단계적 인상, 소득대체율 43% 상향, 국가 지급보장 명문화까지 18년 만의 연금개혁을 쉽게 정리했습니다.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"23:I[622,[],\\\"IconMark\\\"]\\n\"])</script><script>self.__next_f.push([1,\"14:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"2026년 소상공인 지원금 총정리: 정책자금, 세금 혜택, 신청방법까지 | 쓱싹 | 쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"2026년 소상공인을 위한 정부 지원 정책을 총정리했습니다. 정책자금 대출, 세금 감면, 고용지원금까지 사업자가 꼭 알아야 할 정보입니다.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"소상공인, 정책자금, 사업자지원, 세금감면, 정부지원금, 자영업\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"googlebot\\\",\\\"content\\\":\\\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"goo