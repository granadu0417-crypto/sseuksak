003ctd\\u003e성수기라 경쟁 치열\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e추천 대상:\\u003c/strong\\u003e 신규 도전자, 학생\\u003c/p\\u003e\\n\\u003ch4\\u003e3회차 (8월 시험)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e장점\\u003c/th\\u003e\\n\\u003cth\\u003e단점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e여름 방학 활용\\u003c/td\\u003e\\n\\u003ctd\\u003e연내 취업 적용 빠듯\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재도전 기회\\u003c/td\\u003e\\n\\u003ctd\\u003e더위로 집중력 저하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e추천 대상:\\u003c/strong\\u003e 상반기 불합격자, 여름 집중 가능자\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e학습 타임라인\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시험일 기준\\u003c/th\\u003e\\n\\u003cth\\u003e할 일\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-90\\u003c/td\\u003e\\n\\u003ctd\\u003e이론 공부 시작, 교재 선정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-60\\u003c/td\\u003e\\n\\u003ctd\\u003e이론 1회독 완료, 기출 시작\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-30\\u003c/td\\u003e\\n\\u003ctd\\u003e기출 5개년 완료, 오답 정리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-14\\u003c/td\\u003e\\n\\u003ctd\\u003e모의고사, 취약 과목 집중\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-7\\u003c/td\\u003e\\n\\u003ctd\\u003e오답 노트 복습, 컨디션 관리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eD-1\\u003c/td\\u003e\\n\\u003ctd\\u003e준비물 확인, 일찍 취침\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31