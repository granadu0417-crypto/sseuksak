li\\u003e시험 종료 후 문제 유출 금지\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003eQ1. 원서접수 기간 놓쳤어요. 추가 접수 없나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아쉽지만 없습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e국가기술자격은 추가 접수 없음\\u003c/li\\u003e\\n\\u003cli\\u003e다음 회차까지 대기해야 함\\u003c/li\\u003e\\n\\u003cli\\u003e알림 설정 추천 (큐넷 앱)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eQ2. 시험장 변경할 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e원서접수 기간에만 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e접수 마감 후 변경 불가\\u003c/li\\u003e\\n\\u003cli\\u003e취소 후 재접수도 불가 (접수 기간 종료 시)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003eQ3. 필기 합격하고 실기 떨어지면?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2년간 필기 면제됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e같은 종목에 한해 2년간 필기 면제\\u003c/li\\u003e\\n\\u003cli\\u003e2년 초과 시 필기부터 다시 응시\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003eQ4. 기사와 산업기사 동시 접수 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e시험일이 다르면 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e같은 날 시험은 불가\\u003c/li\\u003e\\n\\u003cli\\u003e다른 회차에 각각 접수 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003eQ5. 응시료 환불 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e기간에 따라 다릅니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e환불률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 마감 전\\u003c/td\\u003e\\n\\u003ctd\\u003e100%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 마감~시험 4일 전\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 3일 전 이후\\u003c/td\\u003e\\n\\u003ctd\\u003e환불 불가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-41\\\"\\u003e2026년 시험 일정 캘린더\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-42\\\"\\u003e상반기 (1~6월)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월\\u003c/th\\u003e\\n\\u003cth\\u003e주요 일정\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 접수, 기술사 128회 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 시험, 기술사 필기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 발표, 실기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 실기 시험 시작, 2회 필기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 실기 종료, 2회 필기 시험\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e6월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 2회 필기 발표, 실기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-43\\\"\\u003e하반기 (7~12월)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월\\u003c/th\\u003e\\n\\u003cth\\u003e주요 일정\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e7월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 필기 접수, 2회 실기 시험, 기술사 129회 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e8월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 필기 시험, 2회 실기 종료, 기술사 필기\\u003c/td\\u00