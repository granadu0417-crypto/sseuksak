\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증 (주민등록증, 운전면허증)\\u003c/td\\u003e\\n\\u003ctd\\u003e시계 (스마트워치 제외)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수험표\\u003c/td\\u003e\\n\\u003ctd\\u003e간식\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e컴퓨터용 사인펜\\u003c/td\\u003e\\n\\u003ctd\\u003e여분 필기구\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수정테이프\\u003c/td\\u003e\\n\\u003ctd\\u003e가벼운 외투\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e시험장 도착\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시간\\u003c/th\\u003e\\n\\u003cth\\u003e행동\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 1시간 전\\u003c/td\\u003e\\n\\u003ctd\\u003e시험장 도착\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 30분 전\\u003c/td\\u003e\\n\\u003ctd\\u003e화장실, 좌석 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 10분 전\\u003c/td\\u003e\\n\\u003ctd\\u003e휴대폰 전원 끄기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 시작\\u003c/td\\u003e\\n\\u003ctd\\u003e문제 전체 훑어보기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e주의사항\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e부정행위 주의:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e휴대폰 소지 시 퇴장 (전원 꺼도 불가)\\u003c/li\\u003e\\n\\u003cli\\u003e시험 중 대화 금지\\u003c/li\\u003e\\n\\u003cli\\u003e답안지 훼손 금지\\u003c/li\\u003e\\n\\u003cli\\u003e시험 종료 후 문제 유출 금지\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003eQ1. 원서접수 기간 놓쳤어요. 추가 접수 없나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아쉽지만 없습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e국가기술자격은 추가 접수 없음\\u003c/li\\u003e\\n\\u003cli\\u003e다음 회차까지 대기해야 함\\u003c/li\\u003e\\n\\u003cli\\u003e알림 설정 추천 (큐넷 앱)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eQ2. 시험장 변경할 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e원서접수 기간에만 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e접수 마감 후 변경 불가\\u003c/li\\u003e\\n\\u003cli\\u003e취소 후 재접수도 불가 (접수 기간 종료 시)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003eQ3. 필기 합격하고 실기 떨어지면?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2년간 필기 면제됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e같은 종목에 한해 2년간 필기 면제\\u003c/li\\u003e\\n\\u003cli\\u003e2년 초과 시 필기부터 다시 응시\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003eQ4. 기사와 산업기사 동시 접수 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e시험일이 다르면 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e같은 날 시험은 불가\\u003c/li\\u003e\\n\\u003cli\\u003e다른 회차에 각각 접수 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003eQ5. 응시료 환불 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e기간에 따라 다릅니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e환불률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 마감 전\\u003c/td\\u003e\\n\\u003ctd\\u003e100%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 마감~시험 4일 전\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 3일 전 이후\\u003c/td\\u003e\\n\\u003ctd\\u003e환불 불가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-41\\\"\\u003e2026년 시험 일정 캘린더\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-42\\\"\\u003e상반기 (1~6월)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월\\u003c/th\\u003e\\n\\u003cth\\u003e주요 일정\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 접수, 기술사 128회 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 시험, 기술사 필기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 필기 발표, 실기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 실기 시험 시작, 2회 필기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 1회 실기 종료, 2회 필기 시험\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e6월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 2회 필기 발표, 실기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-43\\\"\\u003e하반기 (7~12월)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월\\u003c/th\\u003e\\n\\u003cth\\u003e주요 일정\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e7월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 필기 접수, 2회 실기 시험, 기술사 129회 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e8월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 필기 시험, 2회 실기 종료, 기술사 필기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e9월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 필기 발표, 실기 접수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 실기 시험 시작, 기술사 필기 발표\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e11월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 실기 종료, 기술사 면접\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e12월\\u003c/td\\u003e\\n\\u003ctd\\u003e기사 3회 최종 발표\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-44\\\"\\u003e합격 후 할 일\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-45\\\"\\u003e자격증 발급\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003cth\\u003e절차\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e온라인\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e큐넷 → 자격증 신청 → 배송 (2~3주)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e방문\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e한국산업인력공단 방문 → 즉시 발급\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e발급 비용:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e신규 발급: 3,100원\\u003c/li\\u003e\\n\\u003cli\\u003e재발급: 3,100원\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-46\\\"\\u003e자격증 활용\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e활용처\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업\\u003c/td\\u003e\\n\\u003ctd\\u003e이력서 기재, 면접 시 어필\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공무원\\u003c/td\\u003e\\n\\u003ctd\\u003e기술직 공무원 가산점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e승진\\u003c/td\\u003e\\n\\u003ctd\\u003e사내 승진 시 가점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e창업\\u003c/td\\u003e\\n\\u003ctd\\u003e관련 업종 인허가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이직\\u003c/td\\u003e\\n\\u003ctd\\u003e경력 증명\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-47\\\"\\u003e정리: 2026년 시험 준비 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-48\\\"\\u003e필수 확인 사항\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 응시 자격 확인 (학력/경력)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 원서접수 일정 캘린더 등록\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 시험 준비 기간 확보 (최소 2~3개월)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 교재 및 강의 준비\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 기출문제 확보\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-49\\\"\\u003e일정별 체크\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e할 일\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 1주 전\\u003c/td\\u003e\\n\\u003ctd\\u003e큐넷 로그인 확인, 사진 준비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접수 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e빠르게 접수 (시험장 조기 마감 주의)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 1개월 전\\u003c/td\\u003e\\n\\u003ctd\\u003e기출문제 집중\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 1주 전\\u003c/td\\u003e\\n\\u003ctd\\u003e오답 정리, 컨디션 관리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시험 당일\\u003c/td\\u003e\\n\\u003ctd\\u003e준비물 확인, 일찍 도착\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-50\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e국가기술자격 시험은 \\u003cstrong\\u003e정해진 일정\\u003c/strong\\u003e에 맞춰 준비해야 합니다.\\u003c/p\\u003e\\n\\u003cp\\u003e2026년 시험 일정을 미리 파악하고, \\u003cstrong\\u003e원서접수 기간을 절대 놓치지 마세요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e자격증은 한 번 취득하면 평생 유효합니다. 올해 목표한 자격증, 꼭 취득하시길 바랍니다!\\u003c/p\\u003e\\n\\u003cp\\u003e정확한 일정은 \\u003ca href=\\\"https://www.q-net.or.kr\\\"\\u003e큐넷(Q-net)\\u003c/a\\u003e에서 확인하세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/new-certifications-2026-guide\\\"\\u003e2026년 신설 국가자격증 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/health-insurance-premium-2026\\\"\\u003e2026년 건강보험료 변경사항 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$24\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/minimum-wage-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 최저임금 완벽 가이드: 시