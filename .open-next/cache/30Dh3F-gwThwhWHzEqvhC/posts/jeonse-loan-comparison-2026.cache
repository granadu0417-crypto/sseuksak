c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-16\\\"\\u003e5. 전세대출 보증 종류\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e보증기관별 특징\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e보증기관\\u003c/th\\u003e\\n\\u003cth\\u003e보증료\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eHUG (주택도시보증공사)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e0.128%~0.154%\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 5억원\\u003c/td\\u003e\\n\\u003ctd\\u003e가장 보편적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eSGI (서울보증보험)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e0.183%~0.358%\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 5억원\\u003c/td\\u003e\\n\\u003ctd\\u003e심사 빠름\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003eHF (한국주택금융공사)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e0.05%~0.15%\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 5억원\\u003c/td\\u003e\\n\\u003ctd\\u003e정책대출 연계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e보증 한도 계산\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e보증 한도 = 전세보증금 × 보증비율 - 선순위 채권\\n\\n※ 보증비율: 수도권 80%, 지방 90%\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e예시\\u003c/strong\\u003e: 전세보증금 4억원, 수도권\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e보증 한도: 4억 × 80% = 3.2억원\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-19\\\"\\u003e6. 전세대출 심사 기준\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003eDSR(총부채원리금상환비율)\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📢 \\u003cstrong\\u003e중요\\u003c/strong\\u003e: 전세대출은 현재 \\u003cstrong\\u003eDSR 규제에서 제외\\u003c/strong\\u003e됩니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대출 종류\\u003c/th\\u003e\\n\\u003cth\\u003eDSR 적용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주택담보대출\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용대출\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e전세대출\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 미적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자동차 할부\\u003c/td\\u003e\\n\\u003ctd\\u003e⚠️ 일부 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e심사 시 확인 항목\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득\\u003c/td\\u003e\\n\\u003ctd\\u003e연 소득 증빙 (원천징수, 소득금액증명)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용점수\\u003c/td\\u003e\\n\\u003ctd\\u003e700점 이상 권장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재직 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e3개월 이상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주택 적격성\\u003c/td\\u003e\\n\\u003ctd\\u003e등기, 전세계약서, 확정일자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e임대인 체납\\u003c/td\\u003e\\n\\u003ctd\\u003e국세, 지방세 체납 여부\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e7. 전세대출 신청 절차\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003eStep by Step\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e1. 전세 계약 체결\\n   ↓ (계약금 지급 후)\\n2. 대출 상품 비교 및 선택\\n   ↓\\n3. 대출 신청 (온라인/방문)\\n   ↓\\n4. 서류 제출 및 심사 (3~7일)\\n   ↓\\n5. 보증서 발급 (1~3일)\\n   ↓\\n6. 대출 실행 (잔금일)\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e필수 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e서류\\u003c/th\\u003e\\n\\u003cth\\u003e용도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증\\u003c/td\\u003e\\n\\u003ctd\\u003e본인 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주민등록등본\\u003c/td\\u003e\\n\\u003ctd\\u003e세대 구성 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득증빙서류\\u003c/td\\u003e\\n\\u003ctd\\u003e소득 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재직증명서\\u003c/td\\u003e\\n\\u003ctd\\u003e직장 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전세계약서\\u003c/td\\u003e\\n\\u003ctd\\u003e계약 내용 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e등기부등본\\u003c/td\\u003e\\n\\u003ctd\\u003e권리관계 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e확정일자\\u003c/td\\u003e\\n\\u003ctd\\u003e대항력 확보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e타이밍 중요!\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시점\\u003c/th\\u003e\\n\\u003cth\\u003e해야 할 일\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e계약 직후\\u003c/td\\u003e\\n\\u003ctd\\u003e대출 상담 및 한도 조회\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e잔금 2주 전\\u003c/td\\u003e\\n\\u003ctd\\u003e정식 대출 신청\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e잔금 3일 전\\u003c/td\\u003e\\n\\u003ctd\\u003e보증서 발급 완료 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e잔금일\\u003c/td\\u003e\\n\\u003ctd\\u003e대출 실행, 전입신고\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-26\\\"\\u003e8. 전세대출 금리 절약 팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e1. 정책대출 우선 검토\\u003c/h3\\u003e\\n\\u003cp\\u003e소득 요건 충족 시 정책대출이 \\u003cstrong\\u003e1~2% 이상\\u003c/strong\\u003e 저렴합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e2. 우대금리 조건 챙기기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e우대 조건\\u003c/th\\u003e\\n\\u003cth\\u003e적용 상품\\u003c/th\\u003e\\n\\u003cth\\u003e우대폭\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e급여이체\\u003c/td\\u003e\\n\\u003ctd\\u003e시중은행\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1~0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적금 연계\\u003c/td\\u003e\\n\\u003ctd\\u003e시중은행\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1~0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e청년\\u003c/td\\u003e\\n\\u003ctd\\u003e정책대출\\u003c/td\\u003e\\n\\u003ctd\\u003e0.2~0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다자녀\\u003c/td\\u003e\\n\\u003ctd\\u003e정책대출\\u003c/td\\u003e\\n\\u003ctd\\u003e0.3~0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e3. 보증기관 비교\\u003c/h3\\u003e\\n\\u003cp\\u003eHF(주택금융공사) 보증이 보증료가 가장 저렴합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e4. 대환대출 검토\\u003c/h3\\u003e\\n\\u003cp\\u003e기존 전세대출 금리가 \\u003cstrong\\u003e현재 금리보다 1% 이상 높다면\\u003c/strong\\u003e 대환을 고려하세요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e5. 금리 비교 사이트 활용\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e금융감독원 금융상품 한눈에\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e주택도시기금 e든든\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e네이버 대출 비교\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003e9. 전세대출 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e전세사기 예방 체크리스트\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e체크 항목\\u003c/th\\u003e\\n\\u003cth\\u003e확인 방법\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e등기부등본 확인\\u003c/td\\u003e\\n\\u003ctd\\u003e근저당, 가압류 여부\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e임대인 체납세금\\u003c/td\\u003e\\n\\u003ctd\\u003e국세, 지방세 열람\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전입세대 확인\\u003c/td\\u003e\\n\\u003ctd\\u003e전입세대 열람 신청\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시세 확인\\u003c/td\\u003e\\n\\u003ctd\\u003eKB시세, 국토부 실거래가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e집주인 본인 확인\\u003c/td\\u003e\\n\\u003ctd\\u003e신분증, 등기권리증 대조\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e갭투자 물건 주의\\u003c/h3\\u003e\\n\\u003cp\\u003e전세가율(전세가/매매가) \\u003cstrong\\u003e80% 이상\\u003c/strong\\u003e인 물건은 주의가 필요합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003e확정일자 필수\\u003c/h3\\u003e\\n\\u003cp\\u003e전입신고와 확정일자는 \\u003cstrong\\u003e대출 실행 당일\\u003c/strong\\u003e 반드시 받으세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-36\\\"\\u003e자주 묻는 질문\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eQ1. 정책대출과 시중은행 대출, 동시 신청 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 동시 신청은 가능하지만, \\u003cstrong\\u003e둘 다 실행은 불가\\u003c/strong\\u003e합니다. 조건 비교 후 유리한 쪽으로 선택하세요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003eQ2. 전세대출 중도상환수수료가 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 상품에 따라 다릅니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e정책대출\\u003c/strong\\u003e: 없음\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e시중은행\\u003c/strong\\u003e: 0~1.5% (대출 3년 내)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e인터넷은행\\u003c/strong\\u003e: 대부분 없음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003eQ3. 1인 가구도 청년버팀목 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 네, 만 34세 이하 \\u003cstrong\\u003e무주택 단독세대주\\u003c/strong\\u003e이면 가능합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003eQ4. 전세보증금 5억원인데, 얼마까지 대출받을 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 수도권 기준:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e정책대출\\u003c/strong\\u003e: 한도 초과 (3억원 이하만 가능)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e시중은행\\u003c/strong\\u003e: 5억 × 80% = 최대 4억원\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-41\\\"\\u003eQ5. 집주인이 세금을 체납하면 어떻게 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 국세, 지방세가 전세권보다 \\u003cstrong\\u003e우선변제\\u003c/strong\\u003e 되므로, 체납이 있으면 보증서 발급이 거절될 수 있습니다. 계약 전 반드시 확인하세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-42\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 전세대출은 \\u003cstrong\\u003e정책대출 활용\\u003c/strong\\u003e이 핵심입니다. 청년이라면 청년버팀목, 신혼부부라면 신혼부부 전용을 우선 검토하세요.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e전세대출 핵심 체크리스트\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e✅ 정책대출 자격 요건 확인\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 여러 상품 금리 비교\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 우대금리 조건 최대한 활용\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 보증기관 비교 (HF가 저렴)\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 등기부등본, 체납세금 확인\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 전입신고 + 확정일자 당일 처리\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e신중한 비교와 꼼꼼한 서류 준비로 안전하게 전세대출을 받으시기 바랍니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-43\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 주택담보대출 금리 비교\\u003c/li\\u003e\\n\\u003cli\\u003e청년 주거 지원 정책 총정리\\u003c/li\\u003e\\n\\u003cli\\u003e전세사기 예방 체크리스트\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었습니다. 금리와 조건은 변경될 수 있으므로 정확한 내용은 해당 금융기관에 직접 문의하시기 바랍니다.\\u003c/em\\u003e\\u003c/p\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$24\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/galaxy-s26-specs-release-date-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"갤럭시 S26 출시일, 스펙, 가격 총정리\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/mortgage-rate-comparison-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"다음 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"주택담보대출 금리 비교 완벽 가이드\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 pt-8 border-t border-gray-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-gray-900 mb-6\\\",\\\"children\\\":\\\"관련 게시글\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",\\\"mortgage-rate-comparison-2026\\\",{\\\"href\\\":\\\"/posts/mortgage-rate-comparison-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"주택담보대출 금리 비교 완벽 가이드\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 주택담보대출 금리를 은행별로 비교하고, 보금자리론부터 시중은행 주담대까지 최저금리 찾는 방법을 알려드립니다. 스트레스 DSR 3단계 적용과 대출 한도 계산법도 함께 확인하세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"self-employed-tax-guide-2026\\\",{\\\"href\\\":\\\"/posts/self-employed-tax-guide-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"real-estate-tax-guide-2026\\\",{\\\"href\\\":\\\"/posts/real-estate-tax-guide-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 