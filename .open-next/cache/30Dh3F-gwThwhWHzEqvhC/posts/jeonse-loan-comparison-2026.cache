003c/td\\u003e\\n\\u003ctd\\u003e2.1%~3.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e일반 무주택자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e신혼부부전용\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5%~2.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e혼인 7년 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e시중은행\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e일반 전세대출\\u003c/td\\u003e\\n\\u003ctd\\u003e3.5%~5.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e자격 제한 적음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e인터넷은행\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e카카오/토스뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e3.3%~5.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e비대면, 빠른 심사\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-1\\\"\\u003e1. 청년버팀목 전세자금대출\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e기본 조건 (2026년)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e대상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e만 19세 ~ 34세 무주택 단독세대주\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소득 요건\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e본인 연소득 5,000만원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e자산 요건\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e순자산 3.61억원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e주택 요건\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e전세보증금 3억원 이하 (수도권), 2억원 이하 (지방)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e대출 한도\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 2억원 (일반), 1.5억원 (보증금 80%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e대출 기간\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 10년 (2년 단위 연장)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e금리 (2026년 1월 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e소득 구간\\u003c/th\\u003e\\n\\u003cth\\u003e금리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e연 2.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e연 2.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e연 3.1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e우대금리 항목\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e우대폭\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다자녀가구\\u003c/td\\u003e\\n\\u003ctd\\u003e-0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한부모가족\\u003c/td\\u003e\\n\\u003ctd\\u003e-0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장애인 가구\\u003c/td\\u003e\\n\\u003ctd\\u003e-0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신규 취업자\\u003c/td\\u003e\\n\\u003ctd\\u003e-0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부동산 전자계약\\u003c/td\\u003e\\n\\u003ctd\\u003e-0.1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003