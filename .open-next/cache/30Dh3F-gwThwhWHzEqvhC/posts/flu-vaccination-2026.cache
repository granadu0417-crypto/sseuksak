\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리 | 쓱싹\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"33\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"2026년 독감(인플루엔자) 예방접종 정보를 총정리했습니다. 무료 접종 대상, 접종 권장 시기, 부작용 및 주의사항까지 알려드립니다.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"34\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://images.unsplash.com/photo-1498837167922-ddd27525d352?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxoZWFsdGh5JTIwZm9vZHxlbnwwfDB8fHwxNzY3NjczODg1fDA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\"}],[\\\"$\\\",\\\"link\\\",\\\"35\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L20\\\",\\\"36\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"19:\\\"$14:metadata\\\"\\n\"])</script><script>self.__next_f.push([1,\"21:I[286,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"default\\\"]\\n1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://unsplash.com/@danielcgold?utm_source=sseuksak\\u0026utm_medium=referral\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Photo by Dan Gold on Unsplash\\\"}]}]\\n22:T38c6,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"독감 주사 맞아야 하나요? 무료로 맞을 수 있나요?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e독감(인플루엔자) 시즌이 다가옵니다. \\u003cstrong\\u003e무료 접종 대상\\u003c/strong\\u003e인지 확인하고, 적절한 시기에 예방접종을 받으세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e독감 예방접종 기본 정보\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e독감이란?\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e인플루엔자 바이러스에 의한 급성 호흡기 감염병\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e독감 (인플루엔자)\\u003c/th\\u003e\\n\\u003cth\\u003e감기 (Common Cold)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e원인\\u003c/td\\u003e\\n\\u003ctd\\u003e인플루엔자 바이러스\\u003c/td\\u003e\\n\\u003ctd\\u003e리노바이러스 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e발병\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e급격히\\u003c/strong\\u003e 시작\\u003c/td\\u003e\\n\\u003ctd\\u003e서서히 시작\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e발열\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e38도 이상\\u003c/strong\\u003e 고열\\u003c/td\\u003e\\n\\u003ctd\\u003e미열 또는 없음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e증상\\u003c/td\\u003e\\n\\u003ctd\\u003e심한 근육통, 두통\\u003c/td\\u003e\\n\\u003ctd\\u003e콧물, 기침\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2주\\u003c/td\\u003e\\n\\u003ctd\\u003e1주 내외\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e합병증\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e폐렴, 사망\\u003c/strong\\u003e 위험\\u003c/td\\u003e\\n\\u003ctd\\u003e드뭄\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e왜 예방접종이 필요한가요?\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e고위험군\\u003c/strong\\u003e 합병증·사망 예방\\u003c/li\\u003e\\n\\u003cli\\u003e감염 시 증상 경감\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e집단 면역\\u003c/strong\\u003e 형성\\u003c/li\\u003e\\n\\u003cli\\u003e의료 시스템 부담 감소\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e2026년 무료 접종 대상\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e국가 예방접종 지원 대상\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e나이/조건\\u003c/th\\u003e\\n\\u003cth\\u003e접종 시기\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e어린이\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e생후 6개월~만 13세\\u003c/td\\u003e\\n\\u003ctd\\u003e9월~12월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e임신부\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e임신 중\\u003c/td\\u003e\\n\\u003ctd\\u003e9월~12월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e어르신\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e만 65세 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e10월~12월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e생애 첫 접종 어린이\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e접종 횟수\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e처음 접종하는 만 9세 미만\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2회\\u003c/strong\\u003e (4주 간격)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이전에 접종한 적 있음\\u003c/td\\u003e\\n\\u003ctd\\u003e1회\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e무료 접종 기간\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e시작\\u003c/th\\u003e\\n\\u003cth\\u003e종료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어린이 (2회 대상)\\u003c/td\\u003e\\n\\u003ctd\\u003e9월 초\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어린이 (1회 대상)\\u003c/td\\u003e\\n\\u003ctd\\u003e9월 중순\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e임신부\\u003c/td\\u003e\\n\\u003ctd\\u003e9월 중순\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어르신 (만 75세 이상)\\u003c/td\\u003e\\n\\u003ctd\\u003e10월 초\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어르신 (만 65~74세)\\u003c/td\\u003e\\n\\u003ctd\\u003e10월 중순\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eTip\\u003c/strong\\u003e: 무료 접종 기간이 \\u003cstrong\\u003e4월 30일\\u003c/strong\\u003e까지 연장되어 있으니, 시즌 중 언제든 접종 가능합니다!\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-7\\\"\\u003e접종 권장 시기\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e언제 맞는 게 좋을까요?\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e10~11월에 접종하는 것이 가장 효과적\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e접종 시기\\u003c/th\\u003e\\n\\u003cth\\u003e장점\\u003c/th\\u003e\\n\\u003cth\\u003e단점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e9월\\u003c/td\\u003e\\n\\u003ctd\\u003e조기 면역 형성\\u003c/td\\u003e\\n\\u003ctd\\u003e이른 봄 면역력 감소 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10~11월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e최적 시기\\u003c/strong\\u003e, 시즌 전 면역\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e12월\\u003c/td\\u003e\\n\\u003ctd\\u003e아직 늦지 않음\\u003c/td\\u003e\\n\\u003ctd\\u003e일부 유행 시작 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1월 이후\\u003c/td\\u003e\\n\\u003ctd\\u003e그래도 접종 권장\\u003c/td\\u003e\\n\\u003ctd\\u003e효과 제한적\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e면역 형성 기간\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e접종 후 \\u003cstrong\\u003e약 2주\\u003c/strong\\u003e면 항체 형성\\u003c/li\\u003e\\n\\u003cli\\u003e효과 지속: \\u003cstrong\\u003e약 6개월\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e매년 접종 필요 (바이러스 변이)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-10\\\"\\u003e접종 장소 및 방법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e무료 접종 가능 장소\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e장소\\u003c/th\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e예약\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e지정 의료기관\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 접종 대상\\u003c/td\\u003e\\n\\u003ctd\\u003e권장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보건소\\u003c/td\\u003e\\n\\u003ctd\\u003e무료 접종 대상\\u003c/td\\u003e\\n\\u003ctd\\u003e권장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e예약 방법\\u003c/h3\\u003