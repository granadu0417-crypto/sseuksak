3e준비물\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어린이\\u003c/td\\u003e\\n\\u003ctd\\u003e주민등록등본 또는 건강보험증\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e임신부\\u003c/td\\u003e\\n\\u003ctd\\u003e산모수첩 또는 임신확인서\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e어르신\\u003c/td\\u003e\\n\\u003ctd\\u003e신분증\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-14\\\"\\u003e유료 접종 안내\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e무료 대상이 아닌 경우\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e권장 여부\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e만 14세~64세 건강한 성인\\u003c/td\\u003e\\n\\u003ctd\\u003e선택적 권장\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e만성질환자\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e강력 권장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e의료기관 종사자\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e강력 권장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e면역저하자\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e강력 권장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e유료 접종 비용\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e백신 종류\\u003c/th\\u003e\\n\\u003cth\\u003e가격 (대략)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3가 백신\\u003c/td\\u003e\\n\\u003ctd\\u003e2만~3만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4가 백신\\u003c/td\\u003e\\n\\u003ctd\\u003e3만~5만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고용량 백신 (어르신용)\\u003c/td\\u003e\\n\\u003ctd\\u003e5만~7만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e참고\\u003c/strong\\u003e: 의료기관별로 가격 상이\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e회사 지원 확인\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e많은 기업에서 \\u003cstrong\\u003e임직원 독감 접종 지원\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e인사팀/복지팀에 문의\\u003c/li\\u003e\\n\\u003cli\\u003e가족 포함 지원하는 곳도 있음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-18\\\"\\u003e백신 종류\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e3가 vs 4가 백신\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e3가 백신\\u003c/th\\u003e\\n\\u003cth\\u003e4가 백신\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e포함 바이러스\\u003c/td\\u003e\\n\\u003ctd\\u003eA형 2종 + B형 1종\\u003c/td\\u003e\\n\\u003ctd\\u003eA형 2종 + B형 2종\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보장 범위\\u003c/td\\u003e\\n\\u003ctd\\u003e표준\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e더 넓음\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가격\\u003c/td\\u003e\\n\\u003ctd\\u003e저렴\\u003c/td\\u003e\\n\\u003ctd\\u003e비쌈\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무료 접종\\u003c/td\\u003e\\n\\u003ctd\\u003e일부 대상\\u003c/td\\u003e\\n\\u003ctd\\u003e일부 대상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e어떤 백신이 좋을까?\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e무료 접종 대상\\u003c/strong\\u003e: 제공되는 백신으로 충분\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e유료 접종 시\\u003c/strong\\u003e: 4가 백신 권장 (더 넓은 보장)\\u003c/li\\u003e\\n\\u003cli\\u003e의사와 상담 후 결정\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-21\\\"\\u003e접종 전후 주의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e접종 전 체크리스트\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 현재 발열, 감염 증상이 없는가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 이전 백신 접종 시 심한 부작용 있었는가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 계란 알레르기가 있는가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 임신 중인가? (임신부용 별도)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 복용 중인 약이 있는가?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e접종 당일\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시점\\u003c/th\\u003e\\n\\u003cth\\u003e주의사항\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접종 전\\u003c/td\\u003e\\n\\u003ctd\\u003e충분한 수면, 컨디션 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접종 직후\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e20~30분 의료기관 대기\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접종 후\\u003c/td\\u003e\\n\\u003ctd\\u003e격한 운동, 음주 자제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e접종 후 주의사항\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기간\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e당일\\u003c/td\\u003e\\n\\u003ctd\\u003e접종 부위 청결, 무리하지 않기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2~3일\\u003c/td\\u003e\\n\\u003ctd\\u003e접종 부위 통증, 미열 가능 (정상)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1주일\\u003c/td\\u003e\\n\\u003ctd\\u003e이상 반응 시 의료기관 방문\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e부작용 및 이상반응\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e흔한 반응 (걱정 불필요)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e반응\\u003c/th\\u003e\\n\\u003cth\\u003e빈도\\u003c/th\\u003e\\n\\u003cth\\u003e기간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접종 부위 통증\\u003c/td\\u003e\\n\\u003ctd\\u003e매우 흔함\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e접종 부위 부기\\u003c/td\\u003e\\n\\u003ctd\\u003e흔함\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e미열 (38도 미만)\\u003c/td\\u003e\\n\\u003ctd\\u003e흔함\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e근육통, 피로\\u003c/td\\u003e\\n\\u003ctd\\u003e흔함\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e드문 심각한 반응\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e반응\\u003c/th\\u003e\\n\\u003cth\\u003e조치\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고열 (39도 이상, 48시간 이상)\\u003c/td\\u003e\\n\\u003ctd\\u003e의료기관 방문\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e심한 알레르기 반응\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e즉시 응급실\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e두드러기, 호흡 곤란\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e즉시 응급실\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e경련, 의식 변화\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e즉시 응급실\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e아나필락시스 대비\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e접종 후 \\u003cstrong\\u003e20~30분 대기\\u003c/strong\\u003e 필수\\u003c/li\\u003e\\n\\u003cli\\u003e의료기관에서 관찰\\u003c/li\\u003e\\n\\u003cli\\u003e이상 시 즉시 의료진 호출\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-29\\\"\\u003e접종 불가 대상\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e절대 금기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e이유\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이전 독감 백신 아나필락시스 경험자\\u003c/td\\u003e\\n\\u003ctd\\u003e심각한 알레르기 위험\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e백신 성분 알레르기\\u003c/td\\u003e\\n\\u003ctd\\u003e성분 확인 필요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e생후 6개월 미만 영아\\u003c/td\\u003e\\n\\u003ctd\\u003e안전성 미확립\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e주의 대상 (의사 상담 필요)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e상담 내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e계란 알레르기\\u003c/td\\u003e\\n\\u003ctd\\u003e두드러기 정도면 접종 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e발열 환자\\u003c/td\\u003e\\n\\u003ctd\\u003e열 내린 후 접종\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e길랭-바레 증후군 병력\\u003c/td\\u003e\\n\\u003ctd\\u003e개별 판단\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e면역억제제 복용 중\\u003c/td\\u003e\\n\\u003ctd\\u003e접종 시기 조정 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003eQ1. 매년 맞아야 하나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 매년 접종해야 합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e인플루엔자 바이러스가 매년 변이\\u003c/li\\u003e\\n\\u003cli\\u003e백신 효과가 약 6개월\\u003c/li\\u003e\\n\\u003cli\\u003e매년 유행 바이러스에 맞춘 새 백신 개발\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003eQ2. 코로나 백신과 함께 맞아도 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 동시 접종 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e다른 팔에 접종 권장\\u003c/li\\u003e\\n\\u003cli\\u003e부작용 발생 시 구분 어려울 수 있음\\u003c/li\\u003e\\n\\u003cli\\u003e개인 상황에 따라 의사와 상담\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003eQ3. 접종해도 독감 걸리나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e걸릴 수 있지만, 증상이 가벼워집니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e백신 효과: 약 40~60%\\u003c/li\\u003e\\n\\u003cli\\u003e중증, 합병증 예방 효과 높음\\u003c/li\\u003e\\n\\u003cli\\u003e입원, 사망 위험 크게 감소\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003eQ4. 감기에 걸렸는데 맞아도 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e가벼운 감기는 접종 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e발열 없는 경미한 증상: 접종 가능\\u003c/li\\u003e\\n\\u003cli\\u003e38도 이상 발열: 회복 후 접종\\u003c/li\\u003e\\n\\u003cli\\u003e의료진 판단 따르기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eQ5. 임신 몇 개월에 맞는 게 좋나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e임신 중 언제든 접종 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e임신 전 기간 안전\\u003c/li\\u003e\\n\\u003cli\\u003e태아에게도 항체 전달\\u003c/li\\u003e\\n\\u003cli\\u003e출산 후 신생아 보호 효과\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-38\\\"\\u003e2026년 독감 예방접종 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003e무료 접종 대상 확인\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 어린이 (생후 6개월~만 13세)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 임신부\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 만 65세 이상 어르신\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003e접종 전 준비\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 접종 가능 의료기관 확인\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 예약 완료 (권장)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 준비물 챙기기 (신분증 등)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 컨디션 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-41\\\"\\u003e접종 후 관리\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 20~30분 대기\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 접종 부위 청결 유지\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 충분한 휴식\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 이상 반응 시 의료기관 방문\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-42\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e독감 예방접종은 \\u003cstrong\\u003e나와 가족을 지키는 가장 확실한 방법\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e핵심 포인트:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e무료 접종 대상\\u003c/strong\\u003e 확인 (어린이, 임신부, 어르신)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e10~11월\\u003c/strong\\u003e 접종이 가장 효과적\\u003c/li\\u003e\\n\\u003cli\\u003e접종 후 \\u003cstrong\\u003e20~30분 대기\\u003c/strong\\u003e 필수\\u003c/li\\u003e\\n\\u003cli\\u003e매년 새로 접종 필요\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e문의: 질병관리청 콜센터 \\u003cstrong\\u003e1339\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/health-insurance-premium-2026\\\"\\u003e2026년 건강보험료 변경사항 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/5th-generation-health-insurance-guide-2026\\\"\\u003e2026년 5세대 실손보험 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$23\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/ev-subsidy-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 전기차 보조금 완벽 가이드: 차종별 지원금, 신청방법 총정리\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/health-insurance-premium-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"다음 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 건강보험료 변경사항 총정리: 인상률, 계산법, 절약 팁까지\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 pt-8 border-t border-gray-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-gray-900 mb-6\\\",\\\"children\\\":\\\"관련 게시글\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",\\\"health-insurance-premium-2026\\\",{\\\"href\\\":\\\"/posts/health-insurance-premium-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"2026년 건강보험료 변경사항 총정리: 인상률, 계산법, 절약 팁까지\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 1월부터 적용되는 건강보험료 변경사항을 정리했습니다. 직장가입자와 지역가입자별 보험료 계산법, 인상 내역, 절약 방법까지 알려드립니다.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"2026-new-year-diet-plan\\\",{\\\"href\\\":\\\"/posts/2026-new-year-diet-plan\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"신년 다이어트 식단: 건강하게 살 빼는 4주 식단표 완벽 가이드\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"새해 다이어트 결심하셨나요? 무리하지 않고 건강하게 살 빼는 4주 식단표와 실천 가능한 다이어트 팁을 정리했습니다. 요요 없는 체중 감량 시작하세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"self-employed-tax-guide-2026\\\",{\\\"href\\\":\\\"/posts/self-employed-tax-guide-2026\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\\\"}]]}]]}]]}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[1402,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"\"]\n3:I[1398,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[8924,[],\"\"]\n6:I[2619,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"\"]\ne:I[7150,[],\"\"]\n:HL[\"/_next/static/media/d2c1ffb734f61872-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font