\"name\":\"google-adsense-account\",\"content\":\"ca-pub-3591490977493759\"}],[\"$\",\"link\",\"9\",{\"rel\":\"canonical\",\"href\":\"https://sseuksak.com/posts/flu-vaccination-2026\"}],[\"$\",\"meta\",\"10\",{\"name\":\"google-site-verification\",\"content\":\"05uSSCwIsJLxLnMlswVBzMSOwEeGCOkpMhx9YJMZcng\"}],[\"$\",\"meta\",\"11\",{\"name\":\"naver-site-verification\",\"content\":\"f82b9ef52a15379f29a3f6d9ffe4dd6b9d6cc43b\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리 | 쓱싹\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"2026년 독감(인플루엔자) 예방접종 정보를 총정리했습니다. 무료 접종 대상, 접종 권장 시기, 부작용 및 주의사항까지 알려드립니다.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://sseuksak.com/posts/flu-vaccination-2026\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"ko_KR\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://images.unsplash.com/photo-1498837167922-ddd27525d352?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxoZWFsdGh5JTIwZm9vZHxlbnwwfDB8fHwxNzY3NjczODg1fDA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:alt\",\"content\":\"2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"22\",{\"property\":\"article:published_time\",\"content\":\"2026-01-06\"}],[\"$\",\"meta\",\"23\",{\"property\":\"article:author\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"24\",{\"property\":\"article:section\",\"content\":\"health\"}],[\"$\",\"meta\",\"25\",{\"property\":\"article:tag\",\"content\":\"독감\"}],[\"$\",\"meta\",\"26\",{\"property\":\"article:tag\",\"content\":\"예방접종\"}],[\"$\",\"meta\",\"27\",{\"property\":\"article:tag\",\"content\":\"인플루엔자\"}],[\"$\",\"meta\",\"28\",{\"property\":\"article:tag\",\"content\":\"백신\"}],[\"$\",\"meta\",\"29\",{\"property\":\"article:tag\",\"content\":\"건강관리\"}],[\"$\",\"meta\",\"30\",{\"property\":\"article:tag\",\"content\":\"무료접종\"}],[\"$\",\"meta\",\"31\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"32\",{\"name\":\"twitter:title\",\"content\":\"2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리 | 쓱싹\"}],[\"$\",\"meta\",\"33\",{\"name\":\"twitter:description\",\"content\":\"2026년 독감(인플루엔자) 예방접종 정보를 총정리했습니다. 무료 접종 대상, 접종 권장 시기, 부작용 및 주의사항까지 알려드립니다.\"}],[\"$\",\"meta\",\"34\",{\"name\":\"twitter:image\",\"content\":\"https://images.unsplash.com/photo-1498837167922-ddd27525d352?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxoZWFsdGh5JTIwZm9vZHxlbnwwfDB8fHwxNzY3NjczODg1fDA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"link\",\"35\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"36\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n21:I[286,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"default\"]\n1b:[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://unsplash.com/@danielcgold?utm_source=sseuksak&utm_medium=referral\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-white\",\"children\":\"Photo by Dan Gold on Unsplash\"}]}]\n22:T38c6,<h1>2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리</h1>\n<p>\"독감 주사 맞아야 하나요? 무료로 맞을 수 있나요?\"</p>\n<p>독감(인플루엔자) 시즌이 다가옵니다. <strong>무료 접종 대상</strong>인지 확인하고, 적절한 시기에 예방접종을 받으세요!</p>\n<hr>\n<h2 id=\"heading-0\">독감 예방접종 기본 정보</h2>\n<h3 id=\"heading-1\">독감이란?</h3>\n<blockquote>\n<p><strong>인플루엔자 바이러스에 의한 급성 호흡기 감염병</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>독감 (인플루엔자)</th>\n<th>감기 (Common Cold)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>원인</td>\n<td>인플루엔자 바이러스</td>\n<td>리노바이러스 등</td>\n</tr>\n<tr>\n<td>발병</td>\n<td><strong>급격히</strong> 시작</td>\n<td>서서히 시작</td>\n</tr>\n<tr>\n<td>발열</td>\n<td><strong>38도 이상</strong> 고열</td>\n<td>미열 또는 없음</td>\n</tr>\n<tr>\n<td>증상</td>\n<td>심한 근육통, 두통</td>\n<td>콧물, 기침</td>\n</tr>\n<tr>\n<td>기간</td>\n<td>1~2주</td>\n<td>1주 내외</td>\n</tr>\n<tr>\n<td>합병증</td>\n<td><strong>폐렴, 사망</strong> 위험</td>\n<td>드뭄</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-2\">왜 예방접종이 필요한가요?</h3>\n<ul>\n<li><strong>고위험군</strong> 합병증·사망 예방</li>\n<li>감염 시 증상 경감</li>\n<li><strong>집단 면역</strong> 형성</li>\n<li>의료 시스템 부담 감소</li>\n</ul>\n<hr>\n<h2 id=\"heading-3\">2026년 무료 접종 대상</h2>\n<h3 id=\"heading-4\">국가 예방접종 지원 대상</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>나이/조건</th>\n<th>접종 시기</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>어린이</strong></td>\n<td>생후 6개월~만 13세</td>\n<td>9월~12월</td>\n</tr>\n<tr>\n<td><strong>임신부</strong></td>\n<td>임신 중</td>\n<td>9월~12월</td>\n</tr>\n<tr>\n<td><strong>어르신</strong></td>\n<td>만 65세 이상</td>\n<td>10월~12월</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">생애 첫 접종 어린이</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>접종 횟수</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>처음 접종하는 만 9세 미만</td>\n<td><strong>2회</strong> (4주 간격)</td>\n</tr>\n<tr>\n<td>이전에 접종한 적 있음</td>\n<td>1회</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-6\">무료 접종 기간</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>시작</th>\n<th>종료</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>어린이 (2회 대상)</td>\n<td>9월 초</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어린이 (1회 대상)</td>\n<td>9월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>임신부</td>\n<td>9월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어르신 (만 75세 이상)</td>\n<td>10월 초</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어르신 (만 65~74세)</td>\n<td>10월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p><strong>Tip</strong>: 무료 접종 기간이 <strong>4월 30일</strong>까지 연장되어 있으니, 시즌 중 언제든 접종 가능합니다!</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-7\">접종 권장 시기</h2>\n<h3 id=\"heading-8\">언제 맞는 게 좋을까요?</h3>\n<blockquote>\n<p><strong>10~11월에 접종하는 것이 가장 효과적</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>접종 시기</th>\n<th>장점</th>\n<th>단점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>9월</td>\n<td>조기 면역 형성</td>\n<td>이른 봄 면역력 감소 가능</td>\n</tr>\n<tr>\n<td><strong>10~11월</strong></td>\n<td><strong>최적 시기</strong>, 시즌 전 면역</td>\n<td>-</td>\n</tr>\n<tr>\n<td>12월</td>\n<td>아직 늦지 않음</td>\n<td>일부 유행 시작 가능</td>\n</tr>\n<tr>\n<td>1월 이후</td>\n<td>그래도 접종 권장</td>\n<td>효과 제한적</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-9\">면역 형성 기간</h3>\n<ul>\n<li>접종 후 <strong>약 2주</strong>면 항체 형성</li>\n<li>효과 지속: <strong>약 6개월</strong></li>\n<li>매년 접종 필요 (바이러스 변이)</li>\n</ul>\n<hr>\n<h2 id=\"heading-10\">접종 장소 및 방법</h2>\n<h3 id=\"heading-11\">무료 접종 가능 장소</h3>\n<table>\n<thead>\n<tr>\n<th>장소</th>\n<th>대상</th>\n<th>예약</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>지정 의료기관</strong></td>\n<td>무료 접종 대상</td>\n<td>권장</td>\n</tr>\n<tr>\n<td>보건소</td>\n<td>무료 접종 대상</td>\n<td>권장</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-12\">예약 방법</h3>\n<ol>\n<li>\n<p><strong>사전예약 시스템</strong> (예방접종 도우미)</p>\n<ul>\n<li>질병관리청 누리집 접속</li>\n<li>접종 예약하기 클릭</li>\n<li>가까운 의료기관 선택</li>\n<li>날짜/시간 예약</li>\n</ul>\n</li>\n<li>\n<p><strong>전화 예약</strong></p>\n<ul>\n<li>가까운 병원/의원 직접 연락</li>\n<li>예약 가능 여부 확인</li>\n</ul>\n</li>\n<li>\n<p><strong>방문 접종</strong> (예약 없이)</p>\n<ul>\n<li>일부 의료기관 가능</li>\n<li>대기 시간 발생 가능</li>\n</ul>\n</li>\n</ol>\n<h3 id=\"heading-13\">준비물</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>준비물</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>어린이</td>\n<td>주민등록등본 또는 건강보험증</td>\n</tr>\n<tr>\n<td>임신부</td>\n<td>산모수첩 또는 임신확인서</td>\n</tr>\n<tr>\n<td>어르신</td>\n<td>신분증</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-14\">유료 접종 안내</h2>\n<h3 id=\"heading-15\">무료 대상이 아닌 경우</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>권장 여부</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>만 14세~64세 건강한 성인</td>\n<td>선택적 권장</td>\n</tr>\n<tr>\n<td>만성질환자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n<tr>\n<td>의료기관 종사자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n<tr>\n<td>면역저하자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-16\">유료 접종 비용</h3>\n<table>\n<thead>\n<tr>\n<th>백신 종류</th>\n<th>가격 (대략)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3가 백신</td>\n<td>2만~3만 원</td>\n</tr>\n<tr>\n<td>4가 백신</td>\n<td>3만~5만 원</td>\n</tr>\n<tr>\n<td>고용량 백신 (어르신용)</td>\n<td>5만~7만 원</td>\n</tr>\n</tbody>\n</table>\n<p><strong>참고</strong>: 의료기관별로 가격 상이</p>\n<h3 id=\"heading-17\">회사 지원 확인</h3>\n<ul>\n<li>많은 기업에서 <strong>임직원 독감 접종 지원</strong></li>\n<li>인사팀/복지팀에 문의</li>\n<li>가족 포함 지원하는 곳도 있음</li>\n</ul>\n<hr>\n<h2 id=\"heading-18\">백신 종류</h2>\n<h3 id=\"heading-19\">3가 vs 4가 백신</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>3가 백신</th>\n<th>4가 백신</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>포함 바이러스</td>\n<td>A형 2종 + B형 1종</td>\n<td>A형 2종 + B형 2종</td>\n</tr>\n<tr>\n<td>보장 범위</td>\n<td>표준</td>\n<td><strong>더 넓음</strong></td>\n</tr>\n<tr>\n<td>가격</td>\n<td>저렴</td>\n<td>비쌈</td>\n</tr>\n<tr>\n<td>무료 접종</td>\n<td>일부 대상</td>\n<td>일부 대상</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-20\">어떤 백신이 좋을까?</h3>\n<ul>\n<li><strong>무료 접종 대상</strong>: 제공되는 백신으로 충분</li>\n<li><strong>유료 접종 시</strong>: 4가 백신 권장 (더 넓은 보장)</li>\n<li>의사와 상담 후 결정</li>\n</ul>\n<hr>\n<h2 id=\"heading-21\">접종 전후 주의사항</h2>\n<h3 id=\"heading-22\">접종 전 체크리스트</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 현재 발열, 감염 증상이 없는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 이전 백신 접종 시 심한 부작용 있었는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 계란 알레르기가 있는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 임신 중인가? (임신부용 별도)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 복용 중인 약이 있는가?</li>\n</ul>\n<h3 id=\"heading-23\">접종 당일</h3>\n<table>\n<thead>\n<tr>\n<th>시점</th>\n<th>주의사항</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>접종 전</td>\n<td>충분한 수면, 컨디션 확인</td>\n</tr>\n<tr>\n<td>접종 직후</td>\n<td><strong>20~30분 의료기관 대기</strong></td>\n</tr>\n<tr>\n<td>접종 후</td>\n<td>격한 운동, 음주 자제</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">접종 후 주의사항</h3>\n<table>\n<thead>\n<tr>\n<th>기간</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>당일</td>\n<td>접종 부위 청결, 무리하지 않기</td>\n</tr>\n<tr>\n<td>2~3일</td>\n<td>접종 부위 통증, 미열 가능 (정상)</td>\n</tr>\n<tr>\n<td>1주일</td>\n<td>이상 반응 시 의료기관 방문</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-25\">부작용 및 이상반응</h2>\n<h3 id=\"heading-26\">흔한 반응 (걱정 불필요)</h3>\n<table>\n<thead>\n<tr>\n<th>반응</th>\n<th>빈도</th>\n<th>기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>접종 부위 통증</td>\n<td>매우 흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>접종 부위 부기</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>미열 (38도 미만)</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>근육통, 피로</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-27\">드문 심각한 반응</h3>\n<table>\n<thead>\n<tr>\n<th>반응</th>\n<th>조치</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>고열 (39도 이상, 48시간 이상)</td>\n<td>의료기관 방문</td>\n</tr>\n<tr>\n<td>심한 알레르기 반응</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n<tr>\n<td>두드러기, 호흡 곤란</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n<tr>\n<td>경련, 의식 변화</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">아나필락시스 대비</h3>\n<ul>\n<li>접종 후 <strong>20~30분 대기</strong> 필수</li>\n<li>의료기관에서 관찰</li>\n<li>이상 시 즉시 의료진 호출</li>\n</ul>\n<hr>\n<h2 id=\"heading-29\">접종 불가 대상</h2>\n<h3 id=\"heading-30\">절대 금기</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>이유</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>이전 독감 백신 아나필락시스 경험자</td>\n<td>심각한 알레르기 위험</td>\n</tr>\n<tr>\n<td>백신 성분 알레르기</td>\n<td>성분 확인 필요</td>\n</tr>\n<tr>\n<td>생후 6개월 미만 영아</td>\n<td>안전성 미확립</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">주의 대상 (의사 상담 필요)</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>상담 내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>계란 알레르기</td>\n<td>두드러기 정도면 접종 가능</td>\n</tr>\n<tr>\n<td>발열 환자</td>\n<td>열 내린 후 접종</td>\n</tr>\n<tr>\n<td>길랭-바레 증후군 병력</td>\n<td>개별 판단</td>\n</tr>\n<tr>\n<td>면역억제제 복용 중</td>\n<td>접종 시기 조정 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-32\">자주 묻는 질문 (FAQ)</h2>\n<h3 id=\"heading-33\">Q1. 매년 맞아야 하나요?</h3>\n<p><strong>네, 매년 접종해야 합니다.</strong></p>\n<ul>\n<li>인플루엔자 바이러스가 매년 변이</li>\n<li>백신 효과가 약 6개월</li>\n<li>매년 유행 바이러스에 맞춘 새 백신 개발</li>\n</ul>\n<h3 id=\"heading-34\">Q2. 코로나 백신과 함께 맞아도 되나요?</h3>\n<p><strong>네, 동시 접종 가능합니다.</strong></p>\n<ul>\n<li>다른 팔에 접종 권장</li>\n<li>부작용 발생 시 구분 어려울 수 있음</li>\n<li>개인 상황에 따라 의사와 상담</li>\n</ul>\n<h3 id=\"heading-35\">Q3. 접종해도 독감 걸리나요?</h3>\n<p><strong>걸릴 수 있지만, 증상이 가벼워집니다.</strong></p>\n<ul>\n<li>백신 효과: 약 40~60%</li>\n<li>중증, 합병증 예방 효과 높음</li>\n<li>입원, 사망 위험 크게 감소</li>\n</ul>\n<h3 id=\"heading-36\">Q4. 감기에 걸렸는데 맞아도 되나요?</h3>\n<p><strong>가벼운 감기는 접종 가능합니다.</strong></p>\n<ul>\n<li>발열 없는 경미한 증상: 접종 가능</li>\n<li>38도 이상 발열: 회복 후 접종</li>\n<li>의료진 판단 따르기</li>\n</ul>\n<h3 id=\"heading-37\">Q5. 임신 몇 개월에 맞는 게 좋나요?</h3>\n<p><strong>임신 중 언제든 접종 가능합니다.</strong></p>\n<ul>\n<li>임신 전 기간 안전</li>\n<li>태아에게도 항체 전달</li>\n<li>출산 후 신생아 보호 효과</li>\n</ul>\n<hr>\n<h2 id=\"heading-38\">2026년 독감 예방접종 체크리스트</h2>\n<h3 id=\"heading-39\">무료 접종 대상 확인</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 어린이 (생후 6개월~만 13세)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 임신부</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 만 65세 이상 어르신</li>\n</ul>\n<h3 id=\"heading-40\">접종 전 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 접종 가능 의료기관 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 예약 완료 (권장)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 준비물 챙기기 (신분증 등)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 컨디션 확인</li>\n</ul>\n<h3 id=\"heading-41\">접종 후 관리</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 20~30분 대기</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 접종 부위 청결 유지</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 충분한 휴식</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 이상 반응 시 의료기관 방문</li>\n</ul>\n<hr>\n<h2 id=\"heading-42\">마무리</h2>\n<p>독감 예방접종은 <strong>나와 가족을 지키는 가장 확실한 방법</strong>입니다.</p>\n<p>핵심 포인트:</p>\n<ol>\n<li><strong>무료 접종 대상</strong> 확인 (어린이, 임신부, 어르신)</li>\n<li><strong>10~11월</strong> 접종이 가장 효과적</li>\n<li>접종 후 <strong>20~30분 대기</strong> 필수</li>\n<li>매년 새로 접종 필요</li>\n</ol>\n<p>문의: 질병관리청 콜센터 <strong>1339</strong></p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/health-insurance-premium-2026\">2026년 건강보험료 변경사항 총정리</a></li>\n<li><a href=\"/posts/5th-generation-health-insurance-guide-2026\">2026년 5세대 실손보험 완벽 가이드</a></li>\n</ul>\n1c:[\"$\",\"$L21\",null,{\"content\":\"$22\"}]\n23:T38c6,<h1>2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리</h1>\n<p>\"독감 주사 맞아야 하나요? 무료로 맞을 수 있나요?\"</p>\n<p>독감(인플루엔자) 시즌이 다가옵니다. <strong>무료 접종 대상</strong>인지 확인하고, 적절한 시기에 예방접종을 받으세요!</p>\n<hr>\n<h2 id=\"heading-0\">독감 예방접종 기본 정보</h2>\n<h3 id=\"heading-1\">독감이란?</h3>\n<blockquote>\n<p><strong>인플루엔자 바이러스에 의한 급성 호흡기 감염병</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>독감 (인플루엔자)</th>\n<th>감기 (Common Cold)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>원인</td>\n<td>인플루엔자 바이러스</td>\n<td>리노바이러스 등</td>\n</tr>\n<tr>\n<td>발병</td>\n<td><strong>급격히</strong> 시작</td>\n<td>서서히 시작</td>\n</tr>\n<tr>\n<td>발열</td>\n<td><strong>38도 이상</strong> 고열</td>\n<td>미열 또는 없음</td>\n</tr>\n<tr>\n<td>증상</td>\n<td>심한 근육통, 두통</td>\n<td>콧물, 기침</td>\n</tr>\n<tr>\n<td>기간</td>\n<td>1~2주</td>\n<td>1주 내외</td>\n</tr>\n<tr>\n<td>합병증</td>\n<td><strong>폐렴, 사망</strong> 위험</td>\n<td>드뭄</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-2\">왜 예방접종이 필요한가요?</h3>\n<ul>\n<li><strong>고위험군</strong> 합병증·사망 예방</li>\n<li>감염 시 증상 경감</li>\n<li><strong>집단 면역</strong> 형성</li>\n<li>의료 시스템 부담 감소</li>\n</ul>\n<hr>\n<h2 id=\"heading-3\">2026년 무료 접종 대상</h2>\n<h3 id=\"heading-4\">국가 예방접종 지원 대상</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>나이/조건</th>\n<th>접종 시기</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>어린이</strong></td>\n<td>생후 6개월~만 13세</td>\n<td>9월~12월</td>\n</tr>\n<tr>\n<td><strong>임신부</strong></td>\n<td>임신 중</td>\n<td>9월~12월</td>\n</tr>\n<tr>\n<td><strong>어르신</strong></td>\n<td>만 65세 이상</td>\n<td>10월~12월</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">생애 첫 접종 어린이</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>접종 횟수</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>처음 접종하는 만 9세 미만</td>\n<td><strong>2회</strong> (4주 간격)</td>\n</tr>\n<tr>\n<td>이전에 접종한 적 있음</td>\n<td>1회</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-6\">무료 접종 기간</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>시작</th>\n<th>종료</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>어린이 (2회 대상)</td>\n<td>9월 초</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어린이 (1회 대상)</td>\n<td>9월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>임신부</td>\n<td>9월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어르신 (만 75세 이상)</td>\n<td>10월 초</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n<tr>\n<td>어르신 (만 65~74세)</td>\n<td>10월 중순</td>\n<td><strong>4월 30일</strong></td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p><strong>Tip</strong>: 무료 접종 기간이 <strong>4월 30일</strong>까지 연장되어 있으니, 시즌 중 언제든 접종 가능합니다!</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-7\">접종 권장 시기</h2>\n<h3 id=\"heading-8\">언제 맞는 게 좋을까요?</h3>\n<blockquote>\n<p><strong>10~11월에 접종하는 것이 가장 효과적</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>접종 시기</th>\n<th>장점</th>\n<th>단점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>9월</td>\n<td>조기 면역 형성</td>\n<td>이른 봄 면역력 감소 가능</td>\n</tr>\n<tr>\n<td><strong>10~11월</strong></td>\n<td><strong>최적 시기</strong>, 시즌 전 면역</td>\n<td>-</td>\n</tr>\n<tr>\n<td>12월</td>\n<td>아직 늦지 않음</td>\n<td>일부 유행 시작 가능</td>\n</tr>\n<tr>\n<td>1월 이후</td>\n<td>그래도 접종 권장</td>\n<td>효과 제한적</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-9\">면역 형성 기간</h3>\n<ul>\n<li>접종 후 <strong>약 2주</strong>면 항체 형성</li>\n<li>효과 지속: <strong>약 6개월</strong></li>\n<li>매년 접종 필요 (바이러스 변이)</li>\n</ul>\n<hr>\n<h2 id=\"heading-10\">접종 장소 및 방법</h2>\n<h3 id=\"heading-11\">무료 접종 가능 장소</h3>\n<table>\n<thead>\n<tr>\n<th>장소</th>\n<th>대상</th>\n<th>예약</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>지정 의료기관</strong></td>\n<td>무료 접종 대상</td>\n<td>권장</td>\n</tr>\n<tr>\n<td>보건소</td>\n<td>무료 접종 대상</td>\n<td>권장</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-12\">예약 방법</h3>\n<ol>\n<li>\n<p><strong>사전예약 시스템</strong> (예방접종 도우미)</p>\n<ul>\n<li>질병관리청 누리집 접속</li>\n<li>접종 예약하기 클릭</li>\n<li>가까운 의료기관 선택</li>\n<li>날짜/시간 예약</li>\n</ul>\n</li>\n<li>\n<p><strong>전화 예약</strong></p>\n<ul>\n<li>가까운 병원/의원 직접 연락</li>\n<li>예약 가능 여부 확인</li>\n</ul>\n</li>\n<li>\n<p><strong>방문 접종</strong> (예약 없이)</p>\n<ul>\n<li>일부 의료기관 가능</li>\n<li>대기 시간 발생 가능</li>\n</ul>\n</li>\n</ol>\n<h3 id=\"heading-13\">준비물</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>준비물</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>어린이</td>\n<td>주민등록등본 또는 건강보험증</td>\n</tr>\n<tr>\n<td>임신부</td>\n<td>산모수첩 또는 임신확인서</td>\n</tr>\n<tr>\n<td>어르신</td>\n<td>신분증</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-14\">유료 접종 안내</h2>\n<h3 id=\"heading-15\">무료 대상이 아닌 경우</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>권장 여부</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>만 14세~64세 건강한 성인</td>\n<td>선택적 권장</td>\n</tr>\n<tr>\n<td>만성질환자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n<tr>\n<td>의료기관 종사자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n<tr>\n<td>면역저하자</td>\n<td><strong>강력 권장</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-16\">유료 접종 비용</h3>\n<table>\n<thead>\n<tr>\n<th>백신 종류</th>\n<th>가격 (대략)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3가 백신</td>\n<td>2만~3만 원</td>\n</tr>\n<tr>\n<td>4가 백신</td>\n<td>3만~5만 원</td>\n</tr>\n<tr>\n<td>고용량 백신 (어르신용)</td>\n<td>5만~7만 원</td>\n</tr>\n</tbody>\n</table>\n<p><strong>참고</strong>: 의료기관별로 가격 상이</p>\n<h3 id=\"heading-17\">회사 지원 확인</h3>\n<ul>\n<li>많은 기업에서 <strong>임직원 독감 접종 지원</strong></li>\n<li>인사팀/복지팀에 문의</li>\n<li>가족 포함 지원하는 곳도 있음</li>\n</ul>\n<hr>\n<h2 id=\"heading-18\">백신 종류</h2>\n<h3 id=\"heading-19\">3가 vs 4가 백신</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>3가 백신</th>\n<th>4가 백신</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>포함 바이러스</td>\n<td>A형 2종 + B형 1종</td>\n<td>A형 2종 + B형 2종</td>\n</tr>\n<tr>\n<td>보장 범위</td>\n<td>표준</td>\n<td><strong>더 넓음</strong></td>\n</tr>\n<tr>\n<td>가격</td>\n<td>저렴</td>\n<td>비쌈</td>\n</tr>\n<tr>\n<td>무료 접종</td>\n<td>일부 대상</td>\n<td>일부 대상</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-20\">어떤 백신이 좋을까?</h3>\n<ul>\n<li><strong>무료 접종 대상</strong>: 제공되는 백신으로 충분</li>\n<li><strong>유료 접종 시</strong>: 4가 백신 권장 (더 넓은 보장)</li>\n<li>의사와 상담 후 결정</li>\n</ul>\n<hr>\n<h2 id=\"heading-21\">접종 전후 주의사항</h2>\n<h3 id=\"heading-22\">접종 전 체크리스트</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 현재 발열, 감염 증상이 없는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 이전 백신 접종 시 심한 부작용 있었는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 계란 알레르기가 있는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 임신 중인가? (임신부용 별도)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 복용 중인 약이 있는가?</li>\n</ul>\n<h3 id=\"heading-23\">접종 당일</h3>\n<table>\n<thead>\n<tr>\n<th>시점</th>\n<th>주의사항</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>접종 전</td>\n<td>충분한 수면, 컨디션 확인</td>\n</tr>\n<tr>\n<td>접종 직후</td>\n<td><strong>20~30분 의료기관 대기</strong></td>\n</tr>\n<tr>\n<td>접종 후</td>\n<td>격한 운동, 음주 자제</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">접종 후 주의사항</h3>\n<table>\n<thead>\n<tr>\n<th>기간</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>당일</td>\n<td>접종 부위 청결, 무리하지 않기</td>\n</tr>\n<tr>\n<td>2~3일</td>\n<td>접종 부위 통증, 미열 가능 (정상)</td>\n</tr>\n<tr>\n<td>1주일</td>\n<td>이상 반응 시 의료기관 방문</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-25\">부작용 및 이상반응</h2>\n<h3 id=\"heading-26\">흔한 반응 (걱정 불필요)</h3>\n<table>\n<thead>\n<tr>\n<th>반응</th>\n<th>빈도</th>\n<th>기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>접종 부위 통증</td>\n<td>매우 흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>접종 부위 부기</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>미열 (38도 미만)</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n<tr>\n<td>근육통, 피로</td>\n<td>흔함</td>\n<td>1~2일</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-27\">드문 심각한 반응</h3>\n<table>\n<thead>\n<tr>\n<th>반응</th>\n<th>조치</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>고열 (39도 이상, 48시간 이상)</td>\n<td>의료기관 방문</td>\n</tr>\n<tr>\n<td>심한 알레르기 반응</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n<tr>\n<td>두드러기, 호흡 곤란</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n<tr>\n<td>경련, 의식 변화</td>\n<td><strong>즉시 응급실</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">아나필락시스 대비</h3>\n<ul>\n<li>접종 후 <strong>20~30분 대기</strong> 필수</li>\n<li>의료기관에서 관찰</li>\n<li>이상 시 즉시 의료진 호출</li>\n</ul>\n<hr>\n<h2 id=\"heading-29\">접종 불가 대상</h2>\n<h3 id=\"heading-30\">절대 금기</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>이유</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>이전 독감 백신 아나필락시스 경험자</td>\n<td>심각한 알레르기 위험</td>\n</tr>\n<tr>\n<td>백신 성분 알레르기</td>\n<td>성분 확인 필요</td>\n</tr>\n<tr>\n<td>생후 6개월 미만 영아</td>\n<td>안전성 미확립</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">주의 대상 (의사 상담 필요)</h3>\n<table>\n<thead>\n<tr>\n<th>대상</th>\n<th>상담 내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>계란 알레르기</td>\n<td>두드러기 정도면 접종 가능</td>\n</tr>\n<tr>\n<td>발열 환자</td>\n<td>열 내린 후 접종</td>\n</tr>\n<tr>\n<td>길랭-바레 증후군 병력</td>\n<td>개별 판단</td>\n</tr>\n<tr>\n<td>면역억제제 복용 중</td>\n<td>접종 시기 조정 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-32\">자주 묻는 질문 (FAQ)</h2>\n<h3 id=\"heading-33\">Q1. 매년 맞아야 하나요?</h3>\n<p><strong>네, 매년 접종해야 합니다.</strong></p>\n<ul>\n<li>인플루엔자 바이러스가 매년 변이</li>\n<li>백신 효과가 약 6개월</li>\n<li>매년 유행 바이러스에 맞춘 새 백신 개발</li>\n</ul>\n<h3 id=\"heading-34\">Q2. 코로나 백신과 함께 맞아도 되나요?</h3>\n<p><strong>네, 동시 접종 가능합니다.</strong></p>\n<ul>\n<li>다른 팔에 접종 권장</li>\n<li>부작용 발생 시 구분 어려울 수 있음</li>\n<li>개인 상황에 따라 의사와 상담</li>\n</ul>\n<h3 id=\"heading-35\">Q3. 접종해도 독감 걸리나요?</h3>\n<p><strong>걸릴 수 있지만, 증상이 가벼워집니다.</strong></p>\n<ul>\n<li>백신 효과: 약 40~60%</li>\n<li>중증, 합병증 예방 효과 높음</li>\n<li>입원, 사망 위험 크게 감소</li>\n</ul>\n<h3 id=\"heading-36\">Q4. 감기에 걸렸는데 맞아도 되나요?</h3>\n<p><strong>가벼운 감기는 접종 가능합니다.</strong></p>\n<ul>\n<li>발열 없는 경미한 증상: 접종 가능</li>\n<li>38도 이상 발열: 회복 후 접종</li>\n<li>의료진 판단 따르기</li>\n</ul>\n<h3 id=\"heading-37\">Q5. 임신 몇 개월에 맞는 게 좋나요?</h3>\n<p><strong>임신 중 언제든 접종 가능합니다.</strong></p>\n<ul>\n<li>임신 전 기간 안전</li>\n<li>태아에게도 항체 전달</li>\n<li>출산 후 신생아 보호 효과</li>\n</ul>\n<hr>\n<h2 id=\"heading-38\">2026년 독감 예방접종 체크리스트</h2>\n<h3 id=\"heading-39\">무료 접종 대상 확인</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 어린이 (생후 6개월~만 13세)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 임신부</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 만 65세 이상 어르신</li>\n</ul>\n<h3 id=\"heading-40\">접종 전 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 접종 가능 의료기관 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 예약 완료 (권장)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 준비물 챙기기 (신분증 등)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 컨디션 확인</li>\n</ul>\n<h3 id=\"heading-41\">접종 후 관리</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 20~30분 대기</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 접종 부위 청결 유지</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 충분한 휴식</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 이상 반응 시 의료기관 방문</li>\n</ul>\n<hr>\n<h2 id=\"heading-42\">마무리</h2>\n<p>독감 예방접종은 <strong>나와 가족을 지키는 가장 확실한 방법</strong>입니다.</p>\n<p>핵심 포인트:</p>\n<ol>\n<li><strong>무료 접종 대상</strong> 확인 (어린이, 임신부, 어르신)</li>\n<li><strong>10~11월</strong> 접종이 가장 효과적</li>\n<li>접종 후 <strong>20~30분 대기</strong> 필수</li>\n<li>매년 새로 접종 필요</li>\n</ol>\n<p>문의: 질병관리청 콜센터 <strong>1339</strong></p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/health-insurance-premium-2026\">2026년 건강보험료 변경사항 총정리</a></li>\n<li><a href=\"/posts/5th-generation-health-insurance-guide-2026\">2026년 5세대 실손보험 완벽 가이드</a></li>\n</ul>\n1d:[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\",\"dangerouslySetInnerHTML\":{\"__html\":\"$23\"}}]\n1e:[\"$\",\"nav\",null,{\"className\":\"border-t border-gray-200 pt-8 mt-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L6\",null,{\"href\":\"/posts/ev-subsidy-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"이전 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 전기차 보조금 완벽 가이드: 차종별 지원금, 신청방법 총정리\"}]]}],[\"$\",\"$L6\",null,{\"href\":\"/posts/health-insurance-premium-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"다음 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 건강보험료 변경사항 총정리: 인상률, 계산법, 절약 팁까지\"}]]}]]}]}]\n1f:[\"$\",\"section\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-200\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-gray-900 mb-6\",\"children\":\"관련 게시글\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L6\",\"health-insurance-premium-2026\",{\"href\":\"/posts/health-insurance-premium-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"2026년 건강보험료 변경사항 총정리: 인상률, 계산법, 절약 팁까지\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 1월부터 적용되는 건강보험료 변경사항을 정리했습니다. 직장가입자와 지역가입자별 보험료 계산법, 인상 내역, 절약 방법까지 알려드립니다.\"}]]}],[\"$\",\"$L6\",\"2026-new-year-diet-plan\",{\"href\":\"/posts/2026-new-year-diet-plan\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"신년 다이어트 식단: 건강하게 살 빼는 4주 식단표 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"새해 다이어트 결심하셨나요? 무리하지 않고 건강하게 살 빼는 4주 식단표와 실천 가능한 다이어트 팁을 정리했습니다. 요요 없는 체중 감량 시작하세요.\"}]]}],[\"$\",\"$L6\",\"self-employed-tax-guide-2026\",{\"href\":\"/posts/self-employed-tax-guide-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\"}]]}]]}]]}]\n"}