\"\\u003e소득공제 vs 세액공제\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e차이점 이해하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e소득공제\\u003c/th\\u003e\\n\\u003cth\\u003e세액공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정의\\u003c/td\\u003e\\n\\u003ctd\\u003e소득에서 빼주는 것\\u003c/td\\u003e\\n\\u003ctd\\u003e세금에서 빼주는 것\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e효과\\u003c/td\\u003e\\n\\u003ctd\\u003e과세표준 감소\\u003c/td\\u003e\\n\\u003ctd\\u003e납부세액 감소\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e절세효과\\u003c/td\\u003e\\n\\u003ctd\\u003e세율에 따라 다름\\u003c/td\\u003e\\n\\u003ctd\\u003e금액 그대로 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e예시\\u003c/td\\u003e\\n\\u003ctd\\u003e신용카드, 보험료\\u003c/td\\u003e\\n\\u003ctd\\u003e의료비, 교육비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e예시로 이해하기\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e연봉 5,000만 원, 소득공제 100만 원 vs 세액공제 100만 원\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e공제 유형\\u003c/th\\u003e\\n\\u003cth\\u003e계산\\u003c/th\\u003e\\n\\u003cth\\u003e절세 효과\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득공제 100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원 × 세율 24%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e24만 원\\u003c/strong\\u003e 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세액공제 100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원 그대로\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e100만 원\\u003c/strong\\u003e 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e→ \\u003cstrong\\u003e세액공제가 더 유리!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-9\\\"\\u003e주요 공제 항목 총정리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e1. 인적공제\\u003c/h3\\u003e\\n\\u003ch4\\u003e기본공제 (1인당 150만 원)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e나이 요건\\u003c/th\\u003e\\n\\u003cth\\u003e소득 요건\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e본인\\u003c/td\\u003e\\n\\u003ctd\\u003e없음\\u003c/td\\u003e\\n\\u003ctd\\u003e없음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e배우자\\u003c/td\\u003e\\n\\u003ctd\\u003e없음\\u003c/td\\u003e\\n\\u003ctd\\u003e연 100만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부모님\\u003c/td\\u003e\\n\\u003ctd\\u003e만 60세 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e연 100만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자녀\\u003c/td\\u003e\\n\\u003ctd\\u003e만 20세 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e연 100만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e형제자매\\u003c/td\\u003e\\n\\u003ctd\\u003e만 20세 이하 or 60세 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e연 100만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e추가공제\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e공제액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e경로우대 (만 70세 이상)\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장애인\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부녀자 (여성 세대주/배우자 있는 여성)\\u003c/td\\u003e\\n\\u003ctd\\u003e50만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한부모\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e2. 신용카드 등 사용액 공제\\u003c/h3\\u003e\\n\\u003ch4\\u003e공제 조건\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최저 사용액\\u003c/td\\u003e\\n\\u003ctd\\u003e총급여의 25% 초과분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원 (총급여 7천만 원 이하)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e결제 수단별 공제율\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e결제 수단\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003cth\\u003e추가 공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용카드\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체크카드/현금영수증\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전통시장\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e50%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e+100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대중교통\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e80%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e+100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문화비 (영화, 공연, 도서)\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e40%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e+100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e절세 전략\\u003c/h4\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e총급여 25%까지\\u003c/strong\\u003e: 신용카드 사용 (포인트/혜택)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e25% 초과분\\u003c/strong\\u003e: 체크카드/현금영수증 사용 (공제율 2배)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e추가 공제\\u003c/strong\\u003e: 전통시장, 대중교통, 문화비 적극 활용\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003e3. 보험료 공제\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일반 보장성 보험\\u003c/td\\u003e\\n\\u003ctd\\u003e12%\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장애인 전용 보험\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e공제 대상 보험\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e생명보험, 상해보험\\u003c/li\\u003e\\n\\u003cli\\u003e자동차보험 (본인 명의)\\u003c/li\\u003e\\n\\u003cli\\u003e화재보험 등\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e4. 의료비 공제\\u003c/h3\\u003e\\n\\u003ch4\\u003e공제 조건\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최저 부담액\\u003c/td\\u003e\\n\\u003ctd\\u003e총급여의 3% 초과분\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e한도\\u003c/td\\u003e\\n\\u003ctd\\u003e700만 원 (일반), 무한도 (난임/장애인/65세 이상)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e공제 대상 의료비\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e포함\\u003c/th\\u003e\\n\\u003cth\\u003e미포함\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e진료비, 수술비\\u003c/td\\u003e\\n\\u003ctd\\u003e미용성형\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e약값, 한약\\u003c/td\\u003e\\n\\u003ctd\\u003e건강기능식품\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e안경, 콘택트렌즈 (50만 원 한도)\\u003c/td\\u003e\\n\\u003ctd\\u003e보험금으로 보전받은 금액\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보청기, 휠체어\\u003c/td\\u003e\\n\\u003ctd\\u003e간병비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e5. 교육비 공제\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e대상\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e본인\\u003c/td\\u003e\\n\\u003ctd\\u003e무제한\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취학 전 아동\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e초·중·고등학생\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대학생\\u003c/td\\u003e\\n\\u003ctd\\u003e900만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e공제 대상 교육비\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e포함\\u003c/th\\u003e\\n\\u003cth\\u003e미포함\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수업료, 입학금\\u003c/td\\u003e\\n\\u003ctd\\u003e학원비 (초등학생 이상)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e급식비, 교과서비\\u003c/td\\u003e\\n\\u003ctd\\u003e유학 준비 어학원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e학교 방과후 활동\\u003c/td\\u003e\\n\\u003ctd\\u003e개인 과외비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e유치원비\\u003c/td\\u003e\\n\\u003ctd\\u003e교복 (선택)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e6. 주거 관련 공제\\u003c/h3\\u003e\\n\\u003ch4\\u003e주택청약종합저축\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e300만 원\\u003c/strong\\u003e (2026년 상향)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최대 공제액\\u003c/td\\u003e\\n\\u003ctd\\u003e120만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e조건\\u003c/td\\u003e\\n\\u003ctd\\u003e무주택 세대주, 총급여 7천만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e월세 세액공제\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e2025년\\u003c/th\\u003e\\n\\u003cth\\u003e2026년 (상향)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e750만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1,000만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e15~17%\\u003c/td\\u003e\\n\\u003ctd\\u003e15~17%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e조건\\u003c/td\\u003e\\n\\u003ctd\\u003e무주택 세대주, 총급여 8천만 원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e월세 환급액 예시\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e월세 70만 원 × 12개월 = 840만 원\\u003c/li\\u003e\\n\\u003cli\\u003e세액공제: 840만 원 × 17% = \\u003cstrong\\u003e142.8만 원 환급!\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e주택담보대출 이자 공제\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e주택 기준시가\\u003c/th\\u003e\\n\\u003cth\\u003e공제 한도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5억 원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e300~1,800만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3억 원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e1,500~1,800만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e7. 기부금 공제\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003cth\\u003e한도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e법정 기부금\\u003c/td\\u003e\\n\\u003ctd\\u003e15~25%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득의 100%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지정 기부금 (종교)\\u003c/td\\u003e\\n\\u003ctd\\u003e15~25%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득의 10%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지정 기부금 (그 외)\\u003c/td\\u003e\\n\\u003ctd\\u003e15~25%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득의 30%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e공제율\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e1,000만 원 이하: 15%\\u003c/li\\u003e\\n\\u003cli\\u003e1,000만 원 초과: 25%\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e8. 연금저축 공제\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e600만 원 (연금저축 400만 원 + IRP 200만 원)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e12~15%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최대 공제액\\u003c/td\\u003e\\n\\u003ctd\\u003e90만 원 (연금저축) + 30만 원 (IRP)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e총급여별 공제율\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e5,500만 원 이하: 15%\\u003c/li\\u003e\\n\\u003cli\\u003e5,500만 원 초과: 12%\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-18\\\"\\u003e연말정산 꿀팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e환급 많이 받는 방법\\u003c/h3\\u003e\\n\\u003ch4\\u003e1. 신용카드 전략\\u003c/h4\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e1~6월: 신용카드 (총급여 25%까지)\\n7~12월: 체크카드/현금영수증 (공제율 2배)\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch4\\u003e2. 맞벌이 부부 전략\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상황\\u003c/th\\u003e\\n\\u003cth\\u003e전략\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득 차이 큼\\u003c/td\\u003e\\n\\u003ctd\\u003e고소득자에게 공제 몰기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e의료비\\u003c/td\\u003e\\n\\u003ctd\\u003e저소득자 명의로 (3% 기준 낮추기)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용카드\\u003c/td\\u003e\\n\\u003ctd\\u003e고소득자 명의로 (한도 채우기)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보험료\\u003c/td\\u003e\\n\\u003ctd\\u003e고소득자 명의로\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e3. 놓치기 쉬운 공제\\u003c/h4\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 안경/콘택트렌즈 구입비\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 대중교통비 (80% 공제!)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 전통시장 사용액 (50% 공제!)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 문화비 (영화, 공연, 도서 - 40% 공제!)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 월세 (세액공제 17%까지)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 기부금 (종교, 사회단체)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 장애인 의료비 (한도 없음)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e간소화 서비스 활용\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e홈택스 접속 (\\u003ca href=\\\"http://www.hometax.go.kr\\\"\\u003ewww.hometax.go.kr\\u003c/a\\u003e)\\u003c/li\\u003e\\n\\u003cli\\u003e연말정산 간소화 서비스 클릭\\u003c/li\\u003e\\n\\u003cli\\u003e공동인증서/금융인증서 로그인\\u003c/li\\u003e\\n\\u003cli\\u003e조회 연도 선택 → 한 번에 조회\\u003c/li\\u003e\\n\\u003cli\\u003ePDF 다운로드 → 회사 제출\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e수동 제출 필요 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e제출 서류\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월세\\u003c/td\\u003e\\n\\u003ctd\\u003e임대차계약서 + 계좌이체 내역\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기부금\\u003c/td\\u003e\\n\\u003ctd\\u003e기부금 영수증\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e해외 의료비\\u003c/td\\u003e\\n\\u003ctd\\u003e현지 영수증 + 번역본\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교복 구입비\\u003c/td\\u003e\\n\\u003ctd\\u003e영수증\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장애인 증명\\u003c/td\\u003e\\n\\u003ctd\\u003e장애인 증명서\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003eQ1. 중도 입사자도 연말정산 하나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e현 직장에서 연말정산\\u003c/li\\u003e\\n\\u003cli\\u003e전 직장 원천징수영수증 제출\\u003c/li\\u003e\\n\\u003cli\\u003e12월까지 재직한 경우 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003eQ2. 퇴사했는데 연말정산 어떻게 하나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e5월 종합소득세 신고로 합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e홈택스에서 직접 신고\\u003c/li\\u003e\\n\\u003cli\\u003e퇴사 후 12월 31일까지 미취업 시\\u003c/li\\u003e\\n\\u003cli\\u003e중도 퇴사 원천징수영수증 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003eQ3. 부모님 공제 형제와 중복 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e아니요, 한 명만 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e형제 중 한 명만 부모님 공제\\u003c/li\\u003e\\n\\u003cli\\u003e사전에 협의 필요\\u003c/li\\u003e\\n\\u003cli\\u003e중복 시 가산세 발생\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003eQ4. 맞벌이인데 자녀 공제 누가 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e협의해서 한 명이 받습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e일반적으로 고소득자가 유리\\u003c/li\\u003e\\n\\u003cli\\u003e중복 공제 불가\\u003c/li\\u003e\\n\\u003cli\\u003e의료비, 교육비도 함께 이동\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003eQ5. 신용카드 공제 얼마나 받을 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e총급여의 25% 초과분에 대해 공제\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e연봉 5천만 원: 1,250만 원 초과분부터\\u003c/li\\u003e\\n\\u003cli\\u003e공제 한도 300만 원\\u003c/li\\u003e\\n\\u003cli\\u003e전통시장/대중교통/문화비 추가 한도\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-28\\\"\\u003e2026년 연말정산 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e제출 전 확인\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 간소화 서비스 PDF 다운로드\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 누락 항목 확인 (월세, 기부금 등)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 가족 공제 중복 확인\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 부양가족 소득 요건 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e추가 절세 검토\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 연금저축 추가 납입 (12월까지)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e IRP 추가 납입 (12월까지)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 주택청약 납입액 확인\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 기부금 추가 고려\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e연말정산은 \\u003cstrong\\u003e아는 만큼 환급\\u003c/strong\\u003e받습니다!\\u003c/p\\u003e\\n\\u003cp\\u003e핵심 정리:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e달라진 점\\u003c/strong\\u003e 꼭 확인 (월세 한도 상향 등)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e신용카드 전략\\u003c/strong\\u003e 적극 활용\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e놓치기 쉬운 공제\\u003c/strong\\u003e 챙기기\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e간소화 서비스\\u003c/strong\\u003e 1월 15일부터 이용\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e궁금한 점은 국세청 콜센터 \\u003cstrong\\u003e126\\u003c/strong\\u003e으로 문의하세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/minimum-wage-2026\\\"\\u003e2026년 최저임금 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/health-insurance-premium-2026\\\"\\u003e2026년 건강보험료 변경사항 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$23\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"