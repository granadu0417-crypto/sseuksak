\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e기본 개념\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e1년간 급여에서 원천징수한 세금과 실제 내야 할 세금을 비교해 정산하는 것\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e더 냈으면\\u003c/strong\\u003e: 환급 (13월의 월급)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e덜 냈으면\\u003c/strong\\u003e: 추가 납부 (13월의 세금)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e연말정산 일정\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e일정\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년 1월 15일\\u003c/td\\u003e\\n\\u003ctd\\u003e간소화 서비스 오픈\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1월 15일~18일\\u003c/td\\u003e\\n\\u003ctd\\u003e간소화 자료 조회/수정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1월 20일~\\u003c/td\\u003e\\n\\u003ctd\\u003e회사에 자료 제출\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2월 말\\u003c/td\\u003e\\n\\u003ctd\\u003e환급/추가납부 반영\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3월 10일까지\\u003c/td\\u003e\\n\\u003ctd\\u003e회사의 원천세 신고 마감\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e2026년 달라진 점\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e주요 변경 사항\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e2025년\\u003c/th\\u003e\\n\\u003cth\\u003e2026년 (2025년 귀속)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용카드 공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e300만 원\\u003c/strong\\u003e (유지)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전통시장 공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e50%\\u003c/strong\\u003e (상향)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대중교통 공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e80%\\u003c/strong\\u003e (유지)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e문화비 공제율\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e40%\\u003c/strong\\u003e (상향)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주택청약 공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e240만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e300만 원\\u003c/strong\\u003e (상향)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월세 세액공제 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e750만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1,000만 원\\u003c/strong\\u003e (상향)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e신설된 공제 항목\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e반려동물 의료비\\u003c/td\\u003e\\n\\u003ctd\\u003e연 100만 원 한도 (시범 적용)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e친환경차 충전비\\u003c/td\\u003e\\n\\u003ctd\\u003e연 200만 원 한도\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e육아휴직 급여 비과세\\u003c/td\\u003e\\n\\u003ctd\\u003e월 200만 원까지\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e소득공제 vs 세액공제\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e차이점 이해하기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e소득공제\\u003c/th\\u003e\\n\\u003cth\\u003e세액공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정의\\u003c/td\\u003e\\n\\u003ctd\\u003e소득에서 빼주는 것\\u003c/td\\u003e\\n\\u003ctd\\u003e세금에서 빼주는 것\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e효과\\u003c/td\\u003e\\n\\u003ctd\\u003e과세표준 감소\\u003c/td\\u003e\\n\\u003ctd\\u003e납부세액 감소\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e절세효과\\u003c/td\\u003e\\n\\u003ctd\\u003e세율에 따라 다름\\u003c/td\\u003e\\n\\u003ctd\\u003e금액 그대로 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e예시\\u003c/td\\u003e\\n\\u003ctd\\u003e신용카드, 보험료\\u003c/td\\u003e\\n\\u003ctd\\u003e의료비, 교육비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e예시로 이해하기\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e연봉 5,000만 원, 소득공제 100만 원 vs 세액공제 100만 원\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e공제 유형\\u003c/th\\u003e\\n\\u003cth\\u003e계산\\u003c/th\\u003e\\n\\u003cth\\u003e절세 효과\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득공제 100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원 × 세율 24%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e24만 원\\u003c/strong\\u003e 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세액공제 100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원 그대로\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e100만 원\\u003c/strong\\u003e 절세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e→ \\u003cstrong\\u003e세액공제가 더 유리!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003chr\\u0