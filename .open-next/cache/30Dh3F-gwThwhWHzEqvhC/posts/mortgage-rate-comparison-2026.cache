}],[\\\"$\\\",\\\"a\\\",\\\"DSR\\\",{\\\"href\\\":\\\"/tag/DSR\\\",\\\"className\\\":\\\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\\\",\\\"children\\\":[\\\"#\\\",\\\"DSR\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"대출금리비교\\\",{\\\"href\\\":\\\"/tag/대출금리비교\\\",\\\"className\\\":\\\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\\\",\\\"children\\\":[\\\"#\\\",\\\"대출금리비교\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"스트레스DSR\\\",{\\\"href\\\":\\\"/tag/스트레스DSR\\\",\\\"className\\\":\\\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\\\",\\\"children\\\":[\\\"#\\\",\\\"스트레스DSR\\\"]}],[\\\"$\\\",\\\"a\\\",\\\"2026년대출\\\",{\\\"href\\\":\\\"/tag/2026년대출\\\",\\\"className\\\":\\\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\\\",\\\"children\\\":[\\\"#\\\",\\\"2026년대출\\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative w-full h-64 md:h-96 mb-8 rounded-lg overflow-hidden\\\",\\\"children\\\":[\\\"$L1a\\\",\\\"$L1b\\\"]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\"]}]]\\n\"])</script><script>self.__next_f.push([1,\"20:I[1356,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"Image\\\"]\\n21:I[286,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"default\\\"]\\n1a:[\\\"$\\\",\\\"$L20\\\",null,{\\\"src\\\":\\\"https://images.unsplash.com/photo-1559067096-49ebca3406aa?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODZ8MA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\",\\\"alt\\\":\\\"주택담보대출 금리 비교 완벽 가이드\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 768px) 100vw, 896px\\\",\\\"className\\\":\\\"object-cover\\\",\\\"priority\\\":true}]\\n1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://unsplash.com/@precondo?utm_source=sseuksak\\u0026utm_medium=referral\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Photo by Precondo CA on Unsplash\\\"}]}]\\n22:T2c39,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 주택담보대출 금리 비교 완벽 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e2026년 주택담보대출을 계획하고 계신가요? 금리 인하 기대감과 함께 스트레스 DSR 3단계 시행으로 대출 환경이 크게 변화했습니다. 이 글에서는 \\u003cstrong\\u003e최신 금리 정보\\u003c/strong\\u003e와 \\u003cstrong\\u003e은행별 비교\\u003c/strong\\u003e, 그리고 \\u003cstrong\\u003e최저금리를 받는 방법\\u003c/strong\\u003e까지 상세하게 안내해 드립니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e2026년 주담대 금리 현황\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한국주택금융공사 보금자리론\\u003c/h3\\u003e\\n\\u003cp\\u003e정책 모기지 상품인 보금자리론의 2026년 1월 기준 금리입니다.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상환 방식\\u003c/th\\u003e\\n\\u003cth\\u003e금리 범위\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e원리금균등분할상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 3.90% ~ 4.20%\\u003c/td\\u003e\\n\\u003ctd\\u003e고정금리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체증식상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 4.00% ~ 4.30%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득증가 예상 시 유리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e보금자리론 자격 요건\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상 주택\\u003c/td\\u003e\\n\\u003ctd\\u003e6억원 이하 (신혼가구 7억원)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득 요건\\u003c/td\\u003e\\n\\u003ctd\\u003e부부합산 연 7,000만원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 3.6억원 (LTV 70%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상환 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e10년 ~ 50년\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 \\u003cstrong\\u003eTip\\u003c/strong\\u003e: 보금자리론은 고정금리 상품으로 금리 변동 리스크가 없습니다. 장기 상환 계획이 있다면 적극 고려하세요.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e시중은행 주담대 금리 비교\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e5대 시중은행 금리 (2026년 1월 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행\\u003c/th\\u003e\\n\\u003cth\\u003e변동금리\\u003c/th\\u003e\\n\\u003cth\\u003e고정금리(5년)\\u003c/th\\u003e\\n\\u003cth\\u003e혼합금리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKB국민은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.05% ~ 5.85%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.20% ~ 5.50%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.15% ~ 5.70%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신한은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.10% ~ 5.90%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.25% ~ 5.55%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.20% ~ 5.75%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e하나은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.08% ~ 5.88%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.22% ~ 5.52%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.18% ~ 5.72%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e우리은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.12% ~ 5.92%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.28% ~ 5.58%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.22% ~ 5.78%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eNH농협\\u003c/td\\u003e\\n\\u003ctd\\u003e4.00% ~ 5.80%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.18% ~ 5.48%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.12% ~ 5.68%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e인터넷전문은행 금리\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행\\u003c/th\\u003e\\n\\u003cth\\u003e변동금리\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e카카오뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e3.95% ~ 5.75%\\u003c/td\\u003e\\n\\u003ctd\\u003e비대면 신청, 빠른 심사\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e토스뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e3.98% ~ 5.78%\\u003c/td\\u003e\\n\\u003ctd\\u003e중도상환수수료 면제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e케이뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e4.02% ~ 5.82%\\u003c/td\\u003e\\n\\u003ctd\\u003e급여이체 시 우대금리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e⚠️ \\u003cstrong\\u003e주의\\u003c/strong\\u003e: 위 금리는 우대금리 적용 전 기준입니다. 급여이체, 카드 사용 등 조건 충족 시 0.3%~0.8% 추가 인하 가능합니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e스트레스 DSR 3단계 완전 정복\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003eDSR이란?\\u003c/h3\\u003e\\n\\u003cp\\u003e**DSR(총부채원리금상환비율)**은 모든 대출의 연간 원리금 상환액을 연 소득으로 나눈 비율입니다.\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003eDSR = (모든 대출 연간 원리금 상환액 ÷ 연 소득) × 100\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e스트레스 DSR 적용 현황\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e단계\\u003c/th\\u003e\\n\\u003cth\\u003e시행일\\u003c/th\\u003e\\n\\u003cth\\u003e수도권\\u003c/th\\u003e\\n\\u003cth\\u003e지방\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1단계\\u003c/td\\u003e\\n\\u003ctd\\u003e2024.02\\u003c/td\\u003e\\n\\u003ctd\\u003e0.38%\\u003c/td\\u003e\\n\\u003ctd\\u003e0.38%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2단계\\u003c/td\\u003e\\n\\u003ctd\\u003e2024.09\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e0.75%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3단계\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2025.07\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3.0%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1.5%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e지방 주담대 유예 조치\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📢 \\u003cstrong\\u003e중요\\u003c/strong\\u003e: 금융위원회는 지방 부동산 시장 침체를 고려하여 \\u003cstrong\\u003e지방 주담대에 대해 2단계 스트레스 금리(0.75%)를 2026년 6월까지 적용\\u003c/strong\\u003e합니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e수도권\\u003c/th\\u003e\\n\\u003cth\\u003e지방\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현재 적용\\u003c/td\\u003e\\n\\u003ctd\\u003e3단계 (3.0%)\\u003c/td\\u003e\\n\\u003ctd\\u003e2단계 유예 (0.75%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년 7월 이후\\u003c/td\\u003e\\n\\u003ctd\\u003e3.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-10\\\"\\u003e대출 한도 계산 방법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003eDSR 40% 기준 한도 계산\\u003c/h3\\u003e\\n\\u003cp\\u003e연소득 6,000만원, 30년 상환, 금리 4.5% 가정 시:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eDSR\\u003c/th\\u003e\\n\\u003cth\\u003e연간 상환 가능액\\u003c/th\\u003e\\n\\u003cth\\u003e대출 가능 금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e2,400만원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 4.7억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e3,000만원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 5.9억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003eLTV(주택담보인정비율) 한도\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e규제지역\\u003c/th\\u003e\\n\\u003cth\\u003e비규제지역\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e70%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e60%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e불가\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e실제 한도 = min(DSR 한도, LTV 한도)\\u003c/h3\\u003e\\n\\u003cp\\u003e예시) 시가 7억원 아파트, 연소득 6,000만원, 무주택자, 비규제지역\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eLTV 한도: 7억 × 70% = 4.9억원\\u003c/li\\u003e\\n\\u003cli\\u003eDSR 한도: 약 4.7억원\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e실제 한도: 4.7억원\\u003c/strong\\u003e (DSR 기준)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-14\\\"\\u003e최저 금리 받는 7가지 방법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e1. 우대금리 조건 최대한 활용\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e우대 폭\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e급여이체\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적금/예금 연계\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용카드 사용\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자동이체 3건 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e비대면 신청\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e2. 고정 vs 변동금리 선택\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e금리 유형\\u003c/th\\u003e\\n\\u003cth\\u003e추천 상황\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고정금리\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 상승 예상, 안정적 상환 원할 때\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e변동금리\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 하락 예상, 조기 상환 계획 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e혼합금리\\u003c/td\\u003e\\n\\u003ctd\\u003e초기 5년 고정 후 변동, 균형잡힌 선택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e3. 대환대출 검토\\u003c/h3\\u003e\\n\\u003cp\\u003e기존 대출 금리가 현재 금리보다 \\u003cstrong\\u003e0.5% 이상 높다면\\u003c/strong\\u003e 대환대출을 고려하세요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e4. 특례보금자리론 활용\\u003c/h3\\u003e\\n\\u003cp\\u003e소득 요건 충족 시 시중금리보다 \\u003cstrong\\u003e1~2% 낮은 금리\\u003c/strong\\u003e로 이용 가능합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e5. 신용점수 관리\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e신용점수\\u003c/th\\u003e\\n\\u003cth\\u003e금리 영향\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e900점 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e최저금리 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e800~899점\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.1% ~ 0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e700~799점\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.3% ~ 0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e6. 중도상환수수료 확인\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행 유형\\u003c/th\\u003e\\n\\u003cth\\u003e중도상환수수료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시중은행\\u003c/td\\u003e\\n\\u003ctd\\u003e잔여 원금의 1.2~1.4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인터넷은행\\u003c/td\\u003e\\n\\u003ctd\\u003e0% ~ 1.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보금자리론\\u003c/td\\u003e\\n\\u003ctd\\u003e3년 이내 1.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e7. 여러 은행 동시 비교\\u003c/h3\\u003e\\n\\u003cp\\u003e금융감독원 \\u003cstrong\\u003e금융상품 한눈에\\u003c/strong\\u003e 서비스를 활용하면 전 금융기관의 대출금리를 한번에 비교할 수 있습니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e2026년 주담대 신청 시 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e필수 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e서류\\u003c/th\\u003e\\n\\u003cth\\u003e용도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증\\u003c/td\\u003e\\n\\u003ctd\\u003e본인 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득증빙 (원천징수영수증, 소득금액증명원)\\u003c/td\\u003e\\n\\u003ctd\\u003eDSR 계산\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재직증명서\\u003c/td\\u003e\\n\\u003ctd\\u003e직장 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e등기부등본\\u003c/td\\u003e\\n\\u003ctd\\u003e담보물 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주민등록등본\\u003c/td\\u003e\\n\\u003ctd\\u003e세대 구성 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKB시세 또는 감정평가서\\u003c/td\\u003e\\n\\u003ctd\\u003eLTV 산정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e신청 프로세스\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e1. 금리 비교 및 은행 선택 (1~2일)\\n   ↓\\n2. 사전 상담 및 한도 조회 (당일)\\n   ↓\\n3. 정식 신청 및 서류 제출 (1~2일)\\n   ↓\\n4. 심사 및 감정평가 (3~7일)\\n   ↓\\n5. 대출 승인 및 실행 (1~2일)\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e주담대 금리 전망\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e2026년 하반기 전망\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e요인\\u003c/th\\u003e\\n\\u003cth\\u003e방향\\u003c/th\\u003e\\n\\u003cth\\u003e영향\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기준금리\\u003c/td\\u003e\\n\\u003ctd\\u003e인하 예상\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 하락 요인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가계부채 관리\\u003c/td\\u003e\\n\\u003ctd\\u003e강화\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 상승 압력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부동산 시장\\u003c/td\\u003e\\n\\u003ctd\\u003e지역별 차별화\\u003c/td\\u003e\\n\\u003ctd\\u003e혼조세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📊 \\u003cstrong\\u003e전문가 전망\\u003c/strong\\u003e: 2026년 하반기 기준금리 추가 인하 시 주담대 금리 0.25%~0.5% 추가 하락 가능성이 있습니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003e자주 묻는 질문\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003eQ1. 스트레스 DSR로 대출이 줄었는데, 방법이 없나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 다음 방법을 고려해보세요:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e상환 기간 연장 (30년 → 40년)\\u003c/li\\u003e\\n\\u003cli\\u003e기존 대출 상환 후 신규 대출\\u003c/li\\u003e\\n\\u003cli\\u003e보금자리론 등 정책대출 활용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003eQ2. 변동금리 vs 고정금리, 지금은 어떤 게 유리한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 현재 금리 인하 사이클 초입으로 \\u003cstrong\\u003e변동금리\\u003c/strong\\u003e가 단기적으로 유리할 수 있으나, 안정성을 원한다면 \\u003cstrong\\u003e혼합금리\\u003c/strong\\u003e(5년 고정 후 변동)를 추천합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ3. 지방 아파트 매수 시 유리한 점이 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 네, 2026년 6월까지 \\u003cstrong\\u003e스트레스 DSR 2단계 적용\\u003c/strong\\u003e으로 수도권 대비 대출 한도가 더 높게 나옵니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 주택담보대출 시장은 \\u003cstrong\\u003e스트레스 DSR 3단계\\u003c/strong\\u003e와 \\u003cstrong\\u003e금리 인하 기대\\u003c/strong\\u003e가 공존하는 복잡한 환경입니다. 최저 금리를 받기 위해서는:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e✅ 여러 은행 금리 비교 필수\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 우대금리 조건 최대한 활용\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 보금자리론 등 정책대출 검토\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 스트레스 DSR 한도 사전 계산\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 신용점수 관리\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e신중한 비교와 준비로 나에게 맞는 최적의 주담대를 찾으시기 바랍니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 전세대출 조건 비교\\u003c/li\\u003e\\n\\u003cli\\u003e청년 주거 지원 정책 총정리\\u003c/li\\u003e\\n\\u003cli\\u003eDSR 계산기 사용법\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었으며, 금리는 시장 상황에 따라 변동될 수 있습니다. 정확한 금리는 해당 금융기관에 직접 문의하시기 바랍니다.\\u003c/em\\u003e\\u003c/p\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L21\\\",null,{\\\"content\\\":\\\"$22\\\"}]\\n23:T2c39,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 주택담보대출 금리 비교 완벽 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e2026년 주택담보대출을 계획하고 계신가요? 금리 인하 기대감과 함께 스트레스 DSR 3단계 시행으로 대출 환경이 크게 변화했습니다. 이 글에서는 \\u003cstrong\\u003e최신 금리 정보\\u003c/strong\\u003e와 \\u003cstrong\\u003e은행별 비교\\u003c/strong\\u003e, 그리고 \\u003cstrong\\u003e최저금리를 받는 방법\\u003c/strong\\u003e까지 상세하게 안내해 드립니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e2026년 주담대 금리 현황\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한국주택금융공사 보금자리론\\u003c/h3\\u003e\\n\\u003cp\\u003e정책 모기지 상품인 보금자리론의 2026년 1월 기준 금리입니다.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상환 방식\\u003c/th\\u003e\\n\\u003cth\\u003e금리 범위\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e원리금균등분할상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 3.90% ~ 4.20%\\u003c/td\\u003e\\n\\u003ctd\\u003e고정금리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e체증식상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 4.00% ~ 4.30%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득증가 예상 시 유리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e보금자리론 자격 요건\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상 주택\\u003c/td\\u003e\\n\\u003ctd\\u003e6억원 이하 (신혼가구 7억원)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득 요건\\u003c/td\\u003e\\n\\u003ctd\\u003e부부합산 연 7,000만원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 3.6억원 (LTV 70%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상환 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e10년 ~ 50년\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 \\u003cstrong\\u003eTip\\u003c/strong\\u003e: 보금자리론은 고정금리 상품으로 금리 변동 리스크가 없습니다. 장기 상환 계획이 있다면 적극 고려하세요.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e시중은행 주담대 금리 비교\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e5대 시중은행 금리 (2026년 1월 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행\\u003c/th\\u003e\\n\\u003cth\\u003e변동금리\\u003c/th\\u003e\\n\\u003cth\\u003e고정금리(5년)\\u003c/th\\u003e\\n\\u003cth\\u003e혼합금리\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKB국민은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.05% ~ 5.85%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.20% ~ 5.50%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.15% ~ 5.70%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신한은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.10% ~ 5.90%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.25% ~ 5.55%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.20% ~ 5.75%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e하나은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.08% ~ 5.88%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.22% ~ 5.52%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.18% ~ 5.72%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e우리은행\\u003c/td\\u003e\\n\\u003ctd\\u003e4.12% ~ 5.92%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.28% ~ 5.58%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.22% ~ 5.78%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eNH농협\\u003c/td\\u003e\\n\\u003ctd\\u003e4.00% ~ 5.80%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.18% ~ 5.48%\\u003c/td\\u003e\\n\\u003ctd\\u003e4.12% ~ 5.68%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e인터넷전문은행 금리\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행\\u003c/th\\u003e\\n\\u003cth\\u003e변동금리\\u003c/th\\u003e\\n\\u003cth\\u003e특징\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e카카오뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e3.95% ~ 5.75%\\u003c/td\\u003e\\n\\u003ctd\\u003e비대면 신청, 빠른 심사\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e토스뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e3.98% ~ 5.78%\\u003c/td\\u003e\\n\\u003ctd\\u003e중도상환수수료 면제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e케이뱅크\\u003c/td\\u003e\\n\\u003ctd\\u003e4.02% ~ 5.82%\\u003c/td\\u003e\\n\\u003ctd\\u003e급여이체 시 우대금리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e⚠️ \\u003cstrong\\u003e주의\\u003c/strong\\u003e: 위 금리는 우대금리 적용 전 기준입니다. 급여이체, 카드 사용 등 조건 충족 시 0.3%~0.8% 추가 인하 가능합니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e스트레스 DSR 3단계 완전 정복\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003eDSR이란?\\u003c/h3\\u003e\\n\\u003cp\\u003e**DSR(총부채원리금상환비율)**은 모든 대출의 연간 원리금 상환액을 연 소득으로 나눈 비율입니다.\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003eDSR = (모든 대출 연간 원리금 상환액 ÷ 연 소득) × 100\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e스트레스 DSR 적용 현황\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e단계\\u003c/th\\u003e\\n\\u003cth\\u003e시행일\\u003c/th\\u003e\\n\\u003cth\\u003e수도권\\u003c/th\\u003e\\n\\u003cth\\u003e지방\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1단계\\u003c/td\\u003e\\n\\u003ctd\\u003e2024.02\\u003c/td\\u003e\\n\\u003ctd\\u003e0.38%\\u003c/td\\u003e\\n\\u003ctd\\u003e0.38%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2단계\\u003c/td\\u003e\\n\\u003ctd\\u003e2024.09\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e0.75%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3단계\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2025.07\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3.0%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1.5%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e지방 주담대 유예 조치\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📢 \\u003cstrong\\u003e중요\\u003c/strong\\u003e: 금융위원회는 지방 부동산 시장 침체를 고려하여 \\u003cstrong\\u003e지방 주담대에 대해 2단계 스트레스 금리(0.75%)를 2026년 6월까지 적용\\u003c/strong\\u003e합니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e수도권\\u003c/th\\u003e\\n\\u003cth\\u003e지방\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현재 적용\\u003c/td\\u003e\\n\\u003ctd\\u003e3단계 (3.0%)\\u003c/td\\u003e\\n\\u003ctd\\u003e2단계 유예 (0.75%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년 7월 이후\\u003c/td\\u003e\\n\\u003ctd\\u003e3.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e1.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-10\\\"\\u003e대출 한도 계산 방법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003eDSR 40% 기준 한도 계산\\u003c/h3\\u003e\\n\\u003cp\\u003e연소득 6,000만원, 30년 상환, 금리 4.5% 가정 시:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003eDSR\\u003c/th\\u003e\\n\\u003cth\\u003e연간 상환 가능액\\u003c/th\\u003e\\n\\u003cth\\u003e대출 가능 금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e2,400만원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 4.7억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e3,000만원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 5.9억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-12\\\"\\u003eLTV(주택담보인정비율) 한도\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e규제지역\\u003c/th\\u003e\\n\\u003cth\\u003e비규제지역\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e무주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e70%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003ctd\\u003e60%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e불가\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e실제 한도 = min(DSR 한도, LTV 한도)\\u003c/h3\\u003e\\n\\u003cp\\u003e예시) 시가 7억원 아파트, 연소득 6,000만원, 무주택자, 비규제지역\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eLTV 한도: 7억 × 70% = 4.9억원\\u003c/li\\u003e\\n\\u003cli\\u003eDSR 한도: 약 4.7억원\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e실제 한도: 4.7억원\\u003c/strong\\u003e (DSR 기준)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-14\\\"\\u003e최저 금리 받는 7가지 방법\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e1. 우대금리 조건 최대한 활용\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e우대 폭\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e급여이체\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적금/예금 연계\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신용카드 사용\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자동이체 3건 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e비대면 신청\\u003c/td\\u003e\\n\\u003ctd\\u003e0.1% ~ 0.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e2. 고정 vs 변동금리 선택\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e금리 유형\\u003c/th\\u003e\\n\\u003cth\\u003e추천 상황\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고정금리\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 상승 예상, 안정적 상환 원할 때\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e변동금리\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 하락 예상, 조기 상환 계획 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e혼합금리\\u003c/td\\u003e\\n\\u003ctd\\u003e초기 5년 고정 후 변동, 균형잡힌 선택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003e3. 대환대출 검토\\u003c/h3\\u003e\\n\\u003cp\\u003e기존 대출 금리가 현재 금리보다 \\u003cstrong\\u003e0.5% 이상 높다면\\u003c/strong\\u003e 대환대출을 고려하세요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e4. 특례보금자리론 활용\\u003c/h3\\u003e\\n\\u003cp\\u003e소득 요건 충족 시 시중금리보다 \\u003cstrong\\u003e1~2% 낮은 금리\\u003c/strong\\u003e로 이용 가능합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e5. 신용점수 관리\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e신용점수\\u003c/th\\u003e\\n\\u003cth\\u003e금리 영향\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e900점 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e최저금리 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e800~899점\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.1% ~ 0.3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e700~799점\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.3% ~ 0.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e6. 중도상환수수료 확인\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e은행 유형\\u003c/th\\u003e\\n\\u003cth\\u003e중도상환수수료\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시중은행\\u003c/td\\u003e\\n\\u003ctd\\u003e잔여 원금의 1.2~1.4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인터넷은행\\u003c/td\\u003e\\n\\u003ctd\\u003e0% ~ 1.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보금자리론\\u003c/td\\u003e\\n\\u003ctd\\u003e3년 이내 1.2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003e7. 여러 은행 동시 비교\\u003c/h3\\u003e\\n\\u003cp\\u003e금융감독원 \\u003cstrong\\u003e금융상품 한눈에\\u003c/strong\\u003e 서비스를 활용하면 전 금융기관의 대출금리를 한번에 비교할 수 있습니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e2026년 주담대 신청 시 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e필수 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e서류\\u003c/th\\u003e\\n\\u003cth\\u003e용도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증\\u003c/td\\u003e\\n\\u003ctd\\u003e본인 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득증빙 (원천징수영수증, 소득금액증명원)\\u003c/td\\u003e\\n\\u003ctd\\u003eDSR 계산\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e재직증명서\\u003c/td\\u003e\\n\\u003ctd\\u003e직장 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e등기부등본\\u003c/td\\u003e\\n\\u003ctd\\u003e담보물 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주민등록등본\\u003c/td\\u003e\\n\\u003ctd\\u003e세대 구성 확인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eKB시세 또는 감정평가서\\u003c/td\\u003e\\n\\u003ctd\\u003eLTV 산정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e신청 프로세스\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e1. 금리 비교 및 은행 선택 (1~2일)\\n   ↓\\n2. 사전 상담 및 한도 조회 (당일)\\n   ↓\\n3. 정식 신청 및 서류 제출 (1~2일)\\n   ↓\\n4. 심사 및 감정평가 (3~7일)\\n   ↓\\n5. 대출 승인 및 실행 (1~2일)\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e주담대 금리 전망\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e2026년 하반기 전망\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e요인\\u003c/th\\u003e\\n\\u003cth\\u003e방향\\u003c/th\\u003e\\n\\u003cth\\u003e영향\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기준금리\\u003c/td\\u003e\\n\\u003ctd\\u003e인하 예상\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 하락 요인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가계부채 관리\\u003c/td\\u003e\\n\\u003ctd\\u003e강화\\u003c/td\\u003e\\n\\u003ctd\\u003e금리 상승 압력\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e부동산 시장\\u003c/td\\u003e\\n\\u003ctd\\u003e지역별 차별화\\u003c/td\\u003e\\n\\u003ctd\\u003e혼조세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e📊 \\u003cstrong\\u003e전문가 전망\\u003c/strong\\u003e: 2026년 하반기 기준금리 추가 인하 시 주담대 금리 0.25%~0.5% 추가 하락 가능성이 있습니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003e자주 묻는 질문\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003eQ1. 스트레스 DSR로 대출이 줄었는데, 방법이 없나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 다음 방법을 고려해보세요:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e상환 기간 연장 (30년 → 40년)\\u003c/li\\u003e\\n\\u003cli\\u003e기존 대출 상환 후 신규 대출\\u003c/li\\u003e\\n\\u003cli\\u003e보금자리론 등 정책대출 활용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003eQ2. 변동금리 vs 고정금리, 지금은 어떤 게 유리한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 현재 금리 인하 사이클 초입으로 \\u003cstrong\\u003e변동금리\\u003c/strong\\u003e가 단기적으로 유리할 수 있으나, 안정성을 원한다면 \\u003cstrong\\u003e혼합금리\\u003c/strong\\u003e(5년 고정 후 변동)를 추천합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ3. 지방 아파트 매수 시 유리한 점이 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 네, 2026년 6월까지 \\u003cstrong\\u003e스트레스 DSR 2단계 적용\\u003c/strong\\u003e으로 수도권 대비 대출 한도가 더 높게 나옵니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 주택담보대출 시장은 \\u003cstrong\\u003e스트레스 DSR 3단계\\u003c/strong\\u003e와 \\u003cstrong\\u003e금리 인하 기대\\u003c/strong\\u003e가 공존하는 복잡한 환경입니다. 최저 금리를 받기 위해서는:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e✅ 여러 은행 금리 비교 필수\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 우대금리 조건 최대한 활용\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 보금자리론 등 정책대출 검토\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 스트레스 DSR 한도 사전 계산\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 신용점수 관리\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e신중한 비교와 준비로 나에게 맞는 최적의 주담대를 찾으시기 바랍니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 전세대출 조건 비교\\u003c/li\\u003e\\n\\u003cli\\u003e청년 주거 지원 정책 총정리\\u003c/li\\u003e\\n\\u003cli\\u003eDSR 계산기 사용법\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었으며, 금리는 시장 상황에 따라 변동될 수 있습니다. 정확한 금리는 해당 금융기관에 직접 문의하시기 바랍니다.\\u003c/em\\u003e\\u003c/p\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$23\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/jeonse-loan-comparison-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"전세대출 조건 비교 가이드 - 청년버팀목부터 시중은행까지\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/national-pension-reform-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"clas