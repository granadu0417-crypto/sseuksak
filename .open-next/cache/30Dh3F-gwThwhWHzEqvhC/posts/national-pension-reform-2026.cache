id=\\\"heading-24\\\"\\u003e재직자노령연금 감액 완화\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e재직자노령연금이 뭔가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e연금 받으면서 일하면 \\u003cstrong\\u003e소득에 따라 연금이 깎이는\\u003c/strong\\u003e 제도예요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e변경 내용\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e월 소득 구간\\u003c/th\\u003e\\n\\u003cth\\u003e개정 전\\u003c/th\\u003e\\n\\u003cth\\u003e개정 후\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e509만 원 미만\\u003c/td\\u003e\\n\\u003ctd\\u003e감액\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e감액 면제\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e509만 원 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e감액\\u003c/td\\u003e\\n\\u003ctd\\u003e감액 (기존과 동일)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e월 소득 509만 원 미만이면 연금 깎이지 않아요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-27\\\"\\u003e기금 소진 시점 연장\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e개정 효과\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e개정 전\\u003c/th\\u003e\\n\\u003cth\\u003e개정 후\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기금 소진 시점\\u003c/td\\u003e\\n\\u003ctd\\u003e2056년\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2064년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기금 수익률 1%p 추가 시\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2071년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e기금 운용을 잘하면 \\u003cstrong\\u003e최대 15년\\u003c/strong\\u003e 더 유지 가능!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003e기금 현황 (2024년 말 기준)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e규모\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e국민연금 기금\\u003c/td\\u003e\\n\\u003ctd\\u003e약 1,200조 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세계 3위\\u003c/td\\u003e\\n\\u003ctd\\u003e연기금 규모\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-30\\\"\\u003e나에게 미치는 영향은?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e연령대별 영향\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연령대\\u003c/th\\u003e\\n\\u003cth\\u003e보험료 영향\\u003c/th\\u003e\\n\\u003cth\\u003e연금 영향\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e20~30대\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e장기간 인상된 보험료 부담\\u003c/td\\u003e\\n\\u003ctd\\u003e소득대체율 43% 혜택 큼\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e40대\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e중간 수준 부담\\u003c/td\\u003e\\n\\u003ctd\\u003e적당한 혜택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e50대\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e단기간만 인상 부담\\u003c/td\\u003e\\n\\u003ctd\\u003e혜택 적음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e60대 이상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e거의 없음\\u003c/td\\u003e\\n\\u003ctd\\u003e기존 연금 유지\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e세대별 요약\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2030세대 (젊은 층)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e더 내지만 → 더 받고, 국가 보장까지\\u003c/li\\u003e\\n\\u003cli\\u003e장기적으로 유리한 구조\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e4050세대 (중년층)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e보험료 인상 부담 있지만\\u003c/li\\u003e\\n\\u003cli\\u003e소득대체율 인상 혜택도 있음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e60대 이상 (은퇴 세대)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e이미 가입 완료된 경우 영향 적음\\u003c/li\\u003e\\n\\u003cli\\u003e기존대로 연금 수령\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-33\\\"\\u003e더 내고 더 받는다, 손해일까?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e단순 계산해보면\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e평균 소득자(월 309만 원) 기준, 40년 가입 시\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e추가 납부 총액\\u003c/td\\u003e\\n\\u003ctd\\u003e약 1,500만 원 (8년간)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e추가 수령 총액\\u003c/td\\u003e\\n\\u003ctd\\u003e약 2,200만 원 (20년 수령 시)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e순이익\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 700만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e오래 살수록 이득!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-35\\\"\\u003e연금 수령 기간별 손익\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e수령 기간\\u003c/th\\u003e\\n\\u003cth\\u003e추가 납부\\u003c/th\\u003e\\n\\u003cth\\u003e추가 수령\\u003c/th\\u003e\\n\\u003cth\\u003e손익\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10년\\u003c/td\\u003e\\n\\u003ctd\\u003e1,500만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e1,100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e-400만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e15년\\u003c/td\\u003e\\n\\u003ctd\\u003e1,500만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e1,650만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e+150만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e20년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e1,500만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,200만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e+700만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e25년\\u003c/td\\u003e\\n\\u003ctd\\u003e1,500만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,750만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e+1,250만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e15년 이상 연금 받으면 이득!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e평균 수명이 계속 늘어나고 있으니, 대부분 이득을 볼 가능성이 높아요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-36\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003eQ1. 언제부터 바뀌나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2026년 1월 1일\\u003c/strong\\u003e부터 시행됩니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-38\\\"\\u003eQ2. 보험료가 한 번에 올라요?\\u003c/h3\\u003e\\n\\u003cp\\u003e아니요! \\u003cstrong\\u003e매년 0.5%p씩 8년에 걸쳐\\u003c/strong\\u003e 단계적으로 인상돼요.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년: 9% → 9.5%\\u003c/li\\u003e\\n\\u003cli\\u003e2033년: 최종 13%\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-39\\\"\\u003eQ3. 직장인은 얼마나 더 내나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e회사가 절반 부담하므로, 2026년 기준 \\u003cstrong\\u003e월 약 7,700원\\u003c/strong\\u003e (평균 소득 기준)\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003eQ4. 연금 받을 때 세금은요?\\u003c/h3\\u003e\\n\\u003cp\\u003e연금소득세가 부과되지만, \\u003cstrong\\u003e연 1,200만 원까지는 분리과세\\u003c/strong\\u003e로 낮은 세율 적용!\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-41\\\"\\u003eQ5. 국민연금 안 받고 일시금으로 받을 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e원칙적으로 \\u003cstrong\\u003e연금으로 수령\\u003c/strong\\u003e하는 것이 원칙이에요.\\n다만 가입 기간이 10년 미만인 경우 일시금 수령 가능합니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-42\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 국민연금 개정, 핵심만 다시 정리하면:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e보험료율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e9% → 13% (8년간 단계적 인상)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소득대체율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e41.5% → 43% (즉시 인상)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국가 지급보장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e법률에 명문화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e출산 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e첫째아부터 12개월 인정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e군복무 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e6개월 → 12개월로 확대\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e기금 수명\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2056년 → 2064년 (수익률↑ 시 2071년)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e**\\\"더 내고 더 받는다\\\"**가 이번 개정의 핵심이에요.\\u003c/p\\u003e\\n\\u003cp\\u003e단기적으로는 부담이 늘지만, 장기적으로는 안정적인 노후 보장을 받을 수 있게 됐어요.\\u003c/p\\u003e\\n\\u003cp\\u003e특히 \\u003cstrong\\u003e국가 지급보장이 법률에 명시\\u003c/strong\\u003e된 건 큰 의미가 있어요. 이제 \\\"내 연금, 나중에 받을 수 있을까?\\\" 걱정은 덜어도 됩니다!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/etf-investment-guide-2026\\\"\\u003eETF 투자 입문 가이드: 초보자도 쉽게 시작하는 2026년 ETF 완벽 정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/2026-investment-strategy-guide\\\"\\u003e2026년 재테크 전략 가이드: 초보자 자산관리 로드맵\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/year-end-tax-guide-2026\\\"\\u003e2026년 연말정산 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e출처:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.mohw.go.kr/board.es?mid=a10503000000\\u0026#x26;bid=0027\\u0026#x26;list_no=1485039\\u0026#x26;act=view\\\"\\u003e보건복지부 - 연금개혁법안 국회 본회의 통과\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.korea.kr/news/policyNewsView.do?newsId=148933465\\\"\\u003e대한민국 정책브리핑 - 국민연금 보험료율 인상\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"https://www.nps.or.kr\\\"\\u003e국민연금공단 공식 사이트\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"$L21\\\",null,{\\\"content\\\":\\\"$22\\\"}]\\n23:T4566,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 국민연금 개정 총정리: 보험료율 인상부터 소득대체율까지 완벽 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"국민연금 보험료가 오른다는데, 얼마나 더 내야 하나요?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e\\\"나중에 연금 더 받는 건 맞나요?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2026년 1월 1일부터 \\u003cstrong\\u003e18년 만에 국민연금이 대폭 개편\\u003c/strong\\u003e됩니다!\\u003c/p\\u003e\\n\\u003cp\\u003e2025년 3월 국회를 통과한 국민연금법 개정안이 드디어 시행되는 건데요. 보험료는 오르지만, 받는 연금도 늘어나고 국가가 지급을 보장하는 내용이 법에 명시됐어요.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 2026년 국민연금 개정의 \\u003cstrong\\u003e모든 것\\u003c/strong\\u003e을 쉽게 정리해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e국민연금 개정, 왜 하게 됐나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e27년 만의 보험료율 인상\\u003c/h3\\u003e\\n\\u003cp\\u003e국민연금 보험료율이 마지막으로 바뀐 건 \\u003cstrong\\u003e1998년\\u003c/strong\\u003e이에요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e보험료율\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1988년\\u003c/td\\u003e\\n\\u003ctd\\u003e3%\\u003c/td\\u003e\\n\\u003ctd\\u003e제도 도입\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1993년\\u003c/td\\u003e\\n\\u003ctd\\u003e6%\\u003c/td\\u003e\\n\\u003ctd\\u003e첫 인상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1998년\\u003c/td\\u003e\\n\\u003ctd\\u003e9%\\u003c/td\\u003e\\n\\u003ctd\\u003e두 번째 인상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년~\\u003c/td\\u003e\\n\\u003ctd\\u003e9.5%→13%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e27년 만의 인상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e그동안 보험료율은 그대로인데, 고령화로 연금 받는 사람은 계속 늘어났어요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e기금 고갈 위기\\u003c/h3\\u003e\\n\\u003cp\\u003e개정 전 전망으로는 국민연금 기금이 \\u003cstrong\\u003e2056년에 바닥날 예정\\u003c/strong\\u003e이었어요.\\u003c/p\\u003e\\n\\u003cp\\u003e이대로면 우리 자녀 세대는 연금을 못 받을 수도 있는 상황이었죠.\\u003c/p\\u003e\\n\\u003cp\\u003e그래서 18년 만에 여야가 합의해서 연금개혁을 이뤄낸 거예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e2026년 국민연금, 뭐가 달라지나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e핵심 변경사항 요약\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e변경 전 (2025년)\\u003c/th\\u003e\\n\\u003cth\\u003e변경 후 (2026년~)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e보험료율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e9%\\u003c/td\\u003e\\n\\u003ctd\\u003e9.5% → 13% (단계적)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소득대체율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e41.5% (계속 인하 예정)\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e43% (인상)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국가 지급보장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e명시 없음\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e법률에 명문화\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e출산 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e둘째아부터\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e첫째아부터 12개월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e군복무 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e6개월\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e12개월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e기금 소진 시점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2056년\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2064년 (8년 연장)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-5\\\"\\u003e보험료율 인상: 얼마나 더 내나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e연도별 보험료율 인상 일정\\u003c/h3\\u003e\\n\\u003cp\\u003e보험료율은 한 번에 오르는 게 아니라 \\u003cstrong\\u003e8년간 단계적으로\\u003c/strong\\u003e 인상돼요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\