ll,{\\\"src\\\":\\\"https://images.unsplash.com/photo-1559526324-593bc073d938?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw1fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\",\\\"alt\\\":\\\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 768px) 100vw, 896px\\\",\\\"className\\\":\\\"object-cover\\\",\\\"priority\\\":true}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://unsplash.com/@austindistel?utm_source=sseuksak\\u0026utm_medium=referral\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Photo by Austin Distel on Unsplash\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"22:T4566,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 국민연금 개정 총정리: 보험료율 인상부터 소득대체율까지 완벽 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"국민연금 보험료가 오른다는데, 얼마나 더 내야 하나요?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e\\\"나중에 연금 더 받는 건 맞나요?\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2026년 1월 1일부터 \\u003cstrong\\u003e18년 만에 국민연금이 대폭 개편\\u003c/strong\\u003e됩니다!\\u003c/p\\u003e\\n\\u003cp\\u003e2025년 3월 국회를 통과한 국민연금법 개정안이 드디어 시행되는 건데요. 보험료는 오르지만, 받는 연금도 늘어나고 국가가 지급을 보장하는 내용이 법에 명시됐어요.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 2026년 국민연금 개정의 \\u003cstrong\\u003e모든 것\\u003c/strong\\u003e을 쉽게 정리해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e국민연금 개정, 왜 하게 됐나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e27년 만의 보험료율 인상\\u003c/h3\\u003e\\n\\u003cp\\u003e국민연금 보험료율이 마지막으로 바뀐 건 \\u003cstrong\\u003e1998년\\u003c/strong\\u003e이에요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e보험료율\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1988년\\u003c/td\\u003e\\n\\u003ctd\\u003e3%\\u003c/td\\u003e\\n\\u003ctd\\u003e제도 도입\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1993년\\u003c/td\\u003e\\n\\u003ctd\\u003e6%\\u003c/td\\u003e\\n\\u003ctd\\u003e첫 인상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1998년\\u003c/td\\u003e\\n\\u003ctd\\u003e9%\\u003c/td\\u003e\\n\\u003ctd\\u003e두 번째 인상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년~\\u003c/td\\u003e\\n\\u003ctd\\u003e9.5%→13%\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e27년 만의 인상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e그동안 보험료율은 그대로인데, 고령화로 연금 받는 사람은 계속 늘어났어요.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e기금 고갈 위기\\u003c/h3\\u003e\\n\\u003cp\\u003e개정 전 전망으로는 국민연금 기금이 \\u003cstrong\\u003e2056년에 바닥날 예정\\u003c/strong\\u003e이었어요.\\u003c/p\\u003e\\n\\u003cp\\u003e이대로면 우리 자녀 세대는 연금을 못 받을 수도 있는 상황이었죠.\\u003c/p\\u003e\\n\\u003cp\\u003e그래서 18년 만에 여야가 합의해서 연금개혁을 이뤄낸 거예요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e2026년 국민연금, 뭐가 달라지나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e핵심 변경사항 요약\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e변경 전 (2025년)\\u003c/th\\u003e\\n\\u003cth\\u003e변경 후 (2026년~)\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e보험료율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e9%\\u003c/td\\u003e\\n\\u003ctd\\u003e9.5% → 13% (단계적)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e소득대체율\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e41.5% (계속 인하 예정)\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e43% (인상)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국가 지급보장\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e명시 없음\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e법률에 명문화\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e출산 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e둘째아부터\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e첫째아부터 12개월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e군복무 크레딧\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e6개월\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e12개월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e기금 소진 시점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2056년\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2064년 (8년 연장)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-5\\\"\\u003e보험료율 인상: 얼마나 더 내나요?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e연도별 보험료율 인상 일정\\u003c/h3\\u003e\\n\\u003cp\\u003e보험료율은 한 번에 오르는 게 아니라 \\u003cstrong\\u003e8년간 단계적으로\\u003c/strong\\u003e 인상돼요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e보험료율\\u003c/th\\u003e\\n\\u003cth\\u003e전년 대비\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2025년\\u003c/td\\u003e\\n\\u003ctd\\u003e9.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e(현행)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e9.5%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2027년\\u003c/td\\u003e\\n\\u003ctd\\u003e10.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2028년\\u003c/td\\u003e\\n\\u003ctd\\u003e10.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2029년\\u003c/td\\u003e\\n\\u003ctd\\u003e11.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2030년\\u003c/td\\u003e\\n\\u003ctd\\u003e11.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2031년\\u003c/td\\u003e\\n\\u003ctd\\u003e12.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2032년\\u003c/td\\u003e\\n\\u003ctd\\u003e12.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e+0.5%p\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2033년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e13.0%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e(최종)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e실제 납부액 변화 (월급 309만 원 기준)\\u003c/h3\\u003e\\n\\u003cp\\u003e보건복지부 발표 기준, 평균 소득자(월 309만 원)의 납부액 변화예요.\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e보험료율\\u003c/th\\u003e\\n\\u003cth\\u003e월 납부액\\u003c/th\\u003e\\n\\u003cth\\u003e인상분\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2025년\\u003c/td\\u003e\\n\\u003ctd\\u003e9.0%\\u003c/td\\u003e\\n\\u003ctd\\u003e27.8만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u00