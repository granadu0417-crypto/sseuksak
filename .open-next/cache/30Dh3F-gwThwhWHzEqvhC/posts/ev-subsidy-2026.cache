le\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e2026년 보조금 규모\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e2025년\\u003c/th\\u003e\\n\\u003cth\\u003e2026년\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e국비 기본\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 300만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e최대 300만 원\\u003c/strong\\u003e (유지)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전환지원금\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e최대 100만 원\\u003c/strong\\u003e (신설)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e청년/취약계층\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국비의 20% 추가\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지방비 평균\\u003c/td\\u003e\\n\\u003ctd\\u003e200~400만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e200~400만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e총 최대\\u003c/td\\u003e\\n\\u003ctd\\u003e약 580만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 680만 원\\u003c/strong\\u003e (추가 지원 시)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e2026년 주요 변화\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e전환지원금 신설\\u003c/strong\\u003e: 내연차(3년 이상) 폐차/판매 후 전기차 구매 시 100만 원 추가\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e청년층(만 19~34세)\\u003c/strong\\u003e: 국비의 20% 추가 지원 (최대 60만 원)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e다자녀 가구(2자녀 이상)\\u003c/strong\\u003e: 최대 300만 원 추가\\u003c/li\\u003e\\n\\u003cli\\u003e예산 규모 20% 확대 (7,800억 원 → 9,360억 원)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e차종별 보조금 예시\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e승용차 (주요 모델) - 예상 보조금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e차종\\u003c/th\\u003e\\n\\u003cth\\u003e차량가\\u003c/th\\u003e\\n\\u003cth\\u003e국비\\u003c/th\\u003e\\n\\u003cth\\u003e지방비(서울)\\u003c/th\\u003e\\n\\u003cth\\u003e총 보조금\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현대 아이오닉6\\u003c/td\\u003e\\n\\u003ctd\\u003e5,200만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 280만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 480만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기아 EV6\\u003c/td\\u003e\\n\\u003ctd\\u003e5,400만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 280만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 480만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e현대 아이오닉5\\u003c/td\\u003e\\n\\u003ctd\\u003e5,000만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 300만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 500만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기아 EV9\\u003c/td\\u003e\\n\\u003ctd\\u003e7,700만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 150만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 250만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e테슬라 모델3\\u003c/td\\u003e\\n\\u003ctd\\u003e5,500만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e약 150만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e150만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 300만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e테슬라 모델Y\\u003c/td\\u003e\\n\\u003ctd\\u003e5,700만 원\\