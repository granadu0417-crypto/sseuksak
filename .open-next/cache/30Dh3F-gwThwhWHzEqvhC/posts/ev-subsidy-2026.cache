y\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e개별소비세\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 300만 원 감면\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취득세\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 140만 원 감면\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자동차세\\u003c/td\\u003e\\n\\u003ctd\\u003e연 13만 원 (경차 수준)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e운영 혜택\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e혜택\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고속도로 통행료\\u003c/td\\u003e\\n\\u003ctd\\u003e50% 할인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공영주차장\\u003c/td\\u003e\\n\\u003ctd\\u003e50% 할인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e충전 요금\\u003c/td\\u003e\\n\\u003ctd\\u003e주유 대비 60~70% 절감\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e혼잡통행료\\u003c/td\\u003e\\n\\u003ctd\\u003e면제 (서울)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e총 혜택 시뮬레이션\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e5,000만 원 전기차 구매 시 (서울 기준, 내연차 전환 시)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e국비 보조금\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지방비 보조금\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e전환지원금\\u003c/td\\u003e\\n\\u003ctd\\u003e100만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e개별소비세 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e300만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취득세 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e140만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e총 혜택\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1,040만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e실구매가\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3,960만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e참고\\u003c/strong\\u003e: 청년층은 국비 20% 추가로 \\u003cstrong\\u003e약 1,100만 원\\u003c/strong\\u003e 혜택 가능!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003eQ1. 보조금은 선착순인가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 예산 소진 시 조기 마감됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e인기 지역은 상반기 조기 마감\\u003c/li\\u003e\\n\\u003cli\\u003e연초 신청이 유리\\u003c/li\\u003e\\n\\u003cli\\u003e지자체별 예산 확인 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003eQ2. 중고 전기차도 보조금 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e신차만 해당됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e중고 전기차는 보조금 미지급\\u003c/li\\u003e\\n\\u003cli\\u003e단, 세금 감면은 일부 적용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003eQ3. 리스/렌트 차량도 보조금 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 받을 수 있습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e리스/렌트 회사가 보조금 신청\\u003c/li\\u003e\\n\\u003cli\\u003e리스료/렌트료에서 보조금 차감\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003eQ4. 법인도 보조금 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 법인도 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e법인 명의 구매 시 동일 지원\\u003c/li\\u003e\\n\\u003cli\\u003e단, 일부 지자체에서 개인 우선 배정\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ5. 보조금 신청 후 취소 가능한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e출고 전이면 가능합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e출고 후 취소 시 보조금 환수\\u003c/li\\u003e\\n\\u003cli\\u003e차량 변경도 재신청 필요\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-31\\\"\\u003e2026년 전기차 보조금 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e구매 전 확인\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 희망 차종의 보조금 대상 여부\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 차량 가격대별 보조금 비율\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 거주 지역 지방비 금액\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 추가 인센티브 (노후차 폐차 등)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003e신청 시 확인\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 지자체 예산 잔여 현황\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 대리점 보조금 신청 대행 여부\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 필요 서류 준비 완료\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 출고 예정일 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e구매 후 확인\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 2년 의무 운행 기간 숙지\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 차량 등록증 보관\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 충전 인프라 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 전기차 보조금은 \\u003cstrong\\u003e최대 800만 원\\u003c/strong\\u003e 이상 받을 수 있습니다! (추가 지원 포함)\\u003c/p\\u003e\\n\\u003cp\\u003e핵심 포인트:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e전환지원금 신설\\u003c/strong\\u003e: 내연차 폐차 시 100만 원 추가\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e청년/취약계층\\u003c/strong\\u003e: 국비의 20% 추가 지원\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e예산 소진 전\\u003c/strong\\u003e 빠른 신청 (1월~)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e지방비 높은 지역\\u003c/strong\\u003e + \\u003cstrong\\u003e세금 감면\\u003c/strong\\u003e 혜택 합산\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e전기차 구매 관련 문의: 환경부 콜센터 \\u003cstrong\\u003e1661-6700\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/youth-policy-2026\\\"\\u003e2026년 청년 정책 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/year-end-tax-settlement-2026\\\"\\u003e2026년 연말정산 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$23\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/ai-digital-textbook-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"AI 디지털교과서 완벽 가이드: 학부모가 알아야 할 핵심 정보\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/flu-vaccination-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"다음 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 독감 예방접종 안내: 무료 대상, 접종 시기, 주의사항 총정리\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 pt-8 border-t border-gray-200\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-gray-900 mb-6\\\",\\\"children\\\":\\\"관련 게시글\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",\\\"2026-new-laws-guide\\\",{\\\"href\\\":\\\"/posts/2026-new-laws-guide\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"2026년 새롭게 바뀌는 법률 15가지 총정리\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 시행되는 주요 법률 변경사항을 총정리했습니다. 구하라법, 노동절 명칭 변경, AI기본법, 도로교통법 개정 등 국민 생활에 영향을 미치는 핵심 법률을 알아보세요.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"trend-korea-2026-keywords\\\",{\\\"href\\\":\\\"/posts/trend-korea-2026-keywords\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"트렌드 코리아 2026 핵심 키워드 10가지 완벽 해설: HORSE POWER\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"트렌드 코리아 2026에서 선정한 10대 소비 트렌드 키워드 HORSE POWER를 쉽게 해설합니다. 휴먼인더루프, 필코노미, 제로클릭, 레디코어 등 2026년 핵심 트렌드를 정리했습니다.\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",\\\"2026-zodiac-fortune-guide\\\",{\\\"href\\\":\\\"/posts/2026-zodiac-fortune-guide\\\",\\\"className\\\":\\\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\\\",\\\"children\\\":\\\"2026년 병오년 띠별 운세 총정리: 12띠 신년운세 완벽 가이드\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 line-clamp-2\\\",\\\"children\\\":\\\"2026년 병오년(붉은 말의 해) 띠별 운세를 총정리합니다. 쥐띠부터 돼지띠까지 12띠 신년운세와 삼재띠 정보, 무료 토정비결 보는 법까지 한눈에 확인하세요.\\\"}]]}]]}]]}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[1402,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"\"]\n3:I[1398,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"177\",\"static/chunks/app/layout-e78f5894d0a0b16c.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[8924,[],\"\"]\n6:I[2619,[\"619\",