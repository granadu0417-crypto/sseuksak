003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e필요 서류\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e서류\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신분증 사본\\u003c/td\\u003e\\n\\u003ctd\\u003e주민등록증 또는 운전면허증\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주민등록등본\\u003c/td\\u003e\\n\\u003ctd\\u003e주소지 확인용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자동차매매계약서\\u003c/td\\u003e\\n\\u003ctd\\u003e대리점 발급\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e통장 사본\\u003c/td\\u003e\\n\\u003ctd\\u003e환급 시 필요\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e노후차 말소 증명\\u003c/td\\u003e\\n\\u003ctd\\u003e조기폐차 인센티브 신청 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-16\\\"\\u003e신청 채널\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e채널\\u003c/th\\u003e\\n\\u003cth\\u003e방법\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e대리점 대행\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e가장 일반적, 대리점에서 처리\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e무공해차 통합누리집\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eev.or.kr - 직접 신청\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e지자체 홈페이지\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e각 시/군/구 환경부서\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-17\\\"\\u003e보조금 유의사항\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003e의무 운행 기간\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\