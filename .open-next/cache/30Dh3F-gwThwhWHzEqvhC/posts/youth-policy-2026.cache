03cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 청년월세지원 신청\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 청년전세대출 조건 확인\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 청년 행복주택 입주 신청\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003e취업 지원\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 국민취업지원제도 상담\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 청년내일채움공제 확인\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 고용센터 방문 상담\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-41\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e청년 정책은 \\u003cstrong\\u003e아는 만큼 혜택\\u003c/strong\\u003e을 받습니다!\\u003c/p\\u003e\\n\\u003cp\\u003e가장 중요한 것:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e온통청년 포털\\u003c/strong\\u003e에서 내 조건에 맞는 정책 확인\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e마감일\\u003c/strong\\u003e 놓치지 않고 신청\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e중복 가능한 정책\\u003c/strong\\u003e은 모두 신청\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e궁금한 점은 청년정책상담 콜센터 \\u003cstrong\\u003e1688-1920\\u003c/strong\\u003e으로 문의하세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/minimum-wage-2026\\\"\\u003e2026년 최저임금 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/year-end-tax-settlement-2026\\\"\\u003e2026년 연말정산 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L20\\\",null,{\\\"content\\\":\\\"$21\\\"}]\\n22:T44f3,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"청년 혜택이 많다는데, 뭐가 있는지 모르겠어요.\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2026년에도 청년을 위한 다양한 정부 지원 정책이 시행됩니다. \\u003cstrong\\u003e청년도약계좌\\u003c/strong\\u003e는 2025년 12월 말 신규 가입이 종료되었고, 2026년 6월 \\u003cstrong\\u003e청년미래적금\\u003c/strong\\u003e이 출시될 예정입니다. \\u003cstrong\\u003e자격 조건\\u003c/strong\\u003e만 맞으면 받을 수 있는 혜택들, 놓치지 마세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e청년 정책 한눈에 보기\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e분야별 주요 정책\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e분야\\u003c/th\\u003e\\n\\u003cth\\u003e정책명\\u003c/th\\u003e\\n\\u003cth\\u003e핵심 혜택\\u003c/th\\u003e\\n\\u003cth\\u003e비고\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e저축/자산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년미래적금\\u003c/td\\u003e\\n\\u003ctd\\u003e3년간 자산 형성\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.6 출시 예정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e저축/자산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년내일저축계좌\\u003c/td\\u003e\\n\\u003ctd\\u003e3년간 최대 1,440만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 현재 가입 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e저축/자산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년도약계좌\\u003c/td\\u003e\\n\\u003ctd\\u003e5년간 최대 5,000만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 신규 종료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e주거\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년월세지원\\u003c/td\\u003e\\n\\u003ctd\\u003e월 20만 원 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e주거\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년전세보증보험\\u003c/td\\u003e\\n\\u003ctd\\u003e보증료 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e취업\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e국민취업지원제도\\u003c/td\\u003e\\n\\u003ctd\\u003e월 50만 원 + 취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e교육\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e국가장학금\\u003c/td\\u003e\\n\\u003ctd\\u003e연 최대 700만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-2\\\"\\u003e청년도약계좌\\u003c/h2\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e⚠️ \\u003cstrong\\u003e중요 안내\\u003c/strong\\u003e: 청년도약계좌 신규 가입은 \\u003cstrong\\u003e2025년 12월 31일부로 종료\\u003c/strong\\u003e되었습니다. 기존 가입자는 만기까지 정상 운영됩니다. 2026년 6월부터 후속 상품인 \\u003cstrong\\u003e청년미래적금\\u003c/strong\\u003e이 출시될 예정입니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e제도 개요 (기존 가입자 해당)\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e5년간 매월 저축하면 정부가 기여금을 더해 최대 5,000만 원 달성\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가입 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e5년 (60개월)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월 납입액\\u003c/td\\u003e\\n\\u003ctd\\u003e40만~70만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정부 기여금\\u003c/td\\u003e\\n\\u003ctd\\u003e월 최대 3.3만