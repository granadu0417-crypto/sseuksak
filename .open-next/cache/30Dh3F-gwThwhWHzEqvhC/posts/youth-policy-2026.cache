3c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e저축/자산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년내일저축계좌\\u003c/td\\u003e\\n\\u003ctd\\u003e3년간 최대 1,440만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 현재 가입 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e저축/자산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년도약계좌\\u003c/td\\u003e\\n\\u003ctd\\u003e5년간 최대 5,000만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 신규 종료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e주거\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년월세지원\\u003c/td\\u003e\\n\\u003ctd\\u003e월 20만 원 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e주거\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e청년전세보증보험\\u003c/td\\u003e\\n\\u003ctd\\u003e보증료 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e취업\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e국민취업지원제도\\u003c/td\\u003e\\n\\u003ctd\\u003e월 50만 원 + 취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e교육\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e국가장학금\\u003c/td\\u003e\\n\\u003ctd\\u003e연 최대 700만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 신청 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-2\\\"\\u003e청년도약계좌\\u003c/h2\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e⚠️ \\u003cstrong\\u003e중요 안내\\u003c/strong\\u003e: 청년도약계좌 신규 가입은 \\u003cstrong\\u003e2025년 12월 31일부로 종료\\u003c/strong\\u003e되었습니다. 기존 가입자는 만기까지 정상 운영됩니다. 2026년 6월부터 후속 상품인 \\u003cstrong\\u003e청년미래적금\\u003c/strong\\u003e이 출시될 예정입니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e제도 개요 (기존 가입자 해당)\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e5년간 매월 저축하면 정부가 기여금을 더해 최대 5,000만 원 달성\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가입 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e5년 (60개월)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월 납입액\\u003c/td\\u003e\\n\\u003ctd\\u003e40만~70만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정부 기여금\\u003c/td\\u003e\\n\\u003ctd\\u003e월 최대 3.3만 원 (2024년 7월 개편)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이자\\u003c/td\\u003e\\n\\u003ctd\\u003e비과세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e만기 수령액\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e최대 5,000만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e신규가입\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 2025.12.31 종료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e가입 자격\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e나이\\u003c/td\\u003e\\n\\u003ctd\\u003e만 19세~34세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득\\u003c/td\\u003e\\n\\u003ctd\\u003e개인소득 7,500만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e가구소득\\u003c/td\\u003e\\n\\u003ctd\\u003e중위소득 250% 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u00