"(max-width: 768px) 100vw, 896px\",\"className\":\"object-cover\",\"priority\":true}],\"$L1b\"]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]}]]\n20:I[286,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"default\"]\n1b:[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://unsplash.com/@austindistel?utm_source=sseuksak&utm_medium=referral\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-white\",\"children\":\"Photo by Austin Distel on Unsplash\"}]}]\n21:T44f3,<h1>2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지</h1>\n<p>\"청년 혜택이 많다는데, 뭐가 있는지 모르겠어요.\"</p>\n<p>2026년에도 청년을 위한 다양한 정부 지원 정책이 시행됩니다. <strong>청년도약계좌</strong>는 2025년 12월 말 신규 가입이 종료되었고, 2026년 6월 <strong>청년미래적금</strong>이 출시될 예정입니다. <strong>자격 조건</strong>만 맞으면 받을 수 있는 혜택들, 놓치지 마세요!</p>\n<hr>\n<h2 id=\"heading-0\">청년 정책 한눈에 보기</h2>\n<h3 id=\"heading-1\">분야별 주요 정책</h3>\n<table>\n<thead>\n<tr>\n<th>분야</th>\n<th>정책명</th>\n<th>핵심 혜택</th>\n<th>비고</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년미래적금</td>\n<td>3년간 자산 형성</td>\n<td>2026.6 출시 예정</td>\n</tr>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년내일저축계좌</td>\n<td>3년간 최대 1,440만 원</td>\n<td>✅ 현재 가입 가능</td>\n</tr>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년도약계좌</td>\n<td>5년간 최대 5,000만 원</td>\n<td>❌ 신규 종료</td>\n</tr>\n<tr>\n<td><strong>주거</strong></td>\n<td>청년월세지원</td>\n<td>월 20만 원 지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>주거</strong></td>\n<td>청년전세보증보험</td>\n<td>보증료 지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>취업</strong></td>\n<td>국민취업지원제도</td>\n<td>월 50만 원 + 취업지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>교육</strong></td>\n<td>국가장학금</td>\n<td>연 최대 700만 원</td>\n<td>✅ 신청 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-2\">청년도약계좌</h2>\n<blockquote>\n<p>⚠️ <strong>중요 안내</strong>: 청년도약계좌 신규 가입은 <strong>2025년 12월 31일부로 종료</strong>되었습니다. 기존 가입자는 만기까지 정상 운영됩니다. 2026년 6월부터 후속 상품인 <strong>청년미래적금</strong>이 출시될 예정입니다.</p>\n</blockquote>\n<h3 id=\"heading-3\">제도 개요 (기존 가입자 해당)</h3>\n<blockquote>\n<p><strong>5년간 매월 저축하면 정부가 기여금을 더해 최대 5,000만 원 달성</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>가입 기간</td>\n<td>5년 (60개월)</td>\n</tr>\n<tr>\n<td>월 납입액</td>\n<td>40만~70만 원</td>\n</tr>\n<tr>\n<td>정부 기여금</td>\n<td>월 최대 3.3만 원 (2024년 7월 개편)</td>\n</tr>\n<tr>\n<td>이자</td>\n<td>비과세</td>\n</tr>\n<tr>\n<td>만기 수령액</td>\n<td><strong>최대 5,000만 원</strong></td>\n</tr>\n<tr>\n<td><strong>신규가입</strong></td>\n<td>❌ 2025.12.31 종료</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-4\">가입 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>개인소득 7,500만 원 이하</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>중위소득 250% 이하</td>\n</tr>\n<tr>\n<td>금융소득</td>\n<td>연 2,000만 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">정부 기여금 체계 (2024년 7월 개편 적용)</h3>\n<table>\n<thead>\n<tr>\n<th>개인소득</th>\n<th>정부 기여금 (월)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2,400만 원 이하</td>\n<td><strong>3.3만 원</strong></td>\n</tr>\n<tr>\n<td>3,600만 원 이하</td>\n<td>2.9만 원</td>\n</tr>\n<tr>\n<td>4,800만 원 이하</td>\n<td>2.3만 원</td>\n</tr>\n<tr>\n<td>6,000만 원 이하</td>\n<td>1.7만 원</td>\n</tr>\n<tr>\n<td>7,500만 원 이하</td>\n<td>1.0만 원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-6\">예상 수령액 계산 (기존 가입자)</h3>\n<p><strong>월 70만 원 × 60개월 + 정부 기여금 + 이자</strong></p>\n<table>\n<thead>\n<tr>\n<th>개인소득</th>\n<th>본인 납입</th>\n<th>정부 기여금</th>\n<th>이자 (예상)</th>\n<th><strong>총 수령액</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2,400만 원 이하</td>\n<td>4,200만 원</td>\n<td>198만 원</td>\n<td>약 700만 원</td>\n<td><strong>약 5,098만 원</strong></td>\n</tr>\n<tr>\n<td>4,800만 원 이하</td>\n<td>4,200만 원</td>\n<td>138만 원</td>\n<td>약 700만 원</td>\n<td><strong>약 5,038만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-7\">가입 안내</h3>\n<blockquote>\n<p>❌ <strong>신규 가입 불가</strong> - 2025년 12월 31일 종료</p>\n</blockquote>\n<p>기존 가입자는 만기까지 정상 운영됩니다. 취급 은행: 국민, 신한, 하나, 우리, 농협, 기업 등</p>\n<hr>\n<h2 id=\"heading-8\">청년미래적금 (2026년 6월 출시 예정)</h2>\n<h3 id=\"heading-9\">제도 개요</h3>\n<blockquote>\n<p><strong>청년도약계좌 후속 상품으로 2026년 6월 출시 예정</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>출시 예정</td>\n<td><strong>2026년 6월</strong></td>\n</tr>\n<tr>\n<td>가입 대상</td>\n<td>만 19세~34세 청년</td>\n</tr>\n<tr>\n<td>가입 기간</td>\n<td>3년 (36개월) 예정</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>기여금 + 비과세 혜택</td>\n</tr>\n<tr>\n<td>상세 내용</td>\n<td>2026년 상반기 발표 예정</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-10\">청년도약계좌와의 차이점 (예상)</h3>\n<ul>\n<li>가입 기간 단축 (5년 → 3년)</li>\n<li>더 높은 정부 기여금 예상</li>\n<li>중도 해지 패널티 완화 예상</li>\n</ul>\n<p><strong>Tip</strong>: 정확한 내용은 2026년 상반기 정부 발표를 확인하세요!</p>\n<hr>\n<h2 id=\"heading-11\">청년내일저축계좌</h2>\n<h3 id=\"heading-12\">제도 개요</h3>\n<blockquote>\n<p><strong>저소득 청년이 3년간 저축하면 정부가 10~30만 원씩 매칭 지원</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>가입 기간</td>\n<td>3년 (36개월)</td>\n</tr>\n<tr>\n<td>월 저축액</td>\n<td>10만 원</td>\n</tr>\n<tr>\n<td>정부 지원금</td>\n<td>월 10~30만 원</td>\n</tr>\n<tr>\n<td>만기 수령액</td>\n<td><strong>720만~1,440만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-13\">가입 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>월 50만 원 이상 230만 원 미만</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>중위소득 100% 이하</td>\n</tr>\n<tr>\n<td>재산</td>\n<td>4.2억 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-14\">정부 매칭 지원금</h3>\n<table>\n<thead>\n<tr>\n<th>가구 소득</th>\n<th>정부 지원 (월)</th>\n<th>만기 수령액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>기준 중위소득 50% 이하</td>\n<td><strong>30만 원</strong></td>\n<td>1,440만 원</td>\n</tr>\n<tr>\n<td>기준 중위소득 100% 이하</td>\n<td><strong>10만 원</strong></td>\n<td>720만 원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-15\">청년도약 vs 청년내일저축 vs 청년미래적금 비교</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>청년도약계좌</th>\n<th>청년내일저축계좌</th>\n<th>청년미래적금</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>기간</td>\n<td>5년</td>\n<td>3년</td>\n<td>3년 (예정)</td>\n</tr>\n<tr>\n<td>본인 납입</td>\n<td>40~70만 원</td>\n<td>10만 원</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>최대 3.3만 원</td>\n<td>최대 30만 원</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>소득 조건</td>\n<td>7,500만 원 이하</td>\n<td>230만 원 미만</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>대상</td>\n<td>일반 청년</td>\n<td>저소득 청년</td>\n<td>일반 청년</td>\n</tr>\n<tr>\n<td><strong>신규 가입</strong></td>\n<td>❌ 종료</td>\n<td>✅ 가능</td>\n<td>2026.6 출시</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Tip</strong>: 현재 가입 가능한 자산형성 상품은 <strong>청년내일저축계좌</strong>입니다!</p>\n<hr>\n<h2 id=\"heading-16\">청년월세지원</h2>\n<h3 id=\"heading-17\">제도 개요</h3>\n<blockquote>\n<p><strong>월세 부담을 덜어주는 월 최대 20만 원 지원</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>월 최대 20만 원</td>\n</tr>\n<tr>\n<td>지원 기간</td>\n<td>최대 12개월</td>\n</tr>\n<tr>\n<td>총 지원액</td>\n<td><strong>최대 240만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-18\">지원 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>청년 본인 연소득 5,000만 원 이하</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>원가구 중위소득 100% 이하</td>\n</tr>\n<tr>\n<td>재산</td>\n<td>1.22억 원 이하</td>\n</tr>\n<tr>\n<td>주거 형태</td>\n<td>월세 거주 (보증금 5천만 원 &#x26; 월세 60만 원 이하)</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-19\">신청 방법</h3>\n<ol>\n<li><strong>복지로</strong> (<a href=\"http://www.bokjiro.go.kr\">www.bokjiro.go.kr</a>) 접속</li>\n<li>청년월세 한시 특별지원 검색</li>\n<li>온라인 신청</li>\n<li>서류 제출 (임대차계약서, 계좌이체 내역)</li>\n<li>심사 후 지급</li>\n</ol>\n<h3 id=\"heading-20\">주의사항</h3>\n<ul>\n<li>임대차계약서 상 본인 명의 필수</li>\n<li>실제 거주 확인</li>\n<li>공공임대주택 거주자 제외</li>\n<li>부모와 동거 시 제외</li>\n</ul>\n<hr>\n<h2 id=\"heading-21\">청년 주거 지원</h2>\n<h3 id=\"heading-22\">청년전세자금대출</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대출 한도</td>\n<td>수도권 1.5억, 지방 1억</td>\n</tr>\n<tr>\n<td>금리</td>\n<td>연 1.5~2.1%</td>\n</tr>\n<tr>\n<td>대출 기간</td>\n<td>최대 10년</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>만 19세~34세, 무주택자</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-23\">청년버팀목전세대출</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대출 한도</td>\n<td>최대 2억 원</td>\n</tr>\n<tr>\n<td>금리</td>\n<td>연 1.8~2.4%</td>\n</tr>\n<tr>\n<td>소득 조건</td>\n<td>연 5,000만 원 이하</td>\n</tr>\n<tr>\n<td>주택 가격</td>\n<td>전세금 3억 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">청년우대형청약통장</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>금리</td>\n<td>연 4.3% (시중 대비 1.5%p 우대)</td>\n</tr>\n<tr>\n<td>이자 비과세</td>\n<td>500만 원 한도</td>\n</tr>\n<tr>\n<td>소득공제</td>\n<td>납입액 40% (300만 원 한도)</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>만 19세~34세, 무주택, 연소득 3,600만 원 이하</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-25\">청년취업지원제도</h2>\n<h3 id=\"heading-26\">국민취업지원제도</h3>\n<blockquote>\n<p><strong>구직 기간 동안 월 50만 원 + 맞춤형 취업지원 서비스</strong></p>\n</blockquote>\n<h4>Ⅰ유형 (구직촉진수당)</h4>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>월 50만 원 × 6개월 = <strong>300만 원</strong></td>\n</tr>\n<tr>\n<td>자격</td>\n<td>중위소득 60% 이하, 재산 4억 이하</td>\n</tr>\n<tr>\n<td>취업지원</td>\n<td>1:1 상담, 직업훈련, 일경험 프로그램</td>\n</tr>\n</tbody>\n</table>\n<h4>Ⅱ유형 (취업활동비)</h4>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>취업활동비 최대 195만 원</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>중위소득 120% 이하</td>\n</tr>\n<tr>\n<td>취업지원</td>\n<td>취업알선, 직업훈련 연계</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-27\">청년도전지원사업</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대상</td>\n<td>취업·교육·훈련에 참여하지 않는 청년 (니트족)</td>\n</tr>\n<tr>\n<td>지원</td>\n<td>맞춤형 프로그램 + 수당 월 50만 원</td>\n</tr>\n<tr>\n<td>기간</td>\n<td>최대 6개월</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">청년내일채움공제</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>참여 기간</td>\n<td>2년</td>\n</tr>\n<tr>\n<td>청년 납입</td>\n<td>월 16만 원 (총 384만 원)</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>600만 원</td>\n</tr>\n<tr>\n<td>기업 지원</td>\n<td>200만 원</td>\n</tr>\n<tr>\n<td><strong>만기 수령액</strong></td>\n<td><strong>1,200만 원+α</strong></td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-29\">청년 교육 지원</h2>\n<h3 id=\"heading-30\">국가장학금</h3>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>지원액 (연간)</th>\n<th>소득 조건</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ⅰ유형</td>\n<td>520만~700만 원</td>\n<td>학자금 지원 1~8구간</td>\n</tr>\n<tr>\n<td>Ⅱ유형</td>\n<td>대학 자체 기준</td>\n<td>대학별 상이</td>\n</tr>\n<tr>\n<td>다자녀</td>\n<td>등록금 전액</td>\n<td>3자녀 이상 가정</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">국가근로장학금</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>시급</td>\n<td>교내 11,640원, 교외 13,010원</td>\n</tr>\n<tr>\n<td>연간 한도</td>\n<td>약 400만 원</td>\n</tr>\n<tr>\n<td>근무시간</td>\n<td>주 20시간 이내</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-32\">학자금대출</h3>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>금리</th>\n<th>상환 방식</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>취업 후 상환 (ICL)</td>\n<td>연 1.7%</td>\n<td>소득 발생 후 상환</td>\n</tr>\n<tr>\n<td>일반 상환</td>\n<td>연 1.7%</td>\n<td>졸업 후 즉시 상환</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-33\">청년 정책 신청 꿀팁</h2>\n<h3 id=\"heading-34\">정보 확인 채널</h3>\n<table>\n<thead>\n<tr>\n<th>채널</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>온통청년</strong></td>\n<td>youth.go.kr - 청년 정책 통합 포털</td>\n</tr>\n<tr>\n<td><strong>정부24</strong></td>\n<td>gov.kr - 행정 서비스 통합</td>\n</tr>\n<tr>\n<td><strong>복지로</strong></td>\n<td>bokjiro.go.kr - 복지 정책 안내</td>\n</tr>\n<tr>\n<td><strong>고용24</strong></td>\n<td>work24.go.kr - 취업 지원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-35\">놓치기 쉬운 청년 정책</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 교통비 지원 (지자체별 상이)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 통신비 지원 (차상위 이하)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 문화생활비 지원 (문화누리카드)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 건강검진 지원</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 마음건강 상담 지원</li>\n</ul>\n<h3 id=\"heading-36\">중복 수혜 가능 여부</h3>\n<table>\n<thead>\n<tr>\n<th>정책 A</th>\n<th>정책 B</th>\n<th>중복 가능</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>청년도약계좌</td>\n<td>청년내일저축</td>\n<td>❌ 불가</td>\n</tr>\n<tr>\n<td>청년미래적금</td>\n<td>청년내일저축</td>\n<td>❌ 불가 (예정)</td>\n</tr>\n<tr>\n<td>청년월세지원</td>\n<td>청년미래적금</td>\n<td>✅ 가능 (예정)</td>\n</tr>\n<tr>\n<td>국민취업지원</td>\n<td>청년미래적금</td>\n<td>✅ 가능 (예정)</td>\n</tr>\n<tr>\n<td>국가장학금</td>\n<td>근로장학금</td>\n<td>✅ 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-37\">2026년 청년 지원 체크리스트</h2>\n<h3 id=\"heading-38\">자산 형성</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년도약계좌 기존 가입자: 유지 관리</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년미래적금 출시 대기 (2026년 6월 예정)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년내일저축 대상 여부 확인 (현재 가입 가능)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년우대형청약통장 전환</li>\n</ul>\n<h3 id=\"heading-39\">주거 지원</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년월세지원 신청</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년전세대출 조건 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 행복주택 입주 신청</li>\n</ul>\n<h3 id=\"heading-40\">취업 지원</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 국민취업지원제도 상담</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년내일채움공제 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 고용센터 방문 상담</li>\n</ul>\n<hr>\n<h2 id=\"heading-41\">마무리</h2>\n<p>청년 정책은 <strong>아는 만큼 혜택</strong>을 받습니다!</p>\n<p>가장 중요한 것:</p>\n<ol>\n<li><strong>온통청년 포털</strong>에서 내 조건에 맞는 정책 확인</li>\n<li><strong>마감일</strong> 놓치지 않고 신청</li>\n<li><strong>중복 가능한 정책</strong>은 모두 신청</li>\n</ol>\n<p>궁금한 점은 청년정책상담 콜센터 <strong>1688-1920</strong>으로 문의하세요!</p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/minimum-wage-2026\">2026년 최저임금 완벽 가이드</a></li>\n<li><a href=\"/posts/year-end-tax-settlement-2026\">2026년 연말정산 완벽 가이드</a></li>\n</ul>\n1c:[\"$\",\"$L20\",null,{\"content\":\"$21\"}]\n22:T44f3,<h1>2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지</h1>\n<p>\"청년 혜택이 많다는데, 뭐가 있는지 모르겠어요.\"</p>\n<p>2026년에도 청년을 위한 다양한 정부 지원 정책이 시행됩니다. <strong>청년도약계좌</strong>는 2025년 12월 말 신규 가입이 종료되었고, 2026년 6월 <strong>청년미래적금</strong>이 출시될 예정입니다. <strong>자격 조건</strong>만 맞으면 받을 수 있는 혜택들, 놓치지 마세요!</p>\n<hr>\n<h2 id=\"heading-0\">청년 정책 한눈에 보기</h2>\n<h3 id=\"heading-1\">분야별 주요 정책</h3>\n<table>\n<thead>\n<tr>\n<th>분야</th>\n<th>정책명</th>\n<th>핵심 혜택</th>\n<th>비고</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년미래적금</td>\n<td>3년간 자산 형성</td>\n<td>2026.6 출시 예정</td>\n</tr>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년내일저축계좌</td>\n<td>3년간 최대 1,440만 원</td>\n<td>✅ 현재 가입 가능</td>\n</tr>\n<tr>\n<td><strong>저축/자산</strong></td>\n<td>청년도약계좌</td>\n<td>5년간 최대 5,000만 원</td>\n<td>❌ 신규 종료</td>\n</tr>\n<tr>\n<td><strong>주거</strong></td>\n<td>청년월세지원</td>\n<td>월 20만 원 지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>주거</strong></td>\n<td>청년전세보증보험</td>\n<td>보증료 지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>취업</strong></td>\n<td>국민취업지원제도</td>\n<td>월 50만 원 + 취업지원</td>\n<td>✅ 신청 가능</td>\n</tr>\n<tr>\n<td><strong>교육</strong></td>\n<td>국가장학금</td>\n<td>연 최대 700만 원</td>\n<td>✅ 신청 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-2\">청년도약계좌</h2>\n<blockquote>\n<p>⚠️ <strong>중요 안내</strong>: 청년도약계좌 신규 가입은 <strong>2025년 12월 31일부로 종료</strong>되었습니다. 기존 가입자는 만기까지 정상 운영됩니다. 2026년 6월부터 후속 상품인 <strong>청년미래적금</strong>이 출시될 예정입니다.</p>\n</blockquote>\n<h3 id=\"heading-3\">제도 개요 (기존 가입자 해당)</h3>\n<blockquote>\n<p><strong>5년간 매월 저축하면 정부가 기여금을 더해 최대 5,000만 원 달성</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>가입 기간</td>\n<td>5년 (60개월)</td>\n</tr>\n<tr>\n<td>월 납입액</td>\n<td>40만~70만 원</td>\n</tr>\n<tr>\n<td>정부 기여금</td>\n<td>월 최대 3.3만 원 (2024년 7월 개편)</td>\n</tr>\n<tr>\n<td>이자</td>\n<td>비과세</td>\n</tr>\n<tr>\n<td>만기 수령액</td>\n<td><strong>최대 5,000만 원</strong></td>\n</tr>\n<tr>\n<td><strong>신규가입</strong></td>\n<td>❌ 2025.12.31 종료</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-4\">가입 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>개인소득 7,500만 원 이하</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>중위소득 250% 이하</td>\n</tr>\n<tr>\n<td>금융소득</td>\n<td>연 2,000만 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">정부 기여금 체계 (2024년 7월 개편 적용)</h3>\n<table>\n<thead>\n<tr>\n<th>개인소득</th>\n<th>정부 기여금 (월)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2,400만 원 이하</td>\n<td><strong>3.3만 원</strong></td>\n</tr>\n<tr>\n<td>3,600만 원 이하</td>\n<td>2.9만 원</td>\n</tr>\n<tr>\n<td>4,800만 원 이하</td>\n<td>2.3만 원</td>\n</tr>\n<tr>\n<td>6,000만 원 이하</td>\n<td>1.7만 원</td>\n</tr>\n<tr>\n<td>7,500만 원 이하</td>\n<td>1.0만 원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-6\">예상 수령액 계산 (기존 가입자)</h3>\n<p><strong>월 70만 원 × 60개월 + 정부 기여금 + 이자</strong></p>\n<table>\n<thead>\n<tr>\n<th>개인소득</th>\n<th>본인 납입</th>\n<th>정부 기여금</th>\n<th>이자 (예상)</th>\n<th><strong>총 수령액</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2,400만 원 이하</td>\n<td>4,200만 원</td>\n<td>198만 원</td>\n<td>약 700만 원</td>\n<td><strong>약 5,098만 원</strong></td>\n</tr>\n<tr>\n<td>4,800만 원 이하</td>\n<td>4,200만 원</td>\n<td>138만 원</td>\n<td>약 700만 원</td>\n<td><strong>약 5,038만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-7\">가입 안내</h3>\n<blockquote>\n<p>❌ <strong>신규 가입 불가</strong> - 2025년 12월 31일 종료</p>\n</blockquote>\n<p>기존 가입자는 만기까지 정상 운영됩니다. 취급 은행: 국민, 신한, 하나, 우리, 농협, 기업 등</p>\n<hr>\n<h2 id=\"heading-8\">청년미래적금 (2026년 6월 출시 예정)</h2>\n<h3 id=\"heading-9\">제도 개요</h3>\n<blockquote>\n<p><strong>청년도약계좌 후속 상품으로 2026년 6월 출시 예정</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>출시 예정</td>\n<td><strong>2026년 6월</strong></td>\n</tr>\n<tr>\n<td>가입 대상</td>\n<td>만 19세~34세 청년</td>\n</tr>\n<tr>\n<td>가입 기간</td>\n<td>3년 (36개월) 예정</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>기여금 + 비과세 혜택</td>\n</tr>\n<tr>\n<td>상세 내용</td>\n<td>2026년 상반기 발표 예정</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-10\">청년도약계좌와의 차이점 (예상)</h3>\n<ul>\n<li>가입 기간 단축 (5년 → 3년)</li>\n<li>더 높은 정부 기여금 예상</li>\n<li>중도 해지 패널티 완화 예상</li>\n</ul>\n<p><strong>Tip</strong>: 정확한 내용은 2026년 상반기 정부 발표를 확인하세요!</p>\n<hr>\n<h2 id=\"heading-11\">청년내일저축계좌</h2>\n<h3 id=\"heading-12\">제도 개요</h3>\n<blockquote>\n<p><strong>저소득 청년이 3년간 저축하면 정부가 10~30만 원씩 매칭 지원</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>가입 기간</td>\n<td>3년 (36개월)</td>\n</tr>\n<tr>\n<td>월 저축액</td>\n<td>10만 원</td>\n</tr>\n<tr>\n<td>정부 지원금</td>\n<td>월 10~30만 원</td>\n</tr>\n<tr>\n<td>만기 수령액</td>\n<td><strong>720만~1,440만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-13\">가입 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>월 50만 원 이상 230만 원 미만</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>중위소득 100% 이하</td>\n</tr>\n<tr>\n<td>재산</td>\n<td>4.2억 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-14\">정부 매칭 지원금</h3>\n<table>\n<thead>\n<tr>\n<th>가구 소득</th>\n<th>정부 지원 (월)</th>\n<th>만기 수령액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>기준 중위소득 50% 이하</td>\n<td><strong>30만 원</strong></td>\n<td>1,440만 원</td>\n</tr>\n<tr>\n<td>기준 중위소득 100% 이하</td>\n<td><strong>10만 원</strong></td>\n<td>720만 원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-15\">청년도약 vs 청년내일저축 vs 청년미래적금 비교</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>청년도약계좌</th>\n<th>청년내일저축계좌</th>\n<th>청년미래적금</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>기간</td>\n<td>5년</td>\n<td>3년</td>\n<td>3년 (예정)</td>\n</tr>\n<tr>\n<td>본인 납입</td>\n<td>40~70만 원</td>\n<td>10만 원</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>최대 3.3만 원</td>\n<td>최대 30만 원</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>소득 조건</td>\n<td>7,500만 원 이하</td>\n<td>230만 원 미만</td>\n<td>미정</td>\n</tr>\n<tr>\n<td>대상</td>\n<td>일반 청년</td>\n<td>저소득 청년</td>\n<td>일반 청년</td>\n</tr>\n<tr>\n<td><strong>신규 가입</strong></td>\n<td>❌ 종료</td>\n<td>✅ 가능</td>\n<td>2026.6 출시</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Tip</strong>: 현재 가입 가능한 자산형성 상품은 <strong>청년내일저축계좌</strong>입니다!</p>\n<hr>\n<h2 id=\"heading-16\">청년월세지원</h2>\n<h3 id=\"heading-17\">제도 개요</h3>\n<blockquote>\n<p><strong>월세 부담을 덜어주는 월 최대 20만 원 지원</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>월 최대 20만 원</td>\n</tr>\n<tr>\n<td>지원 기간</td>\n<td>최대 12개월</td>\n</tr>\n<tr>\n<td>총 지원액</td>\n<td><strong>최대 240만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-18\">지원 자격</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>나이</td>\n<td>만 19세~34세</td>\n</tr>\n<tr>\n<td>소득</td>\n<td>청년 본인 연소득 5,000만 원 이하</td>\n</tr>\n<tr>\n<td>가구소득</td>\n<td>원가구 중위소득 100% 이하</td>\n</tr>\n<tr>\n<td>재산</td>\n<td>1.22억 원 이하</td>\n</tr>\n<tr>\n<td>주거 형태</td>\n<td>월세 거주 (보증금 5천만 원 &#x26; 월세 60만 원 이하)</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-19\">신청 방법</h3>\n<ol>\n<li><strong>복지로</strong> (<a href=\"http://www.bokjiro.go.kr\">www.bokjiro.go.kr</a>) 접속</li>\n<li>청년월세 한시 특별지원 검색</li>\n<li>온라인 신청</li>\n<li>서류 제출 (임대차계약서, 계좌이체 내역)</li>\n<li>심사 후 지급</li>\n</ol>\n<h3 id=\"heading-20\">주의사항</h3>\n<ul>\n<li>임대차계약서 상 본인 명의 필수</li>\n<li>실제 거주 확인</li>\n<li>공공임대주택 거주자 제외</li>\n<li>부모와 동거 시 제외</li>\n</ul>\n<hr>\n<h2 id=\"heading-21\">청년 주거 지원</h2>\n<h3 id=\"heading-22\">청년전세자금대출</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대출 한도</td>\n<td>수도권 1.5억, 지방 1억</td>\n</tr>\n<tr>\n<td>금리</td>\n<td>연 1.5~2.1%</td>\n</tr>\n<tr>\n<td>대출 기간</td>\n<td>최대 10년</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>만 19세~34세, 무주택자</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-23\">청년버팀목전세대출</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대출 한도</td>\n<td>최대 2억 원</td>\n</tr>\n<tr>\n<td>금리</td>\n<td>연 1.8~2.4%</td>\n</tr>\n<tr>\n<td>소득 조건</td>\n<td>연 5,000만 원 이하</td>\n</tr>\n<tr>\n<td>주택 가격</td>\n<td>전세금 3억 원 이하</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">청년우대형청약통장</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>금리</td>\n<td>연 4.3% (시중 대비 1.5%p 우대)</td>\n</tr>\n<tr>\n<td>이자 비과세</td>\n<td>500만 원 한도</td>\n</tr>\n<tr>\n<td>소득공제</td>\n<td>납입액 40% (300만 원 한도)</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>만 19세~34세, 무주택, 연소득 3,600만 원 이하</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-25\">청년취업지원제도</h2>\n<h3 id=\"heading-26\">국민취업지원제도</h3>\n<blockquote>\n<p><strong>구직 기간 동안 월 50만 원 + 맞춤형 취업지원 서비스</strong></p>\n</blockquote>\n<h4>Ⅰ유형 (구직촉진수당)</h4>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>월 50만 원 × 6개월 = <strong>300만 원</strong></td>\n</tr>\n<tr>\n<td>자격</td>\n<td>중위소득 60% 이하, 재산 4억 이하</td>\n</tr>\n<tr>\n<td>취업지원</td>\n<td>1:1 상담, 직업훈련, 일경험 프로그램</td>\n</tr>\n</tbody>\n</table>\n<h4>Ⅱ유형 (취업활동비)</h4>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>지원 금액</td>\n<td>취업활동비 최대 195만 원</td>\n</tr>\n<tr>\n<td>자격</td>\n<td>중위소득 120% 이하</td>\n</tr>\n<tr>\n<td>취업지원</td>\n<td>취업알선, 직업훈련 연계</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-27\">청년도전지원사업</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>대상</td>\n<td>취업·교육·훈련에 참여하지 않는 청년 (니트족)</td>\n</tr>\n<tr>\n<td>지원</td>\n<td>맞춤형 프로그램 + 수당 월 50만 원</td>\n</tr>\n<tr>\n<td>기간</td>\n<td>최대 6개월</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">청년내일채움공제</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>참여 기간</td>\n<td>2년</td>\n</tr>\n<tr>\n<td>청년 납입</td>\n<td>월 16만 원 (총 384만 원)</td>\n</tr>\n<tr>\n<td>정부 지원</td>\n<td>600만 원</td>\n</tr>\n<tr>\n<td>기업 지원</td>\n<td>200만 원</td>\n</tr>\n<tr>\n<td><strong>만기 수령액</strong></td>\n<td><strong>1,200만 원+α</strong></td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-29\">청년 교육 지원</h2>\n<h3 id=\"heading-30\">국가장학금</h3>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>지원액 (연간)</th>\n<th>소득 조건</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ⅰ유형</td>\n<td>520만~700만 원</td>\n<td>학자금 지원 1~8구간</td>\n</tr>\n<tr>\n<td>Ⅱ유형</td>\n<td>대학 자체 기준</td>\n<td>대학별 상이</td>\n</tr>\n<tr>\n<td>다자녀</td>\n<td>등록금 전액</td>\n<td>3자녀 이상 가정</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">국가근로장학금</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>시급</td>\n<td>교내 11,640원, 교외 13,010원</td>\n</tr>\n<tr>\n<td>연간 한도</td>\n<td>약 400만 원</td>\n</tr>\n<tr>\n<td>근무시간</td>\n<td>주 20시간 이내</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-32\">학자금대출</h3>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>금리</th>\n<th>상환 방식</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>취업 후 상환 (ICL)</td>\n<td>연 1.7%</td>\n<td>소득 발생 후 상환</td>\n</tr>\n<tr>\n<td>일반 상환</td>\n<td>연 1.7%</td>\n<td>졸업 후 즉시 상환</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-33\">청년 정책 신청 꿀팁</h2>\n<h3 id=\"heading-34\">정보 확인 채널</h3>\n<table>\n<thead>\n<tr>\n<th>채널</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>온통청년</strong></td>\n<td>youth.go.kr - 청년 정책 통합 포털</td>\n</tr>\n<tr>\n<td><strong>정부24</strong></td>\n<td>gov.kr - 행정 서비스 통합</td>\n</tr>\n<tr>\n<td><strong>복지로</strong></td>\n<td>bokjiro.go.kr - 복지 정책 안내</td>\n</tr>\n<tr>\n<td><strong>고용24</strong></td>\n<td>work24.go.kr - 취업 지원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-35\">놓치기 쉬운 청년 정책</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 교통비 지원 (지자체별 상이)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 통신비 지원 (차상위 이하)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 문화생활비 지원 (문화누리카드)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 건강검진 지원</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 마음건강 상담 지원</li>\n</ul>\n<h3 id=\"heading-36\">중복 수혜 가능 여부</h3>\n<table>\n<thead>\n<tr>\n<th>정책 A</th>\n<th>정책 B</th>\n<th>중복 가능</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>청년도약계좌</td>\n<td>청년내일저축</td>\n<td>❌ 불가</td>\n</tr>\n<tr>\n<td>청년미래적금</td>\n<td>청년내일저축</td>\n<td>❌ 불가 (예정)</td>\n</tr>\n<tr>\n<td>청년월세지원</td>\n<td>청년미래적금</td>\n<td>✅ 가능 (예정)</td>\n</tr>\n<tr>\n<td>국민취업지원</td>\n<td>청년미래적금</td>\n<td>✅ 가능 (예정)</td>\n</tr>\n<tr>\n<td>국가장학금</td>\n<td>근로장학금</td>\n<td>✅ 가능</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-37\">2026년 청년 지원 체크리스트</h2>\n<h3 id=\"heading-38\">자산 형성</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년도약계좌 기존 가입자: 유지 관리</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년미래적금 출시 대기 (2026년 6월 예정)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년내일저축 대상 여부 확인 (현재 가입 가능)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년우대형청약통장 전환</li>\n</ul>\n<h3 id=\"heading-39\">주거 지원</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년월세지원 신청</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년전세대출 조건 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년 행복주택 입주 신청</li>\n</ul>\n<h3 id=\"heading-40\">취업 지원</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 국민취업지원제도 상담</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 청년내일채움공제 확인</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 고용센터 방문 상담</li>\n</ul>\n<hr>\n<h2 id=\"heading-41\">마무리</h2>\n<p>청년 정책은 <strong>아는 만큼 혜택</strong>을 받습니다!</p>\n<p>가장 중요한 것:</p>\n<ol>\n<li><strong>온통청년 포털</strong>에서 내 조건에 맞는 정책 확인</li>\n<li><strong>마감일</strong> 놓치지 않고 신청</li>\n<li><strong>중복 가능한 정책</strong>은 모두 신청</li>\n</ol>\n<p>궁금한 점은 청년정책상담 콜센터 <strong>1688-1920</strong>으로 문의하세요!</p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/minimum-wage-2026\">2026년 최저임금 완벽 가이드</a></li>\n<li><a href=\"/posts/year-end-tax-settlement-2026\">2026년 연말정산 완벽 가이드</a></li>\n</ul>\n1d:[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\",\"dangerouslySetInnerHTML\":{\"__html\":\"$22\"}}]\n1e:[\"$\",\"nav\",null,{\"className\":\"border-t border-gray-200 pt-8 mt-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L6\",null,{\"href\":\"/posts/year-end-tax-settlement-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"이전 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 연말정산 완벽 가이드: 절세 팁, 공제 항목, 달라진 점 총정리\"}]]}],[\"$\",\"$L6\",null,{\"href\":\"/posts/2026-new-laws-guide\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"다음 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 새롭게 바뀌는 법률 15가지 총정리\"}]]}]]}]}]\n1f:[\"$\",\"section\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-200\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-gray-900 mb-6\",\"children\":\"관련 게시글\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L6\",\"self-employed-tax-guide-2026\",{\"href\":\"/posts/self-employed-tax-guide-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\"}]]}],[\"$\",\"$L6\",\"real-estate-tax-guide-2026\",{\"href\":\"/posts/real-estate-tax-guide-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 부동산 세금을 한눈에 정리했습니다. 취득세, 양도소득세, 종합부동산세의 세율과 계산 방법, 절세 전략까지 꼭 알아야 할 핵심 내용을 확인하세요.\"}]]}],[\"$\",\"$L6\",\"national-pension-reform-2026\",{\"href\":\"/posts/national-pension-reform-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 1월부터 시행되는 국민연금 개정안의 모든 것! 보험료율 9%→13% 단계적 인상, 소득대체율 43% 상향, 국가 지급보장 명문화까지 18년 만의 연금개혁을 쉽게 정리했습니다.\"}]]}]]}]]}]\n23:I[622,[],\"IconMark\"]\n14:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지 | 쓱싹 | 쓱싹\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2026년 청년을 위한 정부 지원 정책을 총정리했습니다. 청년도약계좌 종료 후 출시되는 청년미래적금, 청년내일저축계좌, 청년월세지원까지 놓치지 마세요.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"청년정책, 청년미래적금, 청년지원금, 정부지원, 청년월세, 청년취업\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"google-adsense-account\",\"content\":\"ca-pub-3591490977493759\"}],[\"$\",\"link\",\"9\",{\"rel\":\"canonical\",\"href\":\"https://sseuksak.com/posts/youth-policy-2026\"}],[\"$\",\"meta\",\"10\",{\"name\":\"google-site-verification\",\"content\":\"05uSSCwIsJLxLnMlswVBzMSOwEeGCOkpMhx9YJMZcng\"}],[\"$\",\"meta\",\"11\",{\"name\":\"naver-site-verification\",\"content\":\"f82b9ef52a15379f29a3f6d9ffe4dd6b9d6cc43b\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지 | 쓱싹\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"2026년 청년을 위한 정부 지원 정책을 총정리했습니다. 청년도약계좌 종료 후 출시되는 청년미래적금, 청년내일저축계좌, 청년월세지원까지 놓치지 마세요.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://sseuksak.com/posts/youth-policy-2026\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"ko_KR\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://images.unsplash.com/photo-1556155092-490a1ba16284?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:alt\",\"content\":\"2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"22\",{\"property\":\"article:published_time\",\"content\":\"2026-01-06\"}],[\"$\",\"meta\",\"23\",{\"property\":\"article:author\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"24\",{\"property\":\"article:section\",\"content\":\"finance\"}],[\"$\",\"meta\",\"25\",{\"property\":\"article:tag\",\"content\":\"청년정책\"}],[\"$\",\"meta\",\"26\",{\"property\":\"article:tag\",\"content\":\"청년미래적금\"}],[\"$\",\"meta\",\"27\",{\"property\":\"article:tag\",\"content\":\"청년지원금\"}],[\"$\",\"meta\",\"28\",{\"property\":\"article:tag\",\"content\":\"정부지원\"}],[\"$\",\"meta\",\"29\",{\"property\":\"article:tag\",\"content\":\"청년월세\"}],[\"$\",\"meta\",\"30\",{\"property\":\"article:tag\",\"content\":\"청년취업\"}],[\"$\",\"meta\",\"31\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"32\",{\"name\":\"twitter:title\",\"content\":\"2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지 | 쓱싹\"}],[\"$\",\"meta\",\"33\",{\"name\":\"twitter:description\",\"content\":\"2026년 청년을 위한 정부 지원 정책을 총정리했습니다. 청년도약계좌 종료 후 출시되는 청년미래적금, 청년내일저축계좌, 청년월세지원까지 놓치지 마세요.\"}],[\"$\",\"meta\",\"34\",{\"name\":\"twitter:image\",\"content\":\"https://images.unsplash.com/photo-1556155092-490a1ba16284?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"link\",\"35\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L23\",\"36\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n"}