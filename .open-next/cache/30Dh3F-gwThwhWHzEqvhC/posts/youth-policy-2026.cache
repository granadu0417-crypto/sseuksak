\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003e신청 방법\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e복지로\\u003c/strong\\u003e (\\u003ca href=\\\"http://www.bokjiro.go.kr\\\"\\u003ewww.bokjiro.go.kr\\u003c/a\\u003e) 접속\\u003c/li\\u003e\\n\\u003cli\\u003e청년월세 한시 특별지원 검색\\u003c/li\\u003e\\n\\u003cli\\u003e온라인 신청\\u003c/li\\u003e\\n\\u003cli\\u003e서류 제출 (임대차계약서, 계좌이체 내역)\\u003c/li\\u003e\\n\\u003cli\\u003e심사 후 지급\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e주의사항\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e임대차계약서 상 본인 명의 필수\\u003c/li\\u003e\\n\\u003cli\\u003e실제 거주 확인\\u003c/li\\u003e\\n\\u003cli\\u003e공공임대주택 거주자 제외\\u003c/li\\u003e\\n\\u003cli\\u003e부모와 동거 시 제외\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-21\\\"\\u003e청년 주거 지원\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e청년전세자금대출\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e수도권 1.5억, 지방 1억\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e금리\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.5~2.1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 10년\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e만 19세~34세, 무주택자\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e청년버팀목전세대출\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 2억 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e금리\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.8~2.4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득 조건\\u003c/td\\u003e\\n\\u003ctd\\u003e연 5,000만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e주택 가격\\u003c/td\\u003e\\n\\u003ctd\\u003e전세금 3억 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e청년우대형청약통장\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e금리\\u003c/td\\u003e\\n\\u003ctd\\u003e연 4.3% (시중 대비 1.5%p 우대)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이자 비과세\\u003c/td\\u003e\\n\\u003ctd\\u003e500만 원 한도\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e소득공제\\u003c/td\\u003e\\n\\u003ctd\\u003e납입액 40% (300만 원 한도)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e만 19세~34세, 무주택, 연소득 3,600만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e청년취업지원제도\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e국민취업지원제도\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e구직 기간 동안 월 50만 원 + 맞춤형 취업지원 서비스\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003eⅠ유형 (구직촉진수당)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원 금액\\u003c/td\\u003e\\n\\u003ctd\\u003e월 50만 원 × 6개월 = \\u003cstrong\\u003e300만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e중위소득 60% 이하, 재산 4억 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e1:1 상담, 직업훈련, 일경험 프로그램\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003eⅡ유형 (취업활동비)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원 금액\\u003c/td\\u003e\\n\\u003ctd\\u003e취업활동비 최대 195만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e중위소득 120% 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e취업알선, 직업훈련 연계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e청년도전지원사업\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대상\\u003c/td\\u003e\\n\\u003ctd\\u003e취업·교육·훈련에 참여하지 않는 청년 (니트족)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원\\u003c/td\\u003e\\n\\u003ctd\\u003e맞춤형 프로그램 + 수당 월 50만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기간\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 6개월\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e청년내일채움공제\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e참여 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e2년\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e청년 납입\\u003c/td\\u003e\\n\\u003ctd\\u003e월 16만 원 (총 384만 원)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e정부 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e600만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e기업 지원\\u003c/td\\u003e\\n\\u003ctd\\u003e200만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e만기 수령액\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1,200만 원+α\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-29\\\"\\u003e청년 교육 지원\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e국가장학금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e지원액 (연간)\\u003c/th\\u003e\\n\\u003cth\\u003e소득 조건\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eⅠ유형\\u003c/td\\u003e\\n\\u003ctd\\u003e520만~700만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e학자금 지원 1~8구간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eⅡ유형\\u003c/td\\u003e\\n\\u003ctd\\u003e대학 자체 기준\\u003c/td\\u003e\\n\\u003ctd\\u003e대학별 상이\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다자녀\\u003c/td\\u003e\\n\\u003ctd\\u003e등록금 전액\\u003c/td\\u003e\\n\\u003ctd\\u003e3자녀 이상 가정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e국가근로장학금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시급\\u003c/td\\u003e\\n\\u003ctd\\u003e교내 11,640원, 교외 13,010원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연간 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e약 400만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e근무시간\\u003c/td\\u003e\\n\\u003ctd\\u003e주 20시간 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e학자금대출\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e금리\\u003c/th\\u003e\\n\\u003cth\\u003e상환 방식\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업 후 상환 (ICL)\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득 발생 후 상환\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일반 상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e졸업 후 즉시 상환\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-33\\\"\\u003e청년 정책 신청 꿀팁\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e정보 확인 채널\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e채널\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e온통청년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003eyouth.go.kr - 청년 정책 통합 포털\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e정부24\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003egov.kr - 행정 서비스 통합\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e복지로\\u003c/strong\\u