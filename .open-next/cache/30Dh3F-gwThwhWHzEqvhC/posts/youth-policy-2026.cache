\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 고용센터 방문 상담\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-41\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e청년 정책은 \\u003cstrong\\u003e아는 만큼 혜택\\u003c/strong\\u003e을 받습니다!\\u003c/p\\u003e\\n\\u003cp\\u003e가장 중요한 것:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e온통청년 포털\\u003c/strong\\u003e에서 내 조건에 맞는 정책 확인\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e마감일\\u003c/strong\\u003e 놓치지 않고 신청\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e중복 가능한 정책\\u003c/strong\\u003e은 모두 신청\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e궁금한 점은 청년정책상담 콜센터 \\u003cstrong\\u003e1688-1920\\u003c/strong\\u003e으로 문의하세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/minimum-wage-2026\\\"\\u003e2026년 최저임금 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/year-end-tax-settlement-2026\\\"\\u003e2026년 연말정산 완벽 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$22\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/year-end-tax-settlement-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm 