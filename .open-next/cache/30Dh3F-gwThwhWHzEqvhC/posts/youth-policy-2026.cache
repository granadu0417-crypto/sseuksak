003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eⅠ유형\\u003c/td\\u003e\\n\\u003ctd\\u003e520만~700만 원\\u003c/td\\u003e\\n\\u003ctd\\u003e학자금 지원 1~8구간\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003eⅡ유형\\u003c/td\\u003e\\n\\u003ctd\\u003e대학 자체 기준\\u003c/td\\u003e\\n\\u003ctd\\u003e대학별 상이\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다자녀\\u003c/td\\u003e\\n\\u003ctd\\u003e등록금 전액\\u003c/td\\u003e\\n\\u003ctd\\u003e3자녀 이상 가정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e국가근로장학금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시급\\u003c/td\\u003e\\n\\u003ctd\\u003e교내 11,640원, 교외 13,010원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연간 한도\\u003c/td\\u003e\\n\\u003ctd\\u003e약 400만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e근무시간\\u003c/td\\u003e\\n\\u003ctd\\u003e주 20시간 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003e학자금대출\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e금리\\u003c/th\\u003e\\n\\u003cth\\u003e상환 방식\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업 후 상환 (ICL)\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e소득 발생 후 상환\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e일반 상환\\u003c/td\\u003e\\n\\u003ctd\\u003e연 1.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e졸업 후 즉시 상환\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u0