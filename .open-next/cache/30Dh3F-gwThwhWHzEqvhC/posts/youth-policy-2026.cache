x8fDE3Njc2NzM4ODR8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556155092-490a1ba16284%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556155092-490a1ba16284%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1556155092-490a1ba16284%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=3840&amp;q=75\"/><div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\"><a href=\"https://unsplash.com/@austindistel?utm_source=sseuksak&amp;utm_medium=referral\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white\">Photo by Austin Distel on Unsplash</a></div></div><nav class=\"bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8\"><button class=\"flex items-center justify-between w-full text-left font-semibold text-gray-900\"><span class=\"flex items-center gap-2\"><svg class=\"w-5 h-5 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h7\"></path></svg>목차</span><svg class=\"w-5 h-5 text-gray-500 transition-transform rotate-180\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button><ul class=\"mt-3 space-y-2 border-t border-gray-200 pt-3\"><li class=\"\"><a href=\"#heading-0\" class=\"