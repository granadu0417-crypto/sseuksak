tr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e만 19세~34세, 무주택, 연소득 3,600만 원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e청년취업지원제도\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e국민취업지원제도\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e구직 기간 동안 월 50만 원 + 맞춤형 취업지원 서비스\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003eⅠ유형 (구직촉진수당)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원 금액\\u003c/td\\u003e\\n\\u003ctd\\u003e월 50만 원 × 6개월 = \\u003cstrong\\u003e300만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e중위소득 60% 이하, 재산 4억 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e1:1 상담, 직업훈련, 일경험 프로그램\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003eⅡ유형 (취업활동비)\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e지원 금액\\u003c/td\\u003e\\n\\u003ctd\\u003e취업활동비 최대 195만 원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e자격\\u003c/td\\u003e\\n\\u003ctd\\u003e중위소득 120% 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취업지원\\u003c/td\\u003e\\n\\u003ctd\\u003e취업알선, 직업훈련 연계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e청년도전지원사업\\u003c/h3\\u003e\\n\\u003ctab