eading-33\\\"\\u003e13. 의료비 부담 경감\\u003c/h2\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e시행일: 2025년 9월 1일 (선 시행)\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003e다발골수종 치료제 보험 적용 확대\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e변경 전\\u003c/th\\u003e\\n\\u003cth\\u003e변경 후\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보험 적용\\u003c/td\\u003e\\n\\u003ctd\\u003e1차 또는 4차 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2차 이상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연간 약제비\\u003c/td\\u003e\\n\\u003ctd\\u003e약 8,320만원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 416만원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e본인부담률\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003ctd\\u003e5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e14. 세금계산서 발급 의무 강화\\u003c/h2\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e시행일: 2026년 1월 1일\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003e전자세금계산서 의무 확대\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e개인사업자 발급 의무 기준 하향\\u003c/li\\u003e\\n\\u003cli\\u003e미발급 시 가산세 강화\\u003c/li\\u003e\\n\\u003cli\\u003e성실신고 유도 목적\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-37\\\"\\u003e15. 최저임금 인상\\u003c/h2\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e시행일: 2026년 1월 1일\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e2025년\\u003c/th\\u003e\\n\\u003cth\\u003e2026년\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e시급\\u003c/td\\u003e\\n\\u003ctd\\u003e10,030원\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10,320원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인상률\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003ctd\\u003e2.9%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e월급 (209시간)\\u003c/td\\u003e\\n\\u003ctd\\u003e2,096,270원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,156,880원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-38\\\"\\u003e월별 시행 일정 총정리\\u003c/h2\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시행일\\u003c/th\\u003e\\n\\u003cth\\u003e법률/제도\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.01.01\\u003c/td\\u003e\\n\\u003ctd\\u003e구하라법, 곰 사육 금지, 건강보험료 인상, 법인세 인상, 최저임금 인상, 면허갱신 변경\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.01.22\\u003c/td\\u003e\\n\\u003ctd\\u003eAI 기본법\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.03.10\\u003c/td\\u003e\\n\\u003ctd\\u003e노란봉투법\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.04.02\\u003c/td\\u003e\\n\\u003ctd\\u003e약물운전 처벌 강화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.05.01\\u003c/td\\u003e\\n\\u003ctd\\u003e노동절 명칭 변경\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.07\\u003c/td\\u003e\\n\\u003ctd\\u003e대형 상장회사 지배구조 규정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-39\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년에는 국민 생활 전반에 걸쳐 다양한 법률이 변경됩니다. 특히 \\u003cstrong\\u003e구하라법\\u003c/strong\\u003e, \\u003cstrong\\u003eAI기본법\\u003c/strong\\u003e, \\u003cstrong\\u003e노란봉투법\\u003c/strong\\u003e 등은 사회적으로 큰 영향을 미칠 것으로 예상됩니다.\\u003c/p\\u003e\\n\\u003cp\\u003e각 법률의 시행 시기가 다르므로, 본인에게 해당되는 사항은 \\u003cstrong\\u003e시행일을 꼭 확인\\u003c/strong\\u003e하시고 미리 준비하시기 바랍니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-40\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 국민연금 개편 핵심 정리\\u003c/li\\u003e\\n\\u003cli\\u003e2026년 건강보험료 인상 대응법\\u003c/li\\u003e\\n\\u003cli\\u003e2026년 연말정산 달라지는 점\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었으며, 법률 시행 세부사항은 관계 부처 공식 발표를 참고하시기 바랍니다.\\u003c/em\\u003e\\u003c/p\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$25\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/youth-policy-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 청년 정책 총정리: 청년미래적금, 청년내일저축, 주거지원까지\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/car-insurance-renewal-guide-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"다음 글\\\"}],[\\\