-1616400619175-5beda3a17896?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxzdHVkeXxlbnwwfDB8fHwxNzY3NjczODg1fDA\\u0026ixlib=rb-4.1.0\\u0026w=1200\\u0026q=85\\u0026fm=auto\\u0026fit=crop\\\",\\\"alt\\\":\\\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 768px) 100vw, 896px\\\",\\\"className\\\":\\\"object-cover\\\",\\\"priority\\\":true}],\\\"$L1b\\\"]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\"]}]]\\n\"])</script><script>self.__next_f.push([1,\"20:I[286,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-5cad24532f4c0e5d.js\\\",\\\"858\\\",\\\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\\\"],\\\"default\\\"]\\n1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://unsplash.com/@imkirk?utm_source=sseuksak\\u0026utm_medium=referral\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"hover:text-white\\\",\\\"children\\\":\\\"Photo by Iewek Gnos on Unsplash\\\"}]}]\\n21:T3673,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e고교학점제 1년, 학부모가 알아야 할 모든 것: 2026년 핵심 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"아이가 고등학교 가는데, 고교학점제가 뭔지 잘 모르겠어요.\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2025년 3월 전면 시행된 \\u003cstrong\\u003e고교학점제\\u003c/strong\\u003e가 어느덧 1년을 맞이했습니다. 하지만 여전히 많은 학부모님들이 이 제도를 정확히 이해하지 못하고 계십니다.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 고교학점제의 \\u003cstrong\\u003e모든 것\\u003c/strong\\u003e을 학부모 관점에서 정리해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e고교학점제란?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한마디로 정의\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e학생이 직접 과목을 선택하고, 정해진 학점을 이수하면 졸업하는 제도\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003cp\\u003e기존 고등학교 교육은 모든 학생이 똑같은 과목을 똑같이 배웠습니다. 고교학점제는 대학처럼 \\u003cstrong\\u003e자신의 진로와 적성에 맞게\\u003c/strong\\u003e 과목을 선택할 수 있게 합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e왜 도입되었나요?\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기존 문제점\\u003c/th\\u003e\\n\\u003cth\\u003e고교학점제 해결책\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e획일화된 교육과정\\u003c/td\\u003e\\n\\u003ctd\\u003e개인별 맞춤형 교육\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e진로 탐색 기회 부족\\u003c/td\\u003e\\n\\u003ctd\\u003e다양한 과목 선택 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수동적 학습 태도\\u003c/td\\u003e\\n\\u003ctd\\u003e능동적 학습 설계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e성적 위주 평가\\u003c/td\\u003e\\n\\u003ctd\\u003e역량 중심 평가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e도입 일정과 현재 상황\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e단계별 도입 경과\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2020년\\u003c/td\\u003e\\n\\u003ctd\\u003e마이스터고 도입\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2022년\\u003c/td\\u003e\\n\\u003ctd\\u003e특성화고 전면 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2023년\\u003c/td\\u003e\\n\\u003ctd\\u003e일반고 1학년 부분 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2024년\\u003c/td\\u003e\\n\\u003ctd\\u003e일반고 1~2학년 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2025년 3월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e전면 시행\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e시행 1주년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e2026년 현재 상황\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e모든 고등학교\\u003c/strong\\u003e에서 고교학점제 시행 중\\u003c/li\\u003e\\n\\u003cli\\u003e2025년 입학생부터 완전 적용\\u003c/li\\u003e\\n\\u003cli\\u003e기존 재학생은 경과 조치 적용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e핵심 내용 5가지\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e1. 졸업 학점 기준\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e3년간 192학점 이수 시 졸업\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e학점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교과\\u003c/td\\u003e\\n\\u003ctd\\u003e174학점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e창의적 체험활동\\u003c/td\\u003e\\n\\u003ctd\\u003e18학점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e총 졸업 학점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e192학점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e참고\\u003c/strong\\u003e: 1학점 = 50분 수업 16회(한 학기)\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e2. 과목 선택권 확대\\u003c/h3\\u003e\\n\\u003cp\\u003e학생이 직접 선택할 수 있는 과목 범위:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e영역\\u003c/th\\u003e\\n\\u003cth\\u003e선택 가능 과목 예시\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국어\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e화법과 작문, 독서, 문학, 언어와 매체 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e수학\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e수학Ⅰ, 수학Ⅱ, 미적분, 확률과 통계 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e영어\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e영어Ⅰ, 영어Ⅱ, 영어 독해와 작문 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e사회\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e한국지리, 세계지리, 동아시아사, 정치와 법 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e과학\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e물리학, 화학, 생명과학, 지구과학 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e예체능\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e미술, 음악, 체육, 연극 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e진로선택\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 관련 심화 과목\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e3. 최소 성취수준 제도\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e과목별 최소 기준에 도달해야 학점 인정\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상황\\u003c/th\\u003e\\n\\u003cth\\u003e결과\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최소 성취수준 도달\\u003c/td\\u003e\\n\\u003ctd\\u003e학점 인정 (P: Pass)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e미도달\\u003c/td\\u003e\\n\\u003ctd\\u003e보충 이수 후 재평가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e미도달 시 절차\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e과목담당 교사와 보충 학습\\u003c/li\\u003e\\n\\u003cli\\u003e방과후 또는 방학 중 보충 프로그램\\u003c/li\\u003e\\n\\u003cli\\u003e재평가 후 학점 인정 여부 결정\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e4. 성적 산출 방식 변화\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e기존\\u003c/th\\u003e\\n\\u003cth\\u003e고교학점제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e성적표기\\u003c/td\\u003e\\n\\u003ctd\\u003e등급(1~9등급)\\u003c/td\\u003e\\n\\u003ctd\\u003e성취도(A~E) + 등급 병기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e평가기준\\u003c/td\\u003e\\n\\u003ctd\\u003e상대평가 위주\\u003c/td\\u003e\\n\\u003ctd\\u003e절대평가 도입 확대\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e석차표기\\u003c/td\\u003e\\n\\u003ctd\\u003e모든 과목\\u003c/td\\u003e\\n\\u003ctd\\u003e공통과목만\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e5. 공동교육과정\\u003c/h3\\u003e\\n\\u003cp\\u003e자기 학교에 없는 과목은 \\u003cstrong\\u003e다른 학교 또는 온라인\\u003c/strong\\u003e으로 이수 가능!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e오프라인 공동교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e근처 학교에서 수업 수강\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e온라인 공동교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e실시간 화상 수업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e지역 연합 교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e지역 교육청 주관 프로그램\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e학부모가 꼭 알아야 할 것\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e자녀의 진로 탐색 지원하기\\u003c/h3\\u003e\\n\\u003cp\\u003e고교학점제에서 \\u003cstrong\\u003e가장 중요한 것은 진로 설정\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003ch4\\u003e진로 탐색 시기\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e활동\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중3\\u003c/td\\u003e\\n\\u003ctd\\u003e고등학교 입학 전 진로 탐색 시작\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고1 1학기\\u003c/td\\u003e\\n\\u003ctd\\u003e관심 분야 파악, 기초 과목 탐색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고1 2학기\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 심화 과목 선택 준비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고2~3\\u003c/td\\u003e\\n\\u003ctd\\u003e진로에 맞는 심화 과목 집중 이수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e학부모 역할\\u003c/h4\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대화하기\\u003c/strong\\u003e: 자녀의 관심사와 꿈에 대해 자주 이야기\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e정보 제공\\u003c/strong\\u003e: 다양한 직업과 진로 정보 함께 탐색\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e체험 기회\\u003c/strong\\u003e: 직업 체험, 대학 탐방 등 기회 마련\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e결정 존중\\u003c/strong\\u003e: 최종 과목 선택은 자녀의 결정 존중\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e과목 선택 전략\\u003c/h3\\u003e\\n\\u003ch4\\u003e대학 진학 목표인 경우\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e전공 희망\\u003c/th\\u003e\\n\\u003cth\\u003e추천 선택 과목\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이공계\\u003c/td\\u003e\\n\\u003ctd\\u003e미적분, 물리학Ⅱ, 화학Ⅱ 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e의약계\\u003c/td\\u003e\\n\\u003ctd\\u003e생명과학Ⅱ, 화학Ⅱ 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인문사회\\u003c/td\\u003e\\n\\u003ctd\\u003e사회문화, 윤리와 사상, 제2외국어 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상경계\\u003c/td\\u003e\\n\\u003ctd\\u003e경제, 수학Ⅱ, 확률과 통계 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e예술계\\u003c/td\\u003e\\n\\u003ctd\\u003e예술 관련 전문 과목, 실기 과목\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e주의사항\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대학별 선택과목 가이드라인\\u003c/strong\\u003e 확인 필수\\u003c/li\\u003e\\n\\u003cli\\u003e희망 대학의 \\u003cstrong\\u003e입학전형 요강\\u003c/strong\\u003e 미리 파악\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e학과별 권장 이수 과목\\u003c/strong\\u003e 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e성적 관리 포인트\\u003c/h3\\u003e\\n\\u003ch4\\u003e절대평가 과목 전략\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e진로선택 과목은 \\u003cstrong\\u003e절대평가\\u003c/strong\\u003e(A, B, C)\\u003c/li\\u003e\\n\\u003cli\\u003e등급 경쟁 부담 감소\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e실력 향상\\u003c/strong\\u003e에 집중 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e상대평가 과목 전략\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e공통과목, 일반선택 과목은 \\u003cstrong\\u003e등급\\u003c/strong\\u003e 산출\\u003c/li\\u003e\\n\\u003cli\\u003e수강 인원 고려하여 과목 선택\\u003c/li\\u003e\\n\\u003cli\\u003e내신 관리와 실력 균형 맞추기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-16\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003eQ1. 과목을 잘못 선택하면 어떻게 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e학기 중에는 변경이 어렵습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e과목 선택 기간에 신중하게 결정\\u003c/li\\u003e\\n\\u003cli\\u003e담임교사, 진로상담교사와 충분히 상담\\u003c/li\\u003e\\n\\u003cli\\u003e학기 시작 전까지 수정 가능한 경우 있음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003eQ2. 최소 성취수준 미달하면 유급되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e바로 유급되지는 않습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e보충 이수 기회 제공\\u003c/li\\u003e\\n\\u003cli\\u003e재평가 후에도 미달 시 해당 과목만 미인정\\u003c/li\\u003e\\n\\u003cli\\u003e졸업 학점(192학점) 미달 시에만 졸업 유예\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003eQ3. 우리 학교에 원하는 과목이 없으면?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e공동교육과정을 활용하세요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e근처 학교에서 수강 가능\\u003c/li\\u003e\\n\\u003cli\\u003e온라인 화상 수업 개설\\u003c/li\\u003e\\n\\u003cli\\u003e지역 교육청 연합 프로그램 참여\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003eQ4. 대학 입시에 불리하지 않나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e오히려 유리할 수 있습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e대학들은 \\u003cstrong\\u003e과목 선택의 적합성\\u003c/strong\\u003e 평가\\u003c/li\\u003e\\n\\u003cli\\u003e전공 관련 심화 과목 이수 시 가산점\\u003c/li\\u003e\\n\\u003cli\\u003e자기주도적 학습 태도 긍정 평가\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003eQ5. 수능과 어떻게 연결되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e수능은 기존대로 진행됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e수능 응시 과목은 별도 선택\\u003c/li\\u003e\\n\\u003cli\\u003e단, 학교 수업에서 선택한 과목과 일치시키는 것이 유리\\u003c/li\\u003e\\n\\u003cli\\u003e수능 사회/과학탐구는 2과목 선택\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e2026년 달라지는 점\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e전면 시행 1년 후 변화\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e2025년 (시행 첫해)\\u003c/th\\u003e\\n\\u003cth\\u003e2026년\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적용 대상\\u003c/td\\u003e\\n\\u003ctd\\u003e1학년 완전 적용\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2학년 완전 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공동교육과정\\u003c/td\\u003e\\n\\u003ctd\\u003e확대 중\\u003c/td\\u003e\\n\\u003ctd\\u003e안정화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e학교별 운영\\u003c/td\\u003e\\n\\u003ctd\\u003e시범 운영 병행\\u003c/td\\u003e\\n\\u003ctd\\u003e본격 운영\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e학부모 관심 포인트\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대입 반영 방식\\u003c/strong\\u003e 구체화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e공동교육과정\\u003c/strong\\u003e 활성화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e진로 상담\\u003c/strong\\u003e 시스템 강화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e성취평가제\\u003c/strong\\u003e 정착\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e학부모를 위한 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e입학 전 준비\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 자녀와 진로에 대해 충분히 대화했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 고교학점제 기본 내용을 이해했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 희망 고등학교의 개설 과목을 확인했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 진로에 맞는 과목 조합을 생각해 봤나요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e재학 중 관리\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 자녀의 과목 선택 과정에 참여하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 성적표의 성취도(A~E)를 이해하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 최소 성취수준 도달 여부를 확인하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 진로 변경 시 과목 조정 방법을 알고 있나요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e대입 준비\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 희망 대학의 선택과목 가이드라인을 확인했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 수능 응시 과목과 학교 수업 과목이 일치하나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 학생부종합전형 대비 과목 선택이 적절한가요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-29\\\"\\u003e도움받을 수 있는 곳\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e온라인 자료\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e사이트\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고교학점제 공식 사이트\\u003c/td\\u003e\\n\\u003ctd\\u003e제도 안내, 학부모 자료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e커리어넷\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 탐색, 직업 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대입정보포털\\u003c/td\\u003e\\n\\u003ctd\\u003e대학별 입시 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e학교알리미\\u003c/td\\u003e\\n\\u003ctd\\u003e학교별 교육과정 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e학교 내 상담\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e담당자\\u003c/th\\u003e\\n\\u003cth\\u003e상담 내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e담임교사\\u003c/td\\u003e\\n\\u003ctd\\u003e전반적인 학교 생활, 과목 선택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e진로상담교사\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 탐색, 직업 연계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교과담당교사\\u003c/td\\u003e\\n\\u003ctd\\u003e과목 특성, 이수 조건\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교무부\\u003c/td\\u003e\\n\\u003ctd\\u003e학점 이수, 졸업 요건\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e고교학점제는 \\u003cstrong\\u003e학생 중심 교육\\u003c/strong\\u003e으로의 큰 변화입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e처음에는 복잡해 보이지만, 핵심은 간단합니다:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e자녀의 진로\\u003c/strong\\u003e를 함께 탐색하세요\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e과목 선택\\u003c/strong\\u003e을 도와주세요\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e스스로 결정\\u003c/strong\\u003e할 수 있게 지원하세요\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e가장 중요한 것은 \\u003cstrong\\u003e자녀와의 대화\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e무엇을 좋아하는지, 어떤 꿈을 가지고 있는지 자주 이야기하면서 함께 준비해 나가시길 바랍니다!\\u003c/p\\u003e\\n\\u003cp\\u003e궁금한 점은 학교 진로상담교사나 담임선생님께 문의하세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/new-certifications-2026-guide\\\"\\u003e2026년 신설 국가자격증 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/national-technical-exam-schedule-2026\\\"\\u003e2026년 국가기술자격 시험일정 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"$L20\\\",null,{\\\"content\\\":\\\"$21\\\"}]\\n22:T3673,\"])</script><script>self.__next_f.push([1,\"\\u003ch1\\u003e고교학점제 1년, 학부모가 알아야 할 모든 것: 2026년 핵심 가이드\\u003c/h1\\u003e\\n\\u003cp\\u003e\\\"아이가 고등학교 가는데, 고교학점제가 뭔지 잘 모르겠어요.\\\"\\u003c/p\\u003e\\n\\u003cp\\u003e2025년 3월 전면 시행된 \\u003cstrong\\u003e고교학점제\\u003c/strong\\u003e가 어느덧 1년을 맞이했습니다. 하지만 여전히 많은 학부모님들이 이 제도를 정확히 이해하지 못하고 계십니다.\\u003c/p\\u003e\\n\\u003cp\\u003e오늘은 고교학점제의 \\u003cstrong\\u003e모든 것\\u003c/strong\\u003e을 학부모 관점에서 정리해드릴게요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-0\\\"\\u003e고교학점제란?\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-1\\\"\\u003e한마디로 정의\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e학생이 직접 과목을 선택하고, 정해진 학점을 이수하면 졸업하는 제도\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003cp\\u003e기존 고등학교 교육은 모든 학생이 똑같은 과목을 똑같이 배웠습니다. 고교학점제는 대학처럼 \\u003cstrong\\u003e자신의 진로와 적성에 맞게\\u003c/strong\\u003e 과목을 선택할 수 있게 합니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e왜 도입되었나요?\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기존 문제점\\u003c/th\\u003e\\n\\u003cth\\u003e고교학점제 해결책\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e획일화된 교육과정\\u003c/td\\u003e\\n\\u003ctd\\u003e개인별 맞춤형 교육\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e진로 탐색 기회 부족\\u003c/td\\u003e\\n\\u003ctd\\u003e다양한 과목 선택 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수동적 학습 태도\\u003c/td\\u003e\\n\\u003ctd\\u003e능동적 학습 설계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e성적 위주 평가\\u003c/td\\u003e\\n\\u003ctd\\u003e역량 중심 평가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-3\\\"\\u003e도입 일정과 현재 상황\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e단계별 도입 경과\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2020년\\u003c/td\\u003e\\n\\u003ctd\\u003e마이스터고 도입\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2022년\\u003c/td\\u003e\\n\\u003ctd\\u003e특성화고 전면 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2023년\\u003c/td\\u003e\\n\\u003ctd\\u003e일반고 1학년 부분 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2024년\\u003c/td\\u003e\\n\\u003ctd\\u003e일반고 1~2학년 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2025년 3월\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e전면 시행\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e시행 1주년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-5\\\"\\u003e2026년 현재 상황\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e모든 고등학교\\u003c/strong\\u003e에서 고교학점제 시행 중\\u003c/li\\u003e\\n\\u003cli\\u003e2025년 입학생부터 완전 적용\\u003c/li\\u003e\\n\\u003cli\\u003e기존 재학생은 경과 조치 적용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-6\\\"\\u003e핵심 내용 5가지\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e1. 졸업 학점 기준\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e3년간 192학점 이수 시 졸업\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e학점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교과\\u003c/td\\u003e\\n\\u003ctd\\u003e174학점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e창의적 체험활동\\u003c/td\\u003e\\n\\u003ctd\\u003e18학점\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e총 졸업 학점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e192학점\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e참고\\u003c/strong\\u003e: 1학점 = 50분 수업 16회(한 학기)\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e2. 과목 선택권 확대\\u003c/h3\\u003e\\n\\u003cp\\u003e학생이 직접 선택할 수 있는 과목 범위:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e영역\\u003c/th\\u003e\\n\\u003cth\\u003e선택 가능 과목 예시\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e국어\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e화법과 작문, 독서, 문학, 언어와 매체 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e수학\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e수학Ⅰ, 수학Ⅱ, 미적분, 확률과 통계 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e영어\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e영어Ⅰ, 영어Ⅱ, 영어 독해와 작문 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e사회\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e한국지리, 세계지리, 동아시아사, 정치와 법 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e과학\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e물리학, 화학, 생명과학, 지구과학 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e예체능\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e미술, 음악, 체육, 연극 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e진로선택\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 관련 심화 과목\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e3. 최소 성취수준 제도\\u003c/h3\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e과목별 최소 기준에 도달해야 학점 인정\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e상황\\u003c/th\\u003e\\n\\u003cth\\u003e결과\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e최소 성취수준 도달\\u003c/td\\u003e\\n\\u003ctd\\u003e학점 인정 (P: Pass)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e미도달\\u003c/td\\u003e\\n\\u003ctd\\u003e보충 이수 후 재평가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e미도달 시 절차\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e과목담당 교사와 보충 학습\\u003c/li\\u003e\\n\\u003cli\\u003e방과후 또는 방학 중 보충 프로그램\\u003c/li\\u003e\\n\\u003cli\\u003e재평가 후 학점 인정 여부 결정\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e4. 성적 산출 방식 변화\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e기존\\u003c/th\\u003e\\n\\u003cth\\u003e고교학점제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e성적표기\\u003c/td\\u003e\\n\\u003ctd\\u003e등급(1~9등급)\\u003c/td\\u003e\\n\\u003ctd\\u003e성취도(A~E) + 등급 병기\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e평가기준\\u003c/td\\u003e\\n\\u003ctd\\u003e상대평가 위주\\u003c/td\\u003e\\n\\u003ctd\\u003e절대평가 도입 확대\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e석차표기\\u003c/td\\u003e\\n\\u003ctd\\u003e모든 과목\\u003c/td\\u003e\\n\\u003ctd\\u003e공통과목만\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e5. 공동교육과정\\u003c/h3\\u003e\\n\\u003cp\\u003e자기 학교에 없는 과목은 \\u003cstrong\\u003e다른 학교 또는 온라인\\u003c/strong\\u003e으로 이수 가능!\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e유형\\u003c/th\\u003e\\n\\u003cth\\u003e설명\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e오프라인 공동교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e근처 학교에서 수업 수강\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e온라인 공동교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e실시간 화상 수업\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e지역 연합 교육과정\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e지역 교육청 주관 프로그램\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e학부모가 꼭 알아야 할 것\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e자녀의 진로 탐색 지원하기\\u003c/h3\\u003e\\n\\u003cp\\u003e고교학점제에서 \\u003cstrong\\u003e가장 중요한 것은 진로 설정\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003ch4\\u003e진로 탐색 시기\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e활동\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중3\\u003c/td\\u003e\\n\\u003ctd\\u003e고등학교 입학 전 진로 탐색 시작\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고1 1학기\\u003c/td\\u003e\\n\\u003ctd\\u003e관심 분야 파악, 기초 과목 탐색\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고1 2학기\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 심화 과목 선택 준비\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고2~3\\u003c/td\\u003e\\n\\u003ctd\\u003e진로에 맞는 심화 과목 집중 이수\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e학부모 역할\\u003c/h4\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대화하기\\u003c/strong\\u003e: 자녀의 관심사와 꿈에 대해 자주 이야기\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e정보 제공\\u003c/strong\\u003e: 다양한 직업과 진로 정보 함께 탐색\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e체험 기회\\u003c/strong\\u003e: 직업 체험, 대학 탐방 등 기회 마련\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e결정 존중\\u003c/strong\\u003e: 최종 과목 선택은 자녀의 결정 존중\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e과목 선택 전략\\u003c/h3\\u003e\\n\\u003ch4\\u003e대학 진학 목표인 경우\\u003c/h4\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e전공 희망\\u003c/th\\u003e\\n\\u003cth\\u003e추천 선택 과목\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이공계\\u003c/td\\u003e\\n\\u003ctd\\u003e미적분, 물리학Ⅱ, 화학Ⅱ 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e의약계\\u003c/td\\u003e\\n\\u003ctd\\u003e생명과학Ⅱ, 화학Ⅱ 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인문사회\\u003c/td\\u003e\\n\\u003ctd\\u003e사회문화, 윤리와 사상, 제2외국어 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e상경계\\u003c/td\\u003e\\n\\u003ctd\\u003e경제, 수학Ⅱ, 확률과 통계 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e예술계\\u003c/td\\u003e\\n\\u003ctd\\u003e예술 관련 전문 과목, 실기 과목\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch4\\u003e주의사항\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대학별 선택과목 가이드라인\\u003c/strong\\u003e 확인 필수\\u003c/li\\u003e\\n\\u003cli\\u003e희망 대학의 \\u003cstrong\\u003e입학전형 요강\\u003c/strong\\u003e 미리 파악\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e학과별 권장 이수 과목\\u003c/strong\\u003e 확인\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e성적 관리 포인트\\u003c/h3\\u003e\\n\\u003ch4\\u003e절대평가 과목 전략\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e진로선택 과목은 \\u003cstrong\\u003e절대평가\\u003c/strong\\u003e(A, B, C)\\u003c/li\\u003e\\n\\u003cli\\u003e등급 경쟁 부담 감소\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e실력 향상\\u003c/strong\\u003e에 집중 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch4\\u003e상대평가 과목 전략\\u003c/h4\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e공통과목, 일반선택 과목은 \\u003cstrong\\u003e등급\\u003c/strong\\u003e 산출\\u003c/li\\u003e\\n\\u003cli\\u003e수강 인원 고려하여 과목 선택\\u003c/li\\u003e\\n\\u003cli\\u003e내신 관리와 실력 균형 맞추기\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-16\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-17\\\"\\u003eQ1. 과목을 잘못 선택하면 어떻게 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e학기 중에는 변경이 어렵습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e과목 선택 기간에 신중하게 결정\\u003c/li\\u003e\\n\\u003cli\\u003e담임교사, 진로상담교사와 충분히 상담\\u003c/li\\u003e\\n\\u003cli\\u003e학기 시작 전까지 수정 가능한 경우 있음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-18\\\"\\u003eQ2. 최소 성취수준 미달하면 유급되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e바로 유급되지는 않습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e보충 이수 기회 제공\\u003c/li\\u003e\\n\\u003cli\\u003e재평가 후에도 미달 시 해당 과목만 미인정\\u003c/li\\u003e\\n\\u003cli\\u003e졸업 학점(192학점) 미달 시에만 졸업 유예\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-19\\\"\\u003eQ3. 우리 학교에 원하는 과목이 없으면?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e공동교육과정을 활용하세요!\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e근처 학교에서 수강 가능\\u003c/li\\u003e\\n\\u003cli\\u003e온라인 화상 수업 개설\\u003c/li\\u003e\\n\\u003cli\\u003e지역 교육청 연합 프로그램 참여\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003eQ4. 대학 입시에 불리하지 않나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e오히려 유리할 수 있습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e대학들은 \\u003cstrong\\u003e과목 선택의 적합성\\u003c/strong\\u003e 평가\\u003c/li\\u003e\\n\\u003cli\\u003e전공 관련 심화 과목 이수 시 가산점\\u003c/li\\u003e\\n\\u003cli\\u003e자기주도적 학습 태도 긍정 평가\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-21\\\"\\u003eQ5. 수능과 어떻게 연결되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e수능은 기존대로 진행됩니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e수능 응시 과목은 별도 선택\\u003c/li\\u003e\\n\\u003cli\\u003e단, 학교 수업에서 선택한 과목과 일치시키는 것이 유리\\u003c/li\\u003e\\n\\u003cli\\u003e수능 사회/과학탐구는 2과목 선택\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-22\\\"\\u003e2026년 달라지는 점\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e전면 시행 1년 후 변화\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e2025년 (시행 첫해)\\u003c/th\\u003e\\n\\u003cth\\u003e2026년\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e적용 대상\\u003c/td\\u003e\\n\\u003ctd\\u003e1학년 완전 적용\\u003c/td\\u003e\\n\\u003ctd\\u003e1~2학년 완전 적용\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공동교육과정\\u003c/td\\u003e\\n\\u003ctd\\u003e확대 중\\u003c/td\\u003e\\n\\u003ctd\\u003e안정화\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e학교별 운영\\u003c/td\\u003e\\n\\u003ctd\\u003e시범 운영 병행\\u003c/td\\u003e\\n\\u003ctd\\u003e본격 운영\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e학부모 관심 포인트\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e대입 반영 방식\\u003c/strong\\u003e 구체화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e공동교육과정\\u003c/strong\\u003e 활성화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e진로 상담\\u003c/strong\\u003e 시스템 강화\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e성취평가제\\u003c/strong\\u003e 정착\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e학부모를 위한 체크리스트\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e입학 전 준비\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 자녀와 진로에 대해 충분히 대화했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 고교학점제 기본 내용을 이해했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 희망 고등학교의 개설 과목을 확인했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 진로에 맞는 과목 조합을 생각해 봤나요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e재학 중 관리\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 자녀의 과목 선택 과정에 참여하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 성적표의 성취도(A~E)를 이해하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 최소 성취수준 도달 여부를 확인하고 있나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 진로 변경 시 과목 조정 방법을 알고 있나요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e대입 준비\\u003c/h3\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 희망 대학의 선택과목 가이드라인을 확인했나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 수능 응시 과목과 학교 수업 과목이 일치하나요?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 학생부종합전형 대비 과목 선택이 적절한가요?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-29\\\"\\u003e도움받을 수 있는 곳\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003e온라인 자료\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e사이트\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e고교학점제 공식 사이트\\u003c/td\\u003e\\n\\u003ctd\\u003e제도 안내, 학부모 자료\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e커리어넷\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 탐색, 직업 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대입정보포털\\u003c/td\\u003e\\n\\u003ctd\\u003e대학별 입시 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e학교알리미\\u003c/td\\u003e\\n\\u003ctd\\u003e학교별 교육과정 정보\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003e학교 내 상담\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e담당자\\u003c/th\\u003e\\n\\u003cth\\u003e상담 내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e담임교사\\u003c/td\\u003e\\n\\u003ctd\\u003e전반적인 학교 생활, 과목 선택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e진로상담교사\\u003c/td\\u003e\\n\\u003ctd\\u003e진로 탐색, 직업 연계\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교과담당교사\\u003c/td\\u003e\\n\\u003ctd\\u003e과목 특성, 이수 조건\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e교무부\\u003c/td\\u003e\\n\\u003ctd\\u003e학점 이수, 졸업 요건\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-32\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e고교학점제는 \\u003cstrong\\u003e학생 중심 교육\\u003c/strong\\u003e으로의 큰 변화입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e처음에는 복잡해 보이지만, 핵심은 간단합니다:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e자녀의 진로\\u003c/strong\\u003e를 함께 탐색하세요\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e과목 선택\\u003c/strong\\u003e을 도와주세요\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e스스로 결정\\u003c/strong\\u003e할 수 있게 지원하세요\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e가장 중요한 것은 \\u003cstrong\\u003e자녀와의 대화\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e무엇을 좋아하는지, 어떤 꿈을 가지고 있는지 자주 이야기하면서 함께 준비해 나가시길 바랍니다!\\u003c/p\\u003e\\n\\u003cp\\u003e궁금한 점은 학교 진로상담교사나 담임선생님께 문의하세요.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/new-certifications-2026-guide\\\"\\u003e2026년 신설 국가자격증 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/national-technical-exam-schedule-2026\\\"\\u003e2026년 국가기술자격 시험일정 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$22\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/health-insurance-premium-2026\\\",\\\"className\\\":\\\"group flex f