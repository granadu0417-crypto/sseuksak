7-7 7\"}]}],[\"$\",\"span\",null,{\"className\":\"text-gray-900 font-medium truncate max-w-[200px]\",\"children\":\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것\"}]]}]]]}]}],[\"$\",\"header\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl font-bold text-gray-900 mb-4\",\"children\":\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 text-sm text-gray-500\",\"children\":[[\"$\",\"time\",null,{\"dateTime\":\"2026-01-06\",\"children\":\"2026년 1월 6일\"}],[\"$\",\"span\",null,{\"children\":\"12 min read\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2 mt-4\",\"children\":[[\"$\",\"a\",\"고교학점제\",{\"href\":\"/tag/고교학점제\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"고교학점제\"]}],[\"$\",\"a\",\"고등학교\",{\"href\":\"/tag/고등학교\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"고등학교\"]}],[\"$\",\"a\",\"교육제도\",{\"href\":\"/tag/교육제도\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"교육제도\"]}],[\"$\",\"a\",\"진로교육\",{\"href\":\"/tag/진로교육\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"진로교육\"]}],[\"$\",\"a\",\"학부모가이드\",{\"href\":\"/tag/학부모가이드\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"학부모가이드\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"relative w-full h-64 md:h-96 mb-8 rounded-lg overflow-hidden\",\"children\":[[\"$\",\"$L1a\",null,{\"src\":\"https://images.unsplash.com/photo-1616400619175-5beda3a17896?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHwzfHxzdHVkeXxlbnwwfDB8fHwxNzY3NjczODg1fDA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\",\"alt\":\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것\",\"fill\":true,\"sizes\":\"(max-width: 768px) 100vw, 896px\",\"className\":\"object-cover\",\"priority\":true}],\"$L1b\"]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]}]]\n20:I[286,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"default\"]\n1b:[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://unsplash.com/@imkirk?utm_source=sseuksak&utm_medium=referral\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-white\",\"children\":\"Photo by Iewek Gnos on Unsplash\"}]}]\n21:T3673,<h1>고교학점제 1년, 학부모가 알아야 할 모든 것: 2026년 핵심 가이드</h1>\n<p>\"아이가 고등학교 가는데, 고교학점제가 뭔지 잘 모르겠어요.\"</p>\n<p>2025년 3월 전면 시행된 <strong>고교학점제</strong>가 어느덧 1년을 맞이했습니다. 하지만 여전히 많은 학부모님들이 이 제도를 정확히 이해하지 못하고 계십니다.</p>\n<p>오늘은 고교학점제의 <strong>모든 것</strong>을 학부모 관점에서 정리해드릴게요!</p>\n<hr>\n<h2 id=\"heading-0\">고교학점제란?</h2>\n<h3 id=\"heading-1\">한마디로 정의</h3>\n<blockquote>\n<p><strong>학생이 직접 과목을 선택하고, 정해진 학점을 이수하면 졸업하는 제도</strong></p>\n</blockquote>\n<p>기존 고등학교 교육은 모든 학생이 똑같은 과목을 똑같이 배웠습니다. 고교학점제는 대학처럼 <strong>자신의 진로와 적성에 맞게</strong> 과목을 선택할 수 있게 합니다.</p>\n<h3 id=\"heading-2\">왜 도입되었나요?</h3>\n<table>\n<thead>\n<tr>\n<th>기존 문제점</th>\n<th>고교학점제 해결책</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>획일화된 교육과정</td>\n<td>개인별 맞춤형 교육</td>\n</tr>\n<tr>\n<td>진로 탐색 기회 부족</td>\n<td>다양한 과목 선택 가능</td>\n</tr>\n<tr>\n<td>수동적 학습 태도</td>\n<td>능동적 학습 설계</td>\n</tr>\n<tr>\n<td>성적 위주 평가</td>\n<td>역량 중심 평가</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-3\">도입 일정과 현재 상황</h2>\n<h3 id=\"heading-4\">단계별 도입 경과</h3>\n<table>\n<thead>\n<tr>\n<th>연도</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2020년</td>\n<td>마이스터고 도입</td>\n</tr>\n<tr>\n<td>2022년</td>\n<td>특성화고 전면 적용</td>\n</tr>\n<tr>\n<td>2023년</td>\n<td>일반고 1학년 부분 적용</td>\n</tr>\n<tr>\n<td>2024년</td>\n<td>일반고 1~2학년 적용</td>\n</tr>\n<tr>\n<td><strong>2025년 3월</strong></td>\n<td><strong>전면 시행</strong></td>\n</tr>\n<tr>\n<td><strong>2026년</strong></td>\n<td><strong>시행 1주년</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">2026년 현재 상황</h3>\n<ul>\n<li><strong>모든 고등학교</strong>에서 고교학점제 시행 중</li>\n<li>2025년 입학생부터 완전 적용</li>\n<li>기존 재학생은 경과 조치 적용</li>\n</ul>\n<hr>\n<h2 id=\"heading-6\">핵심 내용 5가지</h2>\n<h3 id=\"heading-7\">1. 졸업 학점 기준</h3>\n<blockquote>\n<p><strong>3년간 192학점 이수 시 졸업</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>학점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>교과</td>\n<td>174학점</td>\n</tr>\n<tr>\n<td>창의적 체험활동</td>\n<td>18학점</td>\n</tr>\n<tr>\n<td><strong>총 졸업 학점</strong></td>\n<td><strong>192학점</strong></td>\n</tr>\n</tbody>\n</table>\n<p><strong>참고</strong>: 1학점 = 50분 수업 16회(한 학기)</p>\n<h3 id=\"heading-8\">2. 과목 선택권 확대</h3>\n<p>학생이 직접 선택할 수 있는 과목 범위:</p>\n<table>\n<thead>\n<tr>\n<th>영역</th>\n<th>선택 가능 과목 예시</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>국어</strong></td>\n<td>화법과 작문, 독서, 문학, 언어와 매체 등</td>\n</tr>\n<tr>\n<td><strong>수학</strong></td>\n<td>수학Ⅰ, 수학Ⅱ, 미적분, 확률과 통계 등</td>\n</tr>\n<tr>\n<td><strong>영어</strong></td>\n<td>영어Ⅰ, 영어Ⅱ, 영어 독해와 작문 등</td>\n</tr>\n<tr>\n<td><strong>사회</strong></td>\n<td>한국지리, 세계지리, 동아시아사, 정치와 법 등</td>\n</tr>\n<tr>\n<td><strong>과학</strong></td>\n<td>물리학, 화학, 생명과학, 지구과학 등</td>\n</tr>\n<tr>\n<td><strong>예체능</strong></td>\n<td>미술, 음악, 체육, 연극 등</td>\n</tr>\n<tr>\n<td><strong>진로선택</strong></td>\n<td>진로 관련 심화 과목</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-9\">3. 최소 성취수준 제도</h3>\n<blockquote>\n<p><strong>과목별 최소 기준에 도달해야 학점 인정</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>상황</th>\n<th>결과</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>최소 성취수준 도달</td>\n<td>학점 인정 (P: Pass)</td>\n</tr>\n<tr>\n<td>미도달</td>\n<td>보충 이수 후 재평가</td>\n</tr>\n</tbody>\n</table>\n<p><strong>미도달 시 절차</strong>:</p>\n<ol>\n<li>과목담당 교사와 보충 학습</li>\n<li>방과후 또는 방학 중 보충 프로그램</li>\n<li>재평가 후 학점 인정 여부 결정</li>\n</ol>\n<h3 id=\"heading-10\">4. 성적 산출 방식 변화</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>기존</th>\n<th>고교학점제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>성적표기</td>\n<td>등급(1~9등급)</td>\n<td>성취도(A~E) + 등급 병기</td>\n</tr>\n<tr>\n<td>평가기준</td>\n<td>상대평가 위주</td>\n<td>절대평가 도입 확대</td>\n</tr>\n<tr>\n<td>석차표기</td>\n<td>모든 과목</td>\n<td>공통과목만</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-11\">5. 공동교육과정</h3>\n<p>자기 학교에 없는 과목은 <strong>다른 학교 또는 온라인</strong>으로 이수 가능!</p>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>설명</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>오프라인 공동교육과정</strong></td>\n<td>근처 학교에서 수업 수강</td>\n</tr>\n<tr>\n<td><strong>온라인 공동교육과정</strong></td>\n<td>실시간 화상 수업</td>\n</tr>\n<tr>\n<td><strong>지역 연합 교육과정</strong></td>\n<td>지역 교육청 주관 프로그램</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-12\">학부모가 꼭 알아야 할 것</h2>\n<h3 id=\"heading-13\">자녀의 진로 탐색 지원하기</h3>\n<p>고교학점제에서 <strong>가장 중요한 것은 진로 설정</strong>입니다.</p>\n<h4>진로 탐색 시기</h4>\n<table>\n<thead>\n<tr>\n<th>시기</th>\n<th>활동</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>중3</td>\n<td>고등학교 입학 전 진로 탐색 시작</td>\n</tr>\n<tr>\n<td>고1 1학기</td>\n<td>관심 분야 파악, 기초 과목 탐색</td>\n</tr>\n<tr>\n<td>고1 2학기</td>\n<td>진로 심화 과목 선택 준비</td>\n</tr>\n<tr>\n<td>고2~3</td>\n<td>진로에 맞는 심화 과목 집중 이수</td>\n</tr>\n</tbody>\n</table>\n<h4>학부모 역할</h4>\n<ol>\n<li><strong>대화하기</strong>: 자녀의 관심사와 꿈에 대해 자주 이야기</li>\n<li><strong>정보 제공</strong>: 다양한 직업과 진로 정보 함께 탐색</li>\n<li><strong>체험 기회</strong>: 직업 체험, 대학 탐방 등 기회 마련</li>\n<li><strong>결정 존중</strong>: 최종 과목 선택은 자녀의 결정 존중</li>\n</ol>\n<h3 id=\"heading-14\">과목 선택 전략</h3>\n<h4>대학 진학 목표인 경우</h4>\n<table>\n<thead>\n<tr>\n<th>전공 희망</th>\n<th>추천 선택 과목</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>이공계</td>\n<td>미적분, 물리학Ⅱ, 화학Ⅱ 등</td>\n</tr>\n<tr>\n<td>의약계</td>\n<td>생명과학Ⅱ, 화학Ⅱ 등</td>\n</tr>\n<tr>\n<td>인문사회</td>\n<td>사회문화, 윤리와 사상, 제2외국어 등</td>\n</tr>\n<tr>\n<td>상경계</td>\n<td>경제, 수학Ⅱ, 확률과 통계 등</td>\n</tr>\n<tr>\n<td>예술계</td>\n<td>예술 관련 전문 과목, 실기 과목</td>\n</tr>\n</tbody>\n</table>\n<h4>주의사항</h4>\n<ul>\n<li><strong>대학별 선택과목 가이드라인</strong> 확인 필수</li>\n<li>희망 대학의 <strong>입학전형 요강</strong> 미리 파악</li>\n<li><strong>학과별 권장 이수 과목</strong> 확인</li>\n</ul>\n<h3 id=\"heading-15\">성적 관리 포인트</h3>\n<h4>절대평가 과목 전략</h4>\n<ul>\n<li>진로선택 과목은 <strong>절대평가</strong>(A, B, C)</li>\n<li>등급 경쟁 부담 감소</li>\n<li><strong>실력 향상</strong>에 집중 가능</li>\n</ul>\n<h4>상대평가 과목 전략</h4>\n<ul>\n<li>공통과목, 일반선택 과목은 <strong>등급</strong> 산출</li>\n<li>수강 인원 고려하여 과목 선택</li>\n<li>내신 관리와 실력 균형 맞추기</li>\n</ul>\n<hr>\n<h2 id=\"heading-16\">자주 묻는 질문 (FAQ)</h2>\n<h3 id=\"heading-17\">Q1. 과목을 잘못 선택하면 어떻게 되나요?</h3>\n<p><strong>학기 중에는 변경이 어렵습니다.</strong></p>\n<ul>\n<li>과목 선택 기간에 신중하게 결정</li>\n<li>담임교사, 진로상담교사와 충분히 상담</li>\n<li>학기 시작 전까지 수정 가능한 경우 있음</li>\n</ul>\n<h3 id=\"heading-18\">Q2. 최소 성취수준 미달하면 유급되나요?</h3>\n<p><strong>바로 유급되지는 않습니다.</strong></p>\n<ul>\n<li>보충 이수 기회 제공</li>\n<li>재평가 후에도 미달 시 해당 과목만 미인정</li>\n<li>졸업 학점(192학점) 미달 시에만 졸업 유예</li>\n</ul>\n<h3 id=\"heading-19\">Q3. 우리 학교에 원하는 과목이 없으면?</h3>\n<p><strong>공동교육과정을 활용하세요!</strong></p>\n<ul>\n<li>근처 학교에서 수강 가능</li>\n<li>온라인 화상 수업 개설</li>\n<li>지역 교육청 연합 프로그램 참여</li>\n</ul>\n<h3 id=\"heading-20\">Q4. 대학 입시에 불리하지 않나요?</h3>\n<p><strong>오히려 유리할 수 있습니다.</strong></p>\n<ul>\n<li>대학들은 <strong>과목 선택의 적합성</strong> 평가</li>\n<li>전공 관련 심화 과목 이수 시 가산점</li>\n<li>자기주도적 학습 태도 긍정 평가</li>\n</ul>\n<h3 id=\"heading-21\">Q5. 수능과 어떻게 연결되나요?</h3>\n<p><strong>수능은 기존대로 진행됩니다.</strong></p>\n<ul>\n<li>수능 응시 과목은 별도 선택</li>\n<li>단, 학교 수업에서 선택한 과목과 일치시키는 것이 유리</li>\n<li>수능 사회/과학탐구는 2과목 선택</li>\n</ul>\n<hr>\n<h2 id=\"heading-22\">2026년 달라지는 점</h2>\n<h3 id=\"heading-23\">전면 시행 1년 후 변화</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>2025년 (시행 첫해)</th>\n<th>2026년</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>적용 대상</td>\n<td>1학년 완전 적용</td>\n<td>1~2학년 완전 적용</td>\n</tr>\n<tr>\n<td>공동교육과정</td>\n<td>확대 중</td>\n<td>안정화</td>\n</tr>\n<tr>\n<td>학교별 운영</td>\n<td>시범 운영 병행</td>\n<td>본격 운영</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">학부모 관심 포인트</h3>\n<ol>\n<li><strong>대입 반영 방식</strong> 구체화</li>\n<li><strong>공동교육과정</strong> 활성화</li>\n<li><strong>진로 상담</strong> 시스템 강화</li>\n<li><strong>성취평가제</strong> 정착</li>\n</ol>\n<hr>\n<h2 id=\"heading-25\">학부모를 위한 체크리스트</h2>\n<h3 id=\"heading-26\">입학 전 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 자녀와 진로에 대해 충분히 대화했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 고교학점제 기본 내용을 이해했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 희망 고등학교의 개설 과목을 확인했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 진로에 맞는 과목 조합을 생각해 봤나요?</li>\n</ul>\n<h3 id=\"heading-27\">재학 중 관리</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 자녀의 과목 선택 과정에 참여하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 성적표의 성취도(A~E)를 이해하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 최소 성취수준 도달 여부를 확인하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 진로 변경 시 과목 조정 방법을 알고 있나요?</li>\n</ul>\n<h3 id=\"heading-28\">대입 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 희망 대학의 선택과목 가이드라인을 확인했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 수능 응시 과목과 학교 수업 과목이 일치하나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 학생부종합전형 대비 과목 선택이 적절한가요?</li>\n</ul>\n<hr>\n<h2 id=\"heading-29\">도움받을 수 있는 곳</h2>\n<h3 id=\"heading-30\">온라인 자료</h3>\n<table>\n<thead>\n<tr>\n<th>사이트</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>고교학점제 공식 사이트</td>\n<td>제도 안내, 학부모 자료</td>\n</tr>\n<tr>\n<td>커리어넷</td>\n<td>진로 탐색, 직업 정보</td>\n</tr>\n<tr>\n<td>대입정보포털</td>\n<td>대학별 입시 정보</td>\n</tr>\n<tr>\n<td>학교알리미</td>\n<td>학교별 교육과정 정보</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">학교 내 상담</h3>\n<table>\n<thead>\n<tr>\n<th>담당자</th>\n<th>상담 내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>담임교사</td>\n<td>전반적인 학교 생활, 과목 선택</td>\n</tr>\n<tr>\n<td>진로상담교사</td>\n<td>진로 탐색, 직업 연계</td>\n</tr>\n<tr>\n<td>교과담당교사</td>\n<td>과목 특성, 이수 조건</td>\n</tr>\n<tr>\n<td>교무부</td>\n<td>학점 이수, 졸업 요건</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-32\">마무리</h2>\n<p>고교학점제는 <strong>학생 중심 교육</strong>으로의 큰 변화입니다.</p>\n<p>처음에는 복잡해 보이지만, 핵심은 간단합니다:</p>\n<ol>\n<li><strong>자녀의 진로</strong>를 함께 탐색하세요</li>\n<li><strong>과목 선택</strong>을 도와주세요</li>\n<li><strong>스스로 결정</strong>할 수 있게 지원하세요</li>\n</ol>\n<p>가장 중요한 것은 <strong>자녀와의 대화</strong>입니다.</p>\n<p>무엇을 좋아하는지, 어떤 꿈을 가지고 있는지 자주 이야기하면서 함께 준비해 나가시길 바랍니다!</p>\n<p>궁금한 점은 학교 진로상담교사나 담임선생님께 문의하세요.</p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/new-certifications-2026-guide\">2026년 신설 국가자격증 가이드</a></li>\n<li><a href=\"/posts/national-technical-exam-schedule-2026\">2026년 국가기술자격 시험일정 총정리</a></li>\n</ul>\n1c:[\"$\",\"$L20\",null,{\"content\":\"$21\"}]\n22:T3673,<h1>고교학점제 1년, 학부모가 알아야 할 모든 것: 2026년 핵심 가이드</h1>\n<p>\"아이가 고등학교 가는데, 고교학점제가 뭔지 잘 모르겠어요.\"</p>\n<p>2025년 3월 전면 시행된 <strong>고교학점제</strong>가 어느덧 1년을 맞이했습니다. 하지만 여전히 많은 학부모님들이 이 제도를 정확히 이해하지 못하고 계십니다.</p>\n<p>오늘은 고교학점제의 <strong>모든 것</strong>을 학부모 관점에서 정리해드릴게요!</p>\n<hr>\n<h2 id=\"heading-0\">고교학점제란?</h2>\n<h3 id=\"heading-1\">한마디로 정의</h3>\n<blockquote>\n<p><strong>학생이 직접 과목을 선택하고, 정해진 학점을 이수하면 졸업하는 제도</strong></p>\n</blockquote>\n<p>기존 고등학교 교육은 모든 학생이 똑같은 과목을 똑같이 배웠습니다. 고교학점제는 대학처럼 <strong>자신의 진로와 적성에 맞게</strong> 과목을 선택할 수 있게 합니다.</p>\n<h3 id=\"heading-2\">왜 도입되었나요?</h3>\n<table>\n<thead>\n<tr>\n<th>기존 문제점</th>\n<th>고교학점제 해결책</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>획일화된 교육과정</td>\n<td>개인별 맞춤형 교육</td>\n</tr>\n<tr>\n<td>진로 탐색 기회 부족</td>\n<td>다양한 과목 선택 가능</td>\n</tr>\n<tr>\n<td>수동적 학습 태도</td>\n<td>능동적 학습 설계</td>\n</tr>\n<tr>\n<td>성적 위주 평가</td>\n<td>역량 중심 평가</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-3\">도입 일정과 현재 상황</h2>\n<h3 id=\"heading-4\">단계별 도입 경과</h3>\n<table>\n<thead>\n<tr>\n<th>연도</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2020년</td>\n<td>마이스터고 도입</td>\n</tr>\n<tr>\n<td>2022년</td>\n<td>특성화고 전면 적용</td>\n</tr>\n<tr>\n<td>2023년</td>\n<td>일반고 1학년 부분 적용</td>\n</tr>\n<tr>\n<td>2024년</td>\n<td>일반고 1~2학년 적용</td>\n</tr>\n<tr>\n<td><strong>2025년 3월</strong></td>\n<td><strong>전면 시행</strong></td>\n</tr>\n<tr>\n<td><strong>2026년</strong></td>\n<td><strong>시행 1주년</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-5\">2026년 현재 상황</h3>\n<ul>\n<li><strong>모든 고등학교</strong>에서 고교학점제 시행 중</li>\n<li>2025년 입학생부터 완전 적용</li>\n<li>기존 재학생은 경과 조치 적용</li>\n</ul>\n<hr>\n<h2 id=\"heading-6\">핵심 내용 5가지</h2>\n<h3 id=\"heading-7\">1. 졸업 학점 기준</h3>\n<blockquote>\n<p><strong>3년간 192학점 이수 시 졸업</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>학점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>교과</td>\n<td>174학점</td>\n</tr>\n<tr>\n<td>창의적 체험활동</td>\n<td>18학점</td>\n</tr>\n<tr>\n<td><strong>총 졸업 학점</strong></td>\n<td><strong>192학점</strong></td>\n</tr>\n</tbody>\n</table>\n<p><strong>참고</strong>: 1학점 = 50분 수업 16회(한 학기)</p>\n<h3 id=\"heading-8\">2. 과목 선택권 확대</h3>\n<p>학생이 직접 선택할 수 있는 과목 범위:</p>\n<table>\n<thead>\n<tr>\n<th>영역</th>\n<th>선택 가능 과목 예시</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>국어</strong></td>\n<td>화법과 작문, 독서, 문학, 언어와 매체 등</td>\n</tr>\n<tr>\n<td><strong>수학</strong></td>\n<td>수학Ⅰ, 수학Ⅱ, 미적분, 확률과 통계 등</td>\n</tr>\n<tr>\n<td><strong>영어</strong></td>\n<td>영어Ⅰ, 영어Ⅱ, 영어 독해와 작문 등</td>\n</tr>\n<tr>\n<td><strong>사회</strong></td>\n<td>한국지리, 세계지리, 동아시아사, 정치와 법 등</td>\n</tr>\n<tr>\n<td><strong>과학</strong></td>\n<td>물리학, 화학, 생명과학, 지구과학 등</td>\n</tr>\n<tr>\n<td><strong>예체능</strong></td>\n<td>미술, 음악, 체육, 연극 등</td>\n</tr>\n<tr>\n<td><strong>진로선택</strong></td>\n<td>진로 관련 심화 과목</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-9\">3. 최소 성취수준 제도</h3>\n<blockquote>\n<p><strong>과목별 최소 기준에 도달해야 학점 인정</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>상황</th>\n<th>결과</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>최소 성취수준 도달</td>\n<td>학점 인정 (P: Pass)</td>\n</tr>\n<tr>\n<td>미도달</td>\n<td>보충 이수 후 재평가</td>\n</tr>\n</tbody>\n</table>\n<p><strong>미도달 시 절차</strong>:</p>\n<ol>\n<li>과목담당 교사와 보충 학습</li>\n<li>방과후 또는 방학 중 보충 프로그램</li>\n<li>재평가 후 학점 인정 여부 결정</li>\n</ol>\n<h3 id=\"heading-10\">4. 성적 산출 방식 변화</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>기존</th>\n<th>고교학점제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>성적표기</td>\n<td>등급(1~9등급)</td>\n<td>성취도(A~E) + 등급 병기</td>\n</tr>\n<tr>\n<td>평가기준</td>\n<td>상대평가 위주</td>\n<td>절대평가 도입 확대</td>\n</tr>\n<tr>\n<td>석차표기</td>\n<td>모든 과목</td>\n<td>공통과목만</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-11\">5. 공동교육과정</h3>\n<p>자기 학교에 없는 과목은 <strong>다른 학교 또는 온라인</strong>으로 이수 가능!</p>\n<table>\n<thead>\n<tr>\n<th>유형</th>\n<th>설명</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>오프라인 공동교육과정</strong></td>\n<td>근처 학교에서 수업 수강</td>\n</tr>\n<tr>\n<td><strong>온라인 공동교육과정</strong></td>\n<td>실시간 화상 수업</td>\n</tr>\n<tr>\n<td><strong>지역 연합 교육과정</strong></td>\n<td>지역 교육청 주관 프로그램</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-12\">학부모가 꼭 알아야 할 것</h2>\n<h3 id=\"heading-13\">자녀의 진로 탐색 지원하기</h3>\n<p>고교학점제에서 <strong>가장 중요한 것은 진로 설정</strong>입니다.</p>\n<h4>진로 탐색 시기</h4>\n<table>\n<thead>\n<tr>\n<th>시기</th>\n<th>활동</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>중3</td>\n<td>고등학교 입학 전 진로 탐색 시작</td>\n</tr>\n<tr>\n<td>고1 1학기</td>\n<td>관심 분야 파악, 기초 과목 탐색</td>\n</tr>\n<tr>\n<td>고1 2학기</td>\n<td>진로 심화 과목 선택 준비</td>\n</tr>\n<tr>\n<td>고2~3</td>\n<td>진로에 맞는 심화 과목 집중 이수</td>\n</tr>\n</tbody>\n</table>\n<h4>학부모 역할</h4>\n<ol>\n<li><strong>대화하기</strong>: 자녀의 관심사와 꿈에 대해 자주 이야기</li>\n<li><strong>정보 제공</strong>: 다양한 직업과 진로 정보 함께 탐색</li>\n<li><strong>체험 기회</strong>: 직업 체험, 대학 탐방 등 기회 마련</li>\n<li><strong>결정 존중</strong>: 최종 과목 선택은 자녀의 결정 존중</li>\n</ol>\n<h3 id=\"heading-14\">과목 선택 전략</h3>\n<h4>대학 진학 목표인 경우</h4>\n<table>\n<thead>\n<tr>\n<th>전공 희망</th>\n<th>추천 선택 과목</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>이공계</td>\n<td>미적분, 물리학Ⅱ, 화학Ⅱ 등</td>\n</tr>\n<tr>\n<td>의약계</td>\n<td>생명과학Ⅱ, 화학Ⅱ 등</td>\n</tr>\n<tr>\n<td>인문사회</td>\n<td>사회문화, 윤리와 사상, 제2외국어 등</td>\n</tr>\n<tr>\n<td>상경계</td>\n<td>경제, 수학Ⅱ, 확률과 통계 등</td>\n</tr>\n<tr>\n<td>예술계</td>\n<td>예술 관련 전문 과목, 실기 과목</td>\n</tr>\n</tbody>\n</table>\n<h4>주의사항</h4>\n<ul>\n<li><strong>대학별 선택과목 가이드라인</strong> 확인 필수</li>\n<li>희망 대학의 <strong>입학전형 요강</strong> 미리 파악</li>\n<li><strong>학과별 권장 이수 과목</strong> 확인</li>\n</ul>\n<h3 id=\"heading-15\">성적 관리 포인트</h3>\n<h4>절대평가 과목 전략</h4>\n<ul>\n<li>진로선택 과목은 <strong>절대평가</strong>(A, B, C)</li>\n<li>등급 경쟁 부담 감소</li>\n<li><strong>실력 향상</strong>에 집중 가능</li>\n</ul>\n<h4>상대평가 과목 전략</h4>\n<ul>\n<li>공통과목, 일반선택 과목은 <strong>등급</strong> 산출</li>\n<li>수강 인원 고려하여 과목 선택</li>\n<li>내신 관리와 실력 균형 맞추기</li>\n</ul>\n<hr>\n<h2 id=\"heading-16\">자주 묻는 질문 (FAQ)</h2>\n<h3 id=\"heading-17\">Q1. 과목을 잘못 선택하면 어떻게 되나요?</h3>\n<p><strong>학기 중에는 변경이 어렵습니다.</strong></p>\n<ul>\n<li>과목 선택 기간에 신중하게 결정</li>\n<li>담임교사, 진로상담교사와 충분히 상담</li>\n<li>학기 시작 전까지 수정 가능한 경우 있음</li>\n</ul>\n<h3 id=\"heading-18\">Q2. 최소 성취수준 미달하면 유급되나요?</h3>\n<p><strong>바로 유급되지는 않습니다.</strong></p>\n<ul>\n<li>보충 이수 기회 제공</li>\n<li>재평가 후에도 미달 시 해당 과목만 미인정</li>\n<li>졸업 학점(192학점) 미달 시에만 졸업 유예</li>\n</ul>\n<h3 id=\"heading-19\">Q3. 우리 학교에 원하는 과목이 없으면?</h3>\n<p><strong>공동교육과정을 활용하세요!</strong></p>\n<ul>\n<li>근처 학교에서 수강 가능</li>\n<li>온라인 화상 수업 개설</li>\n<li>지역 교육청 연합 프로그램 참여</li>\n</ul>\n<h3 id=\"heading-20\">Q4. 대학 입시에 불리하지 않나요?</h3>\n<p><strong>오히려 유리할 수 있습니다.</strong></p>\n<ul>\n<li>대학들은 <strong>과목 선택의 적합성</strong> 평가</li>\n<li>전공 관련 심화 과목 이수 시 가산점</li>\n<li>자기주도적 학습 태도 긍정 평가</li>\n</ul>\n<h3 id=\"heading-21\">Q5. 수능과 어떻게 연결되나요?</h3>\n<p><strong>수능은 기존대로 진행됩니다.</strong></p>\n<ul>\n<li>수능 응시 과목은 별도 선택</li>\n<li>단, 학교 수업에서 선택한 과목과 일치시키는 것이 유리</li>\n<li>수능 사회/과학탐구는 2과목 선택</li>\n</ul>\n<hr>\n<h2 id=\"heading-22\">2026년 달라지는 점</h2>\n<h3 id=\"heading-23\">전면 시행 1년 후 변화</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>2025년 (시행 첫해)</th>\n<th>2026년</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>적용 대상</td>\n<td>1학년 완전 적용</td>\n<td>1~2학년 완전 적용</td>\n</tr>\n<tr>\n<td>공동교육과정</td>\n<td>확대 중</td>\n<td>안정화</td>\n</tr>\n<tr>\n<td>학교별 운영</td>\n<td>시범 운영 병행</td>\n<td>본격 운영</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">학부모 관심 포인트</h3>\n<ol>\n<li><strong>대입 반영 방식</strong> 구체화</li>\n<li><strong>공동교육과정</strong> 활성화</li>\n<li><strong>진로 상담</strong> 시스템 강화</li>\n<li><strong>성취평가제</strong> 정착</li>\n</ol>\n<hr>\n<h2 id=\"heading-25\">학부모를 위한 체크리스트</h2>\n<h3 id=\"heading-26\">입학 전 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 자녀와 진로에 대해 충분히 대화했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 고교학점제 기본 내용을 이해했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 희망 고등학교의 개설 과목을 확인했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 진로에 맞는 과목 조합을 생각해 봤나요?</li>\n</ul>\n<h3 id=\"heading-27\">재학 중 관리</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 자녀의 과목 선택 과정에 참여하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 성적표의 성취도(A~E)를 이해하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 최소 성취수준 도달 여부를 확인하고 있나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 진로 변경 시 과목 조정 방법을 알고 있나요?</li>\n</ul>\n<h3 id=\"heading-28\">대입 준비</h3>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 희망 대학의 선택과목 가이드라인을 확인했나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 수능 응시 과목과 학교 수업 과목이 일치하나요?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 학생부종합전형 대비 과목 선택이 적절한가요?</li>\n</ul>\n<hr>\n<h2 id=\"heading-29\">도움받을 수 있는 곳</h2>\n<h3 id=\"heading-30\">온라인 자료</h3>\n<table>\n<thead>\n<tr>\n<th>사이트</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>고교학점제 공식 사이트</td>\n<td>제도 안내, 학부모 자료</td>\n</tr>\n<tr>\n<td>커리어넷</td>\n<td>진로 탐색, 직업 정보</td>\n</tr>\n<tr>\n<td>대입정보포털</td>\n<td>대학별 입시 정보</td>\n</tr>\n<tr>\n<td>학교알리미</td>\n<td>학교별 교육과정 정보</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-31\">학교 내 상담</h3>\n<table>\n<thead>\n<tr>\n<th>담당자</th>\n<th>상담 내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>담임교사</td>\n<td>전반적인 학교 생활, 과목 선택</td>\n</tr>\n<tr>\n<td>진로상담교사</td>\n<td>진로 탐색, 직업 연계</td>\n</tr>\n<tr>\n<td>교과담당교사</td>\n<td>과목 특성, 이수 조건</td>\n</tr>\n<tr>\n<td>교무부</td>\n<td>학점 이수, 졸업 요건</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-32\">마무리</h2>\n<p>고교학점제는 <strong>학생 중심 교육</strong>으로의 큰 변화입니다.</p>\n<p>처음에는 복잡해 보이지만, 핵심은 간단합니다:</p>\n<ol>\n<li><strong>자녀의 진로</strong>를 함께 탐색하세요</li>\n<li><strong>과목 선택</strong>을 도와주세요</li>\n<li><strong>스스로 결정</strong>할 수 있게 지원하세요</li>\n</ol>\n<p>가장 중요한 것은 <strong>자녀와의 대화</strong>입니다.</p>\n<p>무엇을 좋아하는지, 어떤 꿈을 가지고 있는지 자주 이야기하면서 함께 준비해 나가시길 바랍니다!</p>\n<p>궁금한 점은 학교 진로상담교사나 담임선생님께 문의하세요.</p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/new-certifications-2026-guide\">2026년 신설 국가자격증 가이드</a></li>\n<li><a href=\"/posts/national-technical-exam-schedule-2026\">2026년 국가기술자격 시험일정 총정리</a></li>\n</ul>\n1d:[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\",\"dangerouslySetInnerHTML\":{\"__html\":\"$22\"}}]\n1e:[\"$\",\"nav\",null,{\"className\":\"border-t border-gray-200 pt-8 mt-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L6\",null,{\"href\":\"/posts/health-insurance-premium-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"이전 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 건강보험료 변경사항 총정리: 인상률, 계산법, 절약 팁까지\"}]]}],[\"$\",\"$L6\",null,{\"href\":\"/posts/minimum-wage-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"다음 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 최저임금 완벽 가이드: 시급, 월급 계산, 주휴수당까지 총정리\"}]]}]]}]}]\n1f:[\"$\",\"section\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-200\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-gray-900 mb-6\",\"children\":\"관련 게시글\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L6\",\"ai-digital-textbook-2026\",{\"href\":\"/posts/ai-digital-textbook-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"AI 디지털교과서 완벽 가이드: 학부모가 알아야 할 핵심 정보\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2025년 3월 도입된 AI 디지털교과서가 본격화됩니다. 태블릿 수업, 맞춤형 학습, 개인정보 보호까지 학부모님이 알아야 할 모든 것을 정리했습니다.\"}]]}],[\"$\",\"$L6\",\"new-certifications-2026-guide\",{\"href\":\"/posts/new-certifications-2026-guide\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"2026년 신설 국가자격증 가이드: 스마트공장·바이오·모빌리티 7종목 완벽 정리\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 1월 1일부터 시행되는 신설 국가자격증 7종목을 총정리했습니다. 스마트공장산업기사, 바이오공정기능사, 이륜자동차정비기능사 등 정확한 시험 정보와 취득 전략을 알려드립니다.\"}]]}],[\"$\",\"$L6\",\"national-technical-exam-schedule-2026\",{\"href\":\"/posts/national-technical-exam-schedule-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"2026년 국가기술자격 시험일정 총정리: 기사·산업기사·기능사 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 국가기술자격 시험 일정을 총정리했습니다. 기사, 산업기사, 기능사 시험 일정과 접수 기간, 합격 전략까지 한눈에 확인하세요.\"}]]}]]}]]}]\n23:I[622,[],\"IconMark\"]\n14:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것 | 쓱싹 | 쓱싹\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2025년 3월 전면 시행된 고교학점제가 1년을 맞이합니다. 학부모님들이 반드시 알아야 할 핵심 내용, 자녀 진로 지원 방법, 과목 선택 전략까지 총정리했습니다.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"고교학점제, 고등학교, 교육제도, 진로교육, 학부모가이드\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"google-adsense-account\",\"content\":\"ca-pub-3591490977493759\"}],[\"$\",\"link\",\"9\",{\"rel\":\"canonical\",\"href\":\"https://sseuksak.com/posts/high-school-credit-system-2026\"}],[\"$\",\"meta\",\"10\",{\"name\":\"google-site-verification\",\"content\":\"05uSSCwIsJLxLnMlswVBzMSOwEeGCOkpMhx9YJMZcng\"}],[\"$\",\"meta\",\"11\",{\"name\":\"naver-site-verification\",\"content\":\"f82b9ef52a15379f29a3f6d9ffe4dd6b9d6cc43b\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것 | 쓱싹\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"2025년 3월 전면 시행된 고교학점제가 1년을 맞이합니다. 학부모님들이 반드시 알아야 할 핵심 내용, 자녀 진로 지원 방법, 과목 선택 전략까지 총정리했습니다.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://sseuksak.com/posts/high-school-credit-system-2026\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"ko_KR\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://images.unsplash.com/photo-1616400619175-5beda3a17896?ixid=M3w4NTI2NzZ8MHwxfHNl