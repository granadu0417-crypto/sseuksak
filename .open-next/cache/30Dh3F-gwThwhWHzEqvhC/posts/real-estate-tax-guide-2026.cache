 1.56억원\\n4. 기본공제: 250만원\\n5. 과세표준: 1.56억 - 0.025억 = 1.535억원\\n6. 산출세액: 1.535억 × 35% - 1,544만원 = 약 3,829만원\\n7. 지방소득세: 약 383만원\\n→ 총 납부세액: 약 4,212만원\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 12억원 이하 1주택이므로 \\u003cstrong\\u003e비과세\\u003c/strong\\u003e에 해당하여 실제 납부액은 0원입니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e3. 종합부동산세\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e과세 기준일\\u003c/h3\\u003e\\n\\u003cp\\u003e매년 \\u003cstrong\\u003e6월 1일\\u003c/strong\\u003e 기준 보유 부동산 합산\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e공제금액\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e공제금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1세대 1주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e12억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다주택자\\u003c/td\\u003e\\n\\u003ctd\\u003e9억원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e법인\\u003c/td\\u003e\\n\\u003ctd\\u003e공제 없음\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-15\\\"\\u003e세율 (2026년)\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e일반 세율\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e과세표준\\u003c/th\\u003e\\n\\u003cth\\u003e세율\\u003c/th\\u003e\\n\\u003cth\\u003e누진공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e0.5%\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e6억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e0.7%\\u003c/td\\u003e\\n\\u003ctd\\u003e60만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u00