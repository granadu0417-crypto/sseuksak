5\",{\"property\":\"og:site_name\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"ko_KR\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://images.unsplash.com/photo-1556155092-490a1ba16284?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:alt\",\"content\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"22\",{\"property\":\"article:published_time\",\"content\":\"2026-01-07\"}],[\"$\",\"meta\",\"23\",{\"property\":\"article:author\",\"content\":\"쓱싹\"}],[\"$\",\"meta\",\"24\",{\"property\":\"article:section\",\"content\":\"finance\"}],[\"$\",\"meta\",\"25\",{\"property\":\"article:tag\",\"content\":\"부동산세금\"}],[\"$\",\"meta\",\"26\",{\"property\":\"article:tag\",\"content\":\"취득세\"}],[\"$\",\"meta\",\"27\",{\"property\":\"article:tag\",\"content\":\"양도소득세\"}],[\"$\",\"meta\",\"28\",{\"property\":\"article:tag\",\"content\":\"종합부동산세\"}],[\"$\",\"meta\",\"29\",{\"property\":\"article:tag\",\"content\":\"부동산절세\"}],[\"$\",\"meta\",\"30\",{\"property\":\"article:tag\",\"content\":\"2026년세금\"}],[\"$\",\"meta\",\"31\",{\"property\":\"article:tag\",\"content\":\"다주택자세금\"}],[\"$\",\"meta\",\"32\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"33\",{\"name\":\"twitter:title\",\"content\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드 | 쓱싹\"}],[\"$\",\"meta\",\"34\",{\"name\":\"twitter:description\",\"content\":\"2026년 부동산 세금을 한눈에 정리했습니다. 취득세, 양도소득세, 종합부동산세의 세율과 계산 방법, 절세 전략까지 꼭 알아야 할 핵심 내용을 확인하세요.\"}],[\"$\",\"meta\",\"35\",{\"name\":\"twitter:image\",\"content\":\"https://images.unsplash.com/photo-1556155092-490a1ba16284?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"link\",\"36\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"37\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n21:I[1356,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"Image\"]\n22:I[286,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"356\",\"static/chunks/356-5cad24532f4c0e5d.js\",\"858\",\"static/chunks/app/posts/%5Bslug%5D/page-9a2152621871465e.js\"],\"default\"]\n1a:[\"$\",\"$L21\",null,{\"src\":\"https://images.unsplash.com/photo-1556155092-490a1ba16284?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw4fHxiYW5raW5nfGVufDB8MHx8fDE3Njc2NzM4ODR8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\",\"alt\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드\",\"fill\":true,\"sizes\":\"(max-width: 768px) 100vw, 896px\",\"className\":\"object-cover\",\"priority\":true}]\n1b:[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://unsplash.com/@austindistel?utm_source=sseuksak&utm_medium=referral\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-white\",\"children\":\"Photo by Austin Distel on Unsplash\"}]}]\n23:T3b0a,<h1>2026년 부동산 세금 총정리</h1>\n<p>부동산을 취득하거나 보유, 양도할 때 다양한 세금이 발생합니다. 2026년에도 여러 세제 변화가 있는데요, 이 글에서는 <strong>취득세, 양도소득세, 종합부동산세</strong>를 중심으로 핵심 내용을 정리해 드립니다.</p>\n<hr>\n<h2 id=\"heading-0\">부동산 세금 체계 한눈에 보기</h2>\n<table>\n<thead>\n<tr>\n<th>단계</th>\n<th>세금 종류</th>\n<th>과세 시점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>취득</strong></td>\n<td>취득세, 인지세</td>\n<td>부동산 매수 시</td>\n</tr>\n<tr>\n<td><strong>보유</strong></td>\n<td>재산세, 종합부동산세</td>\n<td>매년 6월 1일 기준</td>\n</tr>\n<tr>\n<td><strong>양도</strong></td>\n<td>양도소득세</td>\n<td>부동산 매도 시</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-1\">1. 취득세</h2>\n<h3 id=\"heading-2\">주택 취득세율 (2026년)</h3>\n<table>\n<thead>\n<tr>\n<th>주택 수</th>\n<th>취득가액</th>\n<th>세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>1주택</strong></td>\n<td>6억원 이하</td>\n<td>1%</td>\n</tr>\n<tr>\n<td></td>\n<td>6억~9억원</td>\n<td>2%</td>\n</tr>\n<tr>\n<td></td>\n<td>9억원 초과</td>\n<td>3%</td>\n</tr>\n<tr>\n<td><strong>2주택</strong></td>\n<td>조정대상지역</td>\n<td>8%</td>\n</tr>\n<tr>\n<td></td>\n<td>비조정지역</td>\n<td>1~3%</td>\n</tr>\n<tr>\n<td><strong>3주택 이상</strong></td>\n<td>조정대상지역</td>\n<td>12%</td>\n</tr>\n<tr>\n<td></td>\n<td>비조정지역</td>\n<td>8%</td>\n</tr>\n<tr>\n<td><strong>법인</strong></td>\n<td>전체</td>\n<td>12%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-3\">취득세 계산 공식</h3>\n<pre><code>취득세 = 취득가액 × 세율\n\n※ 실제 납부액 = 취득세 + 지방교육세(취득세의 10%) + 농어촌특별세\n</code></pre>\n<h3 id=\"heading-4\">취득세 감면 혜택</h3>\n<table>\n<thead>\n<tr>\n<th>감면 대상</th>\n<th>감면율</th>\n<th>조건</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>생애최초 주택</td>\n<td>최대 200만원</td>\n<td>부부합산 연소득 7,000만원 이하</td>\n</tr>\n<tr>\n<td>신혼부부</td>\n<td>50% 감면</td>\n<td>혼인 7년 이내, 6억원 이하</td>\n</tr>\n<tr>\n<td>다자녀 가구</td>\n<td>50% 감면</td>\n<td>18세 미만 자녀 3명 이상</td>\n</tr>\n<tr>\n<td>장애인</td>\n<td>면제</td>\n<td>1~3급 장애인</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>💡 <strong>Tip</strong>: 생애최초 주택 취득 시 취득세 감면과 함께 <strong>취득자금 증여 특례</strong>(직계존속 5,000만원 비과세)도 함께 활용하세요.</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-5\">2. 양도소득세</h2>\n<h3 id=\"heading-6\">2026년 양도세 핵심 변경사항</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n<th>적용 기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>다주택자 중과 유예</strong></td>\n<td>2주택 +20%p, 3주택 +30%p 중과 유예</td>\n<td>~2026.05.09</td>\n</tr>\n<tr>\n<td><strong>장기보유특별공제</strong></td>\n<td>다주택자 적용 배제 유지</td>\n<td>계속</td>\n</tr>\n<tr>\n<td><strong>1세대 1주택 비과세</strong></td>\n<td>12억원까지 비과세</td>\n<td>계속</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-7\">기본 세율 (누진세)</h3>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1,400만원 이하</td>\n<td>6%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>5,000만원 이하</td>\n<td>15%</td>\n<td>126만원</td>\n</tr>\n<tr>\n<td>8,800만원 이하</td>\n<td>24%</td>\n<td>576만원</td>\n</tr>\n<tr>\n<td>1.5억원 이하</td>\n<td>35%</td>\n<td>1,544만원</td>\n</tr>\n<tr>\n<td>3억원 이하</td>\n<td>38%</td>\n<td>1,994만원</td>\n</tr>\n<tr>\n<td>5억원 이하</td>\n<td>40%</td>\n<td>2,594만원</td>\n</tr>\n<tr>\n<td>10억원 이하</td>\n<td>42%</td>\n<td>3,594만원</td>\n</tr>\n<tr>\n<td>10억원 초과</td>\n<td>45%</td>\n<td>6,594만원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-8\">다주택자 중과세율 (중과 적용 시)</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>기본세율</th>\n<th>중과세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2주택</td>\n<td>6~45%</td>\n<td>+20%p (최고 65%)</td>\n</tr>\n<tr>\n<td>3주택 이상</td>\n<td>6~45%</td>\n<td>+30%p (최고 75%)</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>⚠️ <strong>중요</strong>: 2026년 5월 9일까지 다주택자 중과가 유예 중입니다. 유예 기간 내 매도 계획이 있다면 시기를 잘 조율하세요.</p>\n</blockquote>\n<h3 id=\"heading-9\">장기보유특별공제</h3>\n<p><strong>1세대 1주택자</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>보유 기간</th>\n<th>공제율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3년</td>\n<td>24%</td>\n</tr>\n<tr>\n<td>4년</td>\n<td>32%</td>\n</tr>\n<tr>\n<td>5년</td>\n<td>40%</td>\n</tr>\n<tr>\n<td>6년</td>\n<td>48%</td>\n</tr>\n<tr>\n<td>7년</td>\n<td>56%</td>\n</tr>\n<tr>\n<td>8년</td>\n<td>64%</td>\n</tr>\n<tr>\n<td>9년</td>\n<td>72%</td>\n</tr>\n<tr>\n<td>10년 이상</td>\n<td>80%</td>\n</tr>\n</tbody>\n</table>\n<p><strong>일반 주택/토지</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>보유 기간</th>\n<th>공제율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3년</td>\n<td>6%</td>\n</tr>\n<tr>\n<td>4년</td>\n<td>8%</td>\n</tr>\n<tr>\n<td>5년</td>\n<td>10%</td>\n</tr>\n<tr>\n<td>...</td>\n<td>연 2%씩 증가</td>\n</tr>\n<tr>\n<td>15년 이상</td>\n<td>30%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-10\">1세대 1주택 비과세 요건</h3>\n<table>\n<thead>\n<tr>\n<th>요건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>보유 기간</td>\n<td>2년 이상</td>\n</tr>\n<tr>\n<td>거주 기간</td>\n<td>2년 이상 (조정대상지역)</td>\n</tr>\n<tr>\n<td>양도가액</td>\n<td>12억원 이하</td>\n</tr>\n<tr>\n<td>세대 요건</td>\n<td>양도일 현재 1세대 1주택</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-11\">양도세 계산 예시</h3>\n<p><strong>조건</strong>: 2020년 5억원 매수, 2026년 8억원 매도, 1세대 1주택, 6년 보유·거주</p>\n<pre><code>1. 양도차익: 8억 - 5억 = 3억원\n2. 장특공제(48%): 3억 × 48% = 1.44억원\n3. 양도소득금액: 3억 - 1.44억 = 1.56억원\n4. 기본공제: 250만원\n5. 과세표준: 1.56억 - 0.025억 = 1.535억원\n6. 산출세액: 1.535억 × 35% - 1,544만원 = 약 3,829만원\n7. 지방소득세: 약 383만원\n→ 총 납부세액: 약 4,212만원\n</code></pre>\n<blockquote>\n<p>💡 12억원 이하 1주택이므로 <strong>비과세</strong>에 해당하여 실제 납부액은 0원입니다.</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-12\">3. 종합부동산세</h2>\n<h3 id=\"heading-13\">과세 기준일</h3>\n<p>매년 <strong>6월 1일</strong> 기준 보유 부동산 합산</p>\n<h3 id=\"heading-14\">공제금액</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>공제금액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1세대 1주택자</td>\n<td>12억원</td>\n</tr>\n<tr>\n<td>다주택자</td>\n<td>9억원</td>\n</tr>\n<tr>\n<td>법인</td>\n<td>공제 없음</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-15\">세율 (2026년)</h3>\n<p><strong>일반 세율</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3억원 이하</td>\n<td>0.5%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>6억원 이하</td>\n<td>0.7%</td>\n<td>60만원</td>\n</tr>\n<tr>\n<td>12억원 이하</td>\n<td>1.0%</td>\n<td>240만원</td>\n</tr>\n<tr>\n<td>25억원 이하</td>\n<td>1.3%</td>\n<td>600만원</td>\n</tr>\n<tr>\n<td>50억원 이하</td>\n<td>1.5%</td>\n<td>1,100만원</td>\n</tr>\n<tr>\n<td>94억원 이하</td>\n<td>2.0%</td>\n<td>3,600만원</td>\n</tr>\n<tr>\n<td>94억원 초과</td>\n<td>2.7%</td>\n<td>10,180만원</td>\n</tr>\n</tbody>\n</table>\n<p><strong>3주택 이상 또는 조정대상지역 2주택 (중과)</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3억원 이하</td>\n<td>1.2%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>6억원 이하</td>\n<td>1.6%</td>\n<td>120만원</td>\n</tr>\n<tr>\n<td>12억원 이하</td>\n<td>2.2%</td>\n<td>480만원</td>\n</tr>\n<tr>\n<td>25억원 이하</td>\n<td>3.6%</td>\n<td>2,160만원</td>\n</tr>\n<tr>\n<td>50억원 이하</td>\n<td>5.0%</td>\n<td>5,660만원</td>\n</tr>\n<tr>\n<td>94억원 이하</td>\n<td>6.0%</td>\n<td>10,660만원</td>\n</tr>\n<tr>\n<td>94억원 초과</td>\n<td>6.0%</td>\n<td>10,660만원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-16\">종부세 계산 예시</h3>\n<p><strong>조건</strong>: 공시가격 15억원 아파트 1채 보유, 1세대 1주택자</p>\n<pre><code>1. 과세표준: 15억 - 12억(공제) = 3억원\n2. 세율 적용: 3억 × 0.5% = 150만원\n3. 세부담 상한: 전년도 재산세+종부세 × 150%\n4. 농어촌특별세: 종부세 × 20% = 30만원\n→ 예상 종부세: 약 180만원\n</code></pre>\n<h3 id=\"heading-17\">세부담 상한제</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>상한 비율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>일반</td>\n<td>전년도 세액 × 150%</td>\n</tr>\n<tr>\n<td>3주택 이상/조정2주택</td>\n<td>전년도 세액 × 300%</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-18\">4. 재산세</h2>\n<h3 id=\"heading-19\">주택 재산세율</h3>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>6,000만원 이하</td>\n<td>0.1%</td>\n</tr>\n<tr>\n<td>1.5억원 이하</td>\n<td>0.15%</td>\n</tr>\n<tr>\n<td>3억원 이하</td>\n<td>0.25%</td>\n</tr>\n<tr>\n<td>3억원 초과</td>\n<td>0.4%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-20\">납부 시기</h3>\n<table>\n<thead>\n<tr>\n<th>기분</th>\n<th>납부 기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1기분</td>\n<td>7월 16일 ~ 7월 31일</td>\n</tr>\n<tr>\n<td>2기분</td>\n<td>9월 16일 ~ 9월 30일</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-21\">부동산 세금 절세 전략</h2>\n<h3 id=\"heading-22\">1. 취득 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>생애최초 감면</td>\n<td>최대 200만원 감면</td>\n</tr>\n<tr>\n<td>신혼부부 감면</td>\n<td>50% 감면 (6억 이하)</td>\n</tr>\n<tr>\n<td>증여 활용</td>\n<td>직계존속 5,000만원 비과세</td>\n</tr>\n<tr>\n<td>공동명의</td>\n<td>종부세 공제액 확대</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-23\">2. 보유 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>공동명의</td>\n<td>종부세 공제액 2배 (9억 × 2인)</td>\n</tr>\n<tr>\n<td>임대사업자 등록</td>\n<td>종부세 합산 배제 (일부)</td>\n</tr>\n<tr>\n<td>공시가격 이의신청</td>\n<td>과다 산정 시 이의신청</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">3. 양도 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2년 이상 보유·거주</td>\n<td>1세대 1주택 비과세</td>\n</tr>\n<tr>\n<td>장기보유</td>\n<td>최대 80% 공제</td>\n</tr>\n<tr>\n<td>중과 유예 활용</td>\n<td>2026.05.09까지 매도</td>\n</tr>\n<tr>\n<td>필요경비 챙기기</td>\n<td>취득세, 중개수수료, 인테리어 등</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-25\">양도세 필요경비 항목</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>공제 가능 여부</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>취득세</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>중개수수료</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>법무사 비용</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>인테리어 비용</td>\n<td>✅ 공제 가능 (자본적 지출)</td>\n</tr>\n<tr>\n<td>이사 비용</td>\n<td>❌ 공제 불가</td>\n</tr>\n<tr>\n<td>대출 이자</td>\n<td>❌ 공제 불가</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-26\">2026년 부동산 세제 전망</h2>\n<h3 id=\"heading-27\">예정된 변화</h3>\n<table>\n<thead>\n<tr>\n<th>시기</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2026.05.09</td>\n<td>다주택자 양도세 중과 유예 종료 예정</td>\n</tr>\n<tr>\n<td>2026년 내</td>\n<td>종부세 개편안 논의 중</td>\n</tr>\n<tr>\n<td>미정</td>\n<td>취득세 체계 개편 검토</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">주의할 점</h3>\n<ol>\n<li><strong>중과 유예 종료 대비</strong>: 다주택자는 5월 9일 이전 매도 검토</li>\n<li><strong>공시가격 변동</strong>: 2026년 공시가격 상승 시 종부세 증가</li>\n<li><strong>정책 변화 모니터링</strong>: 총선 이후 세제 개편 가능성</li>\n</ol>\n<hr>\n<h2 id=\"heading-29\">자주 묻는 질문</h2>\n<h3 id=\"heading-30\">Q1. 일시적 2주택, 비과세 받을 수 있나요?</h3>\n<p>A. 네, 다음 요건 충족 시 가능합니다:</p>\n<ul>\n<li>종전 주택 2년 이상 보유</li>\n<li>신규 주택 취득 후 3년 내 종전 주택 양도</li>\n<li>종전 주택 양도가액 12억원 이하</li>\n</ul>\n<h3 id=\"heading-31\">Q2. 부부 공동명의가 유리한가요?</h3>\n<p>A. 상황에 따라 다릅니다:</p>\n<ul>\n<li><strong>종부세</strong>: 공동명의 시 공제액 2배 (유리)</li>\n<li><strong>양도세</strong>: 각자 지분 계산, 장특공제 중복 (유리)</li>\n<li><strong>취득세</strong>: 차이 없음</li>\n</ul>\n<h3 id=\"heading-32\">Q3. 주택임대사업자 등록하면 세금 혜택이 있나요?</h3>\n<p>A. 2020년 이후 세제 혜택이 대폭 축소되었습니다. 현재는 종부세 합산 배제 정도의 혜택만 일부 유지됩니다.</p>\n<h3 id=\"heading-33\">Q4. 상속받은 주택, 세금은 어떻게 되나요?</h3>\n<p>A. 상속세와 별개로:</p>\n<ul>\n<li><strong>취득세</strong>: 상속 시 2.8% (농특세 포함 3.16%)</li>\n<li><strong>양도세</strong>: 상속 당시 시가로 취득가액 산정</li>\n<li><strong>종부세</strong>: 보유 주택에 합산</li>\n</ul>\n<h3 id=\"heading-34\">Q5. 증여와 양도, 어떤 게 유리한가요?</h3>\n<p>A. 일반적으로:</p>\n<ul>\n<li><strong>시가 상승 예상</strong>: 증여 유리 (미래 시세차익 절세)</li>\n<li><strong>시가 하락 예상</strong>: 양도 유리 (현재 시점 과세)</li>\n<li><strong>자금 필요</strong>: 양도 (현금 확보)</li>\n</ul>\n<hr>\n<h2 id=\"heading-35\">마무리</h2>\n<p>부동산 세금은 취득부터 양도까지 전 과정에서 발생합니다. 2026년에는 특히 <strong>다주택자 양도세 중과 유예 종료</strong>(5월 9일)를 주의 깊게 살펴보셔야 합니다.</p>\n<p><strong>핵심 체크포인트</strong>:</p>\n<ol>\n<li>✅ 1세대 1주택 비과세 요건 확인 (2년 보유·거주)</li>\n<li>✅ 다주택자 중과 유예 기간 활용</li>\n<li>✅ 장기보유특별공제 최대화</li>\n<li>✅ 필요경비 영수증 철저히 보관</li>\n<li>✅ 공동명의 장단점 비교</li>\n</ol>\n<p>세금 문제는 개인 상황에 따라 크게 달라지므로, 중요한 결정 전에는 <strong>세무사 상담</strong>을 받으시기 바랍니다.</p>\n<hr>\n<h3 id=\"heading-36\">함께 읽으면 좋은 글</h3>\n<ul>\n<li>2026년 주택담보대출 금리 비교</li>\n<li>전세대출 조건 비교 가이드</li>\n<li>부동산 경매 입문 가이드</li>\n</ul>\n<hr>\n<p><em>본 글은 2026년 1월 기준으로 작성되었습니다. 세법은 개정될 수 있으므로 정확한 내용은 국세청 또는 세무 전문가에게 확인하시기 바랍니다.</em></p>\n1c:[\"$\",\"$L22\",null,{\"content\":\"$23\"}]\n24:T3b0a,<h1>2026년 부동산 세금 총정리</h1>\n<p>부동산을 취득하거나 보유, 양도할 때 다양한 세금이 발생합니다. 2026년에도 여러 세제 변화가 있는데요, 이 글에서는 <strong>취득세, 양도소득세, 종합부동산세</strong>를 중심으로 핵심 내용을 정리해 드립니다.</p>\n<hr>\n<h2 id=\"heading-0\">부동산 세금 체계 한눈에 보기</h2>\n<table>\n<thead>\n<tr>\n<th>단계</th>\n<th>세금 종류</th>\n<th>과세 시점</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>취득</strong></td>\n<td>취득세, 인지세</td>\n<td>부동산 매수 시</td>\n</tr>\n<tr>\n<td><strong>보유</strong></td>\n<td>재산세, 종합부동산세</td>\n<td>매년 6월 1일 기준</td>\n</tr>\n<tr>\n<td><strong>양도</strong></td>\n<td>양도소득세</td>\n<td>부동산 매도 시</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-1\">1. 취득세</h2>\n<h3 id=\"heading-2\">주택 취득세율 (2026년)</h3>\n<table>\n<thead>\n<tr>\n<th>주택 수</th>\n<th>취득가액</th>\n<th>세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>1주택</strong></td>\n<td>6억원 이하</td>\n<td>1%</td>\n</tr>\n<tr>\n<td></td>\n<td>6억~9억원</td>\n<td>2%</td>\n</tr>\n<tr>\n<td></td>\n<td>9억원 초과</td>\n<td>3%</td>\n</tr>\n<tr>\n<td><strong>2주택</strong></td>\n<td>조정대상지역</td>\n<td>8%</td>\n</tr>\n<tr>\n<td></td>\n<td>비조정지역</td>\n<td>1~3%</td>\n</tr>\n<tr>\n<td><strong>3주택 이상</strong></td>\n<td>조정대상지역</td>\n<td>12%</td>\n</tr>\n<tr>\n<td></td>\n<td>비조정지역</td>\n<td>8%</td>\n</tr>\n<tr>\n<td><strong>법인</strong></td>\n<td>전체</td>\n<td>12%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-3\">취득세 계산 공식</h3>\n<pre><code>취득세 = 취득가액 × 세율\n\n※ 실제 납부액 = 취득세 + 지방교육세(취득세의 10%) + 농어촌특별세\n</code></pre>\n<h3 id=\"heading-4\">취득세 감면 혜택</h3>\n<table>\n<thead>\n<tr>\n<th>감면 대상</th>\n<th>감면율</th>\n<th>조건</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>생애최초 주택</td>\n<td>최대 200만원</td>\n<td>부부합산 연소득 7,000만원 이하</td>\n</tr>\n<tr>\n<td>신혼부부</td>\n<td>50% 감면</td>\n<td>혼인 7년 이내, 6억원 이하</td>\n</tr>\n<tr>\n<td>다자녀 가구</td>\n<td>50% 감면</td>\n<td>18세 미만 자녀 3명 이상</td>\n</tr>\n<tr>\n<td>장애인</td>\n<td>면제</td>\n<td>1~3급 장애인</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>💡 <strong>Tip</strong>: 생애최초 주택 취득 시 취득세 감면과 함께 <strong>취득자금 증여 특례</strong>(직계존속 5,000만원 비과세)도 함께 활용하세요.</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-5\">2. 양도소득세</h2>\n<h3 id=\"heading-6\">2026년 양도세 핵심 변경사항</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>내용</th>\n<th>적용 기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>다주택자 중과 유예</strong></td>\n<td>2주택 +20%p, 3주택 +30%p 중과 유예</td>\n<td>~2026.05.09</td>\n</tr>\n<tr>\n<td><strong>장기보유특별공제</strong></td>\n<td>다주택자 적용 배제 유지</td>\n<td>계속</td>\n</tr>\n<tr>\n<td><strong>1세대 1주택 비과세</strong></td>\n<td>12억원까지 비과세</td>\n<td>계속</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-7\">기본 세율 (누진세)</h3>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1,400만원 이하</td>\n<td>6%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>5,000만원 이하</td>\n<td>15%</td>\n<td>126만원</td>\n</tr>\n<tr>\n<td>8,800만원 이하</td>\n<td>24%</td>\n<td>576만원</td>\n</tr>\n<tr>\n<td>1.5억원 이하</td>\n<td>35%</td>\n<td>1,544만원</td>\n</tr>\n<tr>\n<td>3억원 이하</td>\n<td>38%</td>\n<td>1,994만원</td>\n</tr>\n<tr>\n<td>5억원 이하</td>\n<td>40%</td>\n<td>2,594만원</td>\n</tr>\n<tr>\n<td>10억원 이하</td>\n<td>42%</td>\n<td>3,594만원</td>\n</tr>\n<tr>\n<td>10억원 초과</td>\n<td>45%</td>\n<td>6,594만원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-8\">다주택자 중과세율 (중과 적용 시)</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>기본세율</th>\n<th>중과세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2주택</td>\n<td>6~45%</td>\n<td>+20%p (최고 65%)</td>\n</tr>\n<tr>\n<td>3주택 이상</td>\n<td>6~45%</td>\n<td>+30%p (최고 75%)</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>⚠️ <strong>중요</strong>: 2026년 5월 9일까지 다주택자 중과가 유예 중입니다. 유예 기간 내 매도 계획이 있다면 시기를 잘 조율하세요.</p>\n</blockquote>\n<h3 id=\"heading-9\">장기보유특별공제</h3>\n<p><strong>1세대 1주택자</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>보유 기간</th>\n<th>공제율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3년</td>\n<td>24%</td>\n</tr>\n<tr>\n<td>4년</td>\n<td>32%</td>\n</tr>\n<tr>\n<td>5년</td>\n<td>40%</td>\n</tr>\n<tr>\n<td>6년</td>\n<td>48%</td>\n</tr>\n<tr>\n<td>7년</td>\n<td>56%</td>\n</tr>\n<tr>\n<td>8년</td>\n<td>64%</td>\n</tr>\n<tr>\n<td>9년</td>\n<td>72%</td>\n</tr>\n<tr>\n<td>10년 이상</td>\n<td>80%</td>\n</tr>\n</tbody>\n</table>\n<p><strong>일반 주택/토지</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>보유 기간</th>\n<th>공제율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3년</td>\n<td>6%</td>\n</tr>\n<tr>\n<td>4년</td>\n<td>8%</td>\n</tr>\n<tr>\n<td>5년</td>\n<td>10%</td>\n</tr>\n<tr>\n<td>...</td>\n<td>연 2%씩 증가</td>\n</tr>\n<tr>\n<td>15년 이상</td>\n<td>30%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-10\">1세대 1주택 비과세 요건</h3>\n<table>\n<thead>\n<tr>\n<th>요건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>보유 기간</td>\n<td>2년 이상</td>\n</tr>\n<tr>\n<td>거주 기간</td>\n<td>2년 이상 (조정대상지역)</td>\n</tr>\n<tr>\n<td>양도가액</td>\n<td>12억원 이하</td>\n</tr>\n<tr>\n<td>세대 요건</td>\n<td>양도일 현재 1세대 1주택</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-11\">양도세 계산 예시</h3>\n<p><strong>조건</strong>: 2020년 5억원 매수, 2026년 8억원 매도, 1세대 1주택, 6년 보유·거주</p>\n<pre><code>1. 양도차익: 8억 - 5억 = 3억원\n2. 장특공제(48%): 3억 × 48% = 1.44억원\n3. 양도소득금액: 3억 - 1.44억 = 1.56억원\n4. 기본공제: 250만원\n5. 과세표준: 1.56억 - 0.025억 = 1.535억원\n6. 산출세액: 1.535억 × 35% - 1,544만원 = 약 3,829만원\n7. 지방소득세: 약 383만원\n→ 총 납부세액: 약 4,212만원\n</code></pre>\n<blockquote>\n<p>💡 12억원 이하 1주택이므로 <strong>비과세</strong>에 해당하여 실제 납부액은 0원입니다.</p>\n</blockquote>\n<hr>\n<h2 id=\"heading-12\">3. 종합부동산세</h2>\n<h3 id=\"heading-13\">과세 기준일</h3>\n<p>매년 <strong>6월 1일</strong> 기준 보유 부동산 합산</p>\n<h3 id=\"heading-14\">공제금액</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>공제금액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1세대 1주택자</td>\n<td>12억원</td>\n</tr>\n<tr>\n<td>다주택자</td>\n<td>9억원</td>\n</tr>\n<tr>\n<td>법인</td>\n<td>공제 없음</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-15\">세율 (2026년)</h3>\n<p><strong>일반 세율</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3억원 이하</td>\n<td>0.5%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>6억원 이하</td>\n<td>0.7%</td>\n<td>60만원</td>\n</tr>\n<tr>\n<td>12억원 이하</td>\n<td>1.0%</td>\n<td>240만원</td>\n</tr>\n<tr>\n<td>25억원 이하</td>\n<td>1.3%</td>\n<td>600만원</td>\n</tr>\n<tr>\n<td>50억원 이하</td>\n<td>1.5%</td>\n<td>1,100만원</td>\n</tr>\n<tr>\n<td>94억원 이하</td>\n<td>2.0%</td>\n<td>3,600만원</td>\n</tr>\n<tr>\n<td>94억원 초과</td>\n<td>2.7%</td>\n<td>10,180만원</td>\n</tr>\n</tbody>\n</table>\n<p><strong>3주택 이상 또는 조정대상지역 2주택 (중과)</strong>:</p>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n<th>누진공제</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3억원 이하</td>\n<td>1.2%</td>\n<td>-</td>\n</tr>\n<tr>\n<td>6억원 이하</td>\n<td>1.6%</td>\n<td>120만원</td>\n</tr>\n<tr>\n<td>12억원 이하</td>\n<td>2.2%</td>\n<td>480만원</td>\n</tr>\n<tr>\n<td>25억원 이하</td>\n<td>3.6%</td>\n<td>2,160만원</td>\n</tr>\n<tr>\n<td>50억원 이하</td>\n<td>5.0%</td>\n<td>5,660만원</td>\n</tr>\n<tr>\n<td>94억원 이하</td>\n<td>6.0%</td>\n<td>10,660만원</td>\n</tr>\n<tr>\n<td>94억원 초과</td>\n<td>6.0%</td>\n<td>10,660만원</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-16\">종부세 계산 예시</h3>\n<p><strong>조건</strong>: 공시가격 15억원 아파트 1채 보유, 1세대 1주택자</p>\n<pre><code>1. 과세표준: 15억 - 12억(공제) = 3억원\n2. 세율 적용: 3억 × 0.5% = 150만원\n3. 세부담 상한: 전년도 재산세+종부세 × 150%\n4. 농어촌특별세: 종부세 × 20% = 30만원\n→ 예상 종부세: 약 180만원\n</code></pre>\n<h3 id=\"heading-17\">세부담 상한제</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>상한 비율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>일반</td>\n<td>전년도 세액 × 150%</td>\n</tr>\n<tr>\n<td>3주택 이상/조정2주택</td>\n<td>전년도 세액 × 300%</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-18\">4. 재산세</h2>\n<h3 id=\"heading-19\">주택 재산세율</h3>\n<table>\n<thead>\n<tr>\n<th>과세표준</th>\n<th>세율</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>6,000만원 이하</td>\n<td>0.1%</td>\n</tr>\n<tr>\n<td>1.5억원 이하</td>\n<td>0.15%</td>\n</tr>\n<tr>\n<td>3억원 이하</td>\n<td>0.25%</td>\n</tr>\n<tr>\n<td>3억원 초과</td>\n<td>0.4%</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-20\">납부 시기</h3>\n<table>\n<thead>\n<tr>\n<th>기분</th>\n<th>납부 기간</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1기분</td>\n<td>7월 16일 ~ 7월 31일</td>\n</tr>\n<tr>\n<td>2기분</td>\n<td>9월 16일 ~ 9월 30일</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-21\">부동산 세금 절세 전략</h2>\n<h3 id=\"heading-22\">1. 취득 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>생애최초 감면</td>\n<td>최대 200만원 감면</td>\n</tr>\n<tr>\n<td>신혼부부 감면</td>\n<td>50% 감면 (6억 이하)</td>\n</tr>\n<tr>\n<td>증여 활용</td>\n<td>직계존속 5,000만원 비과세</td>\n</tr>\n<tr>\n<td>공동명의</td>\n<td>종부세 공제액 확대</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-23\">2. 보유 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>공동명의</td>\n<td>종부세 공제액 2배 (9억 × 2인)</td>\n</tr>\n<tr>\n<td>임대사업자 등록</td>\n<td>종부세 합산 배제 (일부)</td>\n</tr>\n<tr>\n<td>공시가격 이의신청</td>\n<td>과다 산정 시 이의신청</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-24\">3. 양도 단계 절세</h3>\n<table>\n<thead>\n<tr>\n<th>전략</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2년 이상 보유·거주</td>\n<td>1세대 1주택 비과세</td>\n</tr>\n<tr>\n<td>장기보유</td>\n<td>최대 80% 공제</td>\n</tr>\n<tr>\n<td>중과 유예 활용</td>\n<td>2026.05.09까지 매도</td>\n</tr>\n<tr>\n<td>필요경비 챙기기</td>\n<td>취득세, 중개수수료, 인테리어 등</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-25\">양도세 필요경비 항목</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>공제 가능 여부</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>취득세</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>중개수수료</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>법무사 비용</td>\n<td>✅ 공제 가능</td>\n</tr>\n<tr>\n<td>인테리어 비용</td>\n<td>✅ 공제 가능 (자본적 지출)</td>\n</tr>\n<tr>\n<td>이사 비용</td>\n<td>❌ 공제 불가</td>\n</tr>\n<tr>\n<td>대출 이자</td>\n<td>❌ 공제 불가</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-26\">2026년 부동산 세제 전망</h2>\n<h3 id=\"heading-27\">예정된 변화</h3>\n<table>\n<thead>\n<tr>\n<th>시기</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2026.05.09</td>\n<td>다주택자 양도세 중과 유예 종료 예정</td>\n</tr>\n<tr>\n<td>2026년 내</td>\n<td>종부세 개편안 논의 중</td>\n</tr>\n<tr>\n<td>미정</td>\n<td>취득세 체계 개편 검토</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-28\">주의할 점</h3>\n<ol>\n<li><strong>중과 유예 종료 대비</strong>: 다주택자는 5월 9일 이전 매도 검토</li>\n<li><strong>공시가격 변동</strong>: 2026년 공시가격 상승 시 종부세 증가</li>\n<li><strong>정책 변화 모니터링</strong>: 총선 이후 세제 개편 가능성</li>\n</ol>\n<hr>\n<h2 id=\"heading-29\">자주 묻는 질문</h2>\n<h3 id=\"heading-30\">Q1. 일시적 2주택, 비과세 받을 수 있나요?</h3>\n<p>A. 네, 다음 요건 충족 시 가능합니다:</p>\n<ul>\n<li>종전 주택 2년 이상 보유</li>\n<li>신규 주택 취득 후 3년 내 종전 주택 양도</li>\n<li>종전 주택 양도가액 12억원 이하</li>\n</ul>\n<h3 id=\"heading-31\">Q2. 부부 공동명의가 유리한가요?</h3>\n<p>A. 상황에 따라 다릅니다:</p>\n<ul>\n<li><strong>종부세</strong>: 공동명의 시 공제액 2배 (유리)</li>\n<li><strong>양도세</strong>: 각자 지분 계산, 장특공제 중복 (유리)</li>\n<li><strong>취득세</strong>: 차이 없음</li>\n</ul>\n<h3 id=\"heading-32\">Q3. 주택임대사업자 등록하면 세금 혜택이 있나요?</h3>\n<p>A. 2020년 이후 세제 혜택이 대폭 축소되었습니다. 현재는 종부세 합산 배제 정도의 혜택만 일부 유지됩니다.</p>\n<h3 id=\"heading-33\">Q4. 상속받은 주택, 세금은 어떻게 되나요?</h3>\n<p>A. 상속세와 별개로:</p>\n<ul>\n<li><strong>취득세</strong>: 상속 시 2.8% (농특세 포함 3.16%)</li>\n<li><strong>양도세</strong>: 상속 당시 시가로 취득가액 산정</li>\n<li><strong>종부세</strong>: 보유 주택에 합산</li>\n</ul>\n<h3 id=\"heading-34\">Q5. 증여와 양도, 어떤 게 유리한가요?</h3>\n<p>A. 일반적으로:</p>\n<ul>\n<li><strong>시가 상승 예상</strong>: 증여 유리 (미래 시세차익 절세)</li>\n<li><strong>시가 하락 예상</strong>: 양도 유리 (현재 시점 과세)</li>\n<li><strong>자금 필요</strong>: 양도 (현금 확보)</li>\n</ul>\n<hr>\n<h2 id=\"heading-35\">마무리</h2>\n<p>부동산 세금은 취득부터 양도까지 전 과정에서 발생합니다. 2026년에는 특히 <strong>다주택자 양도세 중과 유예 종료</strong>(5월 9일)를 주의 깊게 살펴보셔야 합니다.</p>\n<p><strong>핵심 체크포인트</strong>:</p>\n<ol>\n<li>✅ 1세대 1주택 비과세 요건 확인 (2년 보유·거주)</li>\n<li>✅ 다주택자 중과 유예 기간 활용</li>\n<li>✅ 장기보유특별공제 최대화</li>\n<li>✅ 필요경비 영수증 철저히 보관</li>\n<li>✅ 공동명의 장단점 비교</li>\n</ol>\n<p>세금 문제는 개인 상황에 따라 크게 달라지므로, 중요한 결정 전에는 <strong>세무사 상담</strong>을 받으시기 바랍니다.</p>\n<hr>\n<h3 id=\"heading-36\">함께 읽으면 좋은 글</h3>\n<ul>\n<li>2026년 주택담보대출 금리 비교</li>\n<li>전세대출 조건 비교 가이드</li>\n<li>부동산 경매 입문 가이드</li>\n</ul>\n<hr>\n<p><em>본 글은 2026년 1월 기준으로 작성되었습니다. 세법은 개정될 수 있으므로 정확한 내용은 국세청 또는 세무 전문가에게 확인하시기 바랍니다.</em></p>\n1d:[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\",\"dangerouslySetInnerHTML\":{\"__html\":\"$24\"}}]\n1e:[\"$\",\"nav\",null,{\"className\":\"border-t border-gray-200 pt-8 mt-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$L6\",null,{\"href\":\"/posts/national-pension-reform-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"이전 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\"}]]}],[\"$\",\"$L6\",null,{\"href\":\"/posts/self-employed-tax-guide-2026\",\"className\":\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm text-gray-500 mb-1\",\"children\":\"다음 글\"}],[\"$\",\"span\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\",\"children\":\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\"}]]}]]}]}]\n1f:[\"$\",\"section\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-200\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-gray-900 mb-6\",\"children\":\"관련 게시글\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L6\",\"self-employed-tax-guide-2026\",{\"href\":\"/posts/self-employed-tax-guide-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.\"}]]}],[\"$\",\"$L6\",\"national-pension-reform-2026\",{\"href\":\"/posts/national-pension-reform-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 1월부터 시행되는 국민연금 개정안의 모든 것! 보험료율 9%→13% 단계적 인상, 소득대체율 43% 상향, 국가 지급보장 명문화까지 18년 만의 연금개혁을 쉽게 정리했습니다.\"}]]}],[\"$\",\"$L6\",\"mortgage-rate-comparison-2026\",{\"href\":\"/posts/mortgage-rate-comparison-2026\",\"className\":\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\",\"children\":\"주택담보대출 금리 비교 완벽 가이드\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-500 line-clamp-2\",\"children\":\"2026년 주택담보대출 금리를 은행별로 비교하고, 보금자리론부터 시중은행 주담대까지 최저금리 찾는 방법을 알려드립니다. 스트레스 DSR 3단계 적용과 대출 한도 계산법도 함께 확인하세요.\"}]]}]]}]]}]\n"}