ldren\":[[\"$\",\"svg\",null,{\"className\":\"w-4 h-4 text-gray-400 mx-2\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M9 5l7 7-7 7\"}]}],[\"$\",\"span\",null,{\"className\":\"text-gray-900 font-medium truncate max-w-[200px]\",\"children\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드\"}]]}]]]}]}],[\"$\",\"header\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl font-bold text-gray-900 mb-4\",\"children\":\"부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 text-sm text-gray-500\",\"children\":[[\"$\",\"time\",null,{\"dateTime\":\"2026-01-07\",\"children\":\"2026년 1월 7일\"}],[\"$\",\"span\",null,{\"children\":\"13 min read\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2 mt-4\",\"children\":[[\"$\",\"a\",\"부동산세금\",{\"href\":\"/tag/부동산세금\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"부동산세금\"]}],[\"$\",\"a\",\"취득세\",{\"href\":\"/tag/취득세\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"취득세\"]}],[\"$\",\"a\",\"양도소득세\",{\"href\":\"/tag/양도소득세\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"양도소득세\"]}],[\"$\",\"a\",\"종합부동산세\",{\"href\":\"/tag/종합부동산세\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"종합부동산세\"]}],[\"$\",\"a\",\"부동산절세\",{\"href\":\"/tag/부동산절세\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"부동산절세\"]}],[\"$\",\"a\",\"2026년세금\",{\"href\":\"/tag/2026년세금\",\"className\":\"text-sm text-blue-600 bg-blue-50 px-3 py-1 rounded-full hover:bg-blue-100\",\"children\":[\"#\",\"2026년세금\"]}],[\"$\",