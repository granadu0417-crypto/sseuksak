03ctd\\u003e3억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e0.25%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3억원 초과\\u003c/td\\u003e\\n\\u003ctd\\u003e0.4%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-20\\\"\\u003e납부 시기\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e기분\\u003c/th\\u003e\\n\\u003cth\\u003e납부 기간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1기분\\u003c/td\\u003e\\n\\u003ctd\\u003e7월 16일 ~ 7월 31일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2기분\\u003c/td\\u003e\\n\\u003ctd\\u003e9월 16일 ~ 9월 30일\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-21\\\"\\u003e부동산 세금 절세 전략\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-22\\\"\\u003e1. 취득 단계 절세\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e전략\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e생애최초 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 200만원 감면\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신혼부부 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e50% 감면 (6억 이하)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e증여 활용\\u003c/td\\u003e\\n\\u003ctd\\u003e직계존속 5,000만원 비과세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공동명의\\u003c/td\\u003e\\n\\u003ctd\\u003e종부세 공제액 확대\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-23\\\"\\u003e2. 보유 단계 절세\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e전략\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공동명의\\u003c/td\\u003e\\n\\u003ctd\\u003e종부세 공제액 2배 (9억 × 2인)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e임대사업자 등록\\u003c/td\\u003e\\n\\u003ctd\\u003e종부세 합산 배제 (일부)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e공시가격 이의신청\\u003c/td\\u003e\\n\\u003ctd\\u003e과다 산정 시 이의신청\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e3. 양도 단계 절세\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e전략\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2년 이상 보유·거주\\u003c/td\\u003e\\n\\u003ctd\\u003e1세대 1주택 비과세\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장기보유\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 80% 공제\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중과 유예 활용\\u003c/td\\u003e\\n\\u003ctd\\u003e2026.05.09까지 매도\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e필요경비 챙기기\\u003c/td\\u003e\\n\\u003ctd\\u003e취득세, 중개수수료, 인테리어 등\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-25\\\"\\u003e양도세 필요경비 항목\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e공제 가능 여부\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e취득세\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 공제 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e중개수수료\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 공제 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e법무사 비용\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 공제 가능\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e인테리어 비용\\u003c/td\\u003e\\n\\u003ctd\\u003e✅ 공제 가능 (자본적 지출)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e이사 비용\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 공제 불가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e대출 이자\\u003c/td\\u003e\\n\\u003ctd\\u003e❌ 공제 불가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-26\\\"\\u003e2026년 부동산 세제 전망\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e예정된 변화\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e시기\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026.05.09\\u003c/td\\u003e\\n\\u003ctd\\u003e다주택자 양도세 중과 유예 종료 예정\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2026년 내\\u003c/td\\u003e\\n\\u003ctd\\u003e종부세 개편안 논의 중\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e미정\\u003c/td\\u003e\\n\\u003ctd\\u003e취득세 체계 개편 검토\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-28\\\"\\u003e주의할 점\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e중과 유예 종료 대비\\u003c/strong\\u003e: 다주택자는 5월 9일 이전 매도 검토\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e공시가격 변동\\u003c/strong\\u003e: 2026년 공시가격 상승 시 종부세 증가\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e정책 변화 모니터링\\u003c/strong\\u003e: 총선 이후 세제 개편 가능성\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-29\\\"\\u003e자주 묻는 질문\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ1. 일시적 2주택, 비과세 받을 수 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 네, 다음 요건 충족 시 가능합니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e종전 주택 2년 이상 보유\\u003c/li\\u003e\\n\\u003cli\\u003e신규 주택 취득 후 3년 내 종전 주택 양도\\u003c/li\\u003e\\n\\u003cli\\u003e종전 주택 양도가액 12억원 이하\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003eQ2. 부부 공동명의가 유리한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 상황에 따라 다릅니다:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e종부세\\u003c/strong\\u003e: 공동명의 시 공제액 2배 (유리)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e양도세\\u003c/strong\\u003e: 각자 지분 계산, 장특공제 중복 (유리)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e취득세\\u003c/strong\\u003e: 차이 없음\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003eQ3. 주택임대사업자 등록하면 세금 혜택이 있나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 2020년 이후 세제 혜택이 대폭 축소되었습니다. 현재는 종부세 합산 배제 정도의 혜택만 일부 유지됩니다.\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003eQ4. 상속받은 주택, 세금은 어떻게 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 상속세와 별개로:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e취득세\\u003c/strong\\u003e: 상속 시 2.8% (농특세 포함 3.16%)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e양도세\\u003c/strong\\u003e: 상속 당시 시가로 취득가액 산정\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e종부세\\u003c/strong\\u003e: 보유 주택에 합산\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003eQ5. 증여와 양도, 어떤 게 유리한가요?\\u003c/h3\\u003e\\n\\u003cp\\u003eA. 일반적으로:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e시가 상승 예상\\u003c/strong\\u003e: 증여 유리 (미래 시세차익 절세)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e시가 하락 예상\\u003c/strong\\u003e: 양도 유리 (현재 시점 과세)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e자금 필요\\u003c/strong\\u003e: 양도 (현금 확보)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e부동산 세금은 취득부터 양도까지 전 과정에서 발생합니다. 2026년에는 특히 \\u003cstrong\\u003e다주택자 양도세 중과 유예 종료\\u003c/strong\\u003e(5월 9일)를 주의 깊게 살펴보셔야 합니다.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e핵심 체크포인트\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003e✅ 1세대 1주택 비과세 요건 확인 (2년 보유·거주)\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 다주택자 중과 유예 기간 활용\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 장기보유특별공제 최대화\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 필요경비 영수증 철저히 보관\\u003c/li\\u003e\\n\\u003cli\\u003e✅ 공동명의 장단점 비교\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003e세금 문제는 개인 상황에 따라 크게 달라지므로, 중요한 결정 전에는 \\u003cstrong\\u003e세무사 상담\\u003c/strong\\u003e을 받으시기 바랍니다.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003e함께 읽으면 좋은 글\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2026년 주택담보대출 금리 비교\\u003c/li\\u003e\\n\\u003cli\\u003e전세대출 조건 비교 가이드\\u003c/li\\u003e\\n\\u003cli\\u003e부동산 경매 입문 가이드\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e본 글은 2026년 1월 기준으로 작성되었습니다. 세법은 개정될 수 있으므로 정확한 내용은 국세청 또는 세무 전문가에게 확인하시기 바랍니다.\\u003c/em\\u003e\\u003c/p\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$24\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/national-pension-reform-2026\\\",\\\"className\\\":\\\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm text-gray-500 mb-1\\\",\\\"children\\\":\\\"이전 글\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\\\",\\\"children\\\":\\\"2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드\\\"}]]}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\"/posts/self-employed-tax-guide-2026\\\",\