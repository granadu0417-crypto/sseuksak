u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e단계\\u003c/th\\u003e\\n\\u003cth\\u003e세금 종류\\u003c/th\\u003e\\n\\u003cth\\u003e과세 시점\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e취득\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e취득세, 인지세\\u003c/td\\u003e\\n\\u003ctd\\u003e부동산 매수 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e보유\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e재산세, 종합부동산세\\u003c/td\\u003e\\n\\u003ctd\\u003e매년 6월 1일 기준\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e양도\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e양도소득세\\u003c/td\\u003e\\n\\u003ctd\\u003e부동산 매도 시\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-1\\\"\\u003e1. 취득세\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-2\\\"\\u003e주택 취득세율 (2026년)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e주택 수\\u003c/th\\u003e\\n\\u003cth\\u003e취득가액\\u003c/th\\u003e\\n\\u003cth\\u003e세율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1주택\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e6억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e1%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e6억~9억원\\u003c/td\\u003e\\n\\u003ctd\\u003e2%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e9억원 초과\\u003c/td\\u003e\\n\\u003ctd\\u003e3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2주택\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e조정대상지역\\u003c/td\\u003e\\n\\u003ctd\\u003e8%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e비조정지역\\u003c/td\\u003e\\n\\u003ctd\\u003e1~3%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e3주택 이상\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e조정대상지역\\u003c/td\\u003e\\n\\u003ctd\\u003e12%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e비조정지역\\u003c/td\\u003e\\n\\u003ctd\\u003e8%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e법인\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e전체\\u003c/td\\u003e\\n\\u003ctd\\u003e12%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-3\\\"\\u003e취득세 계산 공식\\u003c/h3\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e취득세 = 취득가액 × 세율\\n\\n※ 실제 납부액 = 취득세 + 지방교육세(취득세의 10%) + 농어촌특별세\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003ch3 id=\\\"heading-4\\\"\\u003e취득세 감면 혜택\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e감면 대상\\u003c/th\\u003e\\n\\u003cth\\u003e감면율\\u003c/th\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e생애최초 주택\\u003c/td\\u003e\\n\\u003ctd\\u003e최대 200만원\\u003c/td\\u003e\\n\\u003ctd\\u003e부부합산 연소득 7,000만원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e신혼부부\\u003c/td\\u003e\\n\\u003ctd\\u003e50% 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e혼인 7년 이내, 6억원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e다자녀 가구\\u003c/td\\u003e\\n\\u003ctd\\u003e50% 감면\\u003c/td\\u003e\\n\\u003ctd\\u003e18세 미만 자녀 3명 이상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e장애인\\u003c/td\\u003e\\n\\u003ctd\\u003e면제\\u003c/td\\u003e\\n\\u003ctd\\u003e1~3급 장애인\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 \\u003cstrong\\u003eTip\\u003c/strong\\u003e: 생애최초 주택 취득 시 취득세 감면과 함께 \\u003cstrong\\u003e취득자금 증여 특례\\u003c/strong\\u003e(직계존속 5,000만원 비과세)도 함께 활용하세요.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-5\\\"\\u003e2. 양도소득세\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-6\\\"\\u003e2026년 양도세 핵심 변경사항\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003cth\\u003e적용 기간\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e다주택자 중과 유예\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e2주택 +20%p, 3주택 +30%p 중과 유예\\u003c/td\\u003e\\n\\u003ctd\\u003e~2026.05.09\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e장기보유특별공제\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e다주택자 적용 배제 유지\\u003c/td\\u003e\\n\\u003ctd\\u003e계속\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e1세대 1주택 비과세\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e12억원까지 비과세\\u003c/td\\u003e\\n\\u003ctd\\u003e계속\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-7\\\"\\u003e기본 세율 (누진세)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e과세표준\\u003c/th\\u003e\\n\\u003cth\\u003e세율\\u003c/th\\u003e\\n\\u003cth\\u003e누진공제\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1,400만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e6%\\u003c/td\\u003e\\n\\u003ctd\\u003e-\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5,000만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e15%\\u003c/td\\u003e\\n\\u003ctd\\u003e126만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e8,800만원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e24%\\u003c/td\\u003e\\n\\u003ctd\\u003e576만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1.5억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e35%\\u003c/td\\u003e\\n\\u003ctd\\u003e1,544만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e38%\\u003c/td\\u003e\\n\\u003ctd\\u003e1,994만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003ctd\\u003e2,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10억원 이하\\u003c/td\\u003e\\n\\u003ctd\\u003e42%\\u003c/td\\u003e\\n\\u003ctd\\u003e3,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10억원 초과\\u003c/td\\u003e\\n\\u003ctd\\u003e45%\\u003c/td\\u003e\\n\\u003ctd\\u003e6,594만원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-8\\\"\\u003e다주택자 중과세율 (중과 적용 시)\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e기본세율\\u003c/th\\u003e\\n\\u003cth\\u003e중과세율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2주택\\u003c/td\\u003e\\n\\u003ctd\\u003e6~45%\\u003c/td\\u003e\\n\\u003ctd\\u003e+20%p (최고 65%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3주택 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e6~45%\\u003c/td\\u003e\\n\\u003ctd\\u003e+30%p (최고 75%)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e⚠️ \\u003cstrong\\u003e중요\\u003c/strong\\u003e: 2026년 5월 9일까지 다주택자 중과가 유예 중입니다. 유예 기간 내 매도 계획이 있다면 시기를 잘 조율하세요.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3 id=\\\"heading-9\\\"\\u003e장기보유특별공제\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e1세대 1주택자\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e보유 기간\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3년\\u003c/td\\u003e\\n\\u003ctd\\u003e24%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4년\\u003c/td\\u003e\\n\\u003ctd\\u003e32%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e40%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e6년\\u003c/td\\u003e\\n\\u003ctd\\u003e48%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e7년\\u003c/td\\u003e\\n\\u003ctd\\u003e56%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e8년\\u003c/td\\u003e\\n\\u003ctd\\u003e64%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e9년\\u003c/td\\u003e\\n\\u003ctd\\u003e72%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e10년 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e80%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e일반 주택/토지\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e보유 기간\\u003c/th\\u003e\\n\\u003cth\\u003e공제율\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e3년\\u003c/td\\u003e\\n\\u003ctd\\u003e6%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e4년\\u003c/td\\u003e\\n\\u003ctd\\u003e8%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e5년\\u003c/td\\u003e\\n\\u003ctd\\u003e10%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e...\\u003c/td\\u003e\\n\\u003ctd\\u003e연 2%씩 증가\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e15년 이상\\u003c/td\\u003e\\n\\u003ctd\\u003e30%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-10\\\"\\u003e1세대 1주택 비과세 요건\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e요건\\u003c/th\\u003e\\n\\u003cth\\u003e내용\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e보유 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e2년 이상\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e거주 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e2년 이상 (조정대상지역)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e양도가액\\u003c/td\\u003e\\n\\u003ctd\\u003e12억원 이하\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e세대 요건\\u003c/td\\u003e\\n\\u003ctd\\u003e양도일 현재 1세대 1주택\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-11\\\"\\u003e양도세 계산 예시\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e조건\\u003c/strong\\u003e: 2020년 5억원 매수, 2026년 8억원 매도, 1세대 1주택, 6년 보유·거주\\u003c/p\\u003e\\n\\u003cpre\\u003e\\u003ccode\\u003e1. 양도차익: 8억 - 5억 = 3억원\\n2. 장특공제(48%): 3억 × 48% = 1.44억원\\n3. 양도소득금액: 3억 - 1.44억 = 1.56억원\\n4. 기본공제: 250만원\\n5. 과세표준: 1.56억 - 0.025억 = 1.535억원\\n6. 산출세액: 1.535억 × 35% - 1,544만원 = 약 3,829만원\\n7. 지방소득세: 약 383만원\\n→ 총 납부세액: 약 4,212만원\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003e💡 12억원 이하 1주택이므로 \\u003cstrong\\u003e비과세\\u003c/strong\\u003e에 해당하여 실제 납부액은 0원입니다.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-12\\\"\\u003e3. 종합부동산세\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-13\\\"\\u003e과세 기준일\\u003c/h3\\u003e\\n\\u003cp\\u003e매년 \\u003cstrong\\u003e6월 1일\\u003c/strong\\u003e 기준 보유 부동산 합산\\u003c/p\\u003e\\n\\u003ch3 id=\\\"heading-14\\\"\\u003e공제금액\\u003c/h3\\u003e\\n\\u003