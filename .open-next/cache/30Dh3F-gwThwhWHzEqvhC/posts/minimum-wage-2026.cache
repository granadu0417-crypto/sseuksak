\"2026년\"}],[\"$\",\"meta\",\"31\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"32\",{\"name\":\"twitter:title\",\"content\":\"2026년 최저임금 완벽 가이드: 시급, 월급 계산, 주휴수당까지 총정리 | 쓱싹\"}],[\"$\",\"meta\",\"33\",{\"name\":\"twitter:description\",\"content\":\"2026년 최저임금이 확정되었습니다. 시급, 월급 환산액, 주휴수당 계산법, 사업주와 근로자가 알아야 할 핵심 내용을 총정리했습니다.\"}],[\"$\",\"meta\",\"34\",{\"name\":\"twitter:image\",\"content\":\"https://images.unsplash.com/photo-1526628953301-3e589a6a8b74?ixid=M3w4NTI2NzZ8MHwxfHNlYXJjaHw2fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA&ixlib=rb-4.1.0&w=1200&q=85&fm=auto&fit=crop\"}],[\"$\",\"link\",\"35\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L23\",\"36\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n"}