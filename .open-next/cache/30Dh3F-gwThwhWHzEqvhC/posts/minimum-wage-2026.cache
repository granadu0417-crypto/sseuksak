u003cli\\u003e\\u003cstrong\\u003e사업주에게 시정 요청\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e시정되지 않으면 \\u003cstrong\\u003e고용노동부 신고\\u003c/strong\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e고용노동부 콜센터: 1350\\u003c/li\\u003e\\n\\u003cli\\u003e관할 고용노동청 방문\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e체불임금 청구 소송\\u003c/strong\\u003e\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3 id=\\\"heading-24\\\"\\u003e수습 기간 감액 규정\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e조건\\u003c/th\\u003e\\n\\u003cth\\u003e감액 가능\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e수습 기간\\u003c/td\\u003e\\n\\u003ctd\\u003e3개월 이내\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e단순노무직\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e감액 불가\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e1년 미만 계약\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e감액 불가\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e그 외\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e최대 10% 감액 가능\\u003c/strong\\u003e (시급 9,288원)\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-25\\\"\\u003e최저임금 변화 추이\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-26\\\"\\u003e최근 5년간 최저임금\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e연도\\u003c/th\\u003e\\n\\u003cth\\u003e시급\\u003c/th\\u003e\\n\\u003cth\\u003e월급 (209시간)\\u003c/th\\u003e\\n\\u003cth\\u003e인상률\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2022년\\u003c/td\\u003e\\n\\u003ctd\\u003e9,160원\\u003c/td\\u003e\\n\\u003ctd\\u003e1,914,440원\\u003c/td\\u003e\\n\\u003ctd\\u003e5.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2023년\\u003c/td\\u003e\\n\\u003ctd\\u003e9,620원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,010,580원\\u003c/td\\u003e\\n\\u003ctd\\u003e5.0%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2024년\\u003c/td\\u003e\\n\\u003ctd\\u003e9,860원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,060,740원\\u003c/td\\u003e\\n\\u003ctd\\u003e2.5%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e2025년\\u003c/td\\u003e\\n\\u003ctd\\u003e10,030원\\u003c/td\\u003e\\n\\u003ctd\\u003e2,096,270원\\u003c/td\\u003e\\n\\u003ctd\\u003e1.7%\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2026년\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10,320원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2,156,880원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2.9%\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-27\\\"\\u003e최저임금 1만 원 돌파\\u003c/h3\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e2024년: 9,860원 (1만 원 미달)\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003e2025년: 10,030원\\u003c/strong\\u003e (최초 1만 원 돌파)\\u003c/li\\u003e\\n\\u003cli\\u003e2026년: 10,360원 (1만 원대 안착)\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-28\\\"\\u003e자주 묻는 질문 (FAQ)\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-29\\\"\\u003eQ1. 아르바이트도 주휴수당 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 주 15시간 이상 근무하면 받습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e고용 형태와 관계없이 적용\\u003c/li\\u003e\\n\\u003cli\\u003e주 15시간 미만 근무 시 미적용\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-30\\\"\\u003eQ2. 식대, 교통비는 최저임금에 포함되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e실비 성격이면 포함되지 않습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e실비 변상적 성격: 미포함\\u003c/li\\u003e\\n\\u003cli\\u003e고정 급여 성격: 포함 가능\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-31\\\"\\u003eQ3. 수습 기간에는 최저임금 안 줘도 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e감액할 수 있지만 제한이 있습니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e3개월 이내 수습 기간\\u003c/li\\u003e\\n\\u003cli\\u003e최대 10% 감액 (9,288원)\\u003c/li\\u003e\\n\\u003cli\\u003e단순노무직, 1년 미만 계약은 감액 불가\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-32\\\"\\u003eQ4. 최저임금 위반 신고하면 불이익 받나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e법적으로 불이익 금지입니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e신고를 이유로 해고/불이익 처분 시 처벌\\u003c/li\\u003e\\n\\u003cli\\u003e익명 신고 가능\\u003c/li\\u003e\\n\\u003cli\\u003e고용노동부 1350 상담\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-33\\\"\\u003eQ5. 연봉제도 최저임금 적용되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e네, 시급으로 환산해서 비교합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e연봉 ÷ 12개월 ÷ 209시간 = 시급\\u003c/li\\u003e\\n\\u003cli\\u003e시급이 10,320원 미만이면 위반\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003ch3 id=\\\"heading-34\\\"\\u003eQ6. 야간수당, 주말수당은 어떻게 되나요?\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e최저임금과 별도로 지급해야 합니다.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e구분\\u003c/th\\u003e\\n\\u003cth\\u003e가산율\\u003c/th\\u003e\\n\\u003cth\\u003e시급 환산\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e연장근로\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e15,480원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e야간근로 (22시~06시)\\u003c/td\\u003e\\n\\u003ctd\\u003e50%\\u003c/td\\u003e\\n\\u003ctd\\u003e15,480원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e휴일근로\\u003c/td\\u003e\\n\\u003ctd\\u003e50~100%\\u003c/td\\u003e\\n\\u003ctd\\u003e15,480~20,640원\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-35\\\"\\u003e2026년 최저임금 핵심 정리\\u003c/h2\\u003e\\n\\u003ch3 id=\\\"heading-36\\\"\\u003e꼭 기억할 숫자\\u003c/h3\\u003e\\n\\u003ctable\\u003e\\n\\u003cthead\\u003e\\n\\u003ctr\\u003e\\n\\u003cth\\u003e항목\\u003c/th\\u003e\\n\\u003cth\\u003e금액\\u003c/th\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/thead\\u003e\\n\\u003ctbody\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e시급\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e10,320원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e일급 (8시간)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e82,560원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e월급 (209시간)\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e2,156,880원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003ctr\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e연봉 환산\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003ctd\\u003e\\u003cstrong\\u003e약 2,588만 원\\u003c/strong\\u003e\\u003c/td\\u003e\\n\\u003c/tr\\u003e\\n\\u003c/tbody\\u003e\\n\\u003c/table\\u003e\\n\\u003ch3 id=\\\"heading-37\\\"\\u003e체크리스트\\u003c/h3\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e근로자용\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 내 시급이 10,320원 이상인가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 주휴수당을 받고 있는가? (주 15시간 이상 시)\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 급여명세서를 정기적으로 확인하는가?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e사업주용\\u003c/strong\\u003e:\\u003c/p\\u003e\\n\\u003cul class=\\\"contains-task-list\\\"\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 모든 직원 시급이 10,320원 이상인가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 최저임금을 사업장에 게시했는가?\\u003c/li\\u003e\\n\\u003cli class=\\\"task-list-item\\\"\\u003e\\u003cinput type=\\\"checkbox\\\" disabled\\u003e 주휴수당을 정확히 계산하고 있는가?\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003chr\\u003e\\n\\u003ch2 id=\\\"heading-38\\\"\\u003e마무리\\u003c/h2\\u003e\\n\\u003cp\\u003e2026년 최저임금은 \\u003cstrong\\u003e시급 10,320원\\u003c/strong\\u003e, 월급 환산 \\u003cstrong\\u003e2,156,880원\\u003c/strong\\u003e입니다.\\u003c/p\\u003e\\n\\u003cp\\u003e근로자는 자신의 권리를 알고, 사업주는 법을 준수해야 합니다.\\u003c/p\\u003e\\n\\u003cp\\u003e궁금한 점은 \\u003cstrong\\u003e고용노동부 콜센터 1350\\u003c/strong\\u003e으로 문의하세요!\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e관련 글 추천:\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/health-insurance-premium-2026\\\"\\u003e2026년 건강보험료 변경사항 총정리\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003ca href=\\\"/posts/2026-credit-card-comparison\\\"\\u003e2026년 추천 신용카드 비교 가이드\\u003c/a\\u003e\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$22\\\"}}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"border-t border-gray-200 pt-8 mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"href\\\":\\\