301-3e589a6a8b74%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw2fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1526628953301-3e589a6a8b74%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw2fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1526628953301-3e589a6a8b74%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw2fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1526628953301-3e589a6a8b74%3Fixid%3DM3w4NTI2NzZ8MHwxfHNlYXJjaHw2fHxpbnZlc3RtZW50fGVufDB8MHx8fDE3Njc2NzM4ODV8MA%26ixlib%3Drb-4.1.0%26w%3D1200%26q%3D85%26fm%3Dauto%26fit%3Dcrop&amp;w=3840&amp;q=75\"/><div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-2 text-xs text-white/80\"><a href=\"https://unsplash.com/@dawson2406?utm_source=sseuksak&amp;utm_medium=referral\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white\">Photo by Stephen Dawson on Unsplash</a></div></div><nav class=\"bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8\"><button class=\"flex items-center justify-between w-full text-left font-semibold text-gray-900\"><span class=\"flex items-center gap-2\"><svg class=\"w-5 h-5 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h7\"></path></svg>목차</span><svg class=\"w-5 h-5 text-gray-500 transition-transform rotate-180\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button><ul class=\"mt-3 space-y-2 border-t border-gray-200 pt-3\"><li class=\"\"><a href=\"#heading-0\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->2026년 최저임금 확정</a></li><li class=\"ml-4\"><a href=\"#heading-1\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->시급 및 인상률</a></li><li class=\"ml-4\"><a href=\"#heading-2\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->월급 환산액</a></li><li class=\"\"><a href=\"#heading-3\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->월급 계산 방법</a></li><li class=\"ml-4\"><a href=\"#heading-4\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->기본 계산 공식</a></li><li class=\"ml-4\"><a href=\"#heading-5\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->근무 형태별 월급 예시</a></li><li class=\"ml-4\"><a href=\"#heading-6\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->주휴수당 포함 계산</a></li><li class=\"\"><a href=\"#heading-7\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->주휴수당 완벽 정리</a></li><li class=\"ml-4\"><a href=\"#heading-8\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->주휴수당이란?</a></li><li class=\"ml-4\"><a href=\"#heading-9\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->주휴수당 지급 조건</a></li><li class=\"ml-4\"><a href=\"#heading-10\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->주휴수당 계산 예시</a></li><li class=\"ml-4\"><a href=\"#heading-11\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->주의사항</a></li><li class=\"\"><a href=\"#heading-12\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->시급 계산기 활용법</a></li><li class=\"ml-4\"><a href=\"#heading-13\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->내 시급 확인하기</a></li><li class=\"ml-4\"><a href=\"#heading-14\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->예시: 월급 220만 원 직장인</a></li><li class=\"ml-4\"><a href=\"#heading-15\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->예시: 월급 200만 원 직장인</a></li><li class=\"\"><a href=\"#heading-16\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->사업주가 알아야 할 것</a></li><li class=\"ml-4\"><a href=\"#heading-17\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최저임금 적용 범위</a></li><li class=\"ml-4\"><a href=\"#heading-18\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최저임금 포함/미포함 항목</a></li><li class=\"ml-4\"><a href=\"#heading-19\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->위반 시 처벌</a></li><li class=\"ml-4\"><a href=\"#heading-20\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->사업장 고지 의무</a></li><li class=\"\"><a href=\"#heading-21\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->근로자가 알아야 할 것</a></li><li class=\"ml-4\"><a href=\"#heading-22\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최저임금 미달 확인법</a></li><li class=\"ml-4\"><a href=\"#heading-23\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최저임금 미달 시 대응</a></li><li class=\"ml-4\"><a href=\"#heading-24\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->수습 기간 감액 규정</a></li><li class=\"\"><a href=\"#heading-25\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->최저임금 변화 추이</a></li><li class=\"ml-4\"><a href=\"#heading-26\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최근 5년간 최저임금</a></li><li class=\"ml-4\"><a href=\"#heading-27\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->최저임금 1만 원 돌파</a></li><li class=\"\"><a href=\"#heading-28\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->자주 묻는 질문 (FAQ)</a></li><li class=\"ml-4\"><a href=\"#heading-29\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q1. 아르바이트도 주휴수당 받나요?</a></li><li class=\"ml-4\"><a href=\"#heading-30\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q2. 식대, 교통비는 최저임금에 포함되나요?</a></li><li class=\"ml-4\"><a href=\"#heading-31\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q3. 수습 기간에는 최저임금 안 줘도 되나요?</a></li><li class=\"ml-4\"><a href=\"#heading-32\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q4. 최저임금 위반 신고하면 불이익 받나요?</a></li><li class=\"ml-4\"><a href=\"#heading-33\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q5. 연봉제도 최저임금 적용되나요?</a></li><li class=\"ml-4\"><a href=\"#heading-34\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->Q6. 야간수당, 주말수당은 어떻게 되나요?</a></li><li class=\"\"><a href=\"#heading-35\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->2026년 최저임금 핵심 정리</a></li><li class=\"ml-4\"><a href=\"#heading-36\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->꼭 기억할 숫자</a></li><li class=\"ml-4\"><a href=\"#heading-37\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">◦ <!-- -->체크리스트</a></li><li class=\"\"><a href=\"#heading-38\" class=\"text-gray-600 hover:text-blue-600 text-sm leading-relaxed block py-0.5\">• <!-- -->마무리</a></li></ul></nav><div class=\"prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600\"><h1>2026년 최저임금 완벽 가이드: 시급, 월급 계산, 주휴수당까지 총정리</h1>\n<p>\"2026년 최저임금이 얼마야?\"</p>\n<p>2026년 최저임금이 확정되었습니다. 알바생, 직장인, 사업주 모두가 알아야 할 <strong>핵심 정보</strong>를 정리해드릴게요!</p>\n<hr>\n<h2 id=\"heading-0\">2026년 최저임금 확정</h2>\n<h3 id=\"heading-1\">시급 및 인상률</h3>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>2025년</th>\n<th>2026년</th>\n<th>인상액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>시급</strong></td>\n<td>10,030원</td>\n<td><strong>10,320원</strong></td>\n<td>+290원</td>\n</tr>\n<tr>\n<td><strong>인상률</strong></td>\n<td>1.7%</td>\n<td><strong>2.9%</strong></td>\n<td>-</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-2\">월급 환산액</h3>\n<blockquote>\n<p><strong>월 209시간 기준: 2,156,880원</strong></p>\n</blockquote>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>금액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>시급</td>\n<td>10,320원</td>\n</tr>\n<tr>\n<td>일급 (8시간)</td>\n<td>82,560원</td>\n</tr>\n<tr>\n<td>주급 (40시간)</td>\n<td>412,800원</td>\n</tr>\n<tr>\n<td><strong>월급 (209시간)</strong></td>\n<td><strong>2,156,880원</strong></td>\n</tr>\n</tbody>\n</table>\n<p><strong>참고</strong>: 월 209시간 = 주 40시간 × 52주 ÷ 12개월 + 유급주휴 포함</p>\n<hr>\n<h2 id=\"heading-3\">월급 계산 방법</h2>\n<h3 id=\"heading-4\">기본 계산 공식</h3>\n<blockquote>\n<p><strong>월급 = 시급 × 월 근로시간</strong></p>\n</blockquote>\n<h3 id=\"heading-5\">근무 형태별 월급 예시</h3>\n<table>\n<thead>\n<tr>\n<th>주당 근무시간</th>\n<th>월 근로시간</th>\n<th>월급 (세전)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>15시간 (단시간)</td>\n<td>약 65시간</td>\n<td>약 670,800원</td>\n</tr>\n<tr>\n<td>20시간</td>\n<td>약 87시간</td>\n<td>약 897,840원</td>\n</tr>\n<tr>\n<td>30시간</td>\n<td>약 130시간</td>\n<td>약 1,341,600원</td>\n</tr>\n<tr>\n<td>35시간</td>\n<td>약 152시간</td>\n<td>약 1,568,640원</td>\n</tr>\n<tr>\n<td><strong>40시간 (풀타임)</strong></td>\n<td><strong>209시간</strong></td>\n<td><strong>2,156,880원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-6\">주휴수당 포함 계산</h3>\n<p>주 15시간 이상 근무하면 <strong>주휴수당</strong>이 발생합니다.</p>\n<p><strong>주휴수당 계산법</strong>:</p>\n<blockquote>\n<p>주휴수당 = 1일 근로시간 × 시급</p>\n</blockquote>\n<p><strong>예시: 주 5일, 하루 4시간 근무 (주 20시간)</strong></p>\n<ul>\n<li>1주 기본급: 20시간 × 10,320원 = 206,400원</li>\n<li>주휴수당: 4시간 × 10,320원 = 41,280원</li>\n<li><strong>1주 총급여: 247,680원</strong></li>\n<li>월급 환산: 약 1,073,280원</li>\n</ul>\n<hr>\n<h2 id=\"heading-7\">주휴수당 완벽 정리</h2>\n<h3 id=\"heading-8\">주휴수당이란?</h3>\n<blockquote>\n<p><strong>1주일간 정해진 근무일을 모두 출근하면 받는 유급 휴일 수당</strong></p>\n</blockquote>\n<h3 id=\"heading-9\">주휴수당 지급 조건</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>주 근무시간</td>\n<td><strong>15시간 이상</strong></td>\n</tr>\n<tr>\n<td>출근율</td>\n<td>정해진 근무일 <strong>개근</strong></td>\n</tr>\n<tr>\n<td>고용 형태</td>\n<td>정규직, 아르바이트 <strong>모두 적용</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-10\">주휴수당 계산 예시</h3>\n<p><strong>예시 1: 주 5일, 하루 8시간 근무</strong></p>\n<ul>\n<li>주휴수당 = 8시간 × 10,320원 = <strong>82,560원/주</strong></li>\n<li>월 주휴수당: 약 356,747원</li>\n</ul>\n<p><strong>예시 2: 주 3일, 하루 6시간 근무 (주 18시간)</strong></p>\n<ul>\n<li>1일 평균 근로시간 = 18시간 ÷ 5일 = 3.6시간</li>\n<li>주휴수당 = 3.6시간 × 10,320원 = <strong>37,152원/주</strong></li>\n</ul>\n<p><strong>예시 3: 주 2일, 하루 5시간 근무 (주 10시간)</strong></p>\n<ul>\n<li>주 15시간 미만 → <strong>주휴수당 없음</strong></li>\n</ul>\n<h3 id=\"heading-11\">주의사항</h3>\n<ul>\n<li>결근 시 해당 주 주휴수당 미지급</li>\n<li>지각/조퇴는 결근이 아님 (주휴수당 지급)</li>\n<li>무급휴가 사용 시 주휴수당 계산에서 제외</li>\n</ul>\n<hr>\n<h2 id=\"heading-12\">시급 계산기 활용법</h2>\n<h3 id=\"heading-13\">내 시급 확인하기</h3>\n<p><strong>정확한 시급 계산 공식</strong>:</p>\n<blockquote>\n<p>시급 = 월급 ÷ 월 총 근로시간 (주휴시간 포함)</p>\n</blockquote>\n<h3 id=\"heading-14\">예시: 월급 220만 원 직장인</h3>\n<table>\n<thead>\n<tr>\n<th>계산 항목</th>\n<th>값</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>월급</td>\n<td>2,200,000원</td>\n</tr>\n<tr>\n<td>월 근로시간</td>\n<td>209시간</td>\n</tr>\n<tr>\n<td><strong>시급</strong></td>\n<td><strong>10,526원</strong></td>\n</tr>\n</tbody>\n</table>\n<p>→ 최저임금(10,320원) 이상이므로 <strong>적법</strong></p>\n<h3 id=\"heading-15\">예시: 월급 200만 원 직장인</h3>\n<table>\n<thead>\n<tr>\n<th>계산 항목</th>\n<th>값</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>월급</td>\n<td>2,000,000원</td>\n</tr>\n<tr>\n<td>월 근로시간</td>\n<td>209시간</td>\n</tr>\n<tr>\n<td><strong>시급</strong></td>\n<td><strong>9,569원</strong></td>\n</tr>\n</tbody>\n</table>\n<p>→ 최저임금(10,320원) 미만으로 <strong>위반</strong></p>\n<hr>\n<h2 id=\"heading-16\">사업주가 알아야 할 것</h2>\n<h3 id=\"heading-17\">최저임금 적용 범위</h3>\n<table>\n<thead>\n<tr>\n<th>적용 대상</th>\n<th>내용</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1인 이상 사업장</td>\n<td>모두 적용</td>\n</tr>\n<tr>\n<td>정규직/비정규직</td>\n<td>모두 적용</td>\n</tr>\n<tr>\n<td>아르바이트</td>\n<td>모두 적용</td>\n</tr>\n<tr>\n<td>외국인 근로자</td>\n<td>모두 적용</td>\n</tr>\n<tr>\n<td>수습 기간</td>\n<td><strong>90%까지 감액 가능</strong> (일부 제한)</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-18\">최저임금 포함/미포함 항목</h3>\n<p><strong>최저임금에 포함되는 항목</strong>:</p>\n<ul>\n<li>기본급</li>\n<li>매월 지급되는 고정 상여금</li>\n<li>매월 지급되는 복리후생비</li>\n</ul>\n<p><strong>최저임금에 포함되지 않는 항목</strong>:</p>\n<ul>\n<li>연장근로수당</li>\n<li>야간근로수당</li>\n<li>휴일근로수당</li>\n<li>연차수당</li>\n<li>식대/교통비 (실비 성격)</li>\n</ul>\n<h3 id=\"heading-19\">위반 시 처벌</h3>\n<table>\n<thead>\n<tr>\n<th>위반 내용</th>\n<th>처벌</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>최저임금 미지급</td>\n<td><strong>3년 이하 징역 또는 2천만 원 이하 벌금</strong></td>\n</tr>\n<tr>\n<td>최저임금 고지 위반</td>\n<td>100만 원 이하 과태료</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-20\">사업장 고지 의무</h3>\n<p>모든 사업장은 최저임금을 <strong>근로자가 볼 수 있는 곳</strong>에 게시해야 합니다:</p>\n<ul>\n<li>사무실 게시판</li>\n<li>휴게실</li>\n<li>급여명세서 등</li>\n</ul>\n<hr>\n<h2 id=\"heading-21\">근로자가 알아야 할 것</h2>\n<h3 id=\"heading-22\">최저임금 미달 확인법</h3>\n<ol>\n<li>급여명세서에서 <strong>월급</strong> 확인</li>\n<li>실제 <strong>월 근로시간</strong> 계산 (주휴시간 포함)</li>\n<li><strong>시급 계산</strong>: 월급 ÷ 월 근로시간</li>\n<li>**2026년 최저임금(10,320원)**과 비교</li>\n</ol>\n<h3 id=\"heading-23\">최저임금 미달 시 대응</h3>\n<ol>\n<li><strong>사업주에게 시정 요청</strong></li>\n<li>시정되지 않으면 <strong>고용노동부 신고</strong>\n<ul>\n<li>고용노동부 콜센터: 1350</li>\n<li>관할 고용노동청 방문</li>\n</ul>\n</li>\n<li><strong>체불임금 청구 소송</strong></li>\n</ol>\n<h3 id=\"heading-24\">수습 기간 감액 규정</h3>\n<table>\n<thead>\n<tr>\n<th>조건</th>\n<th>감액 가능</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>수습 기간</td>\n<td>3개월 이내</td>\n</tr>\n<tr>\n<td>단순노무직</td>\n<td><strong>감액 불가</strong></td>\n</tr>\n<tr>\n<td>1년 미만 계약</td>\n<td><strong>감액 불가</strong></td>\n</tr>\n<tr>\n<td>그 외</td>\n<td><strong>최대 10% 감액 가능</strong> (시급 9,288원)</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-25\">최저임금 변화 추이</h2>\n<h3 id=\"heading-26\">최근 5년간 최저임금</h3>\n<table>\n<thead>\n<tr>\n<th>연도</th>\n<th>시급</th>\n<th>월급 (209시간)</th>\n<th>인상률</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2022년</td>\n<td>9,160원</td>\n<td>1,914,440원</td>\n<td>5.0%</td>\n</tr>\n<tr>\n<td>2023년</td>\n<td>9,620원</td>\n<td>2,010,580원</td>\n<td>5.0%</td>\n</tr>\n<tr>\n<td>2024년</td>\n<td>9,860원</td>\n<td>2,060,740원</td>\n<td>2.5%</td>\n</tr>\n<tr>\n<td>2025년</td>\n<td>10,030원</td>\n<td>2,096,270원</td>\n<td>1.7%</td>\n</tr>\n<tr>\n<td><strong>2026년</strong></td>\n<td><strong>10,320원</strong></td>\n<td><strong>2,156,880원</strong></td>\n<td><strong>2.9%</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-27\">최저임금 1만 원 돌파</h3>\n<ul>\n<li>2024년: 9,860원 (1만 원 미달)</li>\n<li><strong>2025년: 10,030원</strong> (최초 1만 원 돌파)</li>\n<li>2026년: 10,360원 (1만 원대 안착)</li>\n</ul>\n<hr>\n<h2 id=\"heading-28\">자주 묻는 질문 (FAQ)</h2>\n<h3 id=\"heading-29\">Q1. 아르바이트도 주휴수당 받나요?</h3>\n<p><strong>네, 주 15시간 이상 근무하면 받습니다.</strong></p>\n<ul>\n<li>고용 형태와 관계없이 적용</li>\n<li>주 15시간 미만 근무 시 미적용</li>\n</ul>\n<h3 id=\"heading-30\">Q2. 식대, 교통비는 최저임금에 포함되나요?</h3>\n<p><strong>실비 성격이면 포함되지 않습니다.</strong></p>\n<ul>\n<li>실비 변상적 성격: 미포함</li>\n<li>고정 급여 성격: 포함 가능</li>\n</ul>\n<h3 id=\"heading-31\">Q3. 수습 기간에는 최저임금 안 줘도 되나요?</h3>\n<p><strong>감액할 수 있지만 제한이 있습니다.</strong></p>\n<ul>\n<li>3개월 이내 수습 기간</li>\n<li>최대 10% 감액 (9,288원)</li>\n<li>단순노무직, 1년 미만 계약은 감액 불가</li>\n</ul>\n<h3 id=\"heading-32\">Q4. 최저임금 위반 신고하면 불이익 받나요?</h3>\n<p><strong>법적으로 불이익 금지입니다.</strong></p>\n<ul>\n<li>신고를 이유로 해고/불이익 처분 시 처벌</li>\n<li>익명 신고 가능</li>\n<li>고용노동부 1350 상담</li>\n</ul>\n<h3 id=\"heading-33\">Q5. 연봉제도 최저임금 적용되나요?</h3>\n<p><strong>네, 시급으로 환산해서 비교합니다.</strong></p>\n<ul>\n<li>연봉 ÷ 12개월 ÷ 209시간 = 시급</li>\n<li>시급이 10,320원 미만이면 위반</li>\n</ul>\n<h3 id=\"heading-34\">Q6. 야간수당, 주말수당은 어떻게 되나요?</h3>\n<p><strong>최저임금과 별도로 지급해야 합니다.</strong></p>\n<table>\n<thead>\n<tr>\n<th>구분</th>\n<th>가산율</th>\n<th>시급 환산</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>연장근로</td>\n<td>50%</td>\n<td>15,480원</td>\n</tr>\n<tr>\n<td>야간근로 (22시~06시)</td>\n<td>50%</td>\n<td>15,480원</td>\n</tr>\n<tr>\n<td>휴일근로</td>\n<td>50~100%</td>\n<td>15,480~20,640원</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"heading-35\">2026년 최저임금 핵심 정리</h2>\n<h3 id=\"heading-36\">꼭 기억할 숫자</h3>\n<table>\n<thead>\n<tr>\n<th>항목</th>\n<th>금액</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>시급</strong></td>\n<td><strong>10,320원</strong></td>\n</tr>\n<tr>\n<td><strong>일급 (8시간)</strong></td>\n<td><strong>82,560원</strong></td>\n</tr>\n<tr>\n<td><strong>월급 (209시간)</strong></td>\n<td><strong>2,156,880원</strong></td>\n</tr>\n<tr>\n<td><strong>연봉 환산</strong></td>\n<td><strong>약 2,588만 원</strong></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"heading-37\">체크리스트</h3>\n<p><strong>근로자용</strong>:</p>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 내 시급이 10,320원 이상인가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 주휴수당을 받고 있는가? (주 15시간 이상 시)</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 급여명세서를 정기적으로 확인하는가?</li>\n</ul>\n<p><strong>사업주용</strong>:</p>\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 모든 직원 시급이 10,320원 이상인가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 최저임금을 사업장에 게시했는가?</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> 주휴수당을 정확히 계산하고 있는가?</li>\n</ul>\n<hr>\n<h2 id=\"heading-38\">마무리</h2>\n<p>2026년 최저임금은 <strong>시급 10,320원</strong>, 월급 환산 <strong>2,156,880원</strong>입니다.</p>\n<p>근로자는 자신의 권리를 알고, 사업주는 법을 준수해야 합니다.</p>\n<p>궁금한 점은 <strong>고용노동부 콜센터 1350</strong>으로 문의하세요!</p>\n<hr>\n<p><strong>관련 글 추천:</strong></p>\n<ul>\n<li><a href=\"/posts/health-insurance-premium-2026\">2026년 건강보험료 변경사항 총정리</a></li>\n<li><a href=\"/posts/2026-credit-card-comparison\">2026년 추천 신용카드 비교 가이드</a></li>\n</ul>\n</div><nav class=\"border-t border-gray-200 pt-8 mt-8\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><a class=\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\" href=\"/posts/high-school-credit-system-2026\"><span class=\"text-sm text-gray-500 mb-1\">이전 글</span><span class=\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\">고교학점제 완벽 가이드: 학부모가 알아야 할 모든 것</span></a><a class=\"group flex flex-col p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors text-right\" href=\"/posts/national-technical-exam-schedule-2026\"><span class=\"text-sm text-gray-500 mb-1\">다음 글</span><span class=\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2\">2026년 국가기술자격 시험일정 총정리: 기사·산업기사·기능사 완벽 가이드</span></a></div></nav><section class=\"mt-12 pt-8 border-t border-gray-200\"><h2 class=\"text-xl font-bold text-gray-900 mb-6\">관련 게시글</h2><div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\"><a class=\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\" href=\"/posts/national-pension-reform-2026\"><h3 class=\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\">2026년 국민연금 개정 총정리: 보험료율 인상, 소득대체율, 연도별 변화 완벽 가이드</h3><p class=\"text-sm text-gray-500 line-clamp-2\">2026년 1월부터 시행되는 국민연금 개정안의 모든 것! 보험료율 9%→13% 단계적 인상, 소득대체율 43% 상향, 국가 지급보장 명문화까지 18년 만의 연금개혁을 쉽게 정리했습니다.</p></a><a class=\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\" href=\"/posts/self-employed-tax-guide-2026\"><h3 class=\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\">개인사업자 절세 가이드 - 종합소득세, 부가세 완벽 정리</h3><p class=\"text-sm text-gray-500 line-clamp-2\">개인사업자를 위한 2026년 절세 전략을 총정리했습니다. 종합소득세 신고, 부가가치세, 간이과세자 기준, 비용처리 방법까지 사업자가 꼭 알아야 할 세금 정보를 확인하세요.</p></a><a class=\"group block p-4 border border-gray-200 rounded-lg hover:border-blue-500 transition-colors\" href=\"/posts/real-estate-tax-guide-2026\"><h3 class=\"font-medium text-gray-900 group-hover:text-blue-600 line-clamp-2 mb-2\">부동산 세금 총정리 - 취득세, 양도세, 종부세 완벽 가이드</h3><p class=\"text-sm text-gray-500 line-clamp-2\">2026년 부동산 세금을 한눈에 정리했습니다. 취득세, 양도소득세, 종합부동산세의 세율과 계산 방법, 절세 전략까지 꼭 알아야 할 핵심 내용을 확인하세요.</p></a></div></section></article><!--$--><!--/$--></main><footer class=\"bg-gray-50 border-t border-gray-200\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">쓱싹</h3><p class=\"text-gray-600 text-sm\">다양한 주제의 유용한 정보를 제공하는 블로그입니다. 금융, 건강, IT 등 생활에 도움이 되는 정보를 쉽게 알려드립니다.</p></div><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">바로가기</h3><ul class=\"space-y-2\"><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/about\">소개</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/contact\">연락처</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/privacy\">개인정보처리방침</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/terms\">이용약관</a></li></ul></div><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">카테고리</h3><ul class=\"space-y-2\"><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/finance\">금융/투자</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/health\">건강/의료</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/tech\">IT/테크</a></li><li><a class=\"text-gray-600 hover:text-blu