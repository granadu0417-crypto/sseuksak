name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"google-adsense-account\" content=\"ca-pub-3591490977493759\"/><meta name=\"google-site-verification\" content=\"05uSSCwIsJLxLnMlswVBzMSOwEeGCOkpMhx9YJMZcng\"/><meta name=\"naver-site-verification\" content=\"f82b9ef52a15379f29a3f6d9ffe4dd6b9d6cc43b\"/><meta property=\"og:title\" content=\"쓱싹 - 유용한 정보 블로그\"/><meta property=\"og:description\" content=\"다양한 주제의 유용한 정보를 제공하는 블로그\"/><meta property=\"og:url\" content=\"https://sseuksak.com\"/><meta property=\"og:site_name\" content=\"쓱싹\"/><meta property=\"og:locale\" content=\"ko_KR\"/><meta property=\"og:image\" content=\"https://sseuksak.com/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"쓱싹\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"쓱싹 - 유용한 정보 블로그\"/><meta name=\"twitter:description\" content=\"다양한 주제의 유용한 정보를 제공하는 블로그\"/><meta name=\"twitter:image\" content=\"https://sseuksak.com/og-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"url\":\"https://sseuksak.com\",\"name\":\"쓱싹\",\"description\":\"다양한 주제의 유용한 정보를 제공하는 블로그\",\"inLanguage\":\"ko-KR\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://sseuksak.com/search?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"쓱싹\",\"url\":\"https://sseuksak.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://sseuksak.com/logo.svg\"},\"sameAs\":[],\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer service\",\"availableLanguage\":\"Korean\"}}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__className_9f2754 antialiased bg-white\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen flex flex-col\"><header class=\"sticky top-0 z-50 bg-white border-b border-gray-200\"><nav class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between items-center h-16\"><a class=\"flex items-center\" href=\"/\"><span class=\"text-2xl font-bold text-blue-600\">쓱싹</span></a><div class=\"hidden md:flex items-center space-x-8\"><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/finance\">금융/투자</a><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/insurance\">보험/법률</a><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/health\">건강/의료</a><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/tech\">IT/테크</a><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/education\">교육/자격증</a><a class=\"text-gray-600 hover:text-blue-600 transition-colors text-sm font-medium\" href=\"/category/lifestyle\">생활정보</a></div><button class=\"md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100\" aria-label=\"메뉴 열기\"><svg class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></nav></header><main class=\"flex-grow\"><div class=\"max-w-2xl mx-auto px-4 py-8\"><nav class=\"mb-6\"><a class=\"text-blue-600 hover:underline\" href=\"/tools\">← 도구 목록으로</a></nav><div class=\"text-center mb-8\"><h1 class=\"text-3xl font-bold text-gray-900 mb-2\">FIRE 조기은퇴 계산기</h1><p class=\"text-gray-600\">경제적 자유를 얻고 몇 살에 은퇴할 수 있는지 계산해요</p></div><div class=\"bg-white rounded-xl border border-gray-200 p-6 mb-6\"><div class=\"space-y-5\"><div><label class=\"block text-sm font-medium text-gray-700 mb-2\">현재 나이</label><input type=\"number\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500\" min=\"20\" max=\"70\" value=\"30\"/></div><div><label class=\"block text-sm font-medium text-gray-700 mb-2\">현재 자산 (원)</label><input type=\"number\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500\" step=\"10000000\" value=\"50000000\"/><p class=\"text-sm text-gray-500 mt-1\">5000만원</p></div><div><label class=\"block text-sm font-medium text-gray-700 mb-2\">연간 소득 (세후)</label><input type=\"number\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500\" step=\"1000000\" value=\"50000000\"/><p class=\"text-sm text-gray-500 mt-1\">5000만원</p></div><div><label class=\"block text-sm font-medium text-gray-700 mb-2\">연간 지출</label><input type=\"number\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500\" step=\"1000000\" value=\"30000000\"/><p class=\"text-sm text-gray-500 mt-1\">3000만원<!-- --> (저축률: <!-- -->40.0<!-- -->%)</p></div><div><label class=\"block text-sm font-medium text-gray-700 mb-2\">예상 투자 수익률 (연 %)</label><input type=\"number\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500\" min=\"0\" max=\"15\" step=\"0.5\" value=\"7\"/><p class=\"text-sm text-gray-500 mt-1\">S&amp;P 500 장기 평균: 약 7%</p></div></div><button class=\"w-full mt-6 py-3 bg-orange-500 text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors\">계산하기</button></div><div class=\"mt-8 bg-yellow-50 rounded-xl border border-yellow-200 p-6\"><h3 class=\"font-semibold text-gray-900 mb-3\">가장 중요한 인사이트</h3><blockquote class=\"border-l-4 border-yellow-400 pl-4 italic text-gray-700\">&quot;복리는 강력하지만 시간이 오래 걸려요. 5~10년 안에 은퇴하려면 <strong>투자 수익률이 아닌 저축률</strong>이 가장 중요해요.&quot;</blockquote><p class=\"text-sm text-gray-600 mt-3\">— networthify.com (FIRE 계산기 원본)</p></div><div class=\"mt-6 bg-white rounded-xl border border-gray-200 p-6\"><h3 class=\"font-semibold text-gray-900 mb-4\">저축률별 은퇴까지 걸리는 시간</h3><p class=\"text-sm text-gray-600 mb-4\">현재 저축률: <span class=\"font-bold text-orange-600\">40.0<!-- -->%</span></p><div class=\"space-y-2\"><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">10<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:49%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">51<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">20<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:63%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">37<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">30<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:72%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">28<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">40<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-orange-500\" style=\"width:78%\"></div></div><span class=\"w-16 text-sm text-right font-bold text-orange-600\">22<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">50<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:83%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">17<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">60<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:87.5%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">12.5<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">70<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:91.5%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">8.5<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">80<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:94.5%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">5.5<!-- -->년</span></div><div class=\"flex items-center gap-3\"><span class=\"w-12 text-sm text-gray-600\">90<!-- -->%</span><div class=\"flex-1 bg-gray-100 rounded-full h-5 overflow-hidden\"><div class=\"h-full rounded-full bg-blue-300\" style=\"width:97.5%\"></div></div><span class=\"w-16 text-sm text-right text-gray-600\">2.5<!-- -->년</span></div></div><p class=\"text-xs text-gray-500 mt-3\">* 연 7% 투자 수익률 가정</p></div><div class=\"mt-6 bg-white rounded-xl border border-gray-200 p-6\"><h3 class=\"font-semibold text-gray-900 mb-4\">FIRE의 5가지 유형</h3><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3\"><div class=\"p-4 rounded-lg border bg-green-100 border-green-300\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"font-medium text-gray-900\">Lean FIRE</span></div><p class=\"text-sm text-gray-600\">최소한의 지출로 빠르게 은퇴. 연간 지출 2천만원 이하 목표.</p><p class=\"text-xs text-gray-500 mt-2\">필요 자금: 연 지출 x <!-- -->20</p></div><div class=\"p-4 rounded-lg border bg-blue-100 border-blue-300\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"font-medium text-gray-900\">Regular FIRE</span></div><p class=\"text-sm text-gray-600\">일반적인 FIRE. 현재 생활 수준 유지하며 은퇴.</p><p class=\"text-xs text-gray-500 mt-2\">필요 자금: 연 지출 x <!-- -->25</p></div><div class=\"p-4 rounded-lg border bg-purple-100 border-purple-300\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"font-medium text-gray-900\">Fat FIRE</span></div><p class=\"text-sm text-gray-600\">넉넉한 은퇴 자금. 여유로운 생활과 여행 가능.</p><p class=\"text-xs text-gray-500 mt-2\">필요 자금: 연 지출 x <!-- -->33</p></div><div class=\"p-4 rounded-lg border bg-orange-100 border-orange-300\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"font-medium text-gray-900\">Coast FIRE</span></div><p class=\"text-sm text-gray-600\">은퇴 자금을 복리로 굴려두고, 생활비만 벌면 되는 상태.</p></div></div><div class=\"mt-3\"><div class=\"p-4 rounded-lg border bg-pink-100 border-pink-300\"><div class=\"flex items-center gap-2 mb-2\"><span class=\"font-medium text-gray-900\">Barista FIRE</span></div><p class=\"text-sm text-gray-600\">부분 은퇴. 좋아하는 일을 파트타임으로 하며 부족분 충당.</p></div></div></div><div class=\"mt-6 bg-blue-50 rounded-xl border border-blue-200 p-6\"><h3 class=\"font-semibold text-gray-900 mb-3\">4% Rule (트리니티 연구)</h3><div class=\"space-y-3 text-sm text-gray-700\"><p>1998년 트리니티 대학의 연구에서 시작된 규칙이에요. 주식 50% + 채권 50% 포트폴리오에서 매년 <strong>초기 자산의 4%</strong>를 인출하면,<strong>30년 이상 자산이 고갈되지 않을 확률이 95% 이상</strong>이라는 연구 결과예요.</p><div class=\"bg-white rounded-lg p-4\"><p class=\"font-medium mb-2\">계산 예시:</p><ul class=\"space-y-1 text-gray-600\"><li>• 연간 지출 3,000만원 → 필요 자금: 3,000만 x 25 = <strong>7.5억원</strong></li><li>• 연간 지출 4,000만원 → 필요 자금: 4,000만 x 25 = <strong>10억원</strong></li><li>• 연간 지출 5,000만원 → 필요 자금: 5,000만 x 25 = <strong>12.5억원</strong></li></ul></div></div></div><div class=\"mt-6 bg-gray-50 rounded-xl p-6\"><h3 class=\"font-semibold text-gray-900 mb-3\">FIRE란?</h3><ul class=\"space-y-2 text-sm text-gray-600\"><li>• <strong>FIRE</strong>: Financial Independence, Retire Early (경제적 자유, 조기 은퇴)</li><li>• <strong>경제적 자유</strong>: 투자 수익만으로 생활비를 충당할 수 있는 상태</li><li>• <strong>핵심</strong>: 소비를 줄이면 1) 저축이 늘고 2) 필요 은퇴 자금이 줄어요</li><li>• <strong>주의</strong>: 인플레이션, 의료비, 예상치 못한 지출을 고려해 여유있게 계획하세요</li></ul><div class=\"mt-4 pt-4 border-t border-gray-200\"><p class=\"text-xs text-gray-500\">참고: networthify.com, Mr. Money Mustache, Trinity Study (1998)</p></div></div></div><!--$--><!--/$--></main><footer class=\"bg-gray-50 border-t border-gray-200\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">쓱싹</h3><p class=\"text-gray-600 text-sm\">다양한 주제의 유용한 정보를 제공하는 블로그입니다. 금융, 건강, IT 등 생활에 도움이 되는 정보를 쉽게 알려드립니다.</p></div><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">바로가기</h3><ul class=\"space-y-2\"><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/about\">소개</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/contact\">연락처</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/privacy\">개인정보처리방침</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/terms\">이용약관</a></li></ul></div><div><h3 class=\"text-lg font-semibold text-gray-900 mb-4\">카테고리</h3><ul class=\"space-y-2\"><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/finance\">금융/투자</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/health\">건강/의료</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/tech\">IT/테크</a></li><li><a class=\"text-gray-600 hover:text-blue-600 text-sm\" href=\"/category/lifestyle\">생활정보</a></li></ul></div></div><div class=\"mt-8 pt-8 border-t border-gray-200\"><p class=\"text-center text-gray-500 text-sm\">© <!-- -->2026<!-- --> 쓱싹. All rights reserved.</p></div></div></footer></div><script src=\"/_next/static/chunks/webpack-afaa36114f407091.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[1402,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-e78f5894d0a0b16c.js\\\"],\\\"\\\"]\\n3:I[1398,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-e78f5894d0a0b16c.js\\\"],\\\"default\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[8924,[],\\\"\\\"]\\n6:I[2619,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"554\\\",\\\"static/chunks/app/tools/page-f6d4c9d14c709db5.js\\\"],\\\"\\\"]\\ne:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/d2c1ffb734f61872-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/css/be89a9700d24476f.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/b060768bd19d627c.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"30Dh3F-gwThwhWHzEqvhC\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"tools\\\",\\\"fire-calculator\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"tools\\\",{\\\"children\\\":[\\\"fire-calculator\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/be89a9700d24476f.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/b060768bd19d627c.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\